---
// /agents — product pillar page, content per research/website-content/agents.md.
// PillarPage pattern: OnaNav → OnaHero(eyebrow) → Explanation → StatsBand →
// FeatureRail(5) → QuoteBlock([VERIFY] placeholder) → TechDetails(3) → FinalCTA → MegaFooter.
import Layout from '../layouts/Layout.astro';
import OnaNav from '../components/ona/OnaNav.astro';
import OnaHero from '../components/ona/OnaHero.astro';
import Explanation from '../components/ona/Explanation.astro';
import Vignette from '../components/ona/Vignette.astro';
import StatsBand from '../components/ona/StatsBand.astro';
import FeatureRail from '../components/ona/FeatureRail.astro';
import QuoteBlock from '../components/ona/QuoteBlock.astro';
import TechDetails from '../components/ona/TechDetails.astro';
import FinalCTA from '../components/ona/FinalCTA.astro';
import MegaFooter from '../components/ona/MegaFooter.astro';

// §3 — Three numbers (product numbers)
const stats = [
  { value: 'Minutes', label: 'to put a prebuilt specialist to work' },
  { value: '24/7', label: 'running in the cloud, working while you sleep' },
  { value: '3 surfaces', label: 'it shows up on: Slack, web, and email' },
];

// §4 — Feature rail (sticky rail + full-width blocks, per ona case-page anatomy)
const features = [
  {
    name: 'Built for the job',
    title: 'Built and tested for the job',
    eyebrow: 'Not a prompt you hope works.',
    body: "Each agent is assembled for its role and run against real work before it touches yours. It does the job, it isn't a demo of the job.",
    vignette: { variant: 'terminal', tint: 'mint' },
  },
  {
    name: 'Reach it anywhere',
    title: 'Reach it where you work',
    eyebrow: 'Hand it off and close your laptop.',
    body: 'Give it a task in Slack, on the web, or over email. It works in the cloud, and the finished work comes back to you in the same place you asked.',
    vignette: { variant: 'connections', tint: 'sky' },
  },
  {
    name: 'Learns your business',
    title: 'It learns your business',
    eyebrow: 'The longer it works, the more it knows.',
    body: "Every task teaches it your accounts, your process, your exceptions. It doesn't reset between sessions, and that knowledge doesn't leave when someone quits.",
    vignette: { variant: 'chat', tint: 'cream' },
  },
  {
    name: 'Prebuilt or custom',
    title: 'Prebuilt, or build your own',
    eyebrow: 'Start in minutes, or build for any job.',
    body: 'Pick a specialist for a common role, or build one yourself. Name the role, connect the tools, set how it works. No code.',
    vignette: { variant: 'workflow', tint: 'orange' },
  },
  {
    name: 'You stay in control',
    title: 'You stay in control',
    eyebrow: 'You see what every agent can touch.',
    body: "What data it can reach, what it can do, and every step it took. Nothing runs where you can't see it.",
    vignette: { variant: 'audit', tint: 'mint' },
  },
];

// §6 — Technical details → docs
const techRows = [
  {
    title: 'How an agent is configured',
    desc: 'Identity, skills, tools, behaviour, integrations.',
  },
  {
    title: 'How agents run in the cloud',
    desc: 'The runtime, scheduling, hand-off.',
  },
  {
    title: 'How agent memory works',
    desc: "What it learns, where it's stored, who sees it.",
  },
];
---

<Layout
  title="Eluu AI — An AI specialist for every role on your team"
  description="Each one comes built for its job and connected to your tools. Hand it work in Slack, and it runs in the cloud while you get on with your day."
  path="/agents"
>
  <OnaNav />
  <main>
    <!-- §1 HERO -->
    <OnaHero
      eyebrow="Agents"
      h1="An AI specialist for every role on your team."
      sub="Each one comes built for its job and connected to your tools. Hand it work in Slack, and it runs in the cloud while you get on with your day."
    />

    <!-- §2 EXPLANATION -->
    <Explanation
      heading="Built for the role, ready to work."
      subhead="Each agent is built for a specific role, with the tools, skills, and knowledge that role needs wired in and tested on real work. Most AI is an experiment. An agent isn't. And it runs in the cloud, so you hand off the work and close your laptop."
      linkLabel="See the agent library"
      linkHref="/cookbook"
    >
      <Vignette variant="prompt" tint="orange" ratio="16 / 10" />
    </Explanation>

    <!-- §3 THREE NUMBERS -->
    <StatsBand stats={stats} />

    <!-- §4 FEATURE RAIL -->
    <FeatureRail features={features} />

    <!-- §5 TESTIMONIAL ([VERIFY] — placeholder) -->
    <QuoteBlock />

    <!-- §6 TECHNICAL DETAILS -->
    <TechDetails rows={techRows} />

    <!-- §7 FINAL CTA -->
    <FinalCTA headline="Start with one specialist. Grow a team." />
  </main>

  <MegaFooter />
</Layout>
