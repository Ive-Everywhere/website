---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import Testimonials from '../components/Testimonials.astro';

const plans = [
  {
    slug: 'team',
    name: 'Team',
    description: 'For small teams getting productive.',
    price: '$17',
    period: '/mo',
    features: [
      '2 colleagues',
      '$20 usage budget /month',
      '1,000 integration credits',
      '25 active jobs',
      '6 parallel sessions',
      '10 action views',
      '5 GB file storage',
      'Team Hard Drive, shared integrations',
      'Up to 3 users',
    ],
  },
  {
    slug: 'max',
    name: 'Max',
    description: 'For growing teams with heavy usage.',
    price: '$99',
    period: '/mo',
    features: [
      'Unlimited colleagues',
      '$150 usage budget /month',
      '25K integration credits',
      '25 active jobs',
      '20 parallel sessions',
      '10 action views',
      '5 GB file storage',
      'Talk to AI colleagues on Slack',
      'Team Hard Drive, shared integrations',
      'Up to 5 users',
    ],
  },
  {
    slug: 'maxpro',
    name: 'Max Pro',
    description: 'Maximum power for demanding teams.',
    price: '$199',
    period: '/mo',
    features: [
      'Unlimited colleagues',
      '$330 usage budget /month',
      '100K integration credits',
      'Unlimited active jobs',
      '40 parallel sessions',
      'Unlimited action views',
      '25 GB file storage',
      'Talk to AI colleagues on Slack',
      'Team Hard Drive, shared integrations',
      'Up to 5 users',
    ],
  },
  {
    slug: 'enterprise',
    name: 'Enterprise',
    description: 'Built for organisations with advanced security, compliance, and scale requirements.',
    price: 'Custom',
    period: '',
    features: [
      'Dedicated account manager',
      'Custom integrations & tool access',
      'SSO & role-based permissions',
      'Advanced audit logging',
      'Customer-facing colleague deployment',
      'Custom data residency',
      'SLA guarantees',
    ],
  },
];
---

<Layout title="Pricing — Eluu AI">
  <Navbar />
  <main class="pr-page">
    <div class="pr-content">
      <!-- Header -->
      <div class="pr-header">
        <span class="pr-badge reveal">Pricing</span>
        <h1 class="pr-title reveal">Power your team at any scale.</h1>
        <p class="pr-sub reveal">Start free. Scale when you're ready.</p>
      </div>

      <!-- Cards -->
      <div class="pr-cards">
        {plans.map((plan) => (
          <div class="pr-card reveal">
            <div class="pr-card-top">
              <h2 class="pr-plan-name">{plan.name}</h2>
              <p class="pr-plan-desc">{plan.description}</p>
              <div class="pr-price">
                <span class="pr-price-value">{plan.price}</span>
                {plan.period && <span class="pr-price-period">{plan.period}</span>}
              </div>
              <a
                href={plan.slug === 'enterprise' ? 'https://cal.com/krishna-kaipa-wh7ao3/15min' : 'https://app.eluu.ai'}
                class={`pr-cta ${plan.slug === 'enterprise' ? 'pr-cta-outline' : 'pr-cta-primary'}`}
                onclick={plan.slug === 'enterprise'
                  ? `window.posthog?.capture('enterprise_contact_clicked')`
                  : `window.posthog?.capture('pricing_plan_selected', { plan: '${plan.slug}' })`}
              >
                {plan.slug === 'enterprise' ? 'Contact sales' : 'Get started'}
              </a>
            </div>
            <div class="pr-divider"></div>
            <ul class="pr-features">
              {plan.features.map((f) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>

    <!-- Testimonials — reuse homepage component -->
    <Testimonials />

    <div class="pr-content" style="padding-top: 0;">

      <!-- FAQ -->
      <div class="pr-faq reveal">
        <h2 class="pr-faq-heading">Questions & Answers</h2>
        <div class="pr-faq-list">
          <details class="pr-faq-item">
            <summary class="pr-faq-q">Is there a free trial?</summary>
            <p class="pr-faq-a">There's no traditional free trial, but every new account comes with a small amount of free usage so you can explore the platform, set up colleagues, and see how it works. Once you've used your free allocation, you'll need to purchase a plan to continue.</p>
          </details>
          <details class="pr-faq-item">
            <summary class="pr-faq-q">How does usage work?</summary>
            <p class="pr-faq-a">Usage is budget-based. Every action your colleagues take — reading data, executing tasks, generating outputs — consumes from your usage budget. Team includes $20/month, Max gives you $150/month, and Max Pro includes $330/month. Enterprise gets custom budgets sized to your workload.</p>
          </details>
          <details class="pr-faq-item">
            <summary class="pr-faq-q">Can I switch plans later?</summary>
            <p class="pr-faq-a">Yes — upgrade or downgrade anytime. Changes take effect at the start of your next billing cycle. Your colleagues, configurations, and Hard Drive data carry over seamlessly. Unused tokens don't roll over between cycles.</p>
          </details>
          <details class="pr-faq-item">
            <summary class="pr-faq-q">Is my data secure?</summary>
            <p class="pr-faq-a">Every connection is scoped with OAuth and per-workspace keys. Your data never leaves your environment. All integrations run through your own infrastructure with full audit logging. Enterprise customers get custom data residency and SLA guarantees.</p>
          </details>
          <details class="pr-faq-item">
            <summary class="pr-faq-q">What integrations are supported?</summary>
            <p class="pr-faq-a">All integrations are supported on every plan — Salesforce, HubSpot, Stripe, Google Sheets, Slack, Gmail, and 20+ more. You also get custom API connections to plug in any tool your team uses. No integration is locked behind a higher tier.</p>
          </details>
          <details class="pr-faq-item">
            <summary class="pr-faq-q">How is billing handled?</summary>
            <p class="pr-faq-a">All payments are processed securely through Paddle. You can pay monthly or annually. Enterprise customers can request invoice/PO billing. Cancel anytime — no lock-in contracts.</p>
          </details>
          <details class="pr-faq-item">
            <summary class="pr-faq-q">What happens if I run out of tokens?</summary>
            <p class="pr-faq-a">Your colleagues will pause until the next billing cycle, when your token allocation replenishes automatically. You can also upgrade your plan at any time for an immediate top-up. Enterprise customers can configure auto-scaling so colleagues never stop.</p>
          </details>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .pr-page {
    background: #13100a;
    min-height: 100vh;
  }

  /* ── Content ── */
  .pr-content {
    max-width: 1380px;
    margin: 0 auto;
    padding: 140px 20px 112px;
    box-sizing: border-box;
  }
  @media (max-width: 480px) {
    .pr-content { padding: 100px 16px 56px; }
  }

  /* ── Header ── */
  .pr-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .pr-badge {
    display: inline-block;
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: rgba(237, 233, 227, 0.6);
    background: rgba(237, 233, 227, 0.06);
    padding: 6px 16px;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.08);
    margin-bottom: 16px;
  }
  .pr-title {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-style: normal;
    font-size: clamp(32px, 5vw, 52px);
    color: #ede9e3;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .pr-sub {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    color: rgba(237, 233, 227, 0.5);
    margin: 0;
    line-height: 1.5;
  }

  /* ── Cards ── */
  .pr-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 640px) {
    .pr-cards { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1080px) {
    .pr-cards { grid-template-columns: 1fr 1fr 1fr 1fr; }
  }

  .pr-card {
    background: #1e1d1b;
    border-radius: 4px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pr-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
  }
  .pr-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .pr-card-top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pr-plan-name {
    font-family: 'Söhne', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #ede9e3;
    margin: 0;
  }
  .pr-plan-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.5;
    margin: 0;
    min-height: 42px;
  }

  .pr-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 12px;
  }
  .pr-price-value {
    font-family: 'Söhne', sans-serif;
    font-size: 42px;
    font-weight: 600;
    color: #ede9e3;
    letter-spacing: -1px;
    line-height: 1;
  }
  .pr-price-period {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
  }

  .pr-divider {
    height: 1px;
    background: rgba(237, 233, 227, 0.06);
    margin: 24px 0;
  }

  .pr-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pr-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.7);
    line-height: 1.4;
  }
  .pr-features svg {
    flex-shrink: 0;
    color: rgba(237, 233, 227, 0.35);
  }

  /* ── CTA buttons ── */
  .pr-cta {
    display: block;
    text-align: center;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 24px;
    border-radius: 4px;
    text-decoration: none;
    line-height: 1;
    margin-top: 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pr-cta:hover { transform: translateY(-1px); }
  .pr-cta-primary {
    background: #ede9e3;
    color: #14120b;
    border: 1px solid #ede9e3; /* match outline variant height */
  }
  .pr-cta-primary:hover { box-shadow: 0 4px 12px rgba(237, 233, 227, 0.15); }
  .pr-cta-outline {
    background: transparent;
    color: rgba(237, 233, 227, 0.7);
    border: 1px solid rgba(237, 233, 227, 0.15);
  }
  .pr-cta-outline:hover {
    border-color: rgba(237, 233, 227, 0.3);
    color: #ede9e3;
  }

  /* ── FAQ ── */
  .pr-faq {
    padding: 96px 0 0;
  }
  .pr-faq-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    letter-spacing: -0.02em;
    margin: 0 0 40px;
  }
  .pr-faq-list {
    max-width: 100%;
  }
  .pr-faq-item {
    border-top: 1px solid rgba(237, 233, 227, 0.06);
  }
  .pr-faq-item:last-child {
    border-bottom: 1px solid rgba(237, 233, 227, 0.06);
  }
  .pr-faq-q {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    font-weight: 500;
    color: rgba(237, 233, 227, 0.7);
    padding: 20px 0;
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    transition: color 0.2s ease;
  }
  .pr-faq-q:hover { color: #ede9e3; }
  .pr-faq-q::-webkit-details-marker { display: none; }
  .pr-faq-q::after {
    content: '+';
    font-family: 'Söhne', sans-serif;
    font-size: 18px;
    font-weight: 300;
    color: rgba(237, 233, 227, 0.35);
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.25s ease;
  }
  .pr-faq-item[open] .pr-faq-q::after {
    transform: rotate(45deg);
  }
  .pr-faq-item[open] .pr-faq-q {
    color: #ede9e3;
  }
  .pr-faq-a {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.65;
    margin: 0;
    padding: 0 0 20px;
    max-width: 100%;
  }
  @media (max-width: 480px) {
    .pr-faq { padding: 56px 0 0; }
    .pr-faq-heading { margin-bottom: 24px; }
  }
</style>
