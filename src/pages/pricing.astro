---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const plans = [
  {
    name: 'Pro plan',
    description: 'Perfect for individuals or small teams getting started with AI colleagues.',
    price: '$50',
    period: '/mo',
    features: [
      '2 AI colleagues',
      'Generous usage',
      'Web app access',
      'Basic memory & learning',
    ],
  },
  {
    name: 'Max plan',
    description: 'For power users and growing teams ready to deploy AI colleagues across their workflow.',
    price: '$200',
    period: '/mo',
    features: [
      'Unlimited AI colleagues',
      'Extended usage and peak time availability',
      'Slack, web & API access',
      'Scheduled tasks & commands',
      'Parallel execution',
      'Persistent memory & learning',
    ],
  },
  {
    name: 'Enterprise plan',
    description: 'Built for organisations with advanced security, compliance, and scale requirements.',
    price: 'Custom',
    period: '',
    features: [
      'Dedicated account manager',
      'Custom integrations & tool access',
      'SSO & role-based permissions',
      'Advanced audit logging',
      'Customer-facing colleague deployment',
      'Custom data residency',
      'SLA guarantees',
    ],
  },
];
---

<Layout title="Pricing — Eluu AI">
  <Navbar />
  <main class="pr-page">
    <!-- Animated gradient background -->
    <div class="pr-gradient" aria-hidden="true">
      <div class="pr-blob pr-blob-1"></div>
      <div class="pr-blob pr-blob-2"></div>
      <div class="pr-blob pr-blob-3"></div>
      <div class="pr-blob pr-blob-4"></div>
      <div class="pr-grain"></div>
    </div>

    <div class="pr-content">
      <!-- Header -->
      <div class="pr-header">
        <span class="pr-badge reveal">Flexible plans for every stage</span>
        <h1 class="pr-title reveal">Smart pricing for AI colleagues</h1>
        <p class="pr-sub reveal">Scalable pricing designed for fast-moving individuals and teams.</p>
      </div>

      <!-- Cards -->
      <div class="pr-cards">
        {plans.map((plan) => (
          <div class="pr-card reveal">
            <div class="pr-card-top">
              <h2 class="pr-plan-name">{plan.name}</h2>
              <p class="pr-plan-desc">{plan.description}</p>
              <div class="pr-price">
                <span class="pr-price-value">{plan.price}</span>
                {plan.period && <span class="pr-price-period">{plan.period}</span>}
              </div>
              <a href={plan.price === 'Custom' ? 'https://cal.com/krishna-kaipa-wh7ao3/15min' : 'https://app.eluu.ai'} class={`pr-cta ${plan.price === 'Custom' ? 'pr-cta-outline' : 'pr-cta-dark'}`}>
                {plan.price === 'Custom' ? 'Contact sales' : 'Get started'}
              </a>
            </div>
            <div class="pr-divider"></div>
            <ul class="pr-features">
              {plan.features.map((f) => (
                <li>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9 12l2 2 4-4"/></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .pr-page {
    position: relative;
    min-height: 100vh;
  }

  /* ── Animated gradient ── */
  .pr-gradient {
    position: absolute; inset: 0; z-index: 0;
    overflow: hidden;
  }
  .pr-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
  }
  .pr-blob-1 {
    width: 50vw; height: 50vw;
    background: radial-gradient(circle, #f5deb3 0%, #f5e6c8 40%, transparent 70%);
    top: -10%; left: -10%;
    animation: pr-drift-1 20s ease-in-out infinite;
  }
  .pr-blob-2 {
    width: 45vw; height: 45vw;
    background: radial-gradient(circle, #b8d8d0 0%, #c5e0d8 40%, transparent 70%);
    top: -5%; right: -5%;
    animation: pr-drift-2 25s ease-in-out infinite;
  }
  .pr-blob-3 {
    width: 40vw; height: 40vw;
    background: radial-gradient(circle, #e8a090 0%, #e0b0a0 40%, transparent 70%);
    bottom: 15%; right: 20%;
    animation: pr-drift-3 22s ease-in-out infinite;
    opacity: 0.5;
  }
  .pr-blob-4 {
    width: 35vw; height: 35vw;
    background: radial-gradient(circle, #d8c8e0 0%, #d0c0d8 40%, transparent 70%);
    bottom: 5%; left: 15%;
    animation: pr-drift-4 18s ease-in-out infinite;
    opacity: 0.4;
  }
  .pr-grain {
    position: absolute; inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
    opacity: 0.5;
    pointer-events: none;
  }

  @keyframes pr-drift-1 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(8vw, 4vh) scale(1.05); }
    50% { transform: translate(3vw, 8vh) scale(0.95); }
    75% { transform: translate(-5vw, 3vh) scale(1.08); }
  }
  @keyframes pr-drift-2 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-6vw, 5vh) scale(0.95); }
    50% { transform: translate(-10vw, 2vh) scale(1.1); }
    75% { transform: translate(-3vw, 7vh) scale(0.98); }
  }
  @keyframes pr-drift-3 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(5vw, -4vh) scale(1.08); }
    50% { transform: translate(-4vw, -8vh) scale(0.92); }
    75% { transform: translate(7vw, -2vh) scale(1.05); }
  }
  @keyframes pr-drift-4 {
    0%, 100% { transform: translate(0, 0) scale(1); }
    25% { transform: translate(-6vw, -5vh) scale(1.1); }
    50% { transform: translate(5vw, -3vh) scale(0.95); }
    75% { transform: translate(-3vw, 4vh) scale(1.02); }
  }

  @media (max-width: 768px) {
    .pr-blob { filter: blur(50px); }
    .pr-blob-3, .pr-blob-4 { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pr-blob { animation: none; }
  }

  /* ── Content ── */
  .pr-content {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 140px 24px 80px;
  }

  /* ── Header ── */
  .pr-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .pr-badge {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #58564d;
    background: rgba(255,255,255,0.6);
    backdrop-filter: blur(8px);
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid rgba(23,16,14,0.08);
    margin-bottom: 16px;
  }
  .pr-title {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 5vw, 56px);
    color: #17100e;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 0 0 12px;
  }
  .pr-sub {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #888;
    margin: 0;
    line-height: 1.5;
  }

  /* ── Cards ── */
  .pr-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }
  @media (min-width: 640px) {
    .pr-cards { grid-template-columns: 1fr 1fr; }
    .pr-card:last-child { grid-column: 1 / -1; }
  }
  @media (min-width: 960px) {
    .pr-cards { grid-template-columns: 1fr 1fr 1fr; }
    .pr-card:last-child { grid-column: auto; }
  }

  .pr-card {
    background: rgba(255,255,255,0.7);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(23,16,14,0.08);
    border-radius: 16px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pr-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0,0,0,0.08);
  }

  .pr-card-top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pr-plan-name {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 700;
    color: #17100e;
    margin: 0;
  }
  .pr-plan-desc {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #888;
    line-height: 1.5;
    margin: 0;
    min-height: 42px;
  }

  .pr-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 12px;
  }
  .pr-price-value {
    font-family: 'Inter', sans-serif;
    font-size: 42px;
    font-weight: 800;
    color: #17100e;
    letter-spacing: -1px;
    line-height: 1;
  }
  .pr-price-period {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #888;
  }

  .pr-divider {
    height: 1px;
    background: rgba(23,16,14,0.08);
    margin: 24px 0;
  }

  .pr-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pr-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #17100e;
    line-height: 1.4;
  }
  .pr-features svg {
    flex-shrink: 0;
  }

  /* ── CTA buttons ── */
  .pr-cta {
    display: block;
    text-align: center;
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1;
    margin-top: 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pr-cta:hover { transform: translateY(-1px); }
  .pr-cta-dark {
    background: #17100e;
    color: #ffffff;
  }
  .pr-cta-dark:hover { box-shadow: 0 4px 12px rgba(23,16,14,0.2); }
  .pr-cta-outline {
    background: #ffffff;
    color: #17100e;
    border: 1px solid rgba(23,16,14,0.12);
  }
  .pr-cta-outline:hover { box-shadow: 0 4px 12px rgba(23,16,14,0.08); }
</style>
