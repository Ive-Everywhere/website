---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const plans = [
  {
    slug: 'pro',
    name: 'Pro plan',
    description: 'Perfect for individuals or small teams getting started with AI colleagues.',
    price: '$50',
    period: '/mo',
    features: [
      '2 AI colleagues',
      'Generous usage',
      'Web app access',
      'Basic memory & learning',
    ],
  },
  {
    slug: 'max',
    name: 'Max plan',
    description: 'For power users and growing teams ready to deploy AI colleagues across their workflow.',
    price: '$200',
    period: '/mo',
    features: [
      'Unlimited AI colleagues',
      'Extended usage and peak time availability',
      'Slack, web & API access',
      'Scheduled tasks & commands',
      'Parallel execution',
      'Persistent memory & learning',
    ],
  },
  {
    slug: 'enterprise',
    name: 'Enterprise plan',
    description: 'Built for organisations with advanced security, compliance, and scale requirements.',
    price: 'Custom',
    period: '',
    features: [
      'Dedicated account manager',
      'Custom integrations & tool access',
      'SSO & role-based permissions',
      'Advanced audit logging',
      'Customer-facing colleague deployment',
      'Custom data residency',
      'SLA guarantees',
    ],
  },
];
---

<Layout title="Pricing — Eluu AI">
  <Navbar />
  <main class="pr-page">
    <div class="pr-content">
      <!-- Header -->
      <div class="pr-header">
        <span class="pr-badge reveal">Pricing</span>
        <h1 class="pr-title reveal">Simple plans, no surprises.</h1>
        <p class="pr-sub reveal">Start free. Scale when you're ready.</p>
      </div>

      <!-- Cards -->
      <div class="pr-cards">
        {plans.map((plan) => (
          <div class="pr-card reveal">
            <div class="pr-card-top">
              <h2 class="pr-plan-name">{plan.name}</h2>
              <p class="pr-plan-desc">{plan.description}</p>
              <div class="pr-price">
                <span class="pr-price-value">{plan.price}</span>
                {plan.period && <span class="pr-price-period">{plan.period}</span>}
              </div>
              <a
                href={plan.slug === 'enterprise' ? 'https://cal.com/krishna-kaipa-wh7ao3/15min' : 'https://app.eluu.ai'}
                class={`pr-cta ${plan.slug === 'enterprise' ? 'pr-cta-outline' : 'pr-cta-primary'}`}
                onclick={plan.slug === 'enterprise'
                  ? `window.posthog?.capture('enterprise_contact_clicked')`
                  : `window.posthog?.capture('pricing_plan_selected', { plan: '${plan.slug}' })`}
              >
                {plan.slug === 'enterprise' ? 'Contact sales' : 'Get started'}
              </a>
            </div>
            <div class="pr-divider"></div>
            <ul class="pr-features">
              {plan.features.map((f) => (
                <li>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                  {f}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .pr-page {
    background: #13100a;
    min-height: 100vh;
  }

  /* ── Content ── */
  .pr-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 140px 24px 112px;
  }
  @media (max-width: 480px) {
    .pr-content { padding: 100px 16px 56px; }
  }

  /* ── Header ── */
  .pr-header {
    text-align: center;
    margin-bottom: 56px;
  }
  .pr-badge {
    display: inline-block;
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: rgba(237, 233, 227, 0.6);
    background: rgba(237, 233, 227, 0.06);
    padding: 6px 16px;
    border-radius: 100px;
    border: 1px solid rgba(237, 233, 227, 0.08);
    margin-bottom: 16px;
  }
  .pr-title {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-style: normal;
    font-size: clamp(32px, 5vw, 52px);
    color: #ede9e3;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }
  .pr-sub {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    color: rgba(237, 233, 227, 0.5);
    margin: 0;
    line-height: 1.5;
  }

  /* ── Cards ── */
  .pr-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 640px) {
    .pr-cards { grid-template-columns: 1fr 1fr; }
    .pr-card:last-child { grid-column: 1 / -1; }
  }
  @media (min-width: 960px) {
    .pr-cards { grid-template-columns: 1fr 1fr 1fr; }
    .pr-card:last-child { grid-column: auto; }
  }

  .pr-card {
    background: #1e1d1b;
    border-radius: 4px;
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pr-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
  }
  .pr-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
  }

  .pr-card-top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .pr-plan-name {
    font-family: 'Söhne', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #ede9e3;
    margin: 0;
  }
  .pr-plan-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.5;
    margin: 0;
    min-height: 42px;
  }

  .pr-price {
    display: flex;
    align-items: baseline;
    gap: 4px;
    margin-top: 12px;
  }
  .pr-price-value {
    font-family: 'Söhne', sans-serif;
    font-size: 42px;
    font-weight: 600;
    color: #ede9e3;
    letter-spacing: -1px;
    line-height: 1;
  }
  .pr-price-period {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
  }

  .pr-divider {
    height: 1px;
    background: rgba(237, 233, 227, 0.06);
    margin: 24px 0;
  }

  .pr-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pr-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.7);
    line-height: 1.4;
  }
  .pr-features svg {
    flex-shrink: 0;
    color: rgba(237, 233, 227, 0.35);
  }

  /* ── CTA buttons ── */
  .pr-cta {
    display: block;
    text-align: center;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 24px;
    border-radius: 4px;
    text-decoration: none;
    line-height: 1;
    margin-top: 16px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .pr-cta:hover { transform: translateY(-1px); }
  .pr-cta-primary {
    background: #ede9e3;
    color: #14120b;
    border: 1px solid #ede9e3; /* match outline variant height */
  }
  .pr-cta-primary:hover { box-shadow: 0 4px 12px rgba(237, 233, 227, 0.15); }
  .pr-cta-outline {
    background: transparent;
    color: rgba(237, 233, 227, 0.7);
    border: 1px solid rgba(237, 233, 227, 0.15);
  }
  .pr-cta-outline:hover {
    border-color: rgba(237, 233, 227, 0.3);
    color: #ede9e3;
  }
</style>
