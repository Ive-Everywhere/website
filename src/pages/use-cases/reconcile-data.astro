---

<Layout
  title="Reconcile data across every system — Eluu AI"
  description="Charges in one tool, invoices in another, the ledger in a third. The agent pulls from all of them, matches line by line, and flags only what doesn't tie out."
  path="/use-cases/reconcile-data"
>
  <OnaNav />
  <main>
    <!-- §1 HERO -->
    <OnaHero
      eyebrow="Use case"
      h1="An agent that reconciles data across every system."
      sub="Charges in one tool, invoices in another, the ledger in a third. The agent pulls from all of them, matches line by line, and flags only what doesn't tie out."
    />

    <!-- §2 VALUE PROP -->
    <Explanation
      heading="It pulls from every system, matches line by line, and flags only the exceptions."
      subhead="The month-end grind, done every night. You look at what's wrong, not everything that's right."
      linkLabel="See it in the cookbook"
      linkHref="/cookbook"
    >
      <Vignette variant="table" tint="orange" ratio="16 / 10" />
    </Explanation>

    <!-- §3 STATS -->
    <StatsBand stats={stats} />

    <!-- §4 FEATURE RAIL -->
    <FeatureRail features={features} />

    <!-- §5 TESTIMONIAL -->
    <QuoteBlock />

    <!-- §6 POWERED BY -->
    <PoweredBy blocks={poweredBy} />

    <!-- §7 AGGREGATE PROOF -->
