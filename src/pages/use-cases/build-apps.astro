---
// /use-cases/build-apps — use-case page, content per research/website-content/usecase-build-apps.md.
import Layout from '../../layouts/Layout.astro';
import OnaNav from '../../components/ona/OnaNav.astro';
import OnaHero from '../../components/ona/OnaHero.astro';
import Explanation from '../../components/ona/Explanation.astro';
import Vignette from '../../components/ona/Vignette.astro';
import StatsBand from '../../components/ona/StatsBand.astro';
import FeatureRail from '../../components/ona/FeatureRail.astro';
import QuoteBlock from '../../components/ona/QuoteBlock.astro';
import PoweredBy from '../../components/ona/PoweredBy.astro';
import LogoBar from '../../components/ona/LogoBar.astro';
import ComplianceBadges from '../../components/ona/ComplianceBadges.astro';
import FinalCTA from '../../components/ona/FinalCTA.astro';
import MegaFooter from '../../components/ona/MegaFooter.astro';

// §3 — Numbers ([VERIFIED] shown, [BENCHMARK] shown, untagged shown)
const stats = [
  {
    value: '92',
    label: 'dashboards one team built, no engineering',
  },
  {
    value: 'Minutes',
    label: 'from a plain-English description to a working app',
  },
  {
    value: 'Live',
    label: "reads current data every time it's opened, not a frozen export",
  },
];

// §4 — Feature rail (sticky rail + full-width blocks, per ona case-page anatomy)
const features = [
  {
    name: 'Describe it',
    title: 'You describe it, the agent builds it',
    eyebrow: 'No code, no engineering ticket.',
    body: 'Tell the agent the tracker or dashboard you want, in plain English. It builds it.',
    vignette: { variant: 'prompt', tint: 'orange' },
  },
  {
    name: 'Connected to data',
    title: 'Connected to your data',
    eyebrow: 'It reads and writes your real systems.',
    body: "The app isn't a copy of your data. It pulls live from your tools and writes back to them.",
    vignette: { variant: 'connections', tint: 'sky' },
  },
  {
    name: 'Data stays live',
    title: 'The data stays live',
    eyebrow: 'Current values every time, not a frozen export.',
    body: 'The dashboard is right when you open it, because it reads your systems on the spot.',
    vignette: { variant: 'table', tint: 'mint' },
  },
  {
    name: 'Boards trigger tasks',
    title: 'Boards that trigger tasks',
    eyebrow: 'It can start the work, not only track it.',
    body: "A board can kick off the work it's tracking, so a kanban column moves the job forward instead of just displaying it.",
    vignette: { variant: 'workflow', tint: 'cream' },
  },
  {
    name: 'Governed by default',
    title: 'Governed like everything else',
    eyebrow: 'Same access controls and audit.',
    body: 'The app runs under the same permissions and audit trail as your agents.',
    vignette: { variant: 'audit', tint: 'mint' },
  },
];

// §6 — Powered by (cross-links; body/CTA copy reused from home.md §3 pillar cards)
const poweredBy = [
  {
    name: 'Connect any tool',
    body: 'Connect every tool your team uses, and see exactly what data each agent can touch.',
    ctaLabel: 'Explore connections',
    href: '/connections',
  },
  {
    name: 'It lives in the workspace',
    body: 'Run as many agents as you need, all in parallel, with shared memory, files, and team skills.',
    ctaLabel: 'Explore the workspace',
    href: '/workspace',
  },
  {
    name: 'Governed and audited',
    body: 'Control access, restrict risky actions, and audit every step. Enterprise-grade by default.',
    ctaLabel: 'Learn about security',
    href: '/security',
  },
];

---

<Layout
  title="Build dashboards and internal apps — Eluu AI"
  description="Describe the dashboard, tracker, or ticketing board you need. An agent builds it, connects it to your tools, and keeps it live."
  path="/use-cases/build-apps"
>
  <OnaNav />
  <main>
    <!-- §1 HERO -->
    <OnaHero
      eyebrow="Use case"
      h1="An agent that builds your internal dashboards and apps."
      sub="Describe the dashboard, tracker, or ticketing board you need. An agent builds it, connects it to your tools, and keeps it live."
    />

    <!-- §2 VALUE PROP -->
    <Explanation
      heading="It builds a working app, connects it to your data, and keeps it live."
      subhead="Not a static export you refresh by hand. A live tool, with its own data and storage, that reads your systems every time it's opened."
      linkLabel="See it in the cookbook"
      linkHref="/cookbook"
    >
      <Vignette variant="workflow" tint="orange" ratio="16 / 10" />
    </Explanation>

    <!-- §3 NUMBERS -->
    <StatsBand stats={stats} />

    <!-- §4 FEATURE RAIL -->
    <FeatureRail features={features} />

    <!-- §5 TESTIMONIAL -->
    <QuoteBlock />

    <!-- §6 POWERED BY -->
    <PoweredBy blocks={poweredBy} />

    <!-- §7 AGGREGATE PROOF -->
    <LogoBar label="Aggregate proof" />

    <!-- §8 COMPLIANCE -->
    <ComplianceBadges />

    <!-- §10 FINAL CTA -->
    <FinalCTA headline="Build the internal tool yourself." />
  </main>

  <MegaFooter />
</Layout>
