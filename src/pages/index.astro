---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroAgents from '../components/HeroAgents.astro';
import WorkforceGrid from '../components/WorkforceGrid.astro';
import PutToWork from '../components/PutToWork.astro';
import Testimonials from '../components/Testimonials.astro';
import Channels from '../components/Channels.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Eluu AI — Specialist agents that run your business" description="Deploy a team of AI specialists that work across your whole tool stack. In the cloud, in your Slack, on your schedule. Connected, controlled, and auditable by default." path="/">
  <Navbar />
  <main>
    <HeroAgents />
    <WorkforceGrid />
    <PutToWork />
    <Testimonials />
    <Channels />
  </main>
  <Footer />
</Layout>
