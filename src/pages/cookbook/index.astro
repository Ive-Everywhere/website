---
/**
 * The Cookbook, `/cookbook`. A browsable gallery of recipes, each a real
 * prompt + workflow you can run today. Layout is ours: hero, category filter,
 * collection cards, a featured strip, then the full grid. Cards link to the
 * recipe detail at `/cookbook/<slug>`.
 */
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { catColor } from '../../lib/cookbook';

const recipes = (await getCollection('cookbook', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const categories = [...new Set(recipes.map((r) => r.data.category))];

// Collections: group by the optional `collection` field, keep first-seen order.
const collectionMeta: Record<string, { blurb: string; tint: string }> = {
  'Month-end pack': { blurb: 'Everything finance runs at close.', tint: 'bg-[#eef1f7]' },
  'Revenue ops': { blurb: 'Keep the pipeline honest.', tint: 'bg-[#eef4ee]' },
  'Incident response': { blurb: 'From page to fix to post-mortem.', tint: 'bg-[#f3eef4]' },
};
const collections = [...new Set(recipes.map((r) => r.data.collection).filter(Boolean))] as string[];

const featured = recipes.filter((r) => r.data.featured);
---

<Base
  title="Cookbook, Eluu"
  description="A gallery of agent recipes, real prompts and workflows you can run across your tools today."
>
  <section class="bg-bg-white-0">
    <div class="page-shell gutter-188 flex flex-col gap-12 pt-16 pb-14">
      {/* hero */}
      <div class="flex flex-col items-center gap-5 text-center">
        <p class="t-mono-md text-text-soft-400">Cookbook</p>
        <h1 class="t-landing-h1 text-text-strong-950 max-w-[820px] text-balance">
          Recipes your agents can run today.
        </h1>
        <p class="t-paragraph-md text-text-sub-600 max-w-[560px] text-pretty">
          Practical prompts and workflows across your whole tool stack. Copy one, point it
          at your systems, and let it run.
        </p>
      </div>

      {/* category filter, static chips (progressive: a tiny script filters the grid) */}
      <div class="flex flex-wrap items-center justify-center gap-2.5" data-cat-bar>
        <button
          type="button"
          data-cat="all"
          class="t-label-md text-text-strong-950 bg-bg-soft-200 aria-[pressed=true]:bg-text-strong-950 aria-[pressed=true]:text-bg-white-0 min-h-9 rounded-full px-4 transition-colors"
          aria-pressed="true">All</button>
        {
          categories.map((c) => (
            <button
              type="button"
              data-cat={c}
              class="t-label-md text-text-sub-600 bg-bg-soft-200 hover:text-text-strong-950 aria-[pressed=true]:bg-text-strong-950 aria-[pressed=true]:text-bg-white-0 min-h-9 rounded-full px-4 transition-colors"
              aria-pressed="false">{c}</button>
          ))
        }
      </div>

      {/* collections */}
      {
        collections.length > 0 && (
          <div class="flex flex-col gap-5">
            <p class="t-mono-md text-text-soft-400 uppercase tracking-[0.08em]">Collections</p>
            <div class="grid gap-6 lg:grid-cols-3">
              {collections.map((name) => {
                const meta = collectionMeta[name] ?? { blurb: '', tint: 'bg-bg-soft-200' };
                const count = recipes.filter((r) => r.data.collection === name).length;
                return (
                  <div class={`${meta.tint} flex flex-col gap-2 rounded-[20px] p-7`}>
                    <p class="t-label-xs text-text-soft-400 font-mono uppercase tracking-[0.08em]">
                      Collection · {count} {count === 1 ? 'recipe' : 'recipes'}
                    </p>
                    <h3 class="t-h6 text-text-strong-950">{name}</h3>
                    <p class="t-label-md text-text-sub-600">{meta.blurb}</p>
                  </div>
                );
              })}
            </div>
          </div>
        )
      }

      {/* featured */}
      {
        featured.length > 0 && (
          <div class="flex flex-col gap-5">
            <p class="t-mono-md text-text-soft-400 uppercase tracking-[0.08em]">Featured</p>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {featured.map((r) => (
                <a
                  href={`/cookbook/${r.id}`}
                  class={`${catColor(r.data.category).surface} flex flex-col gap-4 rounded-[18px] p-5 transition-transform hover:-translate-y-0.5`}
                >
                  <span class={`${catColor(r.data.category).tile} ${catColor(r.data.category).ink} flex size-11 items-center justify-center rounded-[12px]`}>
                    <i class={`${r.data.icon} text-[22px]`} aria-hidden="true" />
                  </span>
                  <div class="flex flex-1 flex-col gap-1.5">
                    <h3 class="t-label-lg text-text-strong-950">{r.data.title}</h3>
                    <p class="t-label-md text-text-sub-600 line-clamp-3">{r.data.description}</p>
                  </div>
                  <span class={`${catColor(r.data.category).ink} t-label-xs font-mono uppercase tracking-[0.06em]`}>
                    {r.data.category}
                  </span>
                </a>
              ))}
            </div>
          </div>
        )
      }

      {/* all recipes */}
      <div class="flex flex-col gap-5">
        <p class="t-mono-md text-text-soft-400 uppercase tracking-[0.08em]">All recipes</p>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-grid>
          {
            recipes.map((r) => (
              <a
                href={`/cookbook/${r.id}`}
                data-card
                data-card-cat={r.data.category}
                class={`${catColor(r.data.category).surface} flex flex-col gap-4 rounded-[18px] p-6 transition-transform hover:-translate-y-0.5`}
              >
                <span class={`${catColor(r.data.category).tile} ${catColor(r.data.category).ink} flex size-12 items-center justify-center rounded-[13px]`}>
                  <i class={`${r.data.icon} text-[24px]`} aria-hidden="true" />
                </span>
                <div class="flex flex-1 flex-col gap-2">
                  <h3 class="t-h6 text-text-strong-950">{r.data.title}</h3>
                  <p class="t-label-md text-text-sub-600 text-pretty">{r.data.description}</p>
                </div>
                <div class="flex items-center gap-2">
                  <span class={`${catColor(r.data.category).ink} t-label-xs bg-bg-white-0/60 rounded-full px-2.5 py-1 font-mono`}>
                    {r.data.category}
                  </span>
                  <span class="t-label-xs text-text-soft-400 rounded-full px-1 py-1 font-mono capitalize">
                    {r.data.difficulty}
                  </span>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Category filter, no framework needed.
  const bar = document.querySelector<HTMLElement>('[data-cat-bar]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-card]'));
  bar?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-cat]');
    if (!btn) return;
    const cat = btn.dataset.cat;
    bar.querySelectorAll<HTMLButtonElement>('[data-cat]').forEach((b) =>
      b.setAttribute('aria-pressed', String(b === btn)),
    );
    for (const card of cards) {
      const show = cat === 'all' || card.dataset.cardCat === cat;
      card.style.display = show ? '' : 'none';
    }
  });
</script>
