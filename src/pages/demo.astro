---
/**
 * Schedule-a-meeting short URL.
 *
 * NOT `Astro.redirect()`. On a static build that compiles to a page with a
 * TWO SECOND meta refresh and a visible "Redirecting from /demo/ to ..."
 * line. This does the same job instantly: `location.replace` fires on first
 * paint, the meta refresh at 0s covers a visitor with JS disabled, and the
 * link covers anyone the other two fail.
 *
 * Site CTAs link to cal.com directly via DEMO_HREF and never land here.
 */
import { DEMO_HREF } from '../lib/waitlist';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting to the booking page</title>
    <meta http-equiv="refresh" content={`0;url=${DEMO_HREF}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={DEMO_HREF} />
    <script is:inline define:vars={{ DEMO_HREF }}>
      location.replace(DEMO_HREF);
    </script>
  </head>
  <body>
    <a href={DEMO_HREF}>Continue to the booking page</a>
  </body>
</html>
