---
/**
 * The OG-image source, `/og-card`. Not a visitor page — a 1200x630 stage the
 * capture tool screenshots to produce `public/brand/og-card.png`, so the link
 * preview is a composed brand card rather than a raw logo file. Uses the
 * site's own tokens and fonts so the card can never drift from the brand.
 * Regenerate: screenshot this route at 1200x630 and save over og-card.png.
 */
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex, nofollow" />
    <title>og-card</title>
  </head>
  <body style="margin:0">
    <div
      id="card"
      style="width:1200px;height:630px;background:#F8F8F3;position:relative;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:44px;font-family:'Inter Variable',ui-sans-serif,system-ui,sans-serif;"
    >
      {/* faint field texture, the site's own decal, pinned to the corners */}
      <img
        src="/brand/decal-light.svg"
        alt=""
        style="position:absolute;right:-120px;top:-120px;width:480px;opacity:0.35;"
      />
      <img
        src="/brand/decal-light.svg"
        alt=""
        style="position:absolute;left:-140px;bottom:-140px;width:480px;opacity:0.35;transform:rotate(180deg);"
      />

      <img src="/brand/logotext-256-light.svg" alt="Eluu AI" style="height:150px;position:relative;" />
      <p
        style="margin:0;position:relative;font-size:44px;line-height:1.25;font-weight:500;letter-spacing:-0.01em;color:#1E1C1E;text-align:center;max-width:900px;"
      >
        The agentic team for your human team.
      </p>
      <p
        style="margin:0;position:relative;font-family:'DM Mono',ui-monospace,monospace;font-size:22px;letter-spacing:0.08em;text-transform:uppercase;color:#58564D;"
      >
        eluu.ai
      </p>
    </div>
  </body>
</html>
