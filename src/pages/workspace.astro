---
// /workspace — product pillar page, content per research/website-content/workspace.md.
// PillarPage pattern: OnaNav → OnaHero(eyebrow) → Explanation → StatsBand →
// FeatureCards(5) → QuoteBlock([VERIFY] placeholder) → TechDetails(3) → FinalCTA → MegaFooter.
import Layout from '../layouts/Layout.astro';
import OnaNav from '../components/ona/OnaNav.astro';
import OnaHero from '../components/ona/OnaHero.astro';
import Explanation from '../components/ona/Explanation.astro';
import StatsBand from '../components/ona/StatsBand.astro';
import FeatureCards from '../components/ona/FeatureCards.astro';
import QuoteBlock from '../components/ona/QuoteBlock.astro';
import TechDetails from '../components/ona/TechDetails.astro';
import FinalCTA from '../components/ona/FinalCTA.astro';
import MegaFooter from '../components/ona/MegaFooter.astro';

// §3 — Three numbers
const stats = [
  { value: 'In parallel', label: 'run as many agents at once as the work needs' },
  { value: 'No limit', label: 'on the context each agent keeps' },
  { value: '24/7', label: 'scheduled jobs run on their own' },
];

// §4 — Feature cards
const featureCards = [
  {
    headline: 'Run many at once',
    eyebrowQuote: 'A whole team of agents, working in parallel.',
    body: "Hand the work to as many agents as it takes. They run at the same time, so ten tasks don't sit in a queue behind each other.",
  },
  {
    headline: 'Infinite context, built in',
    eyebrowQuote: 'Every agent keeps everything it learns.',
    body: 'The workspace stores it all with no limit. An agent keeps what it learned months ago instead of hitting a context ceiling and dropping it.',
  },
  {
    headline: 'Shared skills',
    eyebrowQuote: 'Build a skill once, every agent can use it.',
    body: 'A team skill library, so a workflow that works spreads across your agents instead of getting rebuilt each time.',
  },
  {
    headline: 'One place for the work',
    eyebrowQuote: 'Files, outputs, and dashboards in one home.',
    body: 'Every file, report, and dashboard an agent makes is saved and searchable in the workspace, not buried in a chat log.',
  },
  {
    headline: 'Agents build live apps',
    eyebrowQuote: 'Dashboards, trackers, and boards that stay current.',
    body: 'Agents build working apps that connect to your tools. Scheduled jobs keep them updated as the work happens, so the tracker is right when you open it.',
  },
];

// §6 — Technical details → docs
const techRows = [
  {
    title: 'How parallel execution works',
    desc: 'Running many agents at once.',
  },
  {
    title: 'How agent memory is stored',
    desc: 'The infinite-context store.',
  },
  {
    title: 'How to build an app on Eluu',
    desc: 'Apps with data, storage, and connections.',
  },
];
---

<Layout
  title="Eluu AI — One workspace for your whole team of agents"
  description="Run as many as the work needs, all at once, and everything they produce stays in one place you can see."
  path="/workspace"
>
  <OnaNav />
  <main>
    <!-- §1 HERO -->
    <OnaHero
      eyebrow="Workspace"
      h1="One workspace for your whole team of agents."
      sub="Run as many as the work needs, all at once, and everything they produce stays in one place you can see."
    />

    <!-- §2 EXPLANATION -->
    <Explanation
      heading="Run a team of agents, not one at a time."
      subhead="Hand the work to as many agents as it takes, and they run together in parallel. They share a skills library, each keeps its own memory, and every file, output, and dashboard lands in one place. Some agents belong to the team, some are yours."
      linkLabel="Explore the docs"
      linkHref="#"
      mediaLabel="Workspace view — agents running in parallel, files and dashboards"
    />

    <!-- §3 THREE NUMBERS -->
    <StatsBand stats={stats} />

    <!-- §4 FEATURE CARDS -->
    <FeatureCards cards={featureCards} />

    <!-- §5 TESTIMONIAL ([VERIFY] — placeholder) -->
    <QuoteBlock />

    <!-- §6 TECHNICAL DETAILS -->
    <TechDetails rows={techRows} />

    <!-- §7 FINAL CTA -->
    <FinalCTA headline="Give your team a workspace of agents." />
  </main>

  <MegaFooter />
</Layout>
