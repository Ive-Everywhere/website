---
import '../styles/global.css'
const { title = "Eluu — AI Colleagues" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Your tools, your workflows, your AI team. Fully autonomous." />
  <link rel="canonical" href="https://staging.eluu.ai" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://staging.eluu.ai" />
  <meta property="og:title" content="Eluu — AI Colleagues" />
  <meta property="og:description" content="Your tools, your workflows, your AI team. Fully autonomous." />
  <meta property="og:image" content="https://staging.eluu.ai/images/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Eluu — AI Colleagues" />
  <meta name="twitter:description" content="Your tools, your workflows, your AI team. Fully autonomous." />
  <meta name="twitter:image" content="https://staging.eluu.ai/images/og-image.png" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/season-mix-bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/season-mix-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://demo.eluu.ai" />
  <link rel="dns-prefetch" href="https://demo.eluu.ai" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="/fonts/jersey-10.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/images/logo.svg" as="image" />
  <link rel="preload" href="/images/2683d4a4805b7192bd38dc39f0c5321f8c2b5696.png" as="image" fetchpriority="high" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <!-- ── Splash skip / pre-splash: runs before paint to prevent flash ── -->
  <script is:inline>
    (function () {
      var skip = false;
      try {
        skip = sessionStorage.getItem('eluu_splash_shown') === '1';
      } catch (e) { /* private mode */ }
      // First-time visitors get .pre-splash so the iframe + nav logo are pre-staged
      // for the morph animation. Returning visitors get .splash-skip and see nothing.
      document.documentElement.classList.add(skip ? 'splash-skip' : 'pre-splash');
    })();
  </script>

  <!-- ── Critical splash CSS — inlined so it paints on first frame ── -->
  <style is:inline>
    .splash {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background-color: #f4f3ec;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      /* Pure-CSS auto-hide fallback for JS-disabled or stuck loads */
      animation: splash-auto-hide 3s ease 2.5s forwards;
      will-change: background-color;
      /* Background-color transitions during fade-out */
      transition: background-color 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Bridge image background — blurred, fades in when image arrives */
    .splash::before {
      content: '';
      position: absolute;
      inset: -60px;          /* over-extend so blur edges don't show as cream */
      background: url('/images/2683d4a4805b7192bd38dc39f0c5321f8c2b5696.png') center / cover no-repeat;
      filter: blur(40px) saturate(1.1);
      opacity: 0;
      animation: splash-bg-in 900ms cubic-bezier(0.22, 1, 0.36, 1) 100ms forwards;
      will-change: opacity;
      /* GPU-promote so the fade is smooth */
      transform: translateZ(0);
      backface-visibility: hidden;
      transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    /* Subtle vignette for logo readability */
    .splash::after {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center,
                                   rgba(244, 243, 236, 0.15) 0%,
                                   rgba(244, 243, 236, 0.55) 100%);
      pointer-events: none;
      transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1);
    }

    .splash-inner {
      position: relative;
      z-index: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transform: scale(0.88);
      animation: splash-in 700ms cubic-bezier(0.16, 1, 0.3, 1) 200ms forwards,
                 splash-pulse 2.6s ease-in-out 900ms infinite;
    }

    .splash-logo {
      width: 120px;
      height: 120px;
      display: block;
      /* Matches the SVG's own corner radius (~12% of side) so the box-shadow halo
         follows the logo's actual squared shape instead of looking more rounded */
      border-radius: 14px;
      box-shadow:
        0 0 0 1px rgba(255, 255, 255, 0.18),
        0 14px 48px rgba(23, 16, 14, 0.28),
        0 0 100px rgba(255, 255, 255, 0.5);
      animation: splash-glow 2.6s ease-in-out 900ms infinite;
    }

    /* Fading out — set by JS via .splash.fade-out */
    .splash.fade-out {
      /* The cream bg fades to transparent (alpha animation, smooth) */
      background-color: rgba(244, 243, 236, 0);
      pointer-events: none;
    }
    /* Bridge image dissolves via a replacement animation (more reliable than
       relying on a transition firing when the entrance animation is canceled) */
    .splash.fade-out::before {
      animation: splash-bg-out 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .splash.fade-out::after {
      opacity: 0;
    }
    /* The splash-inner slide is driven by JS (see fadeAndSlide). It snapshots
       the live computed transform — including any pulse offset — so the slide
       starts from the exact current visual state. Zero snap. */
    /* Cancel the glow animation entirely (not just pause) and drop the
       box-shadow so the GPU doesn't keep painting a 100px-radius shadow
       during the slide. Visually identical, slightly cheaper. */
    .splash.fade-out .splash-logo {
      animation: none;
      box-shadow: none;
    }

    @keyframes splash-bg-out {
      0%   { opacity: 0.7; }
      100% { opacity: 0; }
    }

    /* Skip entirely on internal navigation */
    html.splash-skip .splash { display: none !important; }

    @keyframes splash-in {
      0%   { opacity: 0; transform: scale(0.88); }
      100% { opacity: 1; transform: scale(1); }
    }
    @keyframes splash-bg-in {
      0%   { opacity: 0; }
      100% { opacity: 0.7; }
    }
    @keyframes splash-pulse {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.03); }
    }
    @keyframes splash-glow {
      0%, 100% {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.18),
          0 14px 48px rgba(23, 16, 14, 0.28),
          0 0 100px rgba(255, 255, 255, 0.5);
      }
      50% {
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.3),
          0 18px 64px rgba(23, 16, 14, 0.34),
          0 0 140px rgba(255, 255, 255, 0.7);
      }
    }
    @keyframes splash-auto-hide {
      0%   { opacity: 1; pointer-events: auto; }
      99%  { opacity: 0; pointer-events: none; }
      100% { opacity: 0; visibility: hidden; pointer-events: none; }
    }

    /* Responsive sizing */
    @media (max-width: 640px) {
      .splash-logo {
        width: 96px;
        height: 96px;
        border-radius: 12px;
      }
    }
    @media (max-width: 360px) {
      .splash-logo {
        width: 80px;
        height: 80px;
        border-radius: 10px;
      }
    }

    /* ── Iframe slide-in: offset until pre-splash class is removed ── */
    html.pre-splash [data-iframe-wrapper] .iframe-glow {
      transform: translateY(110%);
      opacity: 0;
      /* Kill the soft halo during the slide. The glow's box-shadow extends
         up to 120px above its top edge — and since the wrap's overflow:hidden
         only clips at its outer boundary, that shadow becomes visible in the
         empty area ABOVE the rising iframe, looking like it precedes it. */
      box-shadow: none;
    }
    html.pre-splash [data-iframe-wrapper] .iframe-border {
      /* Same reason — the border's drop-shadow extends ~28px upward and is
         visible above the rising iframe during the slide. */
      box-shadow: none;
    }
    /* Transitions run when pre-splash is removed by JS */
    [data-iframe-wrapper] .iframe-glow {
      transition: transform 1100ms cubic-bezier(0.16, 1, 0.3, 1) 100ms,
                  opacity 800ms cubic-bezier(0.22, 1, 0.36, 1) 100ms,
                  box-shadow 300ms ease 900ms;
      will-change: transform, opacity;
    }
    [data-iframe-wrapper] .iframe-border {
      transition: box-shadow 300ms ease 900ms;
    }

    /* Reduced motion: no pulse, no glow, no slide — just opacity fades */
    @media (prefers-reduced-motion: reduce) {
      .splash-inner {
        animation: splash-in 300ms ease forwards;
      }
      .splash-logo {
        animation: none;
      }
      .splash::before {
        animation: splash-bg-in 400ms ease forwards;
        transition: opacity 300ms ease;
      }
      .splash::after {
        transition: opacity 300ms ease;
      }
      .splash {
        animation: splash-auto-hide 2s ease 1.5s forwards;
        transition: background-color 300ms ease;
      }
      /* JS handles the reduced-motion fade-out (cancels animation + sets opacity).
         No CSS rule needed here. */
      /* Disable iframe slide-up — opacity only */
      html.pre-splash [data-iframe-wrapper] .iframe-glow {
        transform: none;
      }
      [data-iframe-wrapper] .iframe-glow {
        transition: opacity 300ms ease;
      }
    }
  </style>
</head>
<body>
  <!-- ── Splash overlay — covers viewport on first paint, dismissed by JS ── -->
  <div class="splash" id="splash" role="status" aria-busy="true" aria-label="Loading Eluu AI">
    <div class="splash-inner" aria-hidden="true">
      <img src="/images/logo.svg" alt="" class="splash-logo" width="120" height="120" />
    </div>
  </div>

  <!-- ── Splash dismissal: DOMContentLoaded + iframe slide-in ── -->
  <script is:inline>
    (function () {
      var MIN_DURATION = 1100;  // entrance + first pulse beat
      var MAX_DURATION = 2400;  // never block longer than this
      var FADE_DURATION = 1300; // matches longest CSS transition (1100ms slide + 100ms delay) + buffer
      var SAFETY_TIMEOUT = 4500; // absolute final safety net
      var startTime = Date.now();
      var dismissed = false;

      // Absolute safety net — even if everything else fails, the splash is gone by 4.5s.
      setTimeout(function () {
        var s = document.getElementById('splash');
        if (s) s.style.display = 'none';
        document.documentElement.classList.remove('pre-splash');
      }, SAFETY_TIMEOUT);

      var hardCapId = setTimeout(function () { dismiss(); }, MAX_DURATION);

      var splash = document.getElementById('splash');
      if (!splash) {
        clearTimeout(hardCapId);
        document.documentElement.classList.remove('pre-splash');
        return;
      }

      // Returning visitor — pre-splash was never added; mark flag and bail
      if (document.documentElement.classList.contains('splash-skip')) {
        try { sessionStorage.setItem('eluu_splash_shown', '1'); } catch (e) {}
        clearTimeout(hardCapId);
        return;
      }

      function dismiss() {
        if (dismissed) return;
        dismissed = true;
        clearTimeout(hardCapId);

        var elapsed = Date.now() - startTime;
        var remaining = Math.max(0, MIN_DURATION - elapsed);
        setTimeout(fadeAndSlide, remaining);
      }

      function reducedMotion() {
        return window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      function fadeAndSlide() {
        var s = splash || document.getElementById('splash');
        if (!s) return;
        var inner = s.querySelector('.splash-inner');

        // Kill the CSS auto-hide fallback so it doesn't fight the JS fade
        s.style.animation = 'none';

        // Trigger iframe slide-in (CSS transition runs when class is removed)
        document.documentElement.classList.remove('pre-splash');

        // CSS-driven fades: bg-color (.splash), ::before, ::after, glow pause
        s.classList.add('fade-out');
        s.setAttribute('aria-busy', 'false');

        // ── JS-driven logo slide ──
        // Why JS instead of pure CSS:
        //   1. The splash-inner has running animations (splash-in forward-locked
        //      + splash-pulse infinite). A new CSS animation with `forwards`
        //      fill-mode would cause a 100ms delay-phase glitch where the element
        //      falls back to the .splash-inner base CSS (opacity 0, scale 0.88).
        //   2. Even with `both` fill-mode, the new animation's 0% keyframe
        //      doesn't match the pulse-affected current scale (1.00→1.03),
        //      causing a visible scale snap at peak pulse.
        // The fix: capture getComputedStyle().transform BEFORE canceling the
        // animation (must be in this order — once animation is canceled, the
        // computed value drops to the cascade base scale 0.88), pin it as an
        // inline style, force a reflow, then apply the transition. The
        // transition starts from the captured state — zero snap regardless
        // of where in the pulse cycle the user happens to be.
        if (inner) {
          if (reducedMotion()) {
            // Cancel the running CSS animation FIRST — otherwise its forward-locked
            // opacity (1) overrides the inline opacity we're about to set.
            inner.style.animation = 'none';
            inner.style.transition = 'opacity 300ms ease';
            inner.style.opacity = '0';
          } else {
            // 1. Capture live transform (must be BEFORE canceling animation)
            var cs = window.getComputedStyle(inner);
            var currentTransform = cs.transform;
            if (!currentTransform || currentTransform === 'none') {
              currentTransform = 'translate(0, 0)';
            }
            // 2. Pin inline transform so it doesn't snap to scale(0.88) when
            //    we cancel the running animations. We're NOT sliding the logo,
            //    just dissolving it — but we still need to pin transform to
            //    prevent the cascade base from taking over.
            inner.style.transform = currentTransform;
            inner.style.opacity = '1';
            // 3. Cancel running animations (splash-in + splash-pulse)
            inner.style.animation = 'none';
            // 4. Force reflow so the inline state is committed before the next change
            void inner.offsetHeight;
            // 5. Pure opacity fade. Logo dissolves fast (350ms) so it's gone
            //    well before the iframe slide-in (1100ms) finishes. No overlap.
            inner.style.transition = 'opacity 350ms cubic-bezier(0.4, 0, 0.2, 1)';
            inner.style.opacity = '0';
          }
        }

        // After fade completes, hide and persist the flag.
        // Also strip the iframe-glow + iframe-border transitions so future
        // transform/box-shadow changes (e.g., hover effects) don't get the
        // slow-mo treatment.
        setTimeout(function () {
          s.style.display = 'none';
          var glow = document.querySelector('[data-iframe-wrapper] .iframe-glow');
          var border = document.querySelector('[data-iframe-wrapper] .iframe-border');
          if (glow) glow.style.transition = 'none';
          if (border) border.style.transition = 'none';
          try { sessionStorage.setItem('eluu_splash_shown', '1'); } catch (e) {}
        }, FADE_DURATION);
      }

      // Dismiss as soon as the DOM is parsed. We deliberately don't wait for
      // window.load because it waits for the hero iframe (demo.eluu.ai),
      // which is the slow thing we're masking.
      if (document.readyState === 'interactive' || document.readyState === 'complete') {
        dismiss();
      } else {
        document.addEventListener('DOMContentLoaded', dismiss, { once: true });
      }
    })();
  </script>

  <slot />
  <script>
    // Intersection Observer for scroll-reveal animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
      observer.observe(el);
    });
  </script>
</body>
</html>
