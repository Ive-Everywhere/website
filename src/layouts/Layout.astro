---
import '../styles/global.css'
import PostHog from '../components/PostHog.astro';
const {
  title = "Eluu — AI Colleagues",
  description = "AI colleagues that work alongside your team. Eluu integrates with your existing tools to handle tasks, automate workflows, and drive results autonomously.",
  path = "/",
} = Astro.props;
const canonicalURL = `https://eluu.ai${path === "/" ? "/" : path.replace(/\/$/, "")}`;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta name="theme-color" content="#13100a" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content="https://eluu.ai/images/og-image.png" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="Eluu AI" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://eluu.ai/images/og-image.png" />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/sohne-buch.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/sohne-halbfett.otf" as="font" type="font/otf" crossorigin />
  <link rel="preconnect" href="https://demo.eluu.ai" />
  <link rel="dns-prefetch" href="https://demo.eluu.ai" />
  <link rel="preload" href="/fonts/jersey-10.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/images/logo.svg" as="image" />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Organization",
        "@id": "https://eluu.ai/#organization",
        "name": "Eluu AI",
        "url": "https://eluu.ai",
        "logo": "https://eluu.ai/images/logo.svg",
        "sameAs": [
          "https://x.com/EluuAI",
          "https://www.linkedin.com/company/eluu/"
        ]
      },
      {
        "@type": "WebSite",
        "@id": "https://eluu.ai/#website",
        "url": "https://eluu.ai",
        "name": "Eluu AI",
        "publisher": { "@id": "https://eluu.ai/#organization" }
      },
      {
        "@type": "WebPage",
        "@id": canonicalURL,
        "url": canonicalURL,
        "name": title,
        "description": description,
        "isPartOf": { "@id": "https://eluu.ai/#website" }
      }
    ]
  })} />

  <PostHog />
</head>
<body>
  <slot />

  <script>
    // Scroll reveal + hero entry animations.
    // Hero elements (.reveal inside .hero-section) are revealed immediately
    // with a stagger delay — no need to wait for scroll intersection.
    // Everything else reveals as it scrolls into view.
    const heroReveals = document.querySelectorAll('.hero-section .reveal');
    heroReveals.forEach((el, i) => {
      const htmlEl = el as HTMLElement;
      // Stagger: 0ms for first, 200ms for second
      htmlEl.style.transitionDelay = `${i * 200}ms`;
      // Trigger immediately after first paint
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          htmlEl.classList.add('visible');
        });
      });
    });

    // Everything else: scroll-triggered reveal
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal:not(.visible)').forEach((el) => {
      observer.observe(el);
    });
  </script>
</body>
</html>
