---
import '../styles/global.css'
import '../styles/footer.css'
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/PostHog.astro';
const { title, pageTitle, updatedDate = 'February 24, 2026' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Eluu</title>
  <meta name="description" content={`${pageTitle} for Eluu AI platform.`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/sohne-buch.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/sohne-halbfett.otf" as="font" type="font/otf" crossorigin />
  <PostHog />
</head>
<body>
  <Navbar />

  <main class="ln-main">
    <article class="ln-article">
      <header class="ln-header">
        <h1 class="ln-title">{pageTitle}</h1>
        <div class="ln-meta">
          <span class="ln-date">Updated {updatedDate}</span>
        </div>
        <div class="ln-divider"></div>
      </header>
      <div class="ln-body">
        <slot />
      </div>
    </article>
  </main>

  <Footer />

  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
</body>
</html>

<style>
  .ln-main {
    background: #13100a;
    min-height: 100vh;
    padding: 140px 20px 112px;
  }
  @media (min-width: 640px) { .ln-main { padding: 160px 40px 112px; } }

  .ln-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .ln-header { margin-bottom: 48px; }

  .ln-title {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(28px, 5vw, 42px);
    color: #ede9e3;
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 12px;
  }

  .ln-meta { margin-bottom: 24px; }
  .ln-date {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    color: rgba(237, 233, 227, 0.35);
    font-weight: 400;
  }

  .ln-divider {
    height: 1px;
    background: rgba(237, 233, 227, 0.06);
  }

  /* ── Body — :global() needed because slot content doesn't get
     Astro's scoping attribute, so descendant selectors must be
     explicitly global to match the slotted h2/p/ul/li/a elements. ── */
  .ln-body {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.8;
  }

  .ln-body :global(h2) {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: 20px;
    color: #ede9e3;
    letter-spacing: -0.01em;
    margin: 48px 0 16px;
    line-height: 1.3;
    padding-top: 24px;
    border-top: 1px solid rgba(237, 233, 227, 0.06);
    scroll-margin-top: 100px;
  }
  .ln-body :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .ln-body :global(h3) {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: 16px;
    color: rgba(237, 233, 227, 0.85);
    margin: 28px 0 10px;
    line-height: 1.4;
    scroll-margin-top: 100px;
  }

  .ln-body :global(p) { margin: 0 0 16px; }

  .ln-body :global(ul),
  .ln-body :global(ol) {
    margin: 0 0 16px;
    padding-left: 24px;
  }
  .ln-body :global(li) {
    margin-bottom: 8px;
    padding-left: 4px;
  }
  .ln-body :global(li)::marker {
    color: rgba(237, 233, 227, 0.25);
  }

  .ln-body :global(a) {
    color: #ede9e3;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(237, 233, 227, 0.25);
    transition: text-decoration-color 0.2s ease;
  }
  .ln-body :global(a:hover) {
    text-decoration-color: #ede9e3;
  }

  .ln-body :global(strong) {
    color: rgba(237, 233, 227, 0.85);
    font-weight: 600;
  }

  .ln-body :global(blockquote) {
    margin: 24px 0;
    padding: 16px 24px;
    border-left: 3px solid rgba(237, 233, 227, 0.1);
    color: rgba(237, 233, 227, 0.5);
    font-style: italic;
  }
</style>
