---
import '../styles/global.css'
const { title, pageTitle, updatedDate = 'February 24, 2026' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — Eluu</title>
  <meta name="description" content={`${pageTitle} for Eluu AI platform.`} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/season-mix-bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Radio+Canada+Big:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!-- Navbar -->
  <nav id="main-nav" class="site-nav scrolled">
    <div style="max-width: 1800px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between;">
      <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
        <img src="/images/logo.svg" alt="Eluu" class="nav-logo" />
        <span style="font-family: 'Radio Canada Big', sans-serif; font-weight: 500; font-size: clamp(24px, 3vw, 40px); color: #17100e; line-height: 1;">Eluu</span>
      </a>
      <a href="https://app.eluu.ai" class="nav-btn">Log in</a>
    </div>
  </nav>

  <!-- Legal content -->
  <main class="legal-main">
    <div class="legal-container">
      <header class="legal-header">
        <h1 class="legal-title">{pageTitle}</h1>
        <p class="legal-date">Updated {updatedDate}</p>
      </header>
      <div class="legal-body">
        <slot />
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="footer-inner">
      <div class="footer-left">
        <div style="display: flex; align-items: center; gap: 10px;">
          <img src="/images/logo.svg" alt="Eluu" style="width: 36px; height: 36px;" />
          <span style="font-family: 'Radio Canada Big', sans-serif; font-weight: 500; font-size: 26px; color: #17100e; line-height: 1;">Eluu</span>
        </div>
        <span class="footer-copy">&copy; 2025 Eluu AI — All rights reserved</span>
      </div>
      <div class="footer-links">
        <a href="/terms">Terms of Service</a>
        <span class="footer-dot"></span>
        <a href="/privacy">Privacy Policy</a>
        <span class="footer-dot"></span>
        <a href="/security">Security</a>
      </div>
    </div>
  </footer>

  <style>
    .site-nav {
      position: fixed; top: 0; left: 0; right: 0; z-index: 50;
      padding: 12px 16px;
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid rgba(23, 16, 14, 0.06);
    }
    .nav-logo { width: 40px; height: 40px; }
    @media (min-width: 640px) { .nav-logo { width: 48px; height: 48px; } .site-nav { padding: 16px 24px; } }
    @media (min-width: 1024px) { .site-nav { padding: 20px 36px; } }
    .nav-btn {
      font-family: 'Inter', sans-serif; font-size: 14px; font-weight: 500;
      color: #ffffff; background: #17100e; border-radius: 10px;
      padding: 10px 24px; text-decoration: none; line-height: 1;
    }

    .legal-main { background: #f4f3ec; min-height: 100vh; padding: 120px 24px 80px; }
    @media (min-width: 640px) { .legal-main { padding: 140px 40px 80px; } }

    .legal-container { max-width: 800px; margin: 0 auto; }

    .legal-header { margin-bottom: 48px; }
    .legal-title {
      font-family: 'Season Mix', sans-serif; font-weight: 700;
      font-size: clamp(32px, 5vw, 48px); color: #17100e;
      letter-spacing: -1.5px; line-height: 1.1; margin: 0 0 12px;
    }
    .legal-date {
      font-family: 'Inter', sans-serif; font-size: 15px;
      color: #7d7d7d; margin: 0;
    }

    .legal-body {
      font-family: 'Inter', sans-serif; font-size: 15px;
      color: #5c5c5c; line-height: 1.75;
    }
    .legal-body h2 {
      font-family: 'Season Mix', sans-serif; font-weight: 600;
      font-size: 22px; color: #17100e; letter-spacing: -0.3px;
      margin: 48px 0 16px; line-height: 1.3;
    }
    .legal-body h3 {
      font-family: 'Inter', sans-serif; font-weight: 600;
      font-size: 16px; color: #17100e;
      margin: 32px 0 12px; line-height: 1.4;
    }
    .legal-body p { margin: 0 0 16px; }
    .legal-body ul, .legal-body ol {
      margin: 0 0 16px; padding-left: 24px;
    }
    .legal-body li { margin-bottom: 8px; }
    .legal-body a { color: #17100e; text-decoration: underline; text-underline-offset: 2px; }
    .legal-body a:hover { color: #5c5c5c; }
    .legal-body strong { color: #17100e; font-weight: 600; }

    .site-footer { background: #ffffff; padding: 48px 24px; }
    @media (min-width: 640px) { .site-footer { padding: 48px 40px; } }
    @media (min-width: 1024px) { .site-footer { padding: 48px 48px; } }
    .footer-inner {
      display: flex; flex-direction: column; gap: 32px;
      max-width: 1440px; margin: 0 auto;
    }
    @media (min-width: 768px) {
      .footer-inner { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    }
    .footer-left { display: flex; flex-direction: column; gap: 16px; }
    .footer-copy { font-family: 'Inter', sans-serif; font-size: 14px; color: #a3a3a3; }
    .footer-links { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .footer-links a { font-family: 'Inter', sans-serif; font-size: 14px; color: #a3a3a3; text-decoration: none; }
    .footer-links a:hover { color: #17100e; }
    .footer-dot { width: 4px; height: 4px; border-radius: 50%; background: #7c7c7c; display: inline-block; }
  </style>
</body>
</html>
