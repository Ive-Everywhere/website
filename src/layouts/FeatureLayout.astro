---
import '../styles/global.css'
import '../styles/footer.css'
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/PostHog.astro';

interface FeatureData {
  slug: string;
  name: string;
  color: string;
  breadcrumb: string;
  headline: string;
  description: string;
  heroImage?: string;
  intro?: { bold: string; supporting: string };
  valueProps: { title: string; image?: string; features: { title: string; desc: string }[] }[];
  stats: { heading: string; items: { value: string; label: string; desc: string }[] };
  testimonial: { quote: string; attribution: string };
  useCases: { heading: string; image?: string; cases: { title: string; desc: string }[] };
  ctaHeading: string;
}

const { feature: f } = Astro.props as { feature: FeatureData };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{f.name} — Eluu</title>
  <meta name="description" content={f.description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/sohne-buch.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/sohne-halbfett.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/jersey-10.woff2" as="font" type="font/woff2" crossorigin />
  <PostHog />
</head>
<body>
  <Navbar />
  <main>

    <!-- ══ Hero — short tagline + full-width image ══ -->
    <section class="fp-hero">
      <div class="fp-container">
        <div class="fp-breadcrumb">
          <a href="/" class="fp-bc-link">Home</a>
          <span class="fp-bc-sep">/</span>
          <span class="fp-bc-active">{f.breadcrumb}</span>
        </div>
        <h1 class="fp-headline">{f.headline}</h1>
        <div class="fp-hero-image">
          {f.heroImage ? (
            <img src={f.heroImage} alt={f.headline} class="fp-hero-img" loading="eager" />
          ) : (
            <slot name="hero-content">
              <div class="fp-placeholder fp-placeholder-hero" style={`--ft-color: ${f.color}`}></div>
            </slot>
          )}
        </div>
      </div>
    </section>

    <!-- ══ Intro block ══ -->
    {f.intro && (
      <section class="fp-intro">
        <div class="fp-container">
          <h2 class="fp-intro-text">
            <strong>{f.intro.bold}</strong> {f.intro.supporting}
          </h2>
        </div>
      </section>
    )}

    <!-- ══ Value Props — WhyEluu-style dark cards (24-col grid, alternating) ══ -->
    <section class="fp-cards-section">
      <div class="fp-container">
        {f.valueProps.map((block, i) => (
          <div class="fp-card reveal">
            <div class={`fp-card-inner${i % 2 !== 0 ? ' fp-card-inner--reverse' : ''}`}>
              <div class="fp-text-col">
                <div class="fp-text-wrap">
                  <div class="fp-text-block">
                    <h3 class="fp-card-heading">{block.title}</h3>
                    <div class="fp-card-features">
                      {block.features.map((feat) => (
                        <div class="fp-feat">
                          <h4 class="fp-feat-title">{feat.title}</h4>
                          <p class="fp-feat-desc">{feat.desc}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
              <div class="fp-media-col">
                <div class="fp-media-wrap">
                  {block.image ? (
                    <img src={block.image} alt={block.title} class="fp-media-img" loading="lazy" />
                  ) : (
                    <div class="fp-placeholder" style={`--ft-color: ${f.color}`}></div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══ Stats ══ -->
    <section class="fp-stats">
      <div class="fp-container">
        <h2 class="fp-stats-heading reveal">{f.stats.heading}</h2>
        <div class="fp-stats-row">
          {f.stats.items.map((item) => (
            <div class="fp-stats-card reveal">
              <span class="fp-stats-value">{item.value}</span>
              <span class="fp-stats-label">{item.label}</span>
              <p class="fp-stats-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ Testimonial ══ -->
    <section class="fp-testimonial">
      <div class="fp-container">
        <div class="fp-testimonial-inner reveal">
          <blockquote>&ldquo;{f.testimonial.quote}&rdquo;</blockquote>
          <p class="fp-testimonial-attr">&mdash; {f.testimonial.attribution}</p>
        </div>
      </div>
    </section>

    <!-- ══ Use Cases — dark accent section ══ -->
    <section class="fp-uc">
      <div class="fp-container">
        <h2 class="fp-uc-heading">{f.useCases.heading}</h2>
        <div class="fp-uc-layout">
          <div class="fp-uc-tabs">
            {f.useCases.cases.map((c, i) => (
              <button class={`fp-uc-tab${i === 0 ? ' active' : ''}`} data-uc-tab={i} type="button">
                <h3 class="fp-uc-tab-title">{c.title}</h3>
                <p class="fp-uc-tab-desc">{c.desc}</p>
              </button>
            ))}
          </div>
          <div class="fp-uc-image">
            {f.useCases.image ? (
              <img src={f.useCases.image} alt={f.useCases.heading} class="fp-uc-img" loading="lazy" />
            ) : (
              <div class="fp-placeholder fp-placeholder-uc" style={`--ft-color: ${f.color}`}></div>
            )}
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <script>
    // Reveal animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    // Use-cases tab switching
    (function () {
      const tabs = document.querySelectorAll('[data-uc-tab]') as NodeListOf<HTMLElement>;
      if (!tabs.length) return;
      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.dataset.ucTab!, 10);
          tabs.forEach((t, i) => t.classList.toggle('active', i === idx));
        });
      });
    })();
  </script>

<style>
  /* ══ Shared ══ */
  .fp-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Placeholder images */
  .fp-placeholder {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    overflow: hidden;
  }
  .fp-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ft-color);
    opacity: 0.5;
  }
  .fp-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/cookbook-bg.png') center / cover no-repeat;
    opacity: 0.12;
    mix-blend-mode: overlay;
  }

  /* ══ Hero — short tagline + full-width image ══ */
  .fp-hero {
    background: #13100a;
    padding: 140px 0 80px;
  }
  @media (max-width: 480px) { .fp-hero { padding: 100px 0 48px; } }

  .fp-breadcrumb {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
  }
  .fp-bc-link {
    color: rgba(237, 233, 227, 0.4);
    font-weight: 400;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .fp-bc-link:hover { color: #ede9e3; }
  .fp-bc-sep { color: rgba(237, 233, 227, 0.25); }
  .fp-bc-active { color: rgba(237, 233, 227, 0.7); font-weight: 500; }

  .fp-headline {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(36px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #ede9e3;
    margin: 0 0 48px;
  }
  @media (max-width: 768px) {
    .fp-headline { margin-bottom: 32px; }
  }

  .fp-hero-image { width: 100%; }
  .fp-hero-img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
  }
  .fp-placeholder-hero {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    position: relative;
  }

  /* ══ Intro ══ */
  .fp-intro {
    background: #13100a;
    padding: 0 0 112px;
  }
  .fp-intro-text {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: clamp(20px, 2.8vw, 32px);
    color: rgba(237, 233, 227, 0.45);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 720px;
  }
  .fp-intro-text strong {
    color: #ede9e3;
    font-weight: 600;
  }

  /* ══ Value Props — WhyEluu card pattern ══ */
  .fp-cards-section {
    background: #13100a;
  }

  .fp-card {
    margin-bottom: 112px;
  }
  .fp-card:last-child { margin-bottom: 0; }

  .fp-card-inner {
    position: relative;
    background: #1e1d1b;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }
  .fp-card-inner::before {
    content: "";
    pointer-events: none;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
    position: absolute;
    inset: 0;
  }
  @media (min-width: 900px) {
    .fp-card-inner {
      grid-template-columns: repeat(24, 1fr);
      gap: 10px;
    }
  }

  /* Reverse layout (text right, media left) */
  @media (min-width: 900px) {
    .fp-card-inner--reverse .fp-text-col {
      grid-column: 16 / 25;
      grid-row: 1 / -1;
      padding: 36px 36px 36px 30px;
    }
    .fp-card-inner--reverse .fp-media-col {
      grid-column: 1 / 16;
      grid-row: 1 / -1;
    }
  }

  .fp-text-col {
    display: flex;
    align-items: center;
    padding: 28px 24px;
  }
  @media (min-width: 900px) {
    .fp-text-col {
      grid-column: 1 / 10;
      grid-row: 1 / -1;
      padding: 40px 36px;
    }
  }

  .fp-text-wrap {
    width: 100%;
    max-width: 42ch;
  }
  .fp-text-block {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .fp-card-heading {
    font-family: 'Söhne', sans-serif;
    font-size: 1.375rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .fp-card-heading {
      font-size: 1.75rem;
      letter-spacing: -0.025em;
    }
  }

  .fp-card-features {
    display: flex;
    flex-direction: column;
  }
  .fp-feat {
    padding: 16px 0;
    border-top: 1px solid rgba(237, 233, 227, 0.06);
  }
  .fp-feat:first-child { border-top: none; padding-top: 0; }
  .fp-feat-title {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #ede9e3;
    margin: 0 0 5px;
    letter-spacing: -0.01em;
  }
  .fp-feat-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 14.5px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.55);
    line-height: 1.55;
    margin: 0;
  }

  .fp-media-col {
    position: relative;
    min-height: 350px;
  }
  @media (min-width: 900px) {
    .fp-media-col {
      grid-column: 10 / 25;
      grid-row: 1 / -1;
      min-height: 680px;
    }
  }
  .fp-media-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .fp-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 899px) {
    .fp-media-col { min-height: 350px; }
    .fp-card { margin-bottom: 80px; }
  }

  /* ══ Stats ══ */
  .fp-stats {
    background: #13100a;
    padding: 112px 0;
  }
  .fp-stats-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(22px, 3vw, 32px);
    color: #ede9e3;
    letter-spacing: -0.02em;
    margin: 0 0 48px;
    text-align: center;
  }
  .fp-stats-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    max-width: 1200px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .fp-stats-row { grid-template-columns: repeat(3, 1fr); }
  }
  .fp-stats-card {
    background: #1e1d1b;
    border-radius: 4px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .fp-stats-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
  }
  .fp-stats-value {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(32px, 4vw, 48px);
    color: #ede9e3;
    display: block;
  }
  .fp-stats-label {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.7);
    display: block;
    margin-top: 8px;
  }
  .fp-stats-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    color: rgba(237, 233, 227, 0.4);
    margin: 8px auto 0;
    max-width: 280px;
    line-height: 1.5;
  }

  /* ══ Testimonial ══ */
  .fp-testimonial {
    background: #13100a;
    padding: 64px 0;
  }
  .fp-testimonial-inner {
    max-width: 840px;
    margin: 0 auto;
    text-align: center;
  }
  .fp-testimonial-inner blockquote {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: clamp(17px, 2vw, 24px);
    color: rgba(237, 233, 227, 0.7);
    line-height: 1.5;
    margin: 0;
    padding: 0;
    border: none;
  }
  .fp-testimonial-attr {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.35);
    margin: 18px 0 0;
  }

  /* ══ Use Cases — dark accent ══ */
  .fp-uc {
    background: #1e1d1b;
    padding: 112px 0;
  }
  .fp-uc-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(22px, 3vw, 32px);
    color: #ede9e3;
    letter-spacing: -0.02em;
    margin: 0 0 48px;
  }
  .fp-uc-layout {
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }
  @media (max-width: 767.98px) {
    .fp-uc-layout { flex-direction: column; gap: 32px; }
  }

  .fp-uc-tabs {
    width: 45%;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
  }
  @media (max-width: 767.98px) { .fp-uc-tabs { width: 100%; } }

  .fp-uc-tab {
    display: flex;
    flex-direction: column;
    padding: 18px 0;
    border: none;
    border-top: 2px solid rgba(237, 233, 227, 0.08);
    background: transparent;
    cursor: pointer;
    text-align: left;
    transition: border-color 0.2s ease;
  }
  .fp-uc-tab.active { border-top-color: #ede9e3; }

  .fp-uc-tab-title {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: rgba(237, 233, 227, 0.35);
    margin: 0;
    transition: color 0.2s ease;
  }
  .fp-uc-tab.active .fp-uc-tab-title { color: #ede9e3; font-weight: 600; }
  .fp-uc-tab:hover .fp-uc-tab-title { color: rgba(237, 233, 227, 0.6); }

  .fp-uc-tab-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    color: rgba(237, 233, 227, 0.45);
    line-height: 1.5;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.25s ease,
                margin 0.35s ease;
  }
  .fp-uc-tab.active .fp-uc-tab-desc {
    max-height: 120px;
    opacity: 1;
    margin-top: 8px;
  }

  .fp-uc-image {
    flex: 1;
    min-width: 0;
    position: relative;
    min-height: 400px;
  }
  @media (max-width: 767.98px) { .fp-uc-image { min-height: 240px; } }

  .fp-uc-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
    display: block;
  }
  .fp-placeholder-uc {
    border-radius: 4px;
    min-height: 400px;
  }
  @media (max-width: 767.98px) {
    .fp-placeholder-uc { min-height: 240px; }
  }
</style>

</body>
</html>
