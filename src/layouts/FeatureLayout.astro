---
import '../styles/global.css'
import '../styles/footer.css'
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/PostHog.astro';

interface FeatureData {
  slug: string;
  name: string;
  color: string;
  breadcrumb: string;
  headline: string;
  description: string;
  heroImage?: string;
  intro?: { bold: string; supporting: string };
  valueProps: { title: string; description?: string; image?: string; features: { title: string; desc: string }[] }[];
  stats: { heading: string; items: { value: string; label: string; desc: string }[] };
  testimonial: { quote: string; attribution: string; logo?: string };
  useCases: { heading: string; description?: string; image?: string; cases: { title: string; desc: string }[] };
  ctaHeading: string;
}

const { feature: f } = Astro.props as { feature: FeatureData };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{f.name} — Eluu</title>
  <meta name="description" content={f.description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/sohne-buch.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/sohne-halbfett.otf" as="font" type="font/otf" crossorigin />
  <link rel="preload" href="/fonts/jersey-10.woff2" as="font" type="font/woff2" crossorigin />
  <PostHog />
</head>
<body>
  <Navbar />
  <main>

    <!-- ══ Hero — short tagline + full-width image ══ -->
    <section class="fp-hero">
      <div class="fp-container">
        <div class="fp-breadcrumb">
          <a href="/" class="fp-bc-link">Home</a>
          <span class="fp-bc-sep">/</span>
          <span class="fp-bc-active">{f.breadcrumb}</span>
        </div>
        <h1 class="fp-headline">{f.headline}</h1>
        <div class="fp-hero-image">
          {f.heroImage ? (
            <img src={f.heroImage} alt={f.headline} class="fp-hero-img" loading="eager" />
          ) : (
            <slot name="hero-content">
              <div class="fp-placeholder fp-placeholder-hero" style={`--ft-color: ${f.color}`}></div>
            </slot>
          )}
        </div>
      </div>
    </section>

    <!-- ══ Intro block ══ -->
    {f.intro && (
      <section class="fp-intro">
        <div class="fp-container">
          <h2 class="fp-intro-text">
            <strong>{f.intro.bold}</strong> {f.intro.supporting}
          </h2>
        </div>
      </section>
    )}

    <!-- ══ Value Props — WhyEluu-style dark cards (24-col grid, alternating) ══ -->
    <section class="fp-cards-section">
      <div class="fp-container">
        {f.valueProps.map((block, i) => (
          <div class="fp-card reveal">
            <div class={`fp-card-inner${i % 2 !== 0 ? ' fp-card-inner--reverse' : ''}`}>
              <div class="fp-text-col">
                <div class="fp-text-wrap">
                  <div class="fp-text-block">
                    <div class="fp-card-top">
                      <h3 class="fp-card-heading">{block.title}</h3>
                      {block.description && (
                        <p class="fp-card-desc">{block.description}</p>
                      )}
                    </div>
                    <ul class="fp-card-points">
                      {block.features.map((feat) => (
                        <li class="fp-card-point">{feat.title}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
              <div class="fp-media-col">
                <div class="fp-media-wrap">
                  {block.image ? (
                    <img src={block.image} alt={block.title} class="fp-media-img" loading="lazy" />
                  ) : (
                    <div class="fp-placeholder" style={`--ft-color: ${f.color}`}></div>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ══ Stats ══ -->
    <section class="fp-stats">
      <div class="fp-container">
        <h2 class="fp-stats-heading reveal">{f.stats.heading}</h2>
        <div class="fp-stats-row">
          {f.stats.items.map((item) => (
            <div class="fp-stats-card reveal">
              <span class="fp-stats-value">{item.value}</span>
              <span class="fp-stats-label">{item.label}</span>
              <p class="fp-stats-desc">{item.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ Testimonial + Image — merged card ══ -->
    <section class="fp-testi">
      <div class="fp-container">
        <div class="fp-testi-card reveal">
          <div class="fp-testi-text">
            {f.testimonial.logo && (
              <img src={f.testimonial.logo} alt="" class="fp-testi-logo" />
            )}
            <blockquote class="fp-testi-quote">&ldquo;{f.testimonial.quote}&rdquo;</blockquote>
            <p class="fp-testi-attr">{f.testimonial.attribution}</p>
          </div>
          <div class="fp-testi-image">
            {f.useCases.image ? (
              <img src={f.useCases.image} alt="" class="fp-testi-img" />
            ) : (
              <div class="fp-placeholder" style={`--ft-color: ${f.color}`}></div>
            )}
          </div>
        </div>
      </div>
    </section>

  </main>
  <Footer />

  <script>
    // Reveal animations
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

  </script>

<style>
  /* ══ Shared ══ */
  .fp-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* Placeholder images */
  .fp-placeholder {
    position: absolute;
    inset: 0;
    border-radius: 4px;
    overflow: hidden;
  }
  .fp-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ft-color);
    opacity: 0.5;
  }
  .fp-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/cookbook-bg.png') center / cover no-repeat;
    opacity: 0.12;
    mix-blend-mode: overlay;
  }

  /* ══ Hero — short tagline + full-width image ══ */
  .fp-hero {
    background: #13100a;
    padding: 140px 0 80px;
  }
  @media (max-width: 480px) { .fp-hero { padding: 100px 0 48px; } }

  .fp-breadcrumb {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
  }
  .fp-bc-link {
    color: rgba(237, 233, 227, 0.4);
    font-weight: 400;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .fp-bc-link:hover { color: #ede9e3; }
  .fp-bc-sep { color: rgba(237, 233, 227, 0.25); }
  .fp-bc-active { color: rgba(237, 233, 227, 0.7); font-weight: 500; }

  .fp-headline {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: clamp(36px, 6vw, 72px);
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: #ede9e3;
    margin: 0 0 48px;
  }
  @media (max-width: 768px) {
    .fp-headline { margin-bottom: 32px; }
  }

  .fp-hero-image { width: 100%; }
  .fp-hero-img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    display: block;
  }
  .fp-placeholder-hero {
    aspect-ratio: 16 / 9;
    border-radius: 4px;
    position: relative;
  }

  /* ══ Intro — matches homepage hp-intro block ══ */
  .fp-intro {
    background: #13100a;
    padding: 48px 0 64px;
  }
  .fp-intro-text {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: clamp(18px, 2.2vw, 26px);
    color: rgba(237, 233, 227, 0.4);
    line-height: 1.45;
    letter-spacing: -0.01em;
    margin: 0;
    max-width: 900px;
  }
  .fp-intro-text strong {
    color: #ede9e3;
    font-weight: 600;
  }

  /* ══ Value Props — WhyEluu card pattern ══ */
  .fp-cards-section {
    background: #13100a;
  }

  .fp-card {
    margin-bottom: 112px;
  }
  .fp-card:last-child { margin-bottom: 0; }

  .fp-card-inner {
    position: relative;
    background: #1e1d1b;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }
  .fp-card-inner::before {
    content: "";
    pointer-events: none;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
    position: absolute;
    inset: 0;
  }
  @media (min-width: 900px) {
    .fp-card-inner {
      grid-template-columns: repeat(24, 1fr);
      gap: 10px;
    }
  }

  /* Reverse layout (text right, media left) */
  @media (min-width: 900px) {
    .fp-card-inner--reverse .fp-text-col {
      grid-column: 16 / 25;
      grid-row: 1 / -1;
      padding: 36px 36px 36px 30px;
    }
    .fp-card-inner--reverse .fp-media-col {
      grid-column: 1 / 16;
      grid-row: 1 / -1;
    }
  }

  /* ── Text column — matches WhyEluu homepage cards exactly ── */
  .fp-text-col {
    display: flex;
    align-items: center;
    padding: 24px;
  }
  @media (min-width: 900px) {
    .fp-text-col {
      grid-column: 1 / 10;
      grid-row: 1 / -1;
      padding: 36px 30px 36px 36px;
    }
  }

  .fp-text-wrap {
    width: 100%;
    max-width: 42ch;
  }
  /* ── Card text: heading + desc at top, points at bottom ── */
  .fp-text-block {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 320px;
  }
  @media (max-width: 899px) {
    .fp-text-block { min-height: auto; gap: 32px; }
  }

  .fp-card-top {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .fp-card-heading {
    font-family: 'Söhne', sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .fp-card-heading {
      font-size: 1.625rem;
      letter-spacing: -0.02em;
    }
  }

  .fp-card-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.6;
    margin: 0;
    letter-spacing: -0.005em;
  }

  /* Points — title-only list at bottom */
  .fp-card-points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .fp-card-point {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: rgba(237, 233, 227, 0.55);
    letter-spacing: -0.005em;
    padding: 11px 0;
    border-top: 1px solid rgba(237, 233, 227, 0.06);
  }
  .fp-card-point:first-child { border-top: none; }

  .fp-media-col {
    position: relative;
    min-height: 350px;
  }
  @media (min-width: 900px) {
    .fp-media-col {
      grid-column: 10 / 25;
      grid-row: 1 / -1;
      min-height: 680px;
    }
  }
  .fp-media-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .fp-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 899px) {
    .fp-media-col { min-height: 300px; }
    .fp-card { margin-bottom: 72px; }
  }
  @media (max-width: 480px) {
    .fp-media-col { min-height: 220px; }
    .fp-card { margin-bottom: 48px; }
  }

  /* ══ Stats ══ */
  .fp-stats {
    background: #13100a;
    padding: 64px 0;
  }
  .fp-stats-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(22px, 3vw, 32px);
    color: #ede9e3;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
    text-align: center;
  }
  .fp-stats-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    max-width: 1380px;
    margin: 0 auto;
  }
  @media (min-width: 640px) {
    .fp-stats-row { grid-template-columns: repeat(3, 1fr); }
  }
  .fp-stats-card {
    background: #1e1d1b;
    border-radius: 4px;
    padding: 32px 24px;
    text-align: center;
    position: relative;
  }
  .fp-stats-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
  }
  .fp-stats-value {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: clamp(32px, 4vw, 48px);
    color: #ede9e3;
    display: block;
  }
  .fp-stats-label {
    font-family: 'Söhne', sans-serif;
    font-weight: 600;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.7);
    display: block;
    margin-top: 8px;
  }
  .fp-stats-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    color: rgba(237, 233, 227, 0.4);
    margin: 8px auto 0;
    max-width: 280px;
    line-height: 1.5;
  }

  /* ══ Testimonial + Image — merged card ══ */
  .fp-testi {
    background: #13100a;
    padding: 48px 0 72px;
  }

  .fp-testi-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #1e1d1b;
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }
  .fp-testi-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 2;
  }
  @media (min-width: 900px) {
    .fp-testi-card {
      grid-template-columns: 5fr 6fr;
    }
  }

  /* Left: logo top, quote middle, attribution bottom */
  .fp-testi-text {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 36px 28px;
    min-height: 400px;
  }
  @media (min-width: 900px) {
    .fp-testi-text { padding: 48px 44px; }
  }

  .fp-testi-logo {
    display: block;
    height: 40px;
    width: auto;
    object-fit: contain;
    object-position: left;
    filter: brightness(0) invert(1);
    opacity: 0.7;
    align-self: flex-start;
  }

  .fp-testi-quote {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: clamp(18px, 2vw, 24px);
    color: #ede9e3;
    line-height: 1.5;
    letter-spacing: -0.015em;
    margin: 0;
    padding: 0;
    border: none;
  }

  .fp-testi-attr {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    margin: 0;
  }

  /* Right: image — square, covers full panel */
  .fp-testi-image {
    position: relative;
    min-height: 320px;
  }
  @media (min-width: 900px) {
    .fp-testi-image {
      aspect-ratio: 1 / 1;
      min-height: auto;
    }
  }

  .fp-testi-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ══ Use Cases — heading+desc top, points bottom, image right ══ */
  /* Old use cases section removed — merged into testimonial card */
</style>

</body>
</html>
