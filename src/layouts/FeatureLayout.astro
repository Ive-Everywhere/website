---
import '../styles/global.css'
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PostHog from '../components/PostHog.astro';

interface FeatureData {
  slug: string;
  name: string;
  color: string;
  breadcrumb: string;
  headline: string;
  description: string;
  valueProps: { title: string; features: { title: string; desc: string }[] }[];
  stats: { heading: string; items: { value: string; label: string; desc: string }[] };
  testimonial: { quote: string; attribution: string };
  useCases: { heading: string; cases: { title: string; desc: string }[] };
  ctaHeading: string;
}

const { feature: f } = Astro.props as { feature: FeatureData };
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{f.name} — Eluu</title>
  <meta name="description" content={f.description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="preload" href="/fonts/season-mix-bold.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/season-mix-regular.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" href="/fonts/jersey-10.woff2" as="font" type="font/woff2" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  <script is:inline>
    try { sessionStorage.setItem('eluu_splash_shown', '1'); } catch (e) {}
  </script>
  <PostHog />
</head>
<body>
  <Navbar />
  <main>

    <!-- ══ Section 1: Hero — vertically stacked (Harvey style) ══ -->
    <section class="ft-hero">
      <div class="ft-hero-inner">
        <span class="ft-breadcrumb">Platform &gt; {f.breadcrumb}</span>
        <h1 class="ft-hero-headline">{f.headline}</h1>
        <p class="ft-hero-desc">{f.description}</p>
        <div class="ft-hero-ctas">
          <a href="https://app.eluu.ai" class="ft-btn ft-btn-dark"
            onclick={`window.posthog?.capture('feature_get_started_clicked', { feature: '${f.slug}', location: 'hero' })`}
          >Get started</a>
          <a href="https://cal.com/krishna-kaipa-wh7ao3/15min" class="ft-btn ft-btn-light"
            onclick={`window.posthog?.capture('feature_demo_clicked', { feature: '${f.slug}', location: 'hero' })`}
          >Book a demo</a>
        </div>
        <div class="ft-hero-image">
          <div class="ft-placeholder ft-placeholder-hero" style={`--ft-color: ${f.color}`}></div>
        </div>
      </div>
    </section>

    <!-- ══ Section 2: Value Props — sticky scroll (Harvey style)
         Text stays sticky on the left, images/sub-features scroll on the right ══ -->
    {f.valueProps.map((block, blockIdx) => (
      <section class={`ft-vp ${blockIdx % 2 === 0 ? 'ft-vp-white' : 'ft-vp-cream'}`} data-vp-section>
        <div class="ft-vp-inner">
          <!-- Left: sticky text -->
          <div class="ft-vp-sticky">
            <h2 class="ft-vp-title">{block.title}</h2>
          </div>
          <!-- Right: scrolling features -->
          <div class="ft-vp-scroll">
            {block.features.map((feat) => (
              <div class="ft-vp-feature reveal">
                <h3 class="ft-vp-feature-title">{feat.title}</h3>
                <p class="ft-vp-feature-desc">{feat.desc}</p>
                <div class="ft-placeholder ft-placeholder-wide" style={`--ft-color: ${f.color}`}></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    ))}

    <!-- ══ Section 3: Stats ══ -->
    <section class="ft-stats">
      <h2 class="ft-stats-heading reveal">{f.stats.heading}</h2>
      <div class="ft-stats-row">
        {f.stats.items.map((item) => (
          <div class="ft-stats-card reveal">
            <span class="ft-stats-value">{item.value}</span>
            <span class="ft-stats-label">{item.label}</span>
            <p class="ft-stats-desc">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- ══ Section 4: Testimonial ══ -->
    <section class="ft-testimonial">
      <div class="ft-testimonial-inner reveal">
        <blockquote class="ft-testimonial-quote">&ldquo;{f.testimonial.quote}&rdquo;</blockquote>
        <p class="ft-testimonial-attribution">&mdash; {f.testimonial.attribution}</p>
      </div>
    </section>

    <!-- ══ Section 5: Use Cases — click-based tabs, big layout ══ -->
    <section class="ft-uc">
      <h2 class="ft-uc-heading reveal">{f.useCases.heading}</h2>
      <div class="ft-uc-layout">
        <!-- Left: tab sidebar -->
        <nav class="ft-uc-sidebar" aria-label="Use cases">
          {f.useCases.cases.map((c, i) => (
            <button
              class={`ft-uc-tab${i === 0 ? ' active' : ''}`}
              data-uc-tab={i}
              style={`--ft-dot: ${f.color}`}
              type="button"
            >
              <span class="ft-uc-dot"></span>
              <span>{c.title}</span>
            </button>
          ))}
        </nav>
        <!-- Right: content panels -->
        <div class="ft-uc-content">
          {f.useCases.cases.map((c, i) => (
            <div class={`ft-uc-panel${i === 0 ? ' active' : ''}`} data-uc-panel={i}>
              <h3 class="ft-uc-panel-title">{c.title}</h3>
              <p class="ft-uc-panel-desc">{c.desc}</p>
              <div class="ft-placeholder ft-placeholder-uc" style={`--ft-color: ${f.color}`}></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ══ Section 6: CTA Footer ══ -->
    <section style="background: #f4f3ec;">
      <div class="ft-cta-container">
        <img src="/images/cta-bg.jpg" alt="" aria-hidden="true" class="ft-cta-bg" loading="lazy" />
        <div class="ft-cta-overlay"></div>
        <div class="ft-cta-content">
          <h2 class="ft-cta-heading">{f.ctaHeading}</h2>
          <div class="ft-cta-buttons">
            <a href="https://app.eluu.ai" class="ft-btn ft-btn-dark"
              onclick={`window.posthog?.capture('feature_get_started_clicked', { feature: '${f.slug}', location: 'cta_footer' })`}
            >Get started</a>
            <a href="https://cal.com/krishna-kaipa-wh7ao3/15min" class="ft-btn ft-btn-light-white"
              onclick={`window.posthog?.capture('feature_demo_clicked', { feature: '${f.slug}', location: 'cta_footer' })`}
            >Book a demo</a>
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />

  <!-- Reveal observer -->
  <script>
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>

  <!-- Use-cases tab switching (click-based) -->
  <script>
    (function () {
      const tabs = document.querySelectorAll('[data-uc-tab]') as NodeListOf<HTMLElement>;
      const panels = document.querySelectorAll('[data-uc-panel]') as NodeListOf<HTMLElement>;
      if (!tabs.length || !panels.length) return;

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const idx = parseInt(tab.dataset.ucTab!, 10);
          tabs.forEach((t, i) => t.classList.toggle('active', i === idx));
          panels.forEach((p, i) => p.classList.toggle('active', i === idx));
        });
      });
    })();
  </script>

<style>
  /* ══════════════════════════════════════════════════════════
     Shared
     ══════════════════════════════════════════════════════════ */
  .ft-btn {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 12px 28px;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1;
    display: inline-flex;
    align-items: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ft-btn:hover { transform: translateY(-1px); }
  .ft-btn-dark { color: #fff; background: #17100e; }
  .ft-btn-dark:hover { box-shadow: 0 4px 12px rgba(23,16,14,0.2); }
  .ft-btn-light { color: #17100e; background: #fff; border: 1px solid rgba(23,16,14,0.12); }
  .ft-btn-light:hover { box-shadow: 0 4px 12px rgba(23,16,14,0.08); }
  .ft-btn-light-white { color: #17100e; background: #fff; }
  .ft-btn-light-white:hover { box-shadow: 0 4px 16px rgba(255,255,255,0.3); }

  /* Placeholder images */
  .ft-placeholder {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 16px;
    overflow: hidden;
  }
  .ft-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--ft-color);
    opacity: 0.7;
  }
  .ft-placeholder::after {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/images/cookbook-bg.png') center / cover no-repeat;
    opacity: 0.12;
    mix-blend-mode: overlay;
  }
  .ft-placeholder-hero { aspect-ratio: 21 / 9; border-radius: 20px; }
  .ft-placeholder-wide { aspect-ratio: 16 / 9; border-radius: 14px; }
  .ft-placeholder-uc { aspect-ratio: 16 / 10; border-radius: 14px; min-height: 300px; }
  @media (max-width: 767.98px) {
    .ft-placeholder-hero { aspect-ratio: 16 / 9; border-radius: 14px; }
    .ft-placeholder-uc { min-height: 200px; }
  }

  /* ══════════════════════════════════════════════════════════
     Section 1: Hero — vertically stacked (Harvey style)
     ══════════════════════════════════════════════════════════ */
  .ft-hero {
    background: #ffffff;
  }
  .ft-hero-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 140px 20px 60px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
  }
  @media (max-width: 480px) {
    .ft-hero-inner { padding: 120px 16px 32px; gap: 24px; }
  }

  .ft-breadcrumb {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #888;
  }
  .ft-hero-headline {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 6vw, 72px);
    color: #17100e;
    letter-spacing: -2px;
    line-height: 1.05;
    margin: 0;
    max-width: 700px;
  }
  @media (max-width: 480px) { .ft-hero-headline { letter-spacing: -1px; } }
  .ft-hero-desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #5c5c5c;
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }
  .ft-hero-ctas {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .ft-hero-image {
    width: 100%;
  }

  /* ══════════════════════════════════════════════════════════
     Section 2: Value Props — sticky scroll
     Title stays sticky on the left, features scroll on the right
     ══════════════════════════════════════════════════════════ */
  .ft-vp {
    padding: 80px 24px;
  }
  .ft-vp-white { background: #ffffff; }
  .ft-vp-cream { background: #f4f3ec; }
  @media (max-width: 767.98px) { .ft-vp { padding: 48px 16px; } }

  .ft-vp-inner {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    gap: 80px;
    align-items: flex-start;
  }
  @media (max-width: 900px) {
    .ft-vp-inner { flex-direction: column; gap: 32px; }
  }

  /* Sticky title column */
  .ft-vp-sticky {
    width: 340px;
    flex-shrink: 0;
    position: sticky;
    top: 140px;
  }
  @media (max-width: 900px) {
    .ft-vp-sticky { position: static; width: 100%; }
  }

  .ft-vp-title {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 4vw, 40px);
    color: #17100e;
    letter-spacing: -1px;
    line-height: 1.15;
    margin: 0;
  }

  /* Scrolling features column */
  .ft-vp-scroll {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 64px;
  }
  @media (max-width: 767.98px) { .ft-vp-scroll { gap: 40px; } }

  .ft-vp-feature {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .ft-vp-feature-title {
    font-family: 'Inter', sans-serif;
    font-size: 18px;
    font-weight: 600;
    color: #17100e;
    margin: 0;
  }
  .ft-vp-feature-desc {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #5c5c5c;
    line-height: 1.6;
    margin: 0;
    max-width: 560px;
  }

  /* ══════════════════════════════════════════════════════════
     Section 3: Stats
     ══════════════════════════════════════════════════════════ */
  .ft-stats {
    background: #f4f3ec;
    padding: 80px 24px;
    text-align: center;
  }
  @media (max-width: 767.98px) { .ft-stats { padding: 48px 16px; } }

  .ft-stats-heading {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 4vw, 36px);
    color: #17100e;
    letter-spacing: -1px;
    margin: 0 0 48px;
  }
  .ft-stats-row {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    gap: 48px;
    justify-content: center;
  }
  @media (max-width: 767.98px) { .ft-stats-row { flex-direction: column; gap: 32px; } }

  .ft-stats-card { flex: 1; text-align: center; }
  .ft-stats-value {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(36px, 5vw, 56px);
    color: #17100e;
    display: block;
  }
  .ft-stats-label {
    font-family: 'Inter', sans-serif;
    font-weight: 600;
    font-size: 15px;
    color: #17100e;
    display: block;
    margin-top: 8px;
  }
  .ft-stats-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: #5c5c5c;
    margin: 6px auto 0;
    max-width: 280px;
    line-height: 1.5;
  }

  /* ══════════════════════════════════════════════════════════
     Section 4: Testimonial
     ══════════════════════════════════════════════════════════ */
  .ft-testimonial {
    background: #ffffff;
    padding: 80px 24px;
  }
  @media (max-width: 767.98px) { .ft-testimonial { padding: 48px 16px; } }

  .ft-testimonial-inner {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }
  .ft-testimonial-quote {
    font-family: 'Season Mix', sans-serif;
    font-weight: 400;
    font-size: clamp(20px, 3vw, 36px);
    color: #17100e;
    line-height: 1.35;
    margin: 0;
    padding: 0;
    border: none;
    text-indent: -0.4em;
  }
  .ft-testimonial-attribution {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 16px;
    color: #17100e;
    margin: 24px 0 0;
  }

  /* ══════════════════════════════════════════════════════════
     Section 5: Use Cases — click-based tabs, big layout
     ══════════════════════════════════════════════════════════ */
  .ft-uc {
    background: #f4f3ec;
    padding: 80px 24px;
  }
  @media (max-width: 767.98px) { .ft-uc { padding: 48px 16px; } }

  .ft-uc-heading {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 5vw, 44px);
    color: #17100e;
    letter-spacing: -1.5px;
    text-align: center;
    margin: 0 0 48px;
  }

  .ft-uc-layout {
    max-width: 1320px;
    margin: 0 auto;
    display: flex;
    gap: 48px;
    align-items: flex-start;
  }
  @media (max-width: 767.98px) {
    .ft-uc-layout { flex-direction: column; gap: 24px; }
  }

  /* Tab sidebar */
  .ft-uc-sidebar {
    width: 240px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  @media (max-width: 767.98px) {
    .ft-uc-sidebar {
      width: 100%;
      flex-direction: row;
      overflow-x: auto;
      gap: 8px;
      padding-bottom: 8px;
    }
  }

  .ft-uc-tab {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border: none;
    background: transparent;
    border-radius: 10px;
    cursor: pointer;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: #888;
    text-align: left;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .ft-uc-tab:hover {
    background: rgba(23, 16, 14, 0.04);
    color: #17100e;
  }
  .ft-uc-tab.active {
    background: rgba(23, 16, 14, 0.06);
    color: #17100e;
    font-weight: 600;
  }

  .ft-uc-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #d4d3cb;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }
  .ft-uc-tab.active .ft-uc-dot {
    background: var(--ft-dot);
  }

  /* Content panels */
  .ft-uc-content {
    flex: 1;
    min-width: 0;
    position: relative;
    min-height: 500px;
  }
  @media (max-width: 767.98px) { .ft-uc-content { min-height: auto; } }

  .ft-uc-panel {
    display: none;
    flex-direction: column;
    gap: 16px;
  }
  .ft-uc-panel.active {
    display: flex;
    animation: ft-uc-fade 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes ft-uc-fade {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ft-uc-panel-title {
    font-family: 'Inter', sans-serif;
    font-size: 20px;
    font-weight: 600;
    color: #17100e;
    margin: 0;
  }
  .ft-uc-panel-desc {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #5c5c5c;
    line-height: 1.6;
    margin: 0;
    max-width: 600px;
  }

  /* ══════════════════════════════════════════════════════════
     Section 6: CTA Footer
     ══════════════════════════════════════════════════════════ */
  .ft-cta-container {
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }
  @media (min-width: 640px) { .ft-cta-container { min-height: 360px; } }
  @media (min-width: 1024px) { .ft-cta-container { min-height: 500px; } }

  .ft-cta-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .ft-cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(23,16,14,0.25) 0%, rgba(23,16,14,0.45) 100%);
  }
  .ft-cta-content {
    position: relative;
    z-index: 2;
    padding: 56px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: inherit;
  }
  .ft-cta-heading {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 5vw, 48px);
    letter-spacing: -1px;
    color: #ffffff;
    line-height: 1.1;
    margin: 0 0 28px;
  }
  .ft-cta-buttons {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* ══════════════════════════════════════════════════════════
     Reduced motion
     ══════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .ft-uc-panel.active { animation: none; }
  }
</style>

</body>
</html>
