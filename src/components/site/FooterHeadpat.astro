---
/**
 * Footer headpat toy. The Eluu logo mark sits on the first "u" of the footer
 * watermark. Click it and its eyes (the two bars) close into ^ ^ and a hand
 * comes in to pat it. Every click queues another pat, and the more pats are
 * queued the faster they go, so clicking fast pats fast. When the queue runs
 * out the hand leaves and the eyes open again.
 *
 * The mark colours are the logo artwork's own (see public/brand/mark-256-*.svg),
 * which has no token: the brand files ship them as flat colour.
 */
---

<button type="button" class="hp" aria-label="Give Eluu a headpat" data-hp hidden>
  <span class="hp__body" data-hp-body>
    <svg viewBox="0 0 256 256" width="100%" height="100%" aria-hidden="true">
      <rect width="256" height="256" rx="32" class="hp__ink" />
      <polyline class="hp__eye" data-hp-eye="l" points="84,92 84,128 84,164" />
      <polyline class="hp__eye" data-hp-eye="r" points="172,116 172,140 172,164" />
    </svg>
  </span>
  <svg class="hp__hand" viewBox="0 0 170 110" aria-hidden="true" data-hp-hand>
    <rect x="148" y="30" width="22" height="46" rx="6" class="hp__cuff" />
    <path
      class="hp__skin"
      d="M152 30 C120 18 70 14 44 28 C26 38 18 54 20 70 C21 80 30 82 33 74 C34 82 44 84 47 75 C49 83 59 84 61 74 C64 80 74 80 75 70 C78 64 90 62 104 62 C124 62 140 66 152 70 Z"
    />
    <path class="hp__skin" d="M112 62 C106 74 98 82 88 80 C80 78 82 69 92 64" />
    <path class="hp__line" d="M33 74 C32 66 34 58 39 52" />
    <path class="hp__line" d="M47 75 C47 67 49 61 53 56" />
    <path class="hp__line" d="M61 74 C61 68 63 63 67 60" />
  </svg>
</button>

<style>
  .hp {
    --hp-ink: #3d393e;
    --hp-paper: #efead9;
    position: absolute;
    z-index: 20;
    width: 150px;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  @media (max-width: 1023px) {
    .hp {
      width: 96px;
    }
  }
  :global(.dark) .hp,
  :global([data-theme='dark']) .hp {
    --hp-ink: #efead9;
    --hp-paper: #3d393e;
  }
  .hp[hidden] {
    display: none;
  }
  .hp:focus-visible {
    outline: 2px solid var(--primary-base);
    outline-offset: 6px;
    border-radius: 12px;
  }
  .hp__body {
    display: block;
    width: 100%;
    height: 100%;
    transform-origin: 50% 100%;
  }
  .hp__ink {
    fill: var(--hp-ink);
  }
  .hp__eye {
    fill: none;
    stroke: var(--hp-paper);
    stroke-width: 40;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .hp__hand {
    position: absolute;
    left: 9%;
    top: -39%;
    width: 120%;
    opacity: 0;
    pointer-events: none;
    overflow: visible;
  }
  .hp__skin {
    fill: var(--neutral-100);
    stroke: var(--neutral-950);
    stroke-width: 4;
    stroke-linejoin: round;
  }
  .hp__line {
    fill: none;
    stroke: var(--neutral-950);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .hp__cuff {
    fill: var(--maroon-500);
    stroke: var(--neutral-950);
    stroke-width: 4;
  }
</style>

<script>
  const egg = document.querySelector<HTMLElement>('[data-egg]');
  const actor = document.querySelector<HTMLButtonElement>('[data-hp]');
  const body = document.querySelector<HTMLElement>('[data-hp-body]');
  const hand = document.querySelector<SVGSVGElement>('[data-hp-hand]');
  const eyeL = document.querySelector<SVGPolylineElement>('[data-hp-eye="l"]');
  const eyeR = document.querySelector<SVGPolylineElement>('[data-hp-eye="r"]');
  const footer = actor?.closest('footer');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  const ease = (t: number) => t * t * (3 - 2 * t);
  const outBack = (t: number) => 1 + 2.4 * (t - 1) ** 3 + 1.4 * (t - 1) ** 2;

  /** Sit the mark on the first "u" of the watermark. */
  function place() {
    const e = egg!.getBoundingClientRect();
    const f = footer!.getBoundingClientRect();
    const s = actor!.offsetWidth;
    const text = [...egg!.childNodes].find((n) => n.nodeType === Node.TEXT_NODE && n.textContent!.includes('u'));
    let cx = e.left + e.width / 2;
    if (text) {
      const i = text.textContent!.indexOf('u');
      const range = document.createRange();
      range.setStart(text, i);
      range.setEnd(text, i + 1);
      const u = range.getBoundingClientRect();
      cx = u.left + u.width / 2;
    }
    // Inter's x-height top sits about 0.18em below the top of this tight line box.
    const xTop = e.top + parseFloat(getComputedStyle(egg!).fontSize) * 0.18;
    actor!.style.left = `${cx - s / 2 - f.left}px`;
    actor!.style.top = `${xTop - s - f.top}px`;
  }

  /** Bars (the logo) to ^ ^, point by point. */
  function drawEyes(happy: number) {
    const bar = (x: number, y0: number, y1: number) => [[x, y0], [x, (y0 + y1) / 2], [x, y1]];
    const caret = (x: number) => [[x - 28, 140], [x, 112], [x + 28, 140]];
    const mix = (a: number[][], b: number[][]) =>
      a.map((pt, k) => `${lerp(pt[0], b[k][0], happy)},${lerp(pt[1], b[k][1], happy)}`).join(' ');
    eyeL!.setAttribute('points', mix(bar(84, 92, 164), caret(84)));
    eyeR!.setAttribute('points', mix(bar(172, 116, 164), caret(172)));
    const w = `${lerp(40, 24, happy)}`;
    eyeL!.style.strokeWidth = w;
    eyeR!.style.strokeWidth = w;
  }

  // ---- the pat loop -----------------------------------------------------------
  // The hand's own motion: from (18, -8) tilted -6deg to (-14, 10) tilted 5deg
  // and back, once per pat, while the mark squashes under it. Distances are
  // drawn for the 150px mark and scale with it.
  const SLOW = 640; // one pat when a single click is queued
  const FAST = 200; // the cap, however fast you click
  const MAX_QUEUE = 10;
  const ENTER = 360;
  const EXIT = 300;

  type State = 'idle' | 'enter' | 'pat' | 'exit';
  let state: State = 'idle';
  let queue = 0;
  let p = 0; // phase within the current pat, 0..1
  let t0 = 0;
  let last = 0;
  let happy = 0;
  let raf = 0;

  function frame(now: number) {
    const dt = now - last;
    last = now;
    const k = actor!.offsetWidth / 150;
    let x = 18, y = -8, r = -6, alpha = 1, squash = 0;

    if (state === 'enter') {
      const e = outBack(clamp((now - t0) / ENTER));
      x = lerp(60, 18, e);
      y = lerp(-80, -8, e);
      r = lerp(-14, -6, e);
      alpha = clamp((now - t0) / 200);
      if (now - t0 >= ENTER) {
        state = 'pat';
        p = 0;
      }
    } else if (state === 'pat') {
      const period = Math.max(FAST, SLOW / (1 + 0.55 * (queue - 1)));
      p += dt / period;
      if (p >= 1) {
        p -= 1;
        queue -= 1;
        if (queue <= 0) {
          queue = 0;
          p = 0;
          state = 'exit';
          t0 = now;
        }
      }
      const s = ease((1 - Math.cos(p * Math.PI * 2)) / 2);
      x = lerp(18, -14, s);
      y = lerp(-8, 10, s);
      r = lerp(-6, 5, s);
      squash = s;
    } else if (state === 'exit') {
      const e = ease(clamp((now - t0) / EXIT));
      x = lerp(18, 60, e);
      y = lerp(-8, -80, e);
      r = lerp(-6, -14, e);
      alpha = 1 - e;
    }

    // Eyes: closed while the hand is here, open again as it leaves.
    const target = state === 'exit' ? 0 : 1;
    happy = clamp(happy + (target - happy) * Math.min(1, dt / 70));
    drawEyes(happy);
    hand!.style.opacity = `${alpha}`;
    hand!.style.transform = `translate(${x * k}px, ${y * k}px) rotate(${r}deg)`;
    body!.style.transform = `scale(${1 + 0.06 * squash}, ${1 - 0.1 * squash})`;

    if (state === 'exit' && now - t0 >= EXIT && happy < 0.01) {
      state = 'idle';
      drawEyes(0);
      body!.style.transform = '';
      return;
    }
    raf = requestAnimationFrame(frame);
  }

  let stillTimer = 0;

  function pat() {
    queue = Math.min(MAX_QUEUE, queue + 1);
    if (reduced) {
      // No motion: show the pat as a still, and let it go after a moment.
      drawEyes(1);
      hand!.style.opacity = '1';
      clearTimeout(stillTimer);
      stillTimer = window.setTimeout(() => {
        queue = 0;
        drawEyes(0);
        hand!.style.opacity = '0';
      }, 900);
      return;
    }
    if (state === 'idle') {
      state = 'enter';
      t0 = last = performance.now();
      raf = requestAnimationFrame(frame);
    } else if (state === 'exit') {
      // Clicked again while it was leaving: come straight back.
      state = 'enter';
      t0 = performance.now();
    }
  }

  if (egg && actor && body && hand && eyeL && eyeR && footer) {
    const show = () => {
      // The watermark only has a size once it is laid out with its font.
      if (egg.getBoundingClientRect().width === 0) return;
      actor.hidden = false;
      place();
    };
    document.fonts.ready.then(show);
    new ResizeObserver(show).observe(footer);
    actor.addEventListener('click', pat);
  }
</script>
