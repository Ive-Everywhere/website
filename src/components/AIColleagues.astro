---
---
<section class="py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-4 max-w-3xl">
      AI Colleagues designed to work with you.
    </h2>
    <p class="text-base md:text-lg text-[#6B6B6B] max-w-4xl mb-12 leading-relaxed">
      Eluu lets you create AI colleagues that learn your workflows, remember your preferences, and get better over time. They live in Slack, work across your tools in parallel, and run on schedule or on demand.
    </p>

    <!-- Dashboard Mockup -->
    <div class="relative max-w-5xl mx-auto">
      <div class="bg-[#2A2A2A] rounded-2xl p-6 md:p-8 min-h-[400px] relative overflow-hidden">
        <!-- Dark dashboard background -->
        <div class="flex items-center gap-3 mb-6">
          <svg width="24" height="24" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="8" fill="white"/><rect x="10" y="8" width="4" height="16" rx="2" fill="#2A2A2A"/><rect x="18" y="8" width="4" height="16" rx="2" fill="#2A2A2A"/></svg>
          <div class="flex gap-2">
            <div class="w-5 h-5 rounded bg-white/10"></div>
            <div class="w-5 h-5 rounded bg-white/10"></div>
          </div>
        </div>
        <div class="flex items-center gap-2 bg-white/10 rounded-lg px-3 py-2 w-48 mb-8">
          <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m21 21-4.35-4.35"/></svg>
          <span class="text-white/40 text-sm">Search...</span>
        </div>

        <!-- Center actions card -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/3 bg-[#3A3A3A] rounded-xl p-6 w-80 shadow-2xl">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center">
              <svg class="w-4 h-4 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
          </div>
          <h3 class="text-white font-semibold mb-1">Actions</h3>
          <p class="text-white/50 text-sm mb-4">Run complex workflows across your tools with a single click</p>
          <div class="bg-white/10 rounded-lg px-3 py-2 flex items-center gap-2">
            <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="m21 21-4.35-4.35"/></svg>
            <span class="text-white/40 text-sm">Search colleagues...</span>
          </div>
        </div>
      </div>

      <!-- Agentic Colleagues sidebar (floating card) -->
      <div class="absolute -bottom-6 -left-4 md:left-4 bg-white rounded-xl shadow-xl p-5 w-72 z-10">
        <div class="flex items-center gap-2 mb-4">
          <h3 class="font-semibold text-sm">Agentic Colleagues</h3>
          <svg class="w-4 h-4 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-pink-200 flex items-center justify-center text-xs">L</div>
              <div>
                <p class="text-sm font-medium">Lewis (Marketing outreach)</p>
                <p class="text-xs text-green-600">Working on 7 tasks...</p>
              </div>
            </div>
            <svg class="w-4 h-4 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-amber-200 flex items-center justify-center text-xs">J</div>
              <div>
                <p class="text-sm font-medium">Jane (Product Manager)</p>
                <p class="text-xs text-[#6B6B6B]">Paused — waiting for approval</p>
              </div>
            </div>
            <svg class="w-4 h-4 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </div>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-blue-200 flex items-center justify-center text-xs">P</div>
              <div>
                <p class="text-sm font-medium">Prime (Revenue specialist)</p>
                <p class="text-xs text-[#6B6B6B]">Scheduled: 8am tomorrow</p>
              </div>
            </div>
            <svg class="w-4 h-4 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </div>
        </div>
      </div>

      <!-- Notifications card (floating) -->
      <div class="absolute -bottom-4 -right-4 md:right-4 bg-white rounded-xl shadow-xl p-5 w-72 z-10">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-5 h-5">
            <svg viewBox="0 0 24 24" fill="none"><path d="M14.5 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7.5L14.5 2z" fill="#E01E5A"/><path d="M14.5 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V7.5L14.5 2z" fill="url(#slack)" opacity="0.3"/></svg>
          </div>
          <h3 class="font-semibold text-sm">Notifications</h3>
        </div>
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-green-500 flex items-center justify-center mt-0.5">
              <svg class="w-3 h-3 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium">Pipeline risk alert: 3 deals flagged</p>
                <span class="text-xs text-[#6B6B6B]">5 min</span>
              </div>
              <p class="text-xs text-[#6B6B6B]">Task completed</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-5 h-5 rounded-full bg-amber-500 flex items-center justify-center mt-0.5">
              <div class="w-2 h-2 rounded-full bg-white"></div>
            </div>
            <div class="flex-1">
              <div class="flex items-center justify-between">
                <p class="text-sm font-medium">Sprint summary ready for review</p>
                <span class="text-xs text-[#6B6B6B]">Yesterday</span>
              </div>
              <p class="text-xs text-[#6B6B6B]">Waiting for approval</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
