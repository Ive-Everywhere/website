---
const icons = [
  'salesforce', 'notion', 'slack', 'hubspot', 'gmail',
  'googlesheets', 'github', 'jira', 'linear', 'stripe',
  'figma', 'asana', 'intercom', 'zendesk', 'zoom',
  'airtable', 'dropbox', 'mailchimp', 'twilio', 'apollographql',
];
---

<section class="ig-section">
  <div class="ig-wrap">
    <div class="ig-header">
      <h2 class="ig-heading reveal">
        Plug into the tools you already use.
      </h2>
      <p class="ig-desc reveal">
        Your AI colleagues connect natively to CRMs, billing systems, spreadsheets, communication tools, and more. They read, write, and cross-reference across all of them — and your <strong>data never leaves your environment</strong>. Every connection is scoped, encrypted, and fully under your control.
      </p>
    </div>

    <div class="ig-container">
      <div class="ig-mask-l"></div>
      <div class="ig-mask-r"></div>

      <div class="ig-center">
        <img src="/images/eluu-logo.svg" alt="Eluu" />
      </div>

      <!-- 3x copies for seamless circular loop — track never runs empty -->
      <div class="ig-track">
        {[...icons, ...icons, ...icons].map((name) => (
          <div class="ig-icon">
            <img src={`/logos/integrations/${name}.svg`} alt={name} />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .ig-section {
    background: #13100a;
    padding: 112px 0 0;
  }

  .ig-wrap {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .ig-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 4vw, 36px);
    letter-spacing: -1px;
    color: #ede9e3;
    line-height: 1.1;
    margin: 0;
  }

  .ig-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.7;
    margin: 20px 0 0;
  }
  .ig-desc strong {
    color: #ede9e3;
    font-weight: 600;
  }
  @media (max-width: 480px) {
    .ig-heading { font-size: 22px; }
    .ig-desc { font-size: 15px; }
  }

  .ig-header {
    padding: 0 0 24px;
  }
  @media (min-width: 640px) { .ig-header { padding: 0 0 32px; } }
  @media (min-width: 1024px) { .ig-header { padding: 0 0 40px; } }

  .ig-container {
    position: relative;
    background:
      radial-gradient(ellipse at 20% 50%, rgba(237, 115, 59, 0.12) 0%, transparent 50%),
      radial-gradient(ellipse at 80% 30%, rgba(237, 115, 59, 0.08) 0%, transparent 45%),
      radial-gradient(ellipse at 50% 80%, rgba(237, 115, 59, 0.06) 0%, transparent 50%),
      #1e1d1b;
    border-radius: 4px;
    height: 160px;
    overflow: hidden;
    display: flex;
    align-items: center;
    border: 1px solid rgba(237, 233, 227, 0.06);
  }

  .ig-mask-l,
  .ig-mask-r {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 48px;
    z-index: 3;
    pointer-events: none;
  }
  .ig-mask-l {
    left: 0;
    background: linear-gradient(to right, #1e1d1b, transparent);
  }
  .ig-mask-r {
    right: 0;
    background: linear-gradient(to left, #1e1d1b, transparent);
  }

  .ig-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    z-index: 4;
    width: 92px;
    height: 92px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    overflow: hidden;
    background: #2b272c;
    box-shadow:
      0 0 0 5px rgba(237, 115, 59, 0.2),
      0 0 30px rgba(237, 115, 59, 0.1);
    animation: ig-glow 3s ease-in-out infinite;
  }
  .ig-center img {
    width: 100%;
    height: 100%;
    display: block;
    transform: scale(1.08);
  }

  .ig-track {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 0 20px;
    will-change: transform;
  }

  .ig-icon {
    flex-shrink: 0;
    width: 72px;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #2b272c;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.06);
  }
  .ig-icon img {
    width: 36px;
    height: 36px;
    display: block;
    opacity: 0.9;
  }

  @keyframes ig-glow {
    0%, 100% {
      box-shadow:
        0 0 0 5px rgba(237, 115, 59, 0.15),
        0 0 24px rgba(237, 115, 59, 0.08);
    }
    50% {
      box-shadow:
        0 0 0 8px rgba(237, 115, 59, 0.25),
        0 0 40px rgba(237, 115, 59, 0.12);
    }
  }

  /* Very small screens (360px) */
  @media (max-width: 400px) {
    .ig-container { height: 130px; border-radius: 4px; }
    .ig-container::before { border-radius: 4px; }
    .ig-center { width: 72px; height: 72px; border-radius: 4px; }
    .ig-center img { width: 100%; height: 100%; }
    .ig-icon { width: 56px; height: 56px; border-radius: 4px; }
    .ig-icon img { width: 28px; height: 28px; }
    .ig-track { gap: 12px; padding: 0 12px; }
    .ig-mask-l, .ig-mask-r { width: 32px; }
  }

  @media (min-width: 640px) {
    .ig-container { height: 200px; }
    .ig-center { width: 112px; height: 112px; border-radius: 4px; }
    .ig-center img { width: 100%; height: 100%; }
    .ig-icon { width: 90px; height: 90px; border-radius: 4px; }
    .ig-icon img { width: 45px; height: 45px; }
    .ig-track { gap: 28px; padding: 0 28px; }
    .ig-mask-l, .ig-mask-r { width: 160px; }
  }

  @media (min-width: 1024px) {
    .ig-container { height: 260px; border-radius: 4px; }
    .ig-center { width: 137px; height: 137px; border-radius: 4px; }
    .ig-center img { width: 100%; height: 100%; }
    .ig-icon { width: 110px; height: 110px; border-radius: 4px; }
    .ig-icon img { width: 55px; height: 55px; }
    .ig-track { gap: 36px; padding: 0 36px; }
    .ig-mask-l, .ig-mask-r { width: 220px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ig-center { animation: none; }
  }
</style>

<script>
  (function () {
    const container = document.querySelector('.ig-container') as HTMLElement;
    const track = document.querySelector('.ig-track') as HTMLElement;
    if (!track || !container) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const iconEl = track.querySelector('.ig-icon') as HTMLElement;
    if (!iconEl) return;

    const totalIcons = track.children.length;
    const setSize = totalIcons / 3; // 20 unique icons, 3 copies

    let step = 0;
    let centerAdj = 0;

    function measure() {
      const gap = parseFloat(getComputedStyle(track).gap) || 54;
      const iconW = iconEl.offsetWidth;
      step = iconW + gap;
      const padding = parseFloat(getComputedStyle(track).paddingLeft) || 54;
      centerAdj = (container.offsetWidth / 2) - padding - (iconW / 2);
    }

    function setPos(i: number, animate: boolean) {
      track.style.transition = animate
        ? 'transform 0.8s cubic-bezier(0.25, 0.1, 0.25, 1)'
        : 'none';
      track.style.transform = `translateX(${centerAdj - i * step}px)`;
      if (!animate) void track.offsetHeight;
    }

    // Start in the middle set (index setSize..2*setSize) so there are
    // always icons extending past both edges of the container
    let idx = 2 * setSize;
    measure();
    setPos(idx, false);

    function advance() {
      idx--;
      if (idx < setSize) {
        // Jump to identical position in next set — no visual change
        idx += setSize;
        setPos(idx, false);
        // Wait for the jump to render, then animate the next step
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            idx--;
            setPos(idx, true);
          });
        });
      } else {
        setPos(idx, true);
      }
    }

    setInterval(advance, 1800);

    let resizeTimer: number;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => { measure(); setPos(idx, false); }, 200);
    }, { passive: true });
  })();
</script>
