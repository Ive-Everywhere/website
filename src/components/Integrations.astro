---
---
<section class="py-20 md:py-28 relative overflow-hidden">
  <!-- Background: dark nature scene with flowers - using gradient placeholder -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#2A1A30] via-[#1A2A20] to-[#2A1A20]">
    <div class="absolute inset-0 bg-gradient-to-r from-purple-900/30 via-green-900/20 to-amber-900/30"></div>
    <!-- Decorative blurred circles for flower-like background -->
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-purple-500/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-96 h-96 bg-amber-500/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/4 w-64 h-64 bg-pink-500/10 rounded-full blur-3xl"></div>
    <div class="absolute top-1/3 right-1/3 w-48 h-48 bg-orange-500/10 rounded-full blur-2xl"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-white/90 mb-2">
        Connect to all your apps
      </h2>
      <p class="text-3xl md:text-5xl font-bold tracking-tight text-white mb-8">
        Start working from day 0
      </p>
      <p class="text-white/70 max-w-3xl mx-auto leading-relaxed">
        Any tool, internal or external. Colleagues learn how to use them and improve over time. You set exactly what each colleague can access and do. Credentials stay securely stored — never exposed to the AI.
      </p>
    </div>

    <!-- Floating app icons grid -->
    <div class="flex flex-wrap justify-center gap-6 md:gap-8 max-w-3xl mx-auto">
      <!-- Salesforce -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="#00A1E0"><path d="M10.006 5.17a4.012 4.012 0 013.09-1.453 4.074 4.074 0 013.876 2.825 3.303 3.303 0 014.086 3.195 3.303 3.303 0 01-1.66 2.869c.098.388.148.79.148 1.199a4.604 4.604 0 01-4.6 4.6 4.562 4.562 0 01-2.384-.668A3.81 3.81 0 019.253 19.5a3.81 3.81 0 01-3.248-1.81A4.12 4.12 0 012 13.8a4.12 4.12 0 013.154-4.012A3.59 3.59 0 018.4 5.964a3.59 3.59 0 011.606-.794z"/></svg>
      </div>
      <!-- Slack -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24"><path d="M6.527 14.514A1.636 1.636 0 014.89 16.15a1.636 1.636 0 01-1.636-1.636A1.636 1.636 0 014.89 12.88h1.637v1.634zm.818 0a1.636 1.636 0 011.636-1.636 1.636 1.636 0 011.636 1.636v4.09a1.636 1.636 0 01-1.636 1.637 1.636 1.636 0 01-1.636-1.636v-4.09z" fill="#E01E5A"/><path d="M9.481 6.527A1.636 1.636 0 017.845 4.89 1.636 1.636 0 019.48 3.255a1.636 1.636 0 011.636 1.636v1.636H9.481zm0 .818a1.636 1.636 0 011.636 1.636 1.636 1.636 0 01-1.636 1.636H5.393a1.636 1.636 0 01-1.636-1.636 1.636 1.636 0 011.636-1.636h4.088z" fill="#36C5F0"/><path d="M17.468 9.481a1.636 1.636 0 011.636-1.636 1.636 1.636 0 011.636 1.636 1.636 1.636 0 01-1.636 1.636h-1.636V9.48zm-.818 0a1.636 1.636 0 01-1.636 1.636 1.636 1.636 0 01-1.636-1.636V5.393a1.636 1.636 0 011.636-1.636 1.636 1.636 0 011.636 1.636v4.088z" fill="#2EB67D"/><path d="M14.514 17.468a1.636 1.636 0 011.636 1.636 1.636 1.636 0 01-1.636 1.636 1.636 1.636 0 01-1.636-1.636v-1.636h1.636zm0-.818a1.636 1.636 0 01-1.636-1.636 1.636 1.636 0 011.636-1.636h4.09a1.636 1.636 0 011.637 1.636 1.636 1.636 0 01-1.636 1.636h-4.09z" fill="#ECB22E"/></svg>
      </div>
      <!-- Notion -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <span class="text-white text-xl font-bold">N</span>
      </div>
      <!-- Gmail -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24"><path d="M2 6l10 7 10-7v12H2V6z" fill="#EA4335" opacity="0.3"/><path d="M22 6l-10 7L2 6" fill="none" stroke="#EA4335" stroke-width="2"/></svg>
      </div>
      <!-- Zoom -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="#2D8CFF"><rect x="2" y="5" width="14" height="14" rx="3"/><path d="M18 9l4-2v10l-4-2V9z"/></svg>
      </div>
      <!-- Zendesk -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <span class="text-white text-lg font-bold">Z</span>
      </div>
      <!-- Linear -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="white"><circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"/><path d="M8 12l3 3 5-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </div>
      <!-- Asana -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="#F06A6A"><circle cx="12" cy="6" r="4"/><circle cx="6" cy="16" r="4"/><circle cx="18" cy="16" r="4"/></svg>
      </div>
      <!-- Figma -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-6 h-8" viewBox="0 0 12 18"><rect x="0" y="0" width="6" height="6" rx="3" fill="#F24E1E"/><rect x="6" y="0" width="6" height="6" rx="3" fill="#FF7262"/><rect x="0" y="6" width="6" height="6" rx="3" fill="#A259FF"/><rect x="6" y="6" width="6" height="6" rx="3" fill="#1ABCFE"/><rect x="0" y="12" width="6" height="6" rx="3" fill="#0ACF83"/></svg>
      </div>
      <!-- HubSpot -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24" fill="#FF7A59"><circle cx="12" cy="12" r="3"/><path d="M12 5v4m0 6v4M5 12h4m6 0h4" stroke="#FF7A59" stroke-width="2" stroke-linecap="round"/></svg>
      </div>
      <!-- Gong -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <span class="text-white/80 text-sm font-bold">Gong</span>
      </div>
      <!-- Google Sheets -->
      <div class="w-12 h-12 md:w-14 md:h-14 bg-white/10 backdrop-blur-sm rounded-xl flex items-center justify-center hover:bg-white/20 transition-colors">
        <svg class="w-7 h-7" viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2" fill="#0F9D58"/><rect x="7" y="8" width="10" height="8" rx="1" fill="white"/><path d="M12 8v8M7 12h10" stroke="#0F9D58" stroke-width="1"/></svg>
      </div>
    </div>
  </div>
</section>
