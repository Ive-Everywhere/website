---
const testimonials = [
  {
    quote: "I tried ChatGPT, Claude, Zapier — none of them connect to my tools natively. With Eluu, I have a colleague that checks my entire pipeline every morning, cross-references three systems, and DMs me anomalies before my first meeting. What took a week now takes 5 minutes.",
    name: 'COO',
    role: 'B2B SaaS company',
    company: 'TestMu AI',
  },
  {
    quote: "We process 30-40 invoices a day — each one used to take 5 minutes of manual work across Salesforce and Stripe. Our Eluu colleague handles all of it. It also built us an analytics engine across dozens of spreadsheets that would have taken 10,000 lines of code. We couldn't go back.",
    name: 'Head of Finance',
    role: 'B2B SaaS company',
    company: 'Loom',
  },
  {
    quote: 'We connected 4 tools and had an engineering colleague running PR reviews against our sprint backlog. Setup took less than a day and we were seeing results immediately.',
    name: 'Engineering Lead',
    role: '',
    company: 'RIPPLING',
  },
];
---

<section class="ts-section">
  <div style="max-width: 1440px; margin: 0 auto; padding: 0 0;">
    <!-- Company tabs -->
    <div class="ts-tabs reveal">
      <button type="button" class="ts-tab active" data-ts="0">
        <img src="/logos/testimonials/testmu.svg" alt="TestMu AI" class="ts-logo ts-logo-testmu" />
      </button>
      <button type="button" class="ts-tab" data-ts="1">
        <img src="/logos/testimonials/loom.svg" alt="Loom" class="ts-logo ts-logo-loom" />
      </button>
      <button type="button" class="ts-tab" data-ts="2">
        <img src="/logos/testimonials/rippling.svg" alt="Rippling" class="ts-logo ts-logo-rippling" />
      </button>
    </div>

    <!-- Quotes container -->
    <div class="ts-quotes">
      {testimonials.map((t, i) => (
        <div class={`ts-quote ${i === 0 ? 'active' : ''}`} data-tq={i}>
          <blockquote>
            &ldquo;{t.quote}&rdquo;
          </blockquote>
          <div class="ts-attr">
            <p>
              <span class="ts-name">{t.name}</span>{t.role ? `, ${t.role}` : ''}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .ts-section {
    background: #f4f3ec;
    padding: 48px 16px;
  }
  @media (min-width: 640px) { .ts-section { padding: 60px 24px; } }
  @media (min-width: 1024px) { .ts-section { padding: 80px 24px; } }

  /* ── Tabs ── */
  .ts-tabs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 36px;
    margin-bottom: 40px;
  }
  @media (min-width: 640px) { .ts-tabs { gap: 56px; margin-bottom: 56px; } }
  @media (min-width: 1024px) { .ts-tabs { gap: 72px; } }

  .ts-tab {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
    opacity: 0.3;
  }
  .ts-tab:hover { opacity: 0.55; }
  .ts-tab.active { opacity: 1; }

  .ts-logo {
    display: block;
    filter: brightness(0);
    object-fit: contain;
  }

  /* Each logo gets its own width so the TEXT portion aligns visually */
  .ts-logo-testmu { width: 140px; }
  .ts-logo-loom { width: 120px; }
  .ts-logo-rippling { width: 180px; }

  @media (min-width: 640px) {
    .ts-logo-testmu { width: 170px; }
    .ts-logo-loom { width: 150px; }
    .ts-logo-rippling { width: 220px; }
  }
  @media (min-width: 1024px) {
    .ts-logo-testmu { width: 200px; }
    .ts-logo-loom { width: 180px; }
    .ts-logo-rippling { width: 260px; }
  }

  /* ── Quotes container ── */
  .ts-quotes {
    position: relative;
    min-height: 280px;
    text-align: center;
    max-width: 1060px;
    margin: 0 auto;
  }
  @media (min-width: 640px) { .ts-quotes { min-height: 300px; } }
  @media (min-width: 768px) { .ts-quotes { min-height: 320px; } }
  @media (min-width: 1024px) { .ts-quotes { min-height: 340px; } }

  /* ── Single quote ── */
  .ts-quote {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.6s ease;
  }
  .ts-quote.active {
    opacity: 1;
    pointer-events: auto;
  }

  blockquote {
    font-family: 'Season Mix', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 1.35;
    letter-spacing: -0.2px;
    color: #17100e;
    margin: 0;
    padding-bottom: 24px;
    text-indent: -0.4em;
  }
  @media (min-width: 640px) {
    blockquote { font-size: 24px; letter-spacing: -0.3px; padding-bottom: 32px; }
  }
  @media (min-width: 768px) {
    blockquote { font-size: 30px; letter-spacing: -0.5px; }
  }
  @media (min-width: 1024px) {
    blockquote { font-size: 36px; letter-spacing: -0.8px; }
  }

  /* ── Attribution ── */
  .ts-attr {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .ts-attr p {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #17100e;
    margin: 0;
  }

  .ts-name {
    font-weight: 600;
  }
</style>

<script>
  (function () {
    const tabs = document.querySelectorAll('.ts-tab');
    const quotes = document.querySelectorAll('.ts-quote');
    if (!tabs.length) return;

    function show(idx) {
      tabs.forEach((t, i) => t.classList.toggle('active', i === idx));
      quotes.forEach((q, i) => q.classList.toggle('active', i === idx));
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => show(parseInt(tab.dataset.ts)));
    });

    // Auto-rotate every 6 seconds
    let current = 0;
    let timer = setInterval(() => {
      current = (current + 1) % tabs.length;
      show(current);
    }, 6000);

    // Reset timer on manual click
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        current = parseInt(tab.dataset.ts);
        clearInterval(timer);
        timer = setInterval(() => {
          current = (current + 1) % tabs.length;
          show(current);
        }, 6000);
      });
    });
  })();
</script>
