---
const testimonials = [
  {
    quote: "I tried ChatGPT, Claude, Zapier — none of them connect to my tools natively. Eluu checks my entire pipeline every morning, cross-references three systems, and DMs me anomalies before my first meeting.",
    name: 'Chief Operating Officer',
    company: 'TestMu AI',
    logo: '/logos/testimonials/testmu.png',
  },
  {
    quote: "What used to take a full day of pulling reports and cross-referencing spreadsheets now happens automatically before I even open my laptop. Eluu knows our data better than most people on the team.",
    name: 'Senior Product Owner',
    company: 'Ameriprise Financial',
    logo: '/logos/testimonials/ameriprise.png',
  },
  {
    quote: "We needed something that could work across our internal tools without engineering overhead. Eluu connected, indexed everything, and started delivering insights in hours — no babysitting required.",
    name: 'Database Support Engineer',
    company: 'AWS',
    logo: '/logos/testimonials/aws.webp',
  },
];
---

<section class="ts-section">
  <div class="ts-container">
    <div class="ts-grid">
      {testimonials.map((t) => (
        <div class="ts-card reveal">
          <div class="ts-card-top">
            <img src={t.logo} alt={t.company} class="ts-logo" />
          </div>
          <blockquote class="ts-quote">&ldquo;{t.quote}&rdquo;</blockquote>
          <div class="ts-attr">
            <span class="ts-name">{t.name}</span>
            <span class="ts-company">{t.company}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ts-section {
    background: #13100a;
    padding: 112px 0 56px;
  }
  @media (max-width: 480px) { .ts-section { padding: 56px 0 32px; } }

  .ts-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* ── 3-card grid — matches WhyEluu/Frontier card language ── */
  .ts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
  }
  @media (min-width: 640px) {
    .ts-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .ts-grid { grid-template-columns: repeat(3, 1fr); }
  }

  /* ── Card ── */
  .ts-card {
    position: relative;
    background: #1e1d1b;
    border-radius: 4px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 0;
    box-sizing: border-box;
  }
  .ts-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 1;
  }

  /* ── Logo ── */
  .ts-card-top {
    margin-bottom: 20px;
  }

  .ts-logo {
    display: block;
    height: 20px;
    width: auto;
    object-fit: contain;
    filter: brightness(0) invert(1);
    opacity: 0.5;
  }

  /* ── Quote ── */
  .ts-quote {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: 15px;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: rgba(237, 233, 227, 0.85);
    margin: 0;
    text-wrap: pretty;
    flex: 1;
  }

  /* ── Attribution — pushed to bottom via flex ── */
  .ts-attr {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(237, 233, 227, 0.06);
  }

  .ts-name {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #ede9e3;
    letter-spacing: -0.01em;
  }

  .ts-company {
    font-family: 'Söhne', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.35);
    letter-spacing: -0.005em;
  }
</style>
