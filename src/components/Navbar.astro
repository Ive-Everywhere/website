---
---

<nav id="main-nav" class="site-nav">
  <div style="max-width: 1800px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between;">
    <!-- Left: Logo + Name -->
    <a href="/" style="display: flex; align-items: center; gap: 10px; text-decoration: none;">
      <img src="/images/logo.svg" alt="Eluu" class="nav-logo" />
      <span class="nav-wordmark">Eluu AI</span>
    </a>

    <!-- Right: Log in button -->
    <div style="display: flex; align-items: center; gap: 10px;">
      <a href="https://app.eluu.ai" class="nav-link-login">Log in</a>
      <a href="https://app.eluu.ai" class="nav-btn">Get started</a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 12px 16px;
    background: transparent;
    transform: translateY(0);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.3s ease,
                backdrop-filter 0.3s ease;
  }
  .site-nav.hidden {
    transform: translateY(-100%);
  }
  .site-nav.scrolled {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(23, 16, 14, 0.06);
  }
  .nav-logo { width: 40px; height: 40px; }
  @media (min-width: 640px) { .nav-logo { width: 48px; height: 48px; } }
  .nav-wordmark {
    font-family: 'Jersey 10', cursive;
    font-size: 34px;
    color: #17100e;
    line-height: 1;
    letter-spacing: -0.3px;
  }
  @media (min-width: 640px) { .nav-wordmark { font-size: 40px; } }

  .nav-link-login {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #17100e;
    text-decoration: none;
    padding: 10px 16px;
    transition: opacity 0.2s ease;
  }
  .nav-link-login:hover { opacity: 0.6; }

  .nav-btn {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    background: #17100e;
    border-radius: 10px;
    padding: 10px 24px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .nav-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(23, 16, 14, 0.15);
  }
  /* Very small screens (360px and below) */
  @media (max-width: 400px) {
    .nav-wordmark { font-size: 28px; }
    .nav-logo { width: 34px; height: 34px; }
    .nav-link-login { padding: 8px 10px; font-size: 13px; }
    .nav-btn { padding: 8px 16px; font-size: 13px; }
  }

  @media (min-width: 640px) {
    .site-nav { padding: 16px 24px; }
  }
  @media (min-width: 1024px) {
    .site-nav { padding: 20px 36px; }
  }
</style>

<script>
  let lastScrollY = 0;
  let ticking = false;
  const nav = document.getElementById('main-nav');

  function updateNav() {
    const currentY = window.scrollY;

    // Show/hide based on scroll direction
    if (currentY > lastScrollY && currentY > 100) {
      nav?.classList.add('hidden');
    } else {
      nav?.classList.remove('hidden');
    }

    // Add background blur when scrolled
    if (currentY > 50) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }

    lastScrollY = currentY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateNav);
      ticking = true;
    }
  }, { passive: true });
</script>
