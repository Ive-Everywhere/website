---
---

<nav id="main-nav" class="site-nav">
  <div class="nav-bar">
    <div class="nav-container">
      <!-- Left: Logo + Name -->
      <a href="/" class="nav-brand">
        <img src="/images/logo.svg" alt="Eluu" class="nav-logo" />
        <span class="nav-wordmark">Eluu AI</span>
      </a>

      <!-- Center: Platform (with dropdown), Pricing -->
      <div class="nav-links">
        <div class="nav-link-wrap" data-dropdown-wrap>
          <button type="button" class="nav-link nav-link-trigger" aria-expanded="false" aria-haspopup="true">
            <span>Platform</span>
            <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5L6 7.5L9 4.5"/></svg>
          </button>
        </div>
        <a href="/research" class="nav-link">Research</a>
        <a href="/pricing" class="nav-link">Pricing</a>
      </div>

      <!-- Right: Log in + hamburger -->
      <div class="nav-actions">
        <a
          href="https://app.eluu.ai"
          class="nav-btn"
          onclick="window.posthog?.capture('log_in_clicked', { location: 'navbar' })"
        >Log in</a>
        <button class="nav-hamburger" id="nav-hamburger" type="button" aria-label="Menu" aria-expanded="false">
          <span class="nav-ham-line"></span>
          <span class="nav-ham-line"></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Features dropdown -->
  <div class="nav-dropdown" id="nav-dropdown-features" data-dropdown-panel="features">
    <div class="nav-dropdown-inner">
      <div class="nav-dropdown-grid">
        <a href="/features/colleagues" class="nav-dd-item">
          <h4>Colleagues</h4>
          <p>Build an AI-native workforce with specialized colleagues that have real skills.</p>
        </a>
        <a href="/features/team-drive" class="nav-dd-item">
          <h4>Hard Drive</h4>
          <p>Each colleague gets its own storage for files, context, and memory — shared when the colleague is.</p>
        </a>
        <a href="/features/integrations" class="nav-dd-item">
          <h4>Integrations</h4>
          <p>Connect your AI colleagues to any tool, data source, or API your team uses.</p>
        </a>
        <a href="/features/views" class="nav-dd-item">
          <h4>Views</h4>
          <p>Build your agentic command center — live dashboards for pipeline, revenue, and activity.</p>
        </a>
        <a href="/features/slack" class="nav-dd-item">
          <h4>Slack</h4>
          <p>Talk to your AI colleagues directly in Slack — assign tasks, get updates, ask questions.</p>
        </a>
        <a href="/features/jobs" class="nav-dd-item">
          <h4>Jobs</h4>
          <p>Run scheduled tasks and trigger workflows from anywhere — on repeat, on demand.</p>
        </a>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile sidebar — OUTSIDE .site-nav to avoid iOS transform/backdrop-filter bugs -->
<div class="nav-sidebar-backdrop" id="nav-sidebar-backdrop"></div>
<aside class="nav-sidebar" id="nav-sidebar" aria-hidden="true">
  <div class="nav-sidebar-header">
    <button class="nav-sidebar-close" id="nav-sidebar-close" type="button" aria-label="Close menu">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
        <path d="M5 5L15 15M15 5L5 15"/>
      </svg>
    </button>
  </div>
  <nav class="nav-sidebar-links">
    <span class="nav-sidebar-label">Platform</span>
    <a href="/features/colleagues" class="nav-sidebar-link">Colleagues</a>
    <a href="/features/integrations" class="nav-sidebar-link">Integrations</a>
    <a href="/features/team-drive" class="nav-sidebar-link">Hard Drive</a>
    <a href="/features/views" class="nav-sidebar-link">Views</a>
    <a href="/features/jobs" class="nav-sidebar-link">Jobs</a>
    <a href="/features/slack" class="nav-sidebar-link">Slack</a>
    <a href="/research" class="nav-sidebar-link nav-sidebar-link--spaced">Research</a>
    <a href="/pricing" class="nav-sidebar-link">Pricing</a>
  </nav>
  <div class="nav-sidebar-footer">
    <a href="https://app.eluu.ai" class="nav-sidebar-cta">Get started</a>
  </div>
</aside>

<style>
  /* ── The nav is the glass panel. It expands to include the dropdown.
     backdrop-filter on .site-nav blurs only what's behind it — exactly
     the nav bar + dropdown area, not the full page. ── */
  .site-nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    transform: translateY(0);
    /* Unified 0.35s timing so bg and transform animate together — no flash */
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.35s ease,
                backdrop-filter 0.35s ease,
                -webkit-backdrop-filter 0.35s ease,
                border-color 0.35s ease;
    border-bottom: 1px solid transparent;
  }
  .site-nav.hidden {
    transform: translateY(-100%);
  }

  /* Scrolled: applied at scrollY > 0, so navbar ALWAYS has bg when off top */
  .site-nav.scrolled {
    background: rgba(20, 18, 11, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom-color: rgba(237, 233, 227, 0.06);
  }

  /* ── Dropdown-open state: the SAME blur style on the entire nav
     (which now includes the dropdown panel). One unified glass. ── */
  .site-nav.dropdown-open {
    background: rgba(20, 18, 11, 0.85);
    backdrop-filter: blur(40px) saturate(1.15);
    -webkit-backdrop-filter: blur(40px) saturate(1.15);
    border-bottom: 1px solid rgba(237, 233, 227, 0.06);
  }

  /* ── Nav bar row ── */
  .nav-bar {
    padding: 0;
    height: 56px;
    display: flex;
    align-items: center;
  }

  .nav-container {
    max-width: 1380px;
    width: 100%;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .nav-logo { width: 26px; height: 26px; }
  .nav-wordmark {
    font-family: 'Jersey 10', cursive;
    font-size: 28px;
    color: #ede9e3;
    line-height: 1;
    letter-spacing: -0.3px;
  }

  /* ── Center nav links ── */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .nav-link {
    display: flex;
    align-items: center;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.7);
    text-decoration: none;
    line-height: 1;
    height: 100%;
    transition: color 0.2s ease;
  }
  .nav-link:hover { color: #ede9e3; }

  .nav-link-wrap { position: relative; display: flex; align-items: center; }
  .nav-link-trigger {
    display: flex;
    align-items: center;
    gap: 4px;
    background: none;
    border: none;
    margin: 0;
    cursor: pointer;
    padding: 0;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: inherit;
    line-height: 1;
    height: 100%;
  }
  .nav-chevron {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    width: 12px; height: 12px;
    flex-shrink: 0;
  }
  .site-nav.dropdown-open .nav-chevron {
    transform: rotate(180deg);
  }
  .site-nav.dropdown-open .nav-link-trigger {
    opacity: 1;
  }

  /* ── Dropdown panel — inside .site-nav, below .nav-bar ── */
  .nav-dropdown {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
  }
  .nav-dropdown.active {
    grid-template-rows: 1fr;
  }

  .nav-dropdown-inner {
    min-height: 0;
    overflow: hidden;
    padding: 0 20px;
    transition: padding 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-dropdown.active .nav-dropdown-inner {
    padding: 24px 20px 40px;
  }

  /* ── 3×2 grid ── */
  .nav-dropdown-grid {
    max-width: 1380px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 20px 48px;
  }
  .nav-dropdown-grid-sm {
    grid-template-columns: 1fr 1fr;
    max-width: 700px;
  }

  .nav-dd-item {
    text-decoration: none;
    padding: 16px;
    border-radius: 12px;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                background 0.15s ease;
  }
  .nav-dd-item:nth-child(1) { transition-delay: 0.02s; }
  .nav-dd-item:nth-child(2) { transition-delay: 0.05s; }
  .nav-dd-item:nth-child(3) { transition-delay: 0.08s; }
  .nav-dd-item:nth-child(4) { transition-delay: 0.11s; }
  .nav-dd-item:nth-child(5) { transition-delay: 0.14s; }
  .nav-dd-item:nth-child(6) { transition-delay: 0.17s; }

  .nav-dropdown.active .nav-dd-item {
    opacity: 1;
    transform: translateY(0);
  }

  .nav-dd-item:hover {
    background: rgba(237, 233, 227, 0.06);
  }

  .nav-dd-item h4 {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #ede9e3;
    margin: 0 0 6px;
  }
  .nav-dd-item p {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.5;
    margin: 0;
  }

  /* ── Right: Log in ── */
  .nav-actions { display: flex; align-items: center; }
  .nav-btn {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #14120b;
    background: #ede9e3;
    border-radius: 8px;
    padding: 8px 18px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .nav-btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(237, 233, 227, 0.15);
  }

  /* ── Hamburger button — only visible on mobile ── */
  .nav-hamburger {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    /* 44px minimum touch target for iOS */
    width: 44px;
    height: 44px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    padding: 0;
    margin-left: 4px;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .nav-ham-line {
    display: block;
    width: 18px;
    height: 1.5px;
    background: #ede9e3;
    border-radius: 1px;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
                opacity 0.2s ease;
  }
  /* X state when open */
  .nav-hamburger.open .nav-ham-line:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }
  .nav-hamburger.open .nav-ham-line:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* ── Mobile sidebar backdrop ── */
  .nav-sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 998;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    transition: opacity 0.3s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-sidebar-backdrop.open {
    opacity: 1;
  }

  /* ── Mobile sidebar panel ── */
  .nav-sidebar {
    display: none;
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 999;
    width: 240px;
    max-width: 70vw;
    background: #1e1d1b;
    border-left: 1px solid rgba(237, 233, 227, 0.06);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior: contain;
    flex-direction: column;
  }
  .nav-sidebar.open {
    transform: translateX(0);
  }

  .nav-sidebar-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 48px;
    padding: env(safe-area-inset-top) 12px 0;
    flex-shrink: 0;
  }
  .nav-sidebar-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    color: rgba(237, 233, 227, 0.5);
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    transition: color 0.2s ease;
  }
  .nav-sidebar-close:hover { color: #ede9e3; }

  .nav-sidebar-links {
    display: flex;
    flex-direction: column;
    padding: 0 20px;
  }

  /* Section label — Jersey 10 for brand personality */
  .nav-sidebar-label {
    font-family: 'Jersey 10', cursive;
    font-size: 16px;
    letter-spacing: 0.5px;
    color: rgba(237, 233, 227, 0.25);
    padding-bottom: 14px;
    border-bottom: 1px dotted rgba(237, 233, 227, 0.08);
    margin-bottom: 4px;
  }

  /* Feature links — staggered transition on open, tactile tap feedback */
  .nav-sidebar-link {
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: -0.1px;
    color: rgba(237, 233, 227, 0.55);
    text-decoration: none;
    padding: 11px 0;
    border-bottom: 1px solid rgba(237, 233, 227, 0.04);
    -webkit-tap-highlight-color: transparent;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease, color 0.2s ease;
  }
  .nav-sidebar-link:last-child { border-bottom: none; }
  .nav-sidebar-link:active {
    color: rgba(237, 233, 227, 0.9);
  }

  /* Stagger — triggers only when sidebar is open */
  .nav-sidebar.open .nav-sidebar-link {
    opacity: 1;
    transform: translateY(0);
  }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(1) { transition-delay: 60ms; }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(2) { transition-delay: 100ms; }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(3) { transition-delay: 140ms; }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(4) { transition-delay: 180ms; }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(5) { transition-delay: 220ms; }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(6) { transition-delay: 260ms; }
  .nav-sidebar.open .nav-sidebar-link:nth-of-type(7) { transition-delay: 320ms; }

  /* Pricing — elevated standalone link */
  .nav-sidebar-link--spaced {
    margin-top: 20px;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.3px;
    color: rgba(237, 233, 227, 0.8);
    border-bottom: none;
  }

  .nav-sidebar-footer {
    padding: 12px 20px calc(28px + env(safe-area-inset-bottom));
    margin-top: auto;
  }
  .nav-sidebar-cta {
    display: block;
    text-align: center;
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 500;
    color: #14120b;
    background: #ede9e3;
    border-radius: 4px;
    padding: 11px 20px;
    text-decoration: none;
    transition: background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .nav-sidebar-cta:hover { background: #d7d3cd; }

  /* ── Mobile breakpoints ── */
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .nav-dropdown { display: none; }
    .nav-hamburger { display: flex; }
    .nav-sidebar { display: flex; }
    .nav-sidebar-backdrop { display: block; pointer-events: none; }
    .nav-sidebar-backdrop.open { pointer-events: auto; }
  }
  @media (max-width: 400px) {
    .nav-wordmark { font-size: 22px; white-space: nowrap; }
    .nav-logo { width: 22px; height: 22px; }
    .nav-btn { padding: 10px 16px; font-size: 12px; }
  }


  @media (prefers-reduced-motion: reduce) {
    .nav-dropdown, .nav-dd-item, .nav-chevron, .nav-dropdown-inner,
    .nav-sidebar, .nav-sidebar-backdrop { transition: none; }
    .nav-sidebar-link { transition: none; opacity: 1; transform: none; }
  }

</style>

<script>
  const nav = document.getElementById('main-nav');
  const triggers = document.querySelectorAll('[data-dropdown-wrap]') as NodeListOf<HTMLElement>;
  const panels = document.querySelectorAll('[data-dropdown-panel]') as NodeListOf<HTMLElement>;

  // ── Dropdown hover toggle — supports multiple triggers + panels ──
  if (nav && triggers.length && panels.length) {
    let closeTimeout: ReturnType<typeof setTimeout> | null = null;
    let activePanel: HTMLElement | null = null;

    function updateAriaExpanded() {
      triggers.forEach((trigger, i) => {
        const btn = trigger.querySelector('.nav-link-trigger');
        const panel = document.querySelector(`[data-dropdown-panel="${panelMap[i]}"]`);
        if (btn && panel) {
          btn.setAttribute('aria-expanded', String(panel.classList.contains('active')));
        }
      });
    }

    function openDropdown(panel: HTMLElement) {
      if (closeTimeout) { clearTimeout(closeTimeout); closeTimeout = null; }
      panels.forEach(p => { if (p !== panel) p.classList.remove('active'); });
      panel.classList.add('active');
      activePanel = panel;
      nav!.classList.add('dropdown-open');
      updateAriaExpanded();
    }

    function closeDropdown() {
      closeTimeout = setTimeout(() => {
        panels.forEach(p => p.classList.remove('active'));
        nav!.classList.remove('dropdown-open');
        activePanel = null;
        updateAriaExpanded();
      }, 80);
    }

    function cancelClose() {
      if (closeTimeout) { clearTimeout(closeTimeout); closeTimeout = null; }
    }

    // Map triggers to panels by index (Features=0)
    const panelMap = ['features', 'resources'];
    triggers.forEach((trigger, i) => {
      const panel = document.querySelector(`[data-dropdown-panel="${panelMap[i]}"]`) as HTMLElement;
      if (!panel) return;

      trigger.addEventListener('mouseenter', () => openDropdown(panel));
      trigger.addEventListener('mouseleave', closeDropdown);
      panel.addEventListener('mouseenter', cancelClose);
      panel.addEventListener('mouseleave', closeDropdown);

      // Keyboard: toggle on Enter/Space, close on Escape
      const btn = trigger.querySelector('.nav-link-trigger') as HTMLElement;
      if (btn) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          if (panel.classList.contains('active')) {
            closeDropdown();
          } else {
            openDropdown(panel);
          }
        });
        btn.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Escape') {
            closeDropdown();
            btn.focus();
          }
        });
      }
    });

    // Global Escape closes any open dropdown
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && activePanel) {
        panels.forEach(p => p.classList.remove('active'));
        nav!.classList.remove('dropdown-open');
        activePanel = null;
      }
    });
  }

  // ── Scroll behavior ──
  // Best practices: background from scrollY > 0 (no naked floating state),
  // direction delta threshold (60px of continuous downward scroll to hide),
  // instant show on any upward scroll, debounced hide.
  let lastScrollY = 0;
  let scrollDelta = 0;
  let ticking = false;
  const HIDE_DELTA = 60; // px of continuous down-scroll before hiding

  function updateNav() {
    // Skip scroll handling while sidebar is open — body is position:fixed
    // so scrollY is 0 and would corrupt lastScrollY / remove .scrolled
    if (sidebar?.classList.contains('open')) { ticking = false; return; }

    const currentY = window.scrollY;
    const diff = currentY - lastScrollY;

    // Background: apply immediately at any scroll > 0
    nav?.classList.toggle('scrolled', currentY > 0);

    // Hide/show: accumulate directional delta, reset on direction change
    if (diff > 0) {
      // Scrolling down — accumulate
      scrollDelta += diff;
      if (scrollDelta > HIDE_DELTA && currentY > 80) {
        nav?.classList.add('hidden');
      }
    } else {
      // Scrolling up — show immediately, reset delta
      scrollDelta = 0;
      nav?.classList.remove('hidden');
    }

    lastScrollY = currentY;
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(updateNav);
      ticking = true;
    }
  }, { passive: true });

  // ── Mobile sidebar menu ──
  const hamburger = document.getElementById('nav-hamburger');
  const sidebar = document.getElementById('nav-sidebar');
  const backdrop = document.getElementById('nav-sidebar-backdrop');
  const sidebarClose = document.getElementById('nav-sidebar-close');

  // Focus trap: keep Tab cycling inside sidebar
  function trapFocus(e: KeyboardEvent) {
    if (e.key !== 'Tab' || !sidebar) return;
    const focusable = sidebar.querySelectorAll<HTMLElement>('a, button, [tabindex]');
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault(); last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault(); first.focus();
    }
  }

  function openSidebar() {
    if (!hamburger || !sidebar || !backdrop) return;
    hamburger.classList.add('open');
    hamburger.setAttribute('aria-expanded', 'true');
    sidebar.classList.add('open');
    sidebar.setAttribute('aria-hidden', 'false');
    backdrop.classList.add('open');
    // iOS-safe body scroll lock
    const scrollY = window.scrollY;
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.dataset.scrollY = String(scrollY);
    // Hide navbar behind sidebar
    nav?.classList.add('hidden');
    // Focus management
    sidebarClose?.focus();
    document.addEventListener('keydown', trapFocus);
  }

  function closeSidebar() {
    if (!hamburger || !sidebar || !backdrop) return;
    hamburger.classList.remove('open');
    hamburger.setAttribute('aria-expanded', 'false');
    sidebar.classList.remove('open');
    sidebar.setAttribute('aria-hidden', 'true');
    backdrop.classList.remove('open');
    // Restore scroll position
    const scrollY = parseInt(document.body.dataset.scrollY || '0', 10);
    // Reset scroll tracking BEFORE restoring scroll so the scroll
    // listener doesn't interpret the jump as a fast downward scroll
    lastScrollY = scrollY;
    scrollDelta = 0;
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    window.scrollTo(0, scrollY);
    // Restore navbar with correct scrolled state
    nav?.classList.remove('hidden');
    nav?.classList.toggle('scrolled', scrollY > 0);
    // Return focus
    document.removeEventListener('keydown', trapFocus);
    hamburger?.focus();
  }

  if (hamburger && sidebar && backdrop) {
    // Toggle on hamburger tap
    hamburger.addEventListener('click', () => {
      if (sidebar.classList.contains('open')) {
        closeSidebar();
      } else {
        openSidebar();
      }
    });

    // Close on backdrop tap
    backdrop.addEventListener('click', closeSidebar);

    // Close on X button
    if (sidebarClose) {
      sidebarClose.addEventListener('click', closeSidebar);
    }

    // Close on link click
    sidebar.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeSidebar);
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && sidebar.classList.contains('open')) {
        closeSidebar();
      }
    });

    // Close if viewport crosses breakpoint (e.g. orientation change)
    window.addEventListener('resize', () => {
      if (window.innerWidth > 768 && sidebar.classList.contains('open')) {
        closeSidebar();
      }
    });
  }
</script>
