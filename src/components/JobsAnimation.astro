---
// Repeat from any surface — Slack, Web, API, Trigger
---

<div class="rp-wrap">
  <img src="/images/cookbook-bg.png" alt="" class="rp-bg" />

  <div class="rp-window">
    <div class="rp-chrome">
      <div class="rp-dots">
        <span style="background:#e8655a;"></span>
        <span style="background:#e8c15a;"></span>
        <span style="background:#67c96c;"></span>
      </div>
    </div>

    <div class="rp-body" id="rp-body">

      <!-- Pill strip -->
      <div class="rp-pills">
        <div class="rp-pill-track" id="rp-indicator"></div>
        <button class="rp-pill" data-rp="0">Slack</button>
        <button class="rp-pill" data-rp="1">Web</button>
        <button class="rp-pill" data-rp="2">API</button>
        <button class="rp-pill" data-rp="3">Trigger</button>
      </div>

      <!-- Content area -->
      <div class="rp-content">

        <!-- 0: Slack -->
        <div class="rp-panel" data-panel="0">
          <div class="rp-slack">
            <div class="rp-sl-header"><span class="rp-sl-hash">&num;</span> revenue-ops</div>
            <div class="rp-sl-msg rp-sl-user">
              <div class="rp-sl-av">LK</div>
              <div class="rp-sl-body">
                <div class="rp-sl-meta"><span class="rp-sl-name">Likith</span><span class="rp-sl-time">2:34 PM</span></div>
                <div class="rp-sl-text"><span class="rp-sl-mention">{'@'}Lewis</span> check pipeline for deals that moved backwards this week</div>
              </div>
            </div>
            <div class="rp-sl-msg rp-sl-typing" id="rp-typing">
              <div class="rp-sl-av rp-sl-av-bot"><img src="/images/eluu-logo.svg" alt="" width="20" height="20" style="border-radius:4px;" /></div>
              <div class="rp-sl-body">
                <div class="rp-sl-typing-bar"><span class="rp-sl-typing-name">Lewis</span><span class="rp-sl-typing-label">is typing</span><span class="rp-sl-typing-dots"><i></i><i></i><i></i></span></div>
              </div>
            </div>
            <div class="rp-sl-msg rp-sl-bot" id="rp-sl-reply">
              <div class="rp-sl-av rp-sl-av-bot"><img src="/images/eluu-logo.svg" alt="" width="20" height="20" style="border-radius:4px;" /></div>
              <div class="rp-sl-body">
                <div class="rp-sl-meta"><span class="rp-sl-name">Lewis</span><span class="rp-sl-app">APP</span><span class="rp-sl-time">2:34 PM</span></div>
                <div class="rp-sl-text">Found 3 deals that regressed. Acme Corp ($45K) — no activity 12 days. Flagged in Pipeline Health.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 1: Web -->
        <div class="rp-panel" data-panel="1">
          <div class="rp-web">
            <div class="rp-web-bubble rp-web-user">Run the weekly revenue report and send to #leadership</div>
            <div class="rp-web-reply" id="rp-web-reply">
              <div class="rp-web-av"><img src="/images/eluu-logo.svg" alt="" width="20" height="20" style="border-radius:4px;" /></div>
              <div class="rp-web-body">
                <div class="rp-web-meta"><span class="rp-web-name">Lewis</span></div>
                <div class="rp-web-text">Revenue report generated. $1.2M pipeline, 47 deals active, 3 at-risk. Posted to #leadership with executive summary.</div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2: API -->
        <div class="rp-panel" data-panel="2">
          <div class="rp-api">
            <div class="rp-api-block" id="rp-api-req">
              <pre class="rp-api-code" id="rp-api-pre"></pre>
            </div>
          </div>
        </div>

        <!-- 3: Trigger -->
        <div class="rp-panel" data-panel="3">
          <div class="rp-trigger">
            <div class="rp-tr-email" id="rp-tr-email">
              <div class="rp-tr-email-icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div class="rp-tr-email-body">
                <span class="rp-tr-from">john@acme.com</span>
                <span class="rp-tr-subj">Re: <mark class="rp-tr-kw">proposal</mark> for Q3 expansion</span>
              </div>
              <span class="rp-tr-pill" id="rp-tr-pill">Keyword matched</span>
            </div>
            <div class="rp-tr-card" id="rp-tr-card">
              <div class="rp-tr-card-row">
                <div class="rp-tr-card-info">
                  <span class="rp-tr-card-title">Extract deal details & update CRM</span>
                  <span class="rp-tr-card-sub">Sales colleague &middot; Triggered</span>
                </div>
                <div class="rp-tr-badge" id="rp-tr-badge">
                  <span class="rp-tr-badge-dot"></span>
                  <span class="rp-tr-badge-text">Running...</span>
                </div>
              </div>
              <div class="rp-tr-output" id="rp-tr-output">Contact added to HubSpot, deal $85K, follow-up Thursday</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  .rp-wrap {
    position: absolute; inset: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    padding: 24px; box-sizing: border-box;
  }
  .rp-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; }
  .rp-window {
    position: relative; z-index: 1; width: 100%; max-width: 460px; height: 340px;
    background: rgba(250, 249, 244, 0.95);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.1);
    overflow: hidden; font-family: 'Inter', sans-serif;
    display: flex; flex-direction: column;
  }
  .rp-chrome {
    display: flex; align-items: center; padding: 10px 14px;
    border-bottom: 1px solid rgba(0,0,0,0.06); flex-shrink: 0;
  }
  .rp-dots { display: flex; gap: 6px; }
  .rp-dots > span { width: 10px; height: 10px; border-radius: 50%; }

  .rp-body { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

  /* ── Pills ── */
  .rp-pills {
    display: flex; gap: 4px; padding: 10px 14px 8px;
    flex-shrink: 0; position: relative;
  }
  .rp-pill {
    position: relative; z-index: 1;
    font-family: 'Inter', sans-serif; font-size: 11px; font-weight: 600;
    color: #a3a3a3; background: none; border: none; cursor: default;
    padding: 5px 14px; border-radius: 6px;
    transition: color 0.4s ease;
  }
  .rp-pill.active { color: #17100e; }
  .rp-pill-track {
    position: absolute; height: 28px; border-radius: 6px;
    background: rgba(23, 16, 14, 0.06);
    transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1), width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 0;
  }

  /* ── Content ── */
  .rp-content { flex: 1; position: relative; overflow: hidden; }
  .rp-panel {
    position: absolute; top: 0; left: 0; right: 0; padding: 10px 14px;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    pointer-events: none;
  }
  .rp-panel.active { opacity: 1; transform: translateY(0); pointer-events: auto; }

  /* ── Slack ── */
  .rp-slack { display: flex; flex-direction: column; gap: 0; }
  .rp-sl-header {
    font-size: 12px; font-weight: 600; color: #17100e;
    padding: 0 0 8px; border-bottom: 1px solid rgba(0,0,0,0.05); margin-bottom: 8px;
  }
  .rp-sl-hash { color: #a3a3a3; font-weight: 500; }
  .rp-sl-msg { display: flex; gap: 8px; margin-bottom: 10px; opacity: 0; transform: translateY(6px); }
  .rp-sl-av {
    width: 28px; height: 28px; border-radius: 5px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
    background: #343636; color: #f4f3ec; font-size: 9px; font-weight: 700;
  }
  .rp-sl-av-bot { background: transparent; }
  .rp-sl-body { flex: 1; min-width: 0; }
  .rp-sl-meta { display: flex; align-items: center; gap: 5px; margin-bottom: 3px; }
  .rp-sl-name { font-size: 12px; font-weight: 600; color: #17100e; }
  .rp-sl-app { font-size: 8px; font-weight: 700; color: #7d7d7d; background: rgba(0,0,0,0.05); padding: 1px 4px; border-radius: 3px; letter-spacing: 0.4px; }
  .rp-sl-time { font-size: 10px; color: #a3a3a3; }
  .rp-sl-text { font-size: 12px; color: #343636; line-height: 1.5; }
  .rp-sl-mention { color: #5e6ad2; font-weight: 500; }
  .rp-sl-typing { display: none; }
  .rp-sl-typing-bar { display: flex; align-items: center; gap: 4px; font-size: 11px; padding: 3px 0; }
  .rp-sl-typing-name { font-weight: 600; color: #17100e; }
  .rp-sl-typing-label { color: #a3a3a3; }
  .rp-sl-typing-dots { display: inline-flex; gap: 2px; margin-left: 2px; }
  .rp-sl-typing-dots i { display: block; width: 4px; height: 4px; border-radius: 50%; background: #a3a3a3; }

  /* ── Web ── */
  .rp-web { display: flex; flex-direction: column; gap: 12px; }
  .rp-web-bubble {
    align-self: flex-end; max-width: 80%;
    font-size: 12px; color: #fff; background: #343636;
    padding: 8px 12px; border-radius: 14px 14px 4px 14px;
    line-height: 1.45; opacity: 0; transform: translateY(6px);
  }
  .rp-web-reply {
    display: flex; gap: 8px; align-items: flex-start;
    opacity: 0; transform: translateY(6px);
  }
  .rp-web-av { width: 28px; height: 28px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
  .rp-web-body { flex: 1; min-width: 0; }
  .rp-web-meta { margin-bottom: 3px; }
  .rp-web-name { font-size: 12px; font-weight: 600; color: #17100e; }
  .rp-web-text { font-size: 12px; color: #5c5c5c; line-height: 1.5; }

  /* ── API ── */
  .rp-api { display: flex; flex-direction: column; }
  .rp-api-block {
    border-radius: 10px; overflow: hidden;
    opacity: 0; transform: translateY(6px);
  }
  .rp-api-code {
    font-family: 'SF Mono', 'Fira Code', 'Consolas', monospace;
    font-size: 11px; line-height: 1.55;
    color: #d4d4d4; background: #1a1a1a;
    padding: 14px 16px; margin: 0;
    white-space: pre; overflow-x: auto;
  }
  .rp-api-comment { color: #6a9955; }
  .rp-api-method { color: #569cd6; font-weight: 700; }
  .rp-api-url { color: #9cdcfe; }
  .rp-api-key { color: #9cdcfe; }
  .rp-api-str { color: #ce9178; }
  .rp-api-num { color: #b5cea8; }
  .rp-api-status { color: #34a853; font-weight: 600; }

  /* ── Trigger ── */
  .rp-trigger { display: flex; flex-direction: column; gap: 10px; position: relative; }
  .rp-tr-email {
    display: flex; align-items: flex-start; gap: 10px;
    background: #ffffff; border-radius: 10px; padding: 10px 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    position: relative;
    opacity: 0; transform: translateY(6px);
  }
  .rp-tr-email-icon {
    width: 28px; height: 28px; border-radius: 6px; background: rgba(0,0,0,0.04);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0; color: #7d7d7d;
  }
  .rp-tr-email-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .rp-tr-from { font-size: 12px; font-weight: 600; color: #17100e; }
  .rp-tr-subj { font-size: 11.5px; color: #5c5c5c; line-height: 1.4; }
  .rp-tr-kw {
    background: transparent; color: inherit; padding: 0 2px; border-radius: 3px;
    transition: all 0.4s ease;
  }
  .rp-tr-kw.glow { background: rgba(192,57,43,0.12); color: #c0392b; font-weight: 600; }
  .rp-tr-pill {
    position: absolute; top: -6px; right: 14px;
    font-size: 9px; font-weight: 700; color: #c0392b;
    background: rgba(192,57,43,0.08); border: 1px solid rgba(192,57,43,0.15);
    padding: 2px 7px; border-radius: 4px; letter-spacing: 0.2px; text-transform: uppercase;
    opacity: 0; transform: scale(0.9);
  }
  .rp-tr-card {
    position: absolute; top: 0; left: 0; right: 0;
    background: #ffffff; border-radius: 10px; padding: 12px 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    opacity: 0; transform: translateY(6px);
  }
  .rp-tr-card-row { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .rp-tr-card-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .rp-tr-card-title { font-size: 13px; font-weight: 600; color: #17100e; line-height: 1.3; }
  .rp-tr-card-sub { font-size: 11px; color: #a3a3a3; font-weight: 500; }
  .rp-tr-badge {
    display: flex; align-items: center; gap: 5px; flex-shrink: 0;
    padding: 3px 8px; border-radius: 6px; background: rgba(0,0,0,0.04);
    transition: background 0.3s ease;
  }
  .rp-tr-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #e8a838; animation: rp-blink 0.8s ease infinite; }
  @keyframes rp-blink { 0%,100% { opacity:1; } 50% { opacity:0.3; } }
  .rp-tr-badge.done .rp-tr-badge-dot { background: #34a853; animation: none; }
  .rp-tr-badge-text { font-size: 11px; font-weight: 600; color: #7d7d7d; white-space: nowrap; }
  .rp-tr-badge.done .rp-tr-badge-text { color: #34a853; }
  .rp-tr-output {
    font-size: 12px; color: #5c5c5c; line-height: 1.5; margin-top: 10px;
    padding: 6px 10px; background: rgba(94,106,210,0.06); border-radius: 6px;
    opacity: 0; transform: translateY(4px);
  }

  /* ── Typing bounce ── */
  @keyframes rp-bounce { 0%,60%,100% { transform:translateY(0); opacity:0.4; } 30% { transform:translateY(-3px); opacity:1; } }
</style>

<script>
(function() {
  const body = document.getElementById('rp-body');
  if (!body) return;

  const pills = body.querySelectorAll('.rp-pill') as NodeListOf<HTMLElement>;
  const panels = body.querySelectorAll('.rp-panel') as NodeListOf<HTMLElement>;
  const indicator = document.getElementById('rp-indicator') as HTMLElement;

  const EASE = 'all 400ms cubic-bezier(0.16, 1, 0.3, 1)';
  const FADE = 'all 350ms cubic-bezier(0.4, 0, 0.2, 1)';

  function sleep(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  function show(el: HTMLElement, t?: string) {
    el.style.transition = t || EASE;
    el.style.opacity = '1';
    el.style.transform = 'translateY(0) scale(1)';
  }
  function hide(el: HTMLElement) {
    el.style.transition = FADE;
    el.style.opacity = '0';
    el.style.transform = 'translateY(6px)';
  }

  // Populate API code block via JS to avoid Astro template parsing issues
  const apiPre = document.getElementById('rp-api-pre');
  if (apiPre) {
    apiPre.innerHTML = '<span class="rp-api-comment">// Send a task via API</span>\n<span class="rp-api-method">POST</span> <span class="rp-api-url">/v1/tasks</span>\n\n{\n  <span class="rp-api-key">"colleague"</span>: <span class="rp-api-str">"lewis"</span>,\n  <span class="rp-api-key">"task"</span>: <span class="rp-api-str">"enrich new leads"</span>,\n  <span class="rp-api-key">"tools"</span>: [<span class="rp-api-str">"hubspot"</span>, <span class="rp-api-str">"sheets"</span>]\n}\n\n<span class="rp-api-comment">// Response</span>\n<span class="rp-api-status">200 OK</span>\n{\n  <span class="rp-api-key">"status"</span>: <span class="rp-api-str">"complete"</span>,\n  <span class="rp-api-key">"enriched"</span>: <span class="rp-api-num">47</span>,\n  <span class="rp-api-key">"updated"</span>: <span class="rp-api-str">"pipeline-tracker"</span>\n}';
  }

  function activatePill(idx: number) {
    pills.forEach((p, i) => p.classList.toggle('active', i === idx));
    // Slide indicator
    const pill = pills[idx];
    indicator.style.left = pill.offsetLeft + 'px';
    indicator.style.width = pill.offsetWidth + 'px';
    indicator.style.top = pill.offsetTop + 'px';
  }

  function showPanel(idx: number) {
    panels.forEach((p, i) => {
      if (i === idx) { p.classList.add('active'); }
      else { p.classList.remove('active'); }
    });
  }

  function resetElements(panel: HTMLElement) {
    panel.querySelectorAll('.rp-sl-msg, .rp-web-bubble, .rp-web-reply, .rp-api-block, .rp-tr-email, .rp-tr-card').forEach((el) => {
      const e = el as HTMLElement;
      e.style.transition = 'none'; e.style.opacity = '0'; e.style.transform = 'translateY(6px)';
    });
    const typing = panel.querySelector('.rp-sl-typing') as HTMLElement;
    if (typing) { typing.style.display = 'none'; typing.style.opacity = '0'; }
    const reply = panel.querySelector('#rp-sl-reply') as HTMLElement;
    if (reply) { reply.style.opacity = '0'; reply.style.transform = 'translateY(6px)'; }
    const trPill = panel.querySelector('.rp-tr-pill') as HTMLElement;
    if (trPill) { trPill.style.opacity = '0'; trPill.style.transform = 'scale(0.9)'; }
    const trOutput = panel.querySelector('.rp-tr-output') as HTMLElement;
    if (trOutput) { trOutput.style.opacity = '0'; trOutput.style.transform = 'translateY(4px)'; }
    const kw = panel.querySelector('.rp-tr-kw') as HTMLElement;
    if (kw) kw.classList.remove('glow');
    const badge = panel.querySelector('.rp-tr-badge') as HTMLElement;
    if (badge) { badge.classList.remove('done'); const t = badge.querySelector('.rp-tr-badge-text') as HTMLElement; if(t) t.textContent = 'Running...'; }
    void body!.offsetHeight;
  }

  // ── Slack animation ──
  async function animateSlack(panel: HTMLElement) {
    const userMsg = panel.querySelector('.rp-sl-user') as HTMLElement;
    const typing = panel.querySelector('.rp-sl-typing') as HTMLElement;
    const reply = panel.querySelector('#rp-sl-reply') as HTMLElement;
    const dots = panel.querySelectorAll('.rp-sl-typing-dots i') as NodeListOf<HTMLElement>;

    show(userMsg);
    await sleep(800);

    typing.style.display = 'flex';
    void typing.offsetHeight;
    show(typing);
    dots.forEach((d, i) => { d.style.animation = `rp-bounce 0.6s ease ${i * 0.15}s infinite`; });
    await sleep(1400);

    typing.style.transition = FADE; typing.style.opacity = '0';
    await sleep(200);
    typing.style.display = 'none';
    dots.forEach(d => { d.style.animation = 'none'; });

    show(reply);
    await sleep(3000);
  }

  // ── Web animation ──
  async function animateWeb(panel: HTMLElement) {
    const bubble = panel.querySelector('.rp-web-bubble') as HTMLElement;
    const reply = panel.querySelector('.rp-web-reply') as HTMLElement;

    show(bubble);
    await sleep(900);
    show(reply);
    await sleep(3500);
  }

  // ── API animation ──
  async function animateApi(panel: HTMLElement) {
    const block = panel.querySelector('#rp-api-req') as HTMLElement;
    show(block);
    await sleep(4500);
  }

  // ── Trigger animation ──
  async function animateTrigger(panel: HTMLElement) {
    const email = panel.querySelector('.rp-tr-email') as HTMLElement;
    const kw = panel.querySelector('.rp-tr-kw') as HTMLElement;
    const pill = panel.querySelector('.rp-tr-pill') as HTMLElement;
    const card = panel.querySelector('.rp-tr-card') as HTMLElement;
    const badge = panel.querySelector('.rp-tr-badge') as HTMLElement;
    const output = panel.querySelector('.rp-tr-output') as HTMLElement;

    show(email);
    await sleep(600);
    kw.classList.add('glow');
    await sleep(400);
    pill.style.transition = 'all 300ms cubic-bezier(0.16, 1, 0.3, 1)';
    pill.style.opacity = '1'; pill.style.transform = 'scale(1)';
    await sleep(1000);

    hide(email);
    pill.style.transition = FADE; pill.style.opacity = '0';
    kw.classList.remove('glow');
    await sleep(400);

    show(card);
    await sleep(1400);

    badge.classList.add('done');
    const badgeText = badge.querySelector('.rp-tr-badge-text') as HTMLElement;
    if (badgeText) badgeText.textContent = 'Complete';
    await sleep(300);
    show(output);
    await sleep(2000);
  }

  const animators = [animateSlack, animateWeb, animateApi, animateTrigger];

  async function run() {
    // Init indicator
    activatePill(0);

    while (true) {
      for (let i = 0; i < 4; i++) {
        activatePill(i);
        resetElements(panels[i]);
        showPanel(i);
        await sleep(300);
        await animators[i](panels[i]);
      }
    }
  }

  const io = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) { io.disconnect(); run(); }
  }, { threshold: 0.3 });
  io.observe(body);
})();
</script>
