---
// Jobs animation — scheduled and event-based triggers with task execution
---

<div class="jb-wrap">
  <img src="/images/cookbook-bg.png" alt="" class="jb-bg" />

  <div class="jb-window">
    <div class="jb-chrome">
      <div class="jb-dots">
        <span style="background:#e8655a;"></span>
        <span style="background:#e8c15a;"></span>
        <span style="background:#67c96c;"></span>
      </div>
      <div class="jb-chrome-right">
        <span class="jb-label">Jobs</span>
      </div>
    </div>

    <div class="jb-body" id="jb-body">

      <!-- Timeline strip — always visible -->
      <div class="jb-timeline">
        <div class="jb-day" data-day="mon">
          <span class="jb-day-label">Mon</span>
          <span class="jb-day-dot"></span>
          <span class="jb-day-time">6:00 AM</span>
        </div>
        <div class="jb-day" data-day="tue">
          <span class="jb-day-label">Tue</span>
          <span class="jb-day-dot"></span>
          <span class="jb-day-time"></span>
        </div>
        <div class="jb-day" data-day="wed">
          <span class="jb-day-label">Wed</span>
          <span class="jb-day-dot"></span>
          <span class="jb-day-time">6:00 AM</span>
        </div>
        <div class="jb-day" data-day="thu">
          <span class="jb-day-label">Thu</span>
          <span class="jb-day-dot"></span>
          <span class="jb-day-time"></span>
        </div>
        <div class="jb-day" data-day="fri">
          <span class="jb-day-label">Fri</span>
          <span class="jb-day-dot"></span>
          <span class="jb-day-time">6:00 AM</span>
        </div>
      </div>

      <!-- Content area — cards stack here -->
      <div class="jb-content">

        <!-- Scheduled task card -->
        <div class="jb-card" id="jb-sched">
          <div class="jb-card-row">
            <div class="jb-card-info">
              <span class="jb-card-title">Daily pipeline review</span>
              <span class="jb-card-sub">Research colleague</span>
            </div>
            <div class="jb-badge" id="jb-sched-badge">
              <span class="jb-badge-dot"></span>
              <span class="jb-badge-text">Running...</span>
            </div>
          </div>
          <div class="jb-output" id="jb-sched-output">47 deals reviewed, 3 flagged at-risk → pushed to #sales</div>
        </div>

        <!-- Email notification -->
        <div class="jb-email" id="jb-email">
          <div class="jb-email-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div class="jb-email-text">
            <span class="jb-email-from">john@acme.com</span>
            <span class="jb-email-subj">Re: <mark class="jb-kw">proposal</mark> for Q3 expansion</span>
          </div>
          <span class="jb-kw-pill" id="jb-kw-pill">Keyword matched</span>
        </div>

        <!-- Event task card -->
        <div class="jb-card" id="jb-event">
          <div class="jb-card-row">
            <div class="jb-card-info">
              <span class="jb-card-title">Extract deal details & update CRM</span>
              <span class="jb-card-sub">Sales colleague &middot; Triggered</span>
            </div>
            <div class="jb-badge" id="jb-event-badge">
              <span class="jb-badge-dot"></span>
              <span class="jb-badge-text">Running...</span>
            </div>
          </div>
          <div class="jb-output" id="jb-event-output">Contact added to HubSpot, deal $85K, follow-up Thursday</div>
        </div>

      </div>
    </div>
  </div>
</div>

<style>
  .jb-wrap {
    position: absolute; inset: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    padding: 24px; box-sizing: border-box;
  }
  .jb-bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover; z-index: 0;
  }
  .jb-window {
    position: relative; z-index: 1;
    width: 100%; max-width: 400px; height: 320px;
    background: rgba(250, 249, 244, 0.95);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.1);
    overflow: hidden; font-family: 'Inter', sans-serif;
    display: flex; flex-direction: column;
  }
  .jb-chrome {
    display: flex; align-items: center; justify-content: space-between;
    padding: 10px 14px; border-bottom: 1px solid rgba(0,0,0,0.06); flex-shrink: 0;
  }
  .jb-dots { display: flex; gap: 6px; }
  .jb-dots > span { width: 10px; height: 10px; border-radius: 50%; }
  .jb-label { font-size: 13px; font-weight: 600; color: #17100e; }

  .jb-body {
    flex: 1; padding: 14px 16px;
    display: flex; flex-direction: column; gap: 14px; overflow: hidden;
  }

  /* ── Timeline ── */
  .jb-timeline {
    display: flex; justify-content: space-between;
    padding: 8px 4px 4px; flex-shrink: 0;
  }
  .jb-day {
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    flex: 1; position: relative;
  }
  .jb-day-label {
    font-size: 10px; font-weight: 600; color: #b0afa8;
    text-transform: uppercase; letter-spacing: 0.3px;
    transition: color 0.3s ease;
  }
  .jb-day-dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: #d4d3cb; transition: all 0.4s ease;
  }
  .jb-day-time {
    font-size: 9px; font-weight: 600; color: transparent;
    letter-spacing: 0.2px; height: 12px;
    transition: color 0.3s ease;
  }

  /* Active day — soft warm red */
  .jb-day.active .jb-day-label { color: #c0392b; }
  .jb-day.active .jb-day-dot {
    background: #c0392b;
    box-shadow: 0 0 0 4px rgba(192, 57, 43, 0.15);
    animation: jb-pulse 1.2s ease infinite;
  }
  .jb-day.active .jb-day-time { color: #c0392b; }

  @keyframes jb-pulse {
    0%, 100% { box-shadow: 0 0 0 4px rgba(192, 57, 43, 0.15); }
    50% { box-shadow: 0 0 0 7px rgba(192, 57, 43, 0.06); }
  }

  /* ── Content area ── */
  .jb-content {
    flex: 1; position: relative;
  }

  /* ── Task card ── */
  .jb-card {
    position: absolute; top: 0; left: 0; right: 0;
    background: #ffffff; border-radius: 10px;
    padding: 12px 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    opacity: 0; transform: translateY(10px);
  }
  .jb-card-row {
    display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;
  }
  .jb-card-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .jb-card-title { font-size: 13px; font-weight: 600; color: #17100e; line-height: 1.3; }
  .jb-card-sub { font-size: 11px; color: #a3a3a3; font-weight: 500; }

  /* Badge */
  .jb-badge {
    display: flex; align-items: center; gap: 5px; flex-shrink: 0;
    padding: 3px 8px; border-radius: 6px; background: rgba(0,0,0,0.04);
    transition: background 0.3s ease;
  }
  .jb-badge-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: #e8a838;
    animation: jb-blink 0.8s ease infinite;
  }
  @keyframes jb-blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }
  .jb-badge.done .jb-badge-dot { background: #34a853; animation: none; }
  .jb-badge-text { font-size: 11px; font-weight: 600; color: #7d7d7d; white-space: nowrap; }
  .jb-badge.done .jb-badge-text { color: #34a853; }

  /* Output */
  .jb-output {
    font-size: 12px; color: #5c5c5c; line-height: 1.5;
    margin-top: 10px; padding: 6px 10px;
    background: rgba(94, 106, 210, 0.06); border-radius: 6px;
    opacity: 0; transform: translateY(4px);
  }

  /* ── Email ── */
  .jb-email {
    position: absolute; top: 0; left: 0; right: 0;
    display: flex; align-items: flex-start; gap: 10px;
    background: #ffffff; border-radius: 10px;
    padding: 12px 14px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    opacity: 0; transform: translateY(10px);
  }
  .jb-email-icon {
    width: 28px; height: 28px; border-radius: 6px;
    background: rgba(0,0,0,0.04);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; color: #7d7d7d;
  }
  .jb-email-text { display: flex; flex-direction: column; gap: 3px; min-width: 0; flex: 1; }
  .jb-email-from { font-size: 12px; font-weight: 600; color: #17100e; }
  .jb-email-subj { font-size: 11.5px; color: #5c5c5c; line-height: 1.4; }
  .jb-kw {
    background: transparent; color: inherit;
    padding: 0 2px; border-radius: 3px;
    transition: all 0.4s ease;
  }
  .jb-kw.glow {
    background: rgba(192, 57, 43, 0.12);
    color: #c0392b;
    font-weight: 600;
  }

  /* Keyword pill */
  .jb-kw-pill {
    position: absolute; top: -6px; right: 14px;
    font-size: 9px; font-weight: 700;
    color: #c0392b;
    background: rgba(192, 57, 43, 0.08);
    border: 1px solid rgba(192, 57, 43, 0.15);
    padding: 2px 7px; border-radius: 4px;
    letter-spacing: 0.2px; text-transform: uppercase;
    opacity: 0; transform: scale(0.9);
  }
</style>

<script>
(function() {
  const body = document.getElementById('jb-body');
  if (!body) return;

  const days = body.querySelectorAll('.jb-day') as NodeListOf<HTMLElement>;
  const sched = document.getElementById('jb-sched') as HTMLElement;
  const schedBadge = document.getElementById('jb-sched-badge') as HTMLElement;
  const schedOut = document.getElementById('jb-sched-output') as HTMLElement;
  const email = document.getElementById('jb-email') as HTMLElement;
  const kwPill = document.getElementById('jb-kw-pill') as HTMLElement;
  const kw = body.querySelector('.jb-kw') as HTMLElement;
  const evt = document.getElementById('jb-event') as HTMLElement;
  const evtBadge = document.getElementById('jb-event-badge') as HTMLElement;
  const evtOut = document.getElementById('jb-event-output') as HTMLElement;

  const EASE = 'all 400ms cubic-bezier(0.16, 1, 0.3, 1)';
  const FADE = 'all 350ms cubic-bezier(0.4, 0, 0.2, 1)';

  function show(el: HTMLElement, t?: string) {
    el.style.transition = t || EASE;
    el.style.opacity = '1';
    el.style.transform = 'translateY(0) scale(1)';
  }
  function hide(el: HTMLElement) {
    el.style.transition = FADE;
    el.style.opacity = '0';
    el.style.transform = 'translateY(-6px)';
  }
  function sleep(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  function setDone(badge: HTMLElement) {
    badge.classList.add('done');
    const t = badge.querySelector('.jb-badge-text') as HTMLElement;
    if (t) t.textContent = 'Complete';
  }

  function reset() {
    days.forEach(d => d.classList.remove('active'));

    [sched, evt, email].forEach(el => {
      el.style.transition = 'none'; el.style.opacity = '0';
      el.style.transform = 'translateY(10px)';
    });
    [schedOut, evtOut].forEach(el => {
      el.style.transition = 'none'; el.style.opacity = '0';
      el.style.transform = 'translateY(4px)';
    });
    kwPill.style.transition = 'none';
    kwPill.style.opacity = '0';
    kwPill.style.transform = 'scale(0.9)';
    kw.classList.remove('glow');
    [schedBadge, evtBadge].forEach(b => {
      b.classList.remove('done');
      const t = b.querySelector('.jb-badge-text') as HTMLElement;
      if (t) t.textContent = 'Running...';
    });
    void body!.offsetHeight;
  }

  async function run() {
    while (true) {
      reset();
      await sleep(600);

      // ═══ Beat 1: Scheduled ═══
      const wed = body!.querySelector('[data-day="wed"]') as HTMLElement;
      wed.classList.add('active');
      await sleep(900);

      show(sched);
      await sleep(1600);

      setDone(schedBadge);
      await sleep(400);

      show(schedOut);
      await sleep(2400);

      hide(sched);
      schedOut.style.transition = FADE; schedOut.style.opacity = '0';
      wed.classList.remove('active');
      await sleep(500);

      // ═══ Beat 2: Event ═══
      show(email);
      await sleep(700);

      kw.classList.add('glow');
      await sleep(500);

      kwPill.style.transition = 'all 300ms cubic-bezier(0.16, 1, 0.3, 1)';
      kwPill.style.opacity = '1';
      kwPill.style.transform = 'scale(1)';
      await sleep(1200);

      // Fade email, show event card
      hide(email);
      kwPill.style.transition = FADE; kwPill.style.opacity = '0';
      kw.classList.remove('glow');
      await sleep(450);

      show(evt);
      await sleep(1600);

      setDone(evtBadge);
      await sleep(400);

      show(evtOut);
      await sleep(2400);

      hide(evt);
      evtOut.style.transition = FADE; evtOut.style.opacity = '0';
      await sleep(800);
    }
  }

  const io = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) { io.disconnect(); run(); }
  }, { threshold: 0.3 });
  io.observe(body);
})();
</script>
