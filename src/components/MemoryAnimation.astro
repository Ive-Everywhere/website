---
// Memory & Learning animation — colleague recalls context from a short prompt
---

<div class="mm-wrap">
  <img src="/images/cookbook-bg.png" alt="" class="mm-bg" />

  <div class="mm-window">
    <div class="mm-chrome">
      <div class="mm-dots">
        <span style="background:#e8655a;"></span>
        <span style="background:#e8c15a;"></span>
        <span style="background:#67c96c;"></span>
      </div>
      <div class="mm-chrome-right"></div>
    </div>

    <div class="mm-body" id="mm-body">
      <div class="mm-slider" id="mm-slider">
        <!-- Task 1 -->
        <div class="mm-task" data-mm-task="0">
          <div class="mm-bubble-row mm-user-row">
            <div class="mm-bubble mm-bubble-user">prep for the Acme call</div>
          </div>
          <div class="mm-reply-row">
            <div class="mm-reply-av">
              <img src="/images/eluu-logo.svg" alt="" width="22" height="22" style="border-radius:5px;" />
            </div>
            <div class="mm-reply-body">
              <div class="mm-reply-head">
                <span class="mm-reply-name">Lewis</span>
                <span class="mm-reply-tag">APP</span>
                <span class="mm-reply-time">2:34 PM</span>
              </div>
              <div class="mm-lines-wrap">
                <div class="mm-recall">
                  <svg class="mm-recall-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <span>Searching memory...</span>
                </div>
                <div class="mm-lines">
                  <div class="mm-line">
                    <span class="mm-line-label">Last contact</span>
                    <span class="mm-line-value">March 12 — 3 weeks ago</span>
                  </div>
                  <div class="mm-line">
                    <span class="mm-line-label">Deal value</span>
                    <span class="mm-line-value">$48,000 &middot; Negotiation</span>
                  </div>
                  <div class="mm-line">
                    <span class="mm-line-label">Open concern</span>
                    <span class="mm-line-value">Pricing vs. competitor quote</span>
                  </div>
                  <div class="mm-line">
                    <span class="mm-line-label">Ready</span>
                    <span class="mm-line-value">Prep doc with talking points</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Task 2 -->
        <div class="mm-task" data-mm-task="1">
          <div class="mm-bubble-row mm-user-row">
            <div class="mm-bubble mm-bubble-user">follow up with webinar leads</div>
          </div>
          <div class="mm-reply-row">
            <div class="mm-reply-av">
              <img src="/images/eluu-logo.svg" alt="" width="22" height="22" style="border-radius:5px;" />
            </div>
            <div class="mm-reply-body">
              <div class="mm-reply-head">
                <span class="mm-reply-name">Lewis</span>
                <span class="mm-reply-tag">APP</span>
                <span class="mm-reply-time">2:35 PM</span>
              </div>
              <div class="mm-lines-wrap">
                <div class="mm-recall">
                  <svg class="mm-recall-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>
                  </svg>
                  <span>Searching memory...</span>
                </div>
                <div class="mm-lines">
                  <div class="mm-line">
                    <span class="mm-line-label">Source</span>
                    <span class="mm-line-value">12 leads from March 24 webinar</span>
                  </div>
                  <div class="mm-line">
                    <span class="mm-line-label">Engaged</span>
                    <span class="mm-line-value">3 replied, Sarah (Notion) opened 2x</span>
                  </div>
                  <div class="mm-line">
                    <span class="mm-line-label">Action</span>
                    <span class="mm-line-value">Prioritized list ready — 4 marked hot</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .mm-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .mm-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .mm-window {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 460px;
    height: 340px;
    background: rgba(250, 249, 244, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.1);
    overflow: hidden;
    font-family: 'Inter', sans-serif;
    display: flex;
    flex-direction: column;
  }

  .mm-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
    flex-shrink: 0;
  }
  .mm-dots { display: flex; gap: 6px; }
  .mm-dots > span { width: 10px; height: 10px; border-radius: 50%; }
  .mm-label {
    font-size: 13px;
    font-weight: 600;
    color: #17100e;
  }

  .mm-body {
    flex: 1;
    overflow: hidden;
    position: relative;
  }

  .mm-slider {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Task containers — each one fills the visible body area exactly */
  .mm-task {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: 18px;
    box-sizing: border-box;
    height: var(--task-h);
  }

  /* User bubble — right-aligned */
  .mm-bubble-row {
    display: flex;
    opacity: 0;
    transform: translateY(8px);
  }
  .mm-user-row {
    justify-content: flex-end;
  }
  .mm-bubble-user {
    font-size: 13px;
    color: #ffffff;
    background: #343636;
    padding: 8px 14px;
    border-radius: 16px 16px 4px 16px;
    line-height: 1.45;
    max-width: 75%;
    font-weight: 450;
  }

  /* Colleague reply — left-aligned */
  .mm-reply-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    opacity: 0;
    transform: translateY(8px);
  }
  .mm-reply-av {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .mm-reply-body { flex: 1; min-width: 0; }
  .mm-reply-head {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 8px;
  }
  .mm-reply-name { font-size: 13px; font-weight: 600; color: #17100e; }
  .mm-reply-tag {
    font-size: 9px;
    font-weight: 700;
    color: #7d7d7d;
    background: rgba(0,0,0,0.05);
    padding: 1px 5px;
    border-radius: 3px;
    letter-spacing: 0.5px;
  }
  .mm-reply-time { font-size: 11px; color: #a3a3a3; }

  /* Lines wrapper — recall and lines share same space */
  .mm-lines-wrap {
    position: relative;
    min-height: 120px;
  }

  /* Recall indicator — positioned absolute so lines can appear underneath seamlessly */
  .mm-recall {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    font-size: 12px;
    color: #a3a3a3;
    font-weight: 500;
    opacity: 0;
    z-index: 2;
  }
  .mm-recall-icon {
    color: #a3a3a3;
    flex-shrink: 0;
  }
  .mm-recall.searching .mm-recall-icon {
    animation: mm-search 0.8s ease infinite;
  }
  .mm-recall.searching span {
    animation: mm-shimmer 1.2s ease infinite;
  }
  @keyframes mm-search {
    0%, 100% { transform: scale(1); opacity: 0.5; }
    50% { transform: scale(1.1); opacity: 1; }
  }
  @keyframes mm-shimmer {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }

  /* Response lines */
  .mm-lines {
    display: flex;
    flex-direction: column;
    gap: 2px;
    position: relative;
    z-index: 1;
  }
  .mm-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
    font-size: 12.5px;
    line-height: 1.5;
    padding: 5px 10px;
    border-radius: 8px;
    background: transparent;
    opacity: 0;
    transform: translateY(6px);
  }
  .mm-line.highlight {
    background: rgba(94, 106, 210, 0.1);
    transition: background 0.3s ease;
  }
  .mm-line.done {
    background: transparent;
    transition: background 0.6s ease;
  }
  .mm-line-label {
    color: #a3a3a3;
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .mm-line-value {
    color: #17100e;
    font-weight: 500;
  }
</style>

<script>
(function() {
  const body = document.getElementById('mm-body');
  const slider = document.getElementById('mm-slider') as HTMLElement;
  if (!body || !slider) return;

  const tasks = slider.querySelectorAll('.mm-task') as NodeListOf<HTMLElement>;
  if (!tasks.length) return;

  const EASE_IN = 'all 400ms cubic-bezier(0.16, 1, 0.3, 1)';
  const EASE_OUT = 'all 400ms cubic-bezier(0.4, 0, 0.2, 1)';

  function show(el: HTMLElement) {
    el.style.transition = EASE_IN;
    el.style.opacity = '1';
    el.style.transform = 'translateY(0)';
  }

  function sleep(ms: number) {
    return new Promise(r => setTimeout(r, ms));
  }

  function resetTask(task: HTMLElement) {
    const userRow = task.querySelector('.mm-bubble-row') as HTMLElement;
    const replyRow = task.querySelector('.mm-reply-row') as HTMLElement;
    const recall = task.querySelector('.mm-recall') as HTMLElement;
    const lines = task.querySelectorAll('.mm-line') as NodeListOf<HTMLElement>;

    [userRow, replyRow].forEach(el => {
      el.style.transition = 'none';
      el.style.opacity = '0';
      el.style.transform = 'translateY(8px)';
    });
    recall.style.transition = 'none';
    recall.style.opacity = '0';
    recall.classList.remove('searching');
    lines.forEach(ln => {
      ln.style.transition = 'none';
      ln.style.opacity = '0';
      ln.style.transform = 'translateY(6px)';
      ln.classList.remove('highlight', 'done');
    });
  }

  async function animateTask(task: HTMLElement) {
    const userRow = task.querySelector('.mm-bubble-row') as HTMLElement;
    const replyRow = task.querySelector('.mm-reply-row') as HTMLElement;
    const recall = task.querySelector('.mm-recall') as HTMLElement;
    const lines = task.querySelectorAll('.mm-line') as NodeListOf<HTMLElement>;

    await sleep(400);

    // User bubble
    show(userRow);
    await sleep(900);

    // Colleague header
    show(replyRow);
    await sleep(300);

    // Searching memory — appears in same position as first line
    recall.classList.add('searching');
    recall.style.transition = 'opacity 0.3s ease';
    recall.style.opacity = '1';
    await sleep(1400);

    // Fade out recall while fading in first line simultaneously
    recall.style.transition = 'opacity 0.3s ease';
    recall.style.opacity = '0';
    recall.classList.remove('searching');

    // Stream lines — first one starts as recall fades
    for (let i = 0; i < lines.length; i++) {
      const ln = lines[i];
      ln.style.transition = EASE_IN;
      ln.style.opacity = '1';
      ln.style.transform = 'translateY(0)';
      ln.classList.add('highlight');

      if (i > 0) {
        lines[i - 1].classList.remove('highlight');
        lines[i - 1].classList.add('done');
      }
      await sleep(700);
    }

    // Remove last highlight
    lines[lines.length - 1].classList.remove('highlight');
    lines[lines.length - 1].classList.add('done');

    // Hold completed state
    await sleep(2400);
  }

  async function run() {
    const taskHeight = body!.offsetHeight;

    // Set each task to exactly fill the visible area
    slider.style.setProperty('--task-h', taskHeight + 'px');

    let idx = 0;
    tasks.forEach(t => resetTask(t));

    while (true) {
      // Position slider
      slider.style.transition = 'none';
      slider.style.transform = `translateY(-${idx * taskHeight}px)`;
      void slider.offsetHeight;

      resetTask(tasks[idx]);
      void slider.offsetHeight;

      // Animate
      await animateTask(tasks[idx]);

      // Slide to next
      const nextIdx = (idx + 1) % tasks.length;

      if (nextIdx === 0) {
        // Wrap: slide up, then instant jump back
        slider.style.transition = 'transform 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
        slider.style.transform = `translateY(-${(idx + 1) * taskHeight}px)`;
        await sleep(650);
        tasks.forEach(t => resetTask(t));
        slider.style.transition = 'none';
        slider.style.transform = 'translateY(0)';
        void slider.offsetHeight;
      } else {
        resetTask(tasks[nextIdx]);
        slider.style.transition = 'transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
        slider.style.transform = `translateY(-${nextIdx * taskHeight}px)`;
        await sleep(650);
      }

      idx = nextIdx;
    }
  }

  const io = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      io.disconnect();
      run();
    }
  }, { threshold: 0.3 });
  io.observe(body);
})();
</script>
