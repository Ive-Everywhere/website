---
import SectionHeading from './SectionHeading.astro';
import FeatureCard from './FeatureCard.astro';

/**
 * Section 2 — three pillars. Figma `151:2777` (named "Hero"; it is not one).
 *
 * Layout: column, padding 32px 187px 64px, centred, gap 56. Card row gap 36.
 * Cards: `bg-bg-soft-200`, radius 28, padding 40, gap 16.
 *
 * All three cards are byte-identical in Figma — same icon, same heading, same
 * body (spec gap A.1). Cards 2 and 3 were never written. They are rendered as
 * three separate cards so the duplication is visible, not collapsed into one.
 */
interface Props {
  pillars: {
    heading: {
      title: { text: string; node?: string; needed?: boolean };
      sub: { text: string; node?: string; needed?: boolean };
    };
    cards: {
      icon: string;
      heading: { text: string; node?: string; needed?: boolean };
      body: { text: string; node?: string; needed?: boolean };
    }[];
  };
}

const { pillars } = Astro.props;
---

<section class="bg-bg-white-0">
  <div class="page-shell gutter-187 flex flex-col items-center gap-10 pt-8 pb-16 lg:gap-14">
    <SectionHeading heading={pillars.heading} />

    <div class="grid w-full gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-9">
      {
        pillars.cards.map((card, i) => (
          <FeatureCard
            card={card}
            layout="stacked"
            note={i > 0 ? 'identical to pillar card 1 in Figma; never written' : undefined}
          />
        ))
      }
    </div>
  </div>
</section>
