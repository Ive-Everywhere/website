---
import IndexMini from './IndexMini.astro';
import ExecuteMini from './ExecuteMini.astro';
import MemoryMini from './MemoryMini.astro';
---

<!-- ── Frontier — 3-col feature grid, Cursor "Stay on the frontier" layout ── -->
<section class="fr">
  <div class="fr-container">

    <div class="fr-intro">
      <h2 class="fr-heading">How Eluu colleagues work</h2>
    </div>

    <div class="fr-grid">

      <!-- Card 1 — Indexing / understanding tools -->
      <article class="fr-card reveal">
        <div class="fr-text">
          <h3 class="fr-title">Connects to your entire stack</h3>
          <p class="fr-desc">Salesforce, Stripe, Slack, and 20+ more. Reads, writes, queries all.</p>
        </div>
        <div class="fr-media">
          <div class="fr-media-box">
            <IndexMini />
          </div>
        </div>
      </article>

      <!-- Card 2 — Multi-tool execution -->
      <article class="fr-card reveal">
        <div class="fr-text">
          <h3 class="fr-title">Runs work start to finish</h3>
          <p class="fr-desc">Multi-step processes across CRMs, billing, and Slack. No hand-holding.</p>
        </div>
        <div class="fr-media">
          <div class="fr-media-box">
            <ExecuteMini />
          </div>
        </div>
      </article>

      <!-- Card 3 — Memory -->
      <article class="fr-card reveal">
        <div class="fr-text">
          <h3 class="fr-title">Gets better over time</h3>
          <p class="fr-desc">Conversations build memory. Colleagues learn your patterns and preferences.</p>
        </div>
        <div class="fr-media">
          <div class="fr-media-box">
            <MemoryMini />
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  /*
    Cursor "Stay on the frontier" exact values:
      section: bg-theme-bg
      grid: grid-cols-1 xl:grid-cols-3 gap-g1 (10px) items-stretch
      card: padding g1.75 (17.5px), bg-theme-card, rounded-xs (4px), border-01
      text: type-base (16px)
      title: <h3> default
      desc: text-theme-text-sec (60% opacity)
      cta: mt-auto pt-v8/12 (~15px)
      figure: pt-g1.75 (17.5px gap before media)
      media-border-container: rounded-xs, overflow hidden
      aspect: aspect-4/3 mobile → aspect-1/1 desktop
      max-h mobile: 420px
      media bg: bg-theme-card-03-hex (slightly darker variant)
  */

  .fr {
    background: #13100a;
    padding: 112px 0 0; /* top only — next section's top padding is the gap */
  }

  .fr-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .fr-intro {
    margin-bottom: 22.4px; /* mb-v1 */
  }

  .fr-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  /* ── Grid: 1 col mobile → 3 cols on xl (>= 1280px) ── */
  .fr-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-items: stretch;
  }
  @media (min-width: 1024px) {
    .fr-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── Card ── */
  .fr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #1e1d1b;
    border-radius: 4px;
    padding: 17.5px;
    overflow: hidden;
    box-sizing: border-box;
  }
  .fr-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
  }

  /* ── Text area — heading on top, 2-line description below ── */
  .fr-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 48ch;
  }

  .fr-title {
    font-family: 'Söhne', sans-serif;
    font-size: 1rem; /* 16px */
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }

  .fr-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem; /* 15px — one step smaller than heading for hierarchy */
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.45;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }

  /* ── Media — 17.5px gap above, aspect 4:3 mobile → 1:1 desktop ── */
  .fr-media {
    padding-top: 17.5px;
  }

  .fr-media-box {
    position: relative;
    width: 100%;
    background: #161514; /* bg-theme-card-03-hex analogue — slightly darker than card */
    border-radius: 4px;
    overflow: hidden;
    /* Landscape 4:3 — significantly shorter than portrait, still comfortable
       for a floating card + a few rows of content underneath. */
    aspect-ratio: 4 / 3;
  }

  /* Mini animations are position:absolute inset:0 inside their own stages
     and size to their parent — no internal window overrides needed. */

  /* Tablet: 2-col grid */
  @media (min-width: 640px) and (max-width: 1023px) {
    .fr-grid { grid-template-columns: 1fr 1fr; }
    .fr-card:last-child { grid-column: 1 / -1; max-width: 50%; margin: 0 auto; }
  }

  /* Small screens */
  @media (max-width: 639px) {
    .fr { padding: 48px 0 0; }
    .fr-heading { font-size: 20px; }
    .fr-card { padding: 14px; }
    .fr-title { font-size: 14px; }
    .fr-desc { font-size: 13px; }
    .fr-media-box { aspect-ratio: 1 / 1; }
    .fr-media { padding-top: 12px; }
  }
</style>
