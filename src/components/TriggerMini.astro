---
---
<div class="tm-stage">
  <div class="tm-window">
    <div class="tm-card">
      <div class="tm-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </div>
      <div class="tm-info">
        <span class="tm-label">Weekly pipeline brief</span>
        <span class="tm-schedule">Every Monday · 9:00 AM</span>
      </div>
    </div>

    <div class="tm-timeline">
      <div class="tm-event">
        <div class="tm-dot tm-dot-done"></div>
        <div class="tm-ev-text">
          <span class="tm-ev-time">Mon, Apr 7 · 9:00 AM</span>
          <span class="tm-ev-status tm-ev-complete">Completed</span>
        </div>
      </div>
      <div class="tm-event">
        <div class="tm-dot tm-dot-done"></div>
        <div class="tm-ev-text">
          <span class="tm-ev-time">Mon, Apr 14 · 9:00 AM</span>
          <span class="tm-ev-status tm-ev-complete">Completed</span>
        </div>
      </div>
      <div class="tm-event">
        <div class="tm-dot tm-dot-active"></div>
        <div class="tm-ev-text">
          <span class="tm-ev-time">Mon, Apr 21 · 9:00 AM</span>
          <span class="tm-ev-status tm-ev-running">Running...</span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .tm-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 24px 14px 14px; }
  .tm-window { width: 100%; max-width: 280px; }
  .tm-card { display: flex; align-items: center; gap: 10px; padding: 12px 14px; background: #1a1917; border-radius: 6px; border: 1px solid rgba(237,233,227,0.04); margin-bottom: 12px; }
  .tm-icon { color: rgba(237,233,227,0.3); flex-shrink: 0; }
  .tm-info { display: flex; flex-direction: column; gap: 2px; }
  .tm-label { font-family: 'Söhne', sans-serif; font-size: 12px; font-weight: 600; color: rgba(237,233,227,0.85); }
  .tm-schedule { font-family: 'Söhne', sans-serif; font-size: 10px; color: rgba(237,233,227,0.45); }
  .tm-timeline { display: flex; flex-direction: column; padding-left: 8px; }
  .tm-event { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-left: 1px solid rgba(237,233,227,0.06); padding-left: 14px; position: relative; }
  .tm-dot { width: 7px; height: 7px; border-radius: 50%; position: absolute; left: -4px; }
  .tm-dot-done { background: rgba(237,233,227,0.15); }
  .tm-dot-active { background: #f5a623; animation: tm-glow 2s ease-in-out infinite; }
  @keyframes tm-glow { 0%, 100% { box-shadow: 0 0 4px rgba(245,166,35,0.3); } 50% { box-shadow: 0 0 8px rgba(245,166,35,0.6); } }
  .tm-ev-text { display: flex; flex-direction: column; gap: 1px; }
  .tm-ev-time { font-family: 'Söhne', sans-serif; font-size: 10px; color: rgba(237,233,227,0.5); }
  .tm-ev-status { font-family: 'Söhne', sans-serif; font-size: 10px; font-weight: 500; }
  .tm-ev-complete { color: rgba(237,233,227,0.35); }
  .tm-ev-running { color: #f5a623; }
</style>
