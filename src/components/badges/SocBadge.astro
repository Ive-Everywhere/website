---
/**
 * SOC 2 compliance badge.
 *
 * Recoloured from the supplied artwork onto our tokens: the ink maps to
 * `--badge-ink`, mid-tones to `--badge-mid`, and the disc to `--badge-field`.
 * Those four deliberately do NOT invert with the theme, a medallion is dark
 * ink on a light disc in both modes; dark mode just uses duller steps.
 * Inlined rather than shipped as a file because `var()` does not resolve in an
 * SVG loaded through <img>.
 *
 * Source palette -> token:
 *   #12100C    -> currentColor
 *   #272115    -> currentColor
 *   #392E1D    -> currentColor
 *   #60594A    -> var(--badge-mid)
 *   #938E86    -> var(--badge-mid)
 *   #B8AA9F    -> var(--badge-soft)
 *   #DAD1C5    -> var(--badge-soft)
 *   #E9E5DD    -> var(--badge-soft)
 *   #FBFBF9    -> var(--badge-field)
 *   white      -> var(--badge-field)
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
