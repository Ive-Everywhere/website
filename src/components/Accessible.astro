<section class="access">
  <div class="access-inner">
    <h2>Access from <em>anywhere</em></h2>
    <p class="sub-h">Desktop, terminal, SDK, or deploy on any surface your team already uses.</p>
    <div class="access-box">

      <!-- Row 1: Desktop App -->
      <div class="access-row">
        <div class="ar-img">
          <div class="mock-icons">
            <div class="mock-icon" style="background:linear-gradient(135deg,#1a181b,#242126);">
              <span style="font-family:var(--fd);color:var(--alr);">E</span>
            </div>
            <div class="mock-icon" style="background:linear-gradient(135deg,#242126,#33303a);transform:translateY(-8px);">
              <span style="font-size:16px;">&#9881;</span>
            </div>
            <div class="mock-icon" style="background:linear-gradient(135deg,#33303a,#3d1a2e);">
              <span style="font-size:16px;">&#9733;</span>
            </div>
          </div>
        </div>
        <h4>Desktop app</h4>
        <a class="btn-dark" href="#">Download</a>
      </div>

      <!-- Row 2: Terminal -->
      <div class="access-row">
        <div class="ar-img">
          <div class="mock-t">
            <div><span class="p">$</span> <span class="c">eluu</span> <span class="o">run</span> <span class="o">"summarize yesterday's tickets"</span></div>
            <div style="margin-top:6px;"><span class="p">&gt;</span> <span class="o">Analyzing 47 tickets...</span><span class="cur"></span></div>
          </div>
        </div>
        <h4>Terminal</h4>
        <a class="btn-dark" href="#">View CLI docs</a>
      </div>

      <!-- Row 3: SDK -->
      <div class="access-row">
        <div class="ar-img">
          <div class="mock-code">
            <span class="kw">import</span> <span class="fn">{'{ Eluu }'}</span> <span class="kw">from</span> <span class="str">'@eluu/sdk'</span><br/>
            <br/>
            <span class="kw">const</span> <span class="fn">colleague</span> = <span class="kw">await</span> Eluu.<span class="fn">create</span>({'{'}<br/>
            &nbsp;&nbsp;name: <span class="str">'ops-lead'</span>,<br/>
            &nbsp;&nbsp;tools: [<span class="str">'salesforce'</span>, <span class="str">'slack'</span>]<br/>
            {'}'})<br/>
          </div>
        </div>
        <h4>SDK</h4>
        <a class="btn-dark" href="#">Explore SDK</a>
      </div>

      <!-- Row 4: Deploy on any surface -->
      <div class="access-row">
        <div class="ar-img">
          <div class="mock-pills">
            <span class="mock-pill">Slack</span>
            <span class="mock-pill">Web</span>
            <span class="mock-pill">Mobile</span>
            <span class="mock-pill">API</span>
          </div>
        </div>
        <h4>Deploy on any surface</h4>
        <a class="btn-dark" href="#">See integrations</a>
      </div>

    </div>
  </div>
</section>
