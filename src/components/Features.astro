---
const products = [
  {
    title: 'Colleagues',
    description: 'Purpose-built AI teammates that learn your workflows and execute real work.',
    icon: 'colleagues',
  },
  {
    title: 'Cookbook',
    description: 'Pre-built multi-step recipes that chain integrations together. One click.',
    icon: 'cookbook',
  },
  {
    title: 'Slack',
    description: 'Message your AI colleagues like real teammates, right in your channels.',
    icon: 'slack',
  },
  {
    title: 'Automations',
    description: 'Schedule recurring work, set triggers. Colleagues handle the rest.',
    icon: 'automations',
  },
  {
    title: 'Hard Drive',
    description: 'Shared memory. Upload files and playbooks any colleague can reference.',
    icon: 'drive',
  },
  {
    title: 'Abilities',
    description: 'Pre-built tool bundles — scrapers, enrichment, outreach. One-click equip.',
    icon: 'abilities',
  },
];

const platform = [
  {
    title: 'Parallel execution',
    description: 'Multiple colleagues work across your tools simultaneously. No waiting, no bottlenecks.',
    icon: 'parallel',
  },
  {
    title: 'Memory & learning',
    description: 'They remember preferences, past interactions, and context — getting sharper every task.',
    icon: 'memory',
  },
  {
    title: 'Enterprise security',
    description: 'End-to-end encrypted, role-based permissions, audit logs for every action.',
    icon: 'security',
  },
  {
    title: 'Configure once',
    description: 'Set up triggers, schedules, and outputs. Your colleagues run forever — no reminders.',
    icon: 'configure',
  },
];
---

<!-- Products + Platform -->
<section style="background: #f4f3ec; padding: 96px 24px 0;">
  <div style="max-width: 1440px; margin: 0 auto;">
    <div class="ft-header">
      <h2 class="ft-heading reveal">Everything your AI team needs.</h2>
    </div>

    <div class="ft-cards">
      {products.map((p) => (
        <div class="ft-card group reveal">
          <div class="ft-card-hover"></div>
          <div class="ft-card-icon">
            {p.icon === 'colleagues' && (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f4f3ec" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/>
              </svg>
            )}
            {p.icon === 'cookbook' && (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f4f3ec" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 19.5A2.5 2.5 0 016.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="13" y2="11"/>
              </svg>
            )}
            {p.icon === 'slack' && (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f4f3ec" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14.5 10c-.83 0-1.5-.67-1.5-1.5v-5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5z"/><path d="M20.5 10H19v-1.5c0-.83.67-1.5 1.5-1.5s1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/><path d="M9.5 14c.83 0 1.5.67 1.5 1.5v5c0 .83-.67 1.5-1.5 1.5S8 21.33 8 20.5v-5c0-.83.67-1.5 1.5-1.5z"/><path d="M3.5 14H5v1.5c0 .83-.67 1.5-1.5 1.5S2 16.33 2 15.5 2.67 14 3.5 14z"/><path d="M14 14.5c0-.83.67-1.5 1.5-1.5h5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5h-5c-.83 0-1.5-.67-1.5-1.5z"/><path d="M14 20.5V19h1.5c.83 0 1.5.67 1.5 1.5s-.67 1.5-1.5 1.5-1.5-.67-1.5-1.5z"/><path d="M10 9.5C10 10.33 9.33 11 8.5 11h-5C2.67 11 2 10.33 2 9.5S2.67 8 3.5 8h5c.83 0 1.5.67 1.5 1.5z"/><path d="M10 3.5V5H8.5C7.67 5 7 4.33 7 3.5S7.67 2 8.5 2s1.5.67 1.5 1.5z"/>
              </svg>
            )}
            {p.icon === 'automations' && (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f4f3ec" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/>
              </svg>
            )}
            {p.icon === 'drive' && (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f4f3ec" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
              </svg>
            )}
            {p.icon === 'abilities' && (
              <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#f4f3ec" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
              </svg>
            )}
          </div>
          <div class="ft-card-text">
            <h3>{p.title}</h3>
            <p>{p.description}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="ft-platform" style="padding-top: 80px; padding-bottom: 72px;">
    <!-- Left: text -->
    <div class="ft-plat-text">
      <h2 class="ft-heading reveal">Built on a powerful foundation.</h2>
      <p class="reveal" style="font-family: 'Inter', sans-serif; font-size: 16px; color: #5c5c5c; line-height: 1.6; margin: 12px 0 0;">
        Every colleague runs on the same enterprise-grade infrastructure — secure, scalable, and designed to handle real work at scale.
      </p>
    </div>

    <!-- Right: feature grid -->
    <div class="ft-plat-grid">
      {platform.map((f) => (
        <div class="ft-plat-item reveal">
          <div class="ft-plat-head">
            <div class="ft-plat-icon">
              {f.icon === 'parallel' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>
                </svg>
              )}
              {f.icon === 'memory' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 2a7 7 0 00-4 12.7V17a1 1 0 001 1h6a1 1 0 001-1v-2.3A7 7 0 0012 2z"/><line x1="9" y1="21" x2="15" y2="21"/>
                </svg>
              )}
              {f.icon === 'security' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              )}
              {f.icon === 'configure' && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0118.8-4.3M22 12.5a10 10 0 01-18.8 4.2"/>
                </svg>
              )}
            </div>
            <h4>{f.title}</h4>
          </div>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* ── Shared ── */
  .ft-heading {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-weight: 700;
    font-size: 40px;
    letter-spacing: -1.5px;
    color: #000;
    line-height: 1.1;
    margin: 0;
  }
  @media (min-width: 640px) { .ft-heading { font-size: 48px; letter-spacing: -2px; } }

  .ft-header { margin-bottom: 40px; }

  /* ── Product cards ── */
  .ft-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (min-width: 640px) {
    .ft-cards { gap: 20px; }
  }
  @media (min-width: 768px) {
    .ft-cards {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }
  }
  @media (min-width: 1024px) {
    .ft-cards {
      grid-template-columns: repeat(6, 1fr);
      gap: 24px;
    }
  }

  /* ── Single card ── */
  .ft-card {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  /* Hover background — Modal style */
  .ft-card-hover {
    pointer-events: none;
    position: absolute;
    inset: -12px;
    z-index: -1;
    background: #d4d3c8;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .ft-card:hover .ft-card-hover,
  .ft-card:active .ft-card-hover {
    opacity: 1;
  }

  /* ── Icon block — window into shared bg image ── */
  .ft-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    aspect-ratio: 1;
    padding: 30%;
    background: url('/images/products-bg.webp') center / 600% no-repeat;
    background-attachment: local;
  }
  /* Each card shows a different slice of the background */
  .ft-card:nth-child(1) .ft-card-icon { background-position: 0% 50%; }
  .ft-card:nth-child(2) .ft-card-icon { background-position: 20% 50%; }
  .ft-card:nth-child(3) .ft-card-icon { background-position: 40% 50%; }
  .ft-card:nth-child(4) .ft-card-icon { background-position: 60% 50%; }
  .ft-card:nth-child(5) .ft-card-icon { background-position: 80% 50%; }
  .ft-card:nth-child(6) .ft-card-icon { background-position: 100% 50%; }

  .ft-card-icon svg {
    width: 100%;
    height: 100%;
  }

  /* ── Card text ── */
  .ft-card-text h3 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #17100e;
    margin: 0 0 6px;
    letter-spacing: -0.3px;
  }
  .ft-card-text p {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #5c5c5c;
    line-height: 1.5;
    margin: 0;
  }

  /* ── Platform section ── */
  .ft-platform {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }
  @media (min-width: 768px) {
    .ft-platform {
      flex-direction: row;
      align-items: flex-start;
      gap: 80px;
    }
  }

  .ft-plat-text {
    flex-shrink: 0;
  }
  @media (min-width: 768px) {
    .ft-plat-text { width: 33.33%; }
  }

  .ft-plat-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
  }
  @media (min-width: 640px) {
    .ft-plat-grid {
      grid-template-columns: 1fr 1fr;
      gap: 56px 56px;
    }
  }
  @media (min-width: 768px) {
    .ft-plat-grid { width: 66.66%; }
  }

  .ft-plat-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ft-plat-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .ft-plat-icon {
    color: #17100e;
    flex-shrink: 0;
  }

  .ft-plat-item h4 {
    font-family: 'Bricolage Grotesque', sans-serif;
    font-size: 20px;
    font-weight: 700;
    color: #17100e;
    margin: 0;
    letter-spacing: -0.2px;
    line-height: 1.4;
  }

  .ft-plat-item p {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    color: #5c5c5c;
    line-height: 1.55;
    margin: 0;
  }
</style>
