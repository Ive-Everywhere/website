---
const platform = [
  {
    title: 'Integration security',
    description: 'Scoped OAuth and per-workspace keys. Colleagues only see what they should.',
    icon: 'security',
  },
  {
    title: 'Skill security',
    description: 'Every recipe runs in a sandbox with explicit permissions, reviewed before touching data.',
    icon: 'parallel',
  },
  {
    title: 'Data protection',
    description: 'Outbound traffic is inspected and blocked at the boundary. Sensitive data never leaves.',
    icon: 'memory',
  },
  {
    title: 'Continuous monitoring',
    description: 'Every action is logged and streamed in real time, with alerts on anomalies.',
    icon: 'configure',
  },
];
---

<!-- Security -->
<section class="ft-section ft-security-section">
  <div class="ft-container">
    <div class="ft-sec-intro">
      <h2 class="ft-sec-heading reveal">Enterprise-grade security.</h2>
    </div>
    <div class="ft-sec-grid">
      {platform.map((f) => (
        <div class="ft-sec-item reveal">
          <div class="ft-sec-icon">
            {f.icon === 'security' && (<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>)}
            {f.icon === 'parallel' && (<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>)}
            {f.icon === 'memory' && (<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>)}
            {f.icon === 'configure' && (<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>)}
          </div>
          <h3 class="ft-sec-title">{f.title}</h3>
          <p class="ft-sec-desc">{f.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<slot />

<style>
  .ft-section { background: #13100a; padding: 112px 0 0; }
  @media (max-width: 480px) { .ft-section { padding: 56px 0 0; } }
  .ft-container { max-width: 1380px; margin: 0 auto; padding: 0 20px; }

  /* Security */
  /* Security — Cursor-style stacked layout, flat cards */
  .ft-sec-intro {
    margin-bottom: 32px;
  }
  .ft-sec-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 700;
    font-size: clamp(22px, 4vw, 36px);
    letter-spacing: -1px;
    color: #ede9e3;
    line-height: 1.2;
    margin: 0;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .ft-sec-heading { white-space: normal; }
  }

  .ft-sec-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px 24px;
  }
  @media (min-width: 640px) { .ft-sec-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .ft-sec-grid { grid-template-columns: repeat(4, 1fr); } }

  .ft-sec-item {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.025);
    border-radius: 4px;
    padding: 24px;
  }
  .ft-sec-icon {
    color: #ede9e3;
    opacity: 0.7;
    margin-bottom: 4px;
  }
  .ft-sec-title {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    font-weight: 500;
    color: #ede9e3;
    line-height: 1.4;
    margin: 0;
    letter-spacing: -0.005em;
  }
  .ft-sec-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    color: rgba(237, 233, 227, 0.55);
    line-height: 1.55;
    margin: 0;
    text-wrap: pretty;
  }
</style>
