---
import ContextAnimation from './ContextAnimation.astro';
import ExecuteAnimation from './ExecuteAnimation.astro';
import BuilderAnimation from './BuilderAnimation.astro';
import IndexAnimation from './IndexAnimation.astro';
---

<!-- Why Eluu — sticky card stacking section -->
<section class="we">
  <div class="we-wrap">
    <!-- Header -->
    <div class="we-head">
      <h2 class="we-title reveal">Designed to get real work done.</h2>
    </div>

    <!-- Cards -->
    <div class="we-cards">

      <!-- Card 1 — Index -->
      <section class="we-card" data-card="0"
        style="--ct:128px; --ch:640px; --cm:0px; --cz:1;">
        <div class="we-label">Index</div>
        <div class="we-text">
          <h3>Maps your tools. Understands your data.</h3>
          <p>Connects to Salesforce, Stripe, Sheets, Slack, and 20+ tools. Learns your schema, maps relationships across systems, and builds a unified index — so it already knows where to look before you ask.</p>
        </div>
        <div class="we-media we-anim">
          <IndexAnimation />
        </div>
      </section>

      <!-- Card 2 — Execute -->
      <section class="we-card" data-card="1"
        style="--ct:128px; --ch:640px; --cm:0px; --cz:2;">
        <div class="we-label">Execute</div>
        <div class="we-text">
          <h3>Workflows that actually span tools.</h3>
          <p>Pulls data from your CRM, creates invoices in Stripe, logs to a spreadsheet, messages your team in Slack. Runs end-to-end, in parallel, across your entire stack. One click. Zero babysitting.</p>
        </div>
        <div class="we-media we-anim">
          <ExecuteAnimation />
        </div>
      </section>

      <!-- Card 3 — Learn -->
      <section class="we-card" data-card="2"
        style="--ct:128px; --ch:640px; --cm:0px; --cz:3;">
        <div class="we-label">Learn</div>
        <div class="we-text">
          <h3>Context that compounds.</h3>
          <p>Remembers your preferences, past decisions, and how you like things done. Say "prep for the Acme call" — it pulls deal history, spots concerns, and builds talking points without being told where to look.</p>
        </div>
        <div class="we-media we-anim">
          <ContextAnimation />
        </div>
      </section>

      <!-- Card 4 — Build -->
      <section class="we-card" data-card="3"
        style="--ct:128px; --ch:640px; --cm:0px; --cz:4;">
        <div class="we-label">Build</div>
        <div class="we-text">
          <h3>Creates tools you couldn't build yourself.</h3>
          <p>Your colleagues don't just run workflows — they build operational tools. Analytics engines, contract analyzers, procurement systems, live dashboards. Work that would take engineering weeks, done in hours. No code, no tickets, no waiting.</p>
        </div>
        <div class="we-media we-anim">
          <BuilderAnimation />
        </div>
      </section>

    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .we { background: #f4f3ec; }

  .we-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 48px 16px;
  }
  @media (min-width: 640px)  { .we-wrap { padding: 60px 24px; } }
  @media (min-width: 768px)  { .we-wrap { padding: 64px 32px; } }
  @media (min-width: 1024px) { .we-wrap { padding: 96px 24px; } }

  /* ── Header ── */
  .we-head {
    padding-bottom: 24px;
  }
  @media (min-width: 640px)  { .we-head { padding-bottom: 32px; } }
  @media (min-width: 768px)  { .we-head { padding-bottom: 36px; } }
  @media (min-width: 1024px) { .we-head { padding-bottom: 40px; } }

  .we-title {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 5vw + 4px, 56px);
    color: #17100e;
    line-height: 1.1;
    letter-spacing: -1px;
    margin: 0;
    padding-bottom: 20px;
  }
  @media (min-width: 640px)  { .we-title { padding-bottom: 28px; letter-spacing: -1.5px; } }
  @media (min-width: 768px)  { .we-title { padding-bottom: 32px; } }
  @media (min-width: 1024px) { .we-title { padding-bottom: 40px; letter-spacing: -2px; } }

  /* ── Cards container ── */
  /* NEVER add overflow: hidden here — it breaks sticky card stacking */
  .we-cards { }

  /* ── Card ── */
  .we-card {
    border-top: 1px solid #d4d3cb;
    background: #f4f3ec;
    width: 100%;
    margin-bottom: 32px;
  }
  .we-card:last-child { margin-bottom: 0; }

  @media (min-width: 640px) {
    .we-card { margin-bottom: 40px; }
  }
  @media (min-width: 768px) {
    .we-card { margin-bottom: 48px; }
  }

  @media (min-width: 1024px) {
    .we-card {
      position: sticky;
      top: var(--ct);
      height: var(--ch);
      margin-top: var(--cm);
      margin-bottom: 0;
      display: flex;
      overflow: hidden;
      z-index: var(--cz);
    }
  }

  /* ── Card label ── */
  .we-label {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #17100e;
    letter-spacing: 0.5px;
    padding: 16px 0;
    flex-shrink: 0;
  }
  @media (min-width: 1024px) {
    .we-label {
      width: 160px;
      padding: 32px 48px 32px 0;
    }
  }

  /* ── Card text ── */
  .we-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0 0 16px;
  }
  @media (min-width: 640px) { .we-text { gap: 12px; padding: 0 0 24px; } }
  @media (min-width: 768px) { .we-text { gap: 14px; padding: 0 0 28px; } }
  @media (min-width: 1024px) {
    .we-text {
      width: 32%;
      gap: 16px;
      padding: 32px 48px 32px 0;
      flex-shrink: 0;
    }
  }

  .we-text h3 {
    font-family: 'Season Mix', sans-serif;
    font-size: clamp(20px, 2.5vw + 4px, 32px);
    font-weight: 700;
    color: #17100e;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .we-text h3 { letter-spacing: -1px; }
  }

  .we-text p {
    font-family: 'Inter', sans-serif;
    font-size: clamp(14px, 1vw + 6px, 16px);
    color: #5c5c5c;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Card media ── */
  .we-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    border: 1px solid #d4d3cb;
    border-radius: 0;
    overflow: hidden;
  }
  @media (min-width: 640px) { .we-media { aspect-ratio: 4/3; } }
  @media (min-width: 768px) { .we-media { aspect-ratio: 16/10; } }
  @media (min-width: 1024px) {
    .we-media {
      flex: 1;
      min-width: 0;
      min-height: 300px;
      aspect-ratio: auto;
      border-radius: 0;
      border-top: none;
    }
  }

  /* ── Animation media ── */
  .we-anim {
    border: none;
    background: none;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  /* ── Video media ── */
  .we-vid {
    border: none;
    background: none;
    padding: 0;
    overflow: hidden;
  }
  .we-vid video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 12px;
  }
  @media (min-width: 768px) {
    .we-vid video { border-radius: 16px; }
  }
  @media (min-width: 1024px) {
    .we-vid video { border-radius: 0; }
  }


</style>

