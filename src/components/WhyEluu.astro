<style>
  /*
    Cursor exact values (from their production CSS):
    --g: 0.625rem (10px)
    --v: 1.4rem (22.4px)
    --spacing-g1: 10px
    --spacing-g1.75: 17.5px
    --spacing-v4: 89.6px (card margin-bottom)
    --radius-xs: 4px
    --text-base: 1rem (16px), line-height 1.5, weight 400, tracking 0.005em
    --text-md: 1.375rem (22px), line-height 1.3, weight 400, tracking -0.005em
    --color-theme-card-hex: #1e1d1b
    --color-theme-border-01: ~2.5% of fg = nearly invisible
    --color-theme-accent: #f54e00
    Grid: 24 columns, gap 10px
    Text: col 1-8 (33.3%), Media: col 9-24 (66.7%)
    Card: padding g1.75 (17.5px), border-radius 4px
    Product mockup: border-radius 10px (rounded-[10px])
  */

  .we {
    background: #13100a;
  }

  .we-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ── Card — 112px spacing between cards for generous breathing room ── */
  .we-card {
    margin-bottom: 112px;
  }
  .we-card:last-child {
    margin-bottom: 0;
  }

  /* ── Card inner — the actual card surface ──
     Cursor: .card with padding g1.75, bg card-hex, radius-xs, border border-01
     Uses 24-column grid inside */
  .we-card-inner {
    position: relative;
    background: #1e1d1b;
    border-radius: 4px;
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
  }
  .we-card-inner::before {
    content: "";
    pointer-events: none;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
    position: absolute;
    inset: 0;
  }

  @media (min-width: 900px) {
    .we-card-inner {
      grid-template-columns: repeat(24, 1fr);
      gap: 10px;
    }
  }

  /* ── Reverse layout (text right, media left) ── */
  @media (min-width: 900px) {
    .we-card-inner--reverse .we-text-col {
      grid-column: 16 / 25;
      grid-row: 1 / -1;
      padding: 36px 36px 36px 30px;
    }
    .we-card-inner--reverse .we-media-col {
      grid-column: 1 / 16;
      grid-row: 1 / -1;
    }
  }

  /* ── Text column ──
     Cursor: lg:col-start-1 lg:col-end-9 lg:items-center lg:pl-g0.25 lg:pr-g3 */
  .we-text-col {
    display: flex;
    align-items: center;
    padding: 24px;
  }
  @media (min-width: 900px) {
    .we-text-col {
      grid-column: 1 / 10;
      grid-row: 1 / -1;
      padding: 36px 30px 36px 36px;
    }
  }

  .we-text-wrap {
    width: 100%;
    max-width: 42ch; /* tighter measure for Söhne heading — reads better */
  }

  .we-text-block {
    display: flex;
    flex-direction: column;
    gap: 10px; /* small breath between heading and description */
  }

  /* Heading — Söhne Halbfett (600). Bold statement, tight letter-spacing.
     Size scales: 20px mobile → 26px desktop. */
  .we-heading {
    font-family: 'Söhne', sans-serif;
    font-size: 1.25rem; /* 20px mobile */
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }
  @media (min-width: 768px) {
    .we-heading {
      font-size: 1.625rem; /* 26px */
      line-height: 1.2;
      letter-spacing: -0.02em;
    }
  }

  /* Description — Söhne Buch (400). 60% opacity, relaxed line-height. */
  .we-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 1rem; /* 16px mobile */
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .we-desc {
      font-size: 1.125rem; /* 18px */
      line-height: 1.55;
      letter-spacing: -0.01em;
    }
  }

  /* Breathing room before the CTA link */
  .we-cta {
    margin-top: 24px;
  }
  @media (min-width: 768px) {
    .we-cta {
      margin-top: 28px;
    }
  }

  /* CTA link — pill with subtle peach border, 4px radius to match card language */
  .we-link {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem; /* 14px */
    font-weight: 400;
    color: #f54e00;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: transparent;
    border: 1px solid rgba(245, 78, 0, 0.2);
    border-radius: 4px;
    padding: 7px 14px;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .we-link:hover {
    background: rgba(245, 78, 0, 0.06);
    border-color: rgba(245, 78, 0, 0.35);
  }

  /* ── Media column ──
     Cursor: lg:col-start-9 lg:col-end-25 lg:items-center
     Contains the media-border-container with rounded-xs, overflow hidden */
  .we-media-col {
    position: relative;
    min-height: 350px;
  }
  @media (min-width: 900px) {
    .we-media-col {
      grid-column: 10 / 25;
      grid-row: 1 / -1;
      min-height: 680px;
    }
  }

  /* Cursor: media-border-container — z-index 1, rounded-xs (4px), overflow hidden, relative
     Has ::after border pseudo */
  .we-media-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .we-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }


  /* ── Row of 2 smaller cards (Jobs + Slack) ── */
  .we-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    margin-bottom: 0;
  }
  @media (min-width: 900px) {
    .we-row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .we-small-card {
    background: #1e1d1b;
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }
  .we-small-card::before {
    content: "";
    pointer-events: none;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
    position: absolute;
    inset: 0;
  }
  .we-small-inner {
    display: flex;
    flex-direction: column;
  }
  .we-small-text {
    padding: 24px 24px 16px;
    display: flex;
    flex-direction: column;
  }
  .we-small-media {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin: 0 24px 24px;
    border-radius: 4px;
  }
  .we-small-media .we-media-img {
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .we-media-col { min-height: 300px; }
    .we-card { margin-bottom: 72px; }
  }
  @media (max-width: 480px) {
    .we-media-col { min-height: 220px; }
    .we-card { margin-bottom: 48px; }
    .we-text-col { padding: 20px 16px; }
    .we-small-text { padding: 20px 16px 12px; }
    .we-small-media { margin: 0 16px 16px; }
  }
</style>
