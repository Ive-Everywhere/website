    <!-- Card 4 — Views -->
    <div class="we-card reveal">
      <div class="we-card-inner we-card-inner--reverse">
        <div class="we-text-col">
          <div class="we-text-wrap">
            <div class="we-text-block">
              <h3 class="we-heading">Dashboards built for your business</h3>
              <p class="we-desc">Agentic command centers tailored to how your team actually works — pipeline, revenue, support, or whatever you need to see at a glance.</p>
