---
import MemoryAnimation from './MemoryAnimation.astro';
import CookbookAnimation from './CookbookAnimation.astro';
import JobsAnimation from './JobsAnimation.astro';
import ParallelAnimation from './ParallelAnimation.astro';
---

<!-- Why Eluu — sticky card stacking section -->
<section class="we">
  <div class="we-wrap">
    <div class="we-grid">

      <!-- Sidebar -->
      <nav class="we-side" aria-label="Why Eluu sections">
        <div class="we-side-inner">
          <button type="button" class="we-nav active" data-i="0" aria-current="true">
            <div class="we-pie"></div>
            <span>Memory</span>
          </button>
          <div class="we-divider"></div>
          <button type="button" class="we-nav" data-i="1">
            <div class="we-pie"></div>
            <span>Cookbook</span>
          </button>
          <div class="we-divider"></div>
          <button type="button" class="we-nav" data-i="2">
            <div class="we-pie"></div>
            <span>Scheduling</span>
          </button>
          <div class="we-divider"></div>
          <button type="button" class="we-nav" data-i="3">
            <div class="we-pie"></div>
            <span>Execution</span>
          </button>
        </div>
      </nav>

      <!-- Header -->
      <div class="we-head">
        <h2 class="we-title reveal">Designed to get real work done.</h2>
      </div>

      <!-- Cards -->
      <div class="we-cards">

        <!-- Card 1 — Memory -->
        <section class="we-card" data-card="0"
          style="--ct:128px; --ch:640px; --cm:0px; --cz:1;">
          <div class="we-text">
            <h3>Persistent memory</h3>
            <p>Remembers your preferences, criteria, and context across every session. Builds processes that compound — one team built the equivalent of a 10,000-line script without writing code.</p>
          </div>
          <div class="we-media we-anim">
            <MemoryAnimation />
          </div>
        </section>

        <!-- Card 2 — Cookbook -->
        <section class="we-card" data-card="1"
          style="--ct:128px; --ch:640px; --cm:0px; --cz:2;">
          <div class="we-text">
            <h3>Complex workflows. One click.</h3>
            <p>Pre-built recipes that chain your tools together into operational workflows. Process invoices, reconcile payments, enrich contacts — activate in minutes, no code required.</p>
          </div>
          <div class="we-media we-anim">
            <CookbookAnimation />
          </div>
        </section>

        <!-- Card 3 — Jobs -->
        <section class="we-card" data-card="2"
          style="--ct:128px; --ch:640px; --cm:0px; --cz:3;">
          <div class="we-text">
            <h3>Scheduled operations</h3>
            <p>Daily pipeline checks, weekly reports, monthly reconciliations — set up recurring workflows that run without you. Trigger from a schedule or a real-world event like an email keyword or deal stage change.</p>
          </div>
          <div class="we-media we-anim">
            <JobsAnimation />
          </div>
        </section>

        <!-- Card 4 — Multitasking -->
        <section class="we-card" data-card="3"
          style="--ct:128px; --ch:640px; --cm:0px; --cz:4;">
          <div class="we-text">
            <h3>Cross-system execution</h3>
            <p>Runs multi-step workflows across your entire stack. Processes invoices, checks pipelines, reconciles payments, enriches contacts — in the background, in parallel, without you watching.</p>
          </div>
          <div class="we-media we-anim">
            <ParallelAnimation />
          </div>
        </section>

      </div>
    </div>
  </div>
</section>

<style>
  /* ── Section ── */
  .we { background: #f4f3ec; }

  .we-wrap {
    max-width: 1440px;
    margin: 0 auto;
    padding: 80px 24px;
  }
  @media (min-width: 640px)  { .we-wrap { padding: 80px 40px; } }
  @media (min-width: 1024px) { .we-wrap { padding: 80px 48px; } }

  /* ── Grid ── */
  .we-grid { display: grid; grid-template-columns: 1fr; }

  @media (min-width: 1024px) {
    .we-grid {
      grid-template-columns: 200px 1fr;
      column-gap: 48px;
    }
  }

  /* ── Sidebar ── */
  .we-side {
    display: none;
    grid-row: 2;
    grid-column: 1;
  }
  @media (min-width: 1024px) { .we-side { display: block; } }

  .we-side-inner {
    position: sticky;
    top: 160px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .we-nav {
    display: flex;
    align-items: center;
    gap: 16px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    text-align: left;
  }

  .we-pie {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    flex-shrink: 0;
    background: rgba(23, 16, 14, 0.12);
  }

  .we-divider {
    height: 1px;
    background: #d4d3cb;
  }

  .we-nav span:last-child {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.5px;
    line-height: 1;
    color: rgba(23, 16, 14, 0.2);
    transition: color 0.3s ease;
  }

  .we-nav.active span:last-child { color: #17100e; }

  /* ── Header ── */
  .we-head {
    grid-column: 1;
    grid-row: 1;
    padding-bottom: 40px;
  }
  @media (min-width: 1024px) {
    .we-head { grid-column: 2; grid-row: 1; padding-bottom: 0; }
  }

  .we-title {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 6vw, 56px);
    color: #17100e;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 0;
    padding-bottom: 32px;
  }
  @media (min-width: 640px) { .we-title { padding-bottom: 40px; letter-spacing: -2px; } }

  /* ── Cards container ── */
  .we-cards { grid-column: 1; grid-row: 2; }
  @media (min-width: 1024px) {
    .we-cards { grid-column: 2; grid-row: 2; min-width: 0; }
  }

  /* ── Card ── */
  .we-card {
    border-top: 1px solid #d4d3cb;
    background: #f4f3ec;
    width: 100%;
    margin-bottom: 48px;
  }
  .we-card:last-child { margin-bottom: 0; }

  @media (min-width: 1024px) {
    .we-card {
      position: sticky;
      top: var(--ct);
      height: var(--ch);
      margin-top: var(--cm);
      margin-bottom: 0;
      display: flex;
      overflow: hidden;
      z-index: var(--cz);
    }
  }

  /* ── Card text ── */
  .we-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0;
  }
  @media (min-width: 640px) { .we-text { gap: 16px; padding: 32px 0; } }
  @media (min-width: 1024px) {
    .we-text {
      width: 32%;
      padding: 32px 48px 32px 0;
      flex-shrink: 0;
    }
  }

  .we-text h3 {
    font-family: 'Season Mix', sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #17100e;
    line-height: 1.15;
    letter-spacing: -0.5px;
    margin: 0;
  }
  @media (min-width: 1024px) {
    .we-text h3 { font-size: 32px; letter-spacing: -1px; }
  }

  .we-text p {
    font-family: 'Inter', sans-serif;
    font-size: 16px;
    color: #5c5c5c;
    line-height: 1.6;
    margin: 0;
  }

  /* ── Card media ── */
  .we-media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 260px;
    border: 1px solid #d4d3cb;
    border-radius: 0;
    overflow: hidden;
  }
  @media (min-width: 640px) { .we-media { min-height: 300px; } }
  @media (min-width: 1024px) {
    .we-media {
      flex: 1;
      min-width: 0;
      border-radius: 0;
      border-top: none;
    }
  }

  /* ── Animation media ── */
  .we-anim {
    border: none;
    background: none;
    padding: 0;
    position: relative;
    overflow: hidden;
  }

  /* ── Video media ── */
  .we-vid {
    border: none;
    background: none;
    padding: 0;
    overflow: hidden;
  }
  .we-vid video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 16px;
  }
  @media (min-width: 1024px) {
    .we-vid video { border-radius: 0; }
  }


</style>

<script>
  (function () {
    const cards = document.querySelectorAll('.we-card') as NodeListOf<HTMLElement>;
    const navs = document.querySelectorAll('.we-nav');
    const pies = document.querySelectorAll('.we-pie') as NodeListOf<HTMLElement>;
    if (!cards.length || !navs.length) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let ticking = false;

    function getStick(card: HTMLElement) {
      return parseInt(getComputedStyle(card).getPropertyValue('--ct')) || 128;
    }

    function update() {
      let active = 0;
      const cardTops: number[] = [];

      cards.forEach((card, i) => {
        const top = card.getBoundingClientRect().top;
        const stick = getStick(card);
        cardTops.push(top);
        if (top <= stick + 20) active = i;
      });

      navs.forEach((n, i) => {
        const isActive = i === active;
        n.classList.toggle('active', isActive);
        n.setAttribute('aria-current', isActive ? 'true' : 'false');
      });

      // Pie progress: each card fills its dot while it's the active sticky card.
      // We detect "active" by which card's top is at or above its sticky position.
      // Progress = how far past sticky / distance until next card takes over.
      pies.forEach((pie, i) => {
        const stick = getStick(cards[i]);
        const top = cardTops[i];
        const isStuck = top <= stick + 20;

        // Next card's sticky position (or a fallback for the last card)
        const nextTop = i < cards.length - 1 ? cardTops[i + 1] : null;
        const nextStick = i < cards.length - 1 ? getStick(cards[i + 1]) : stick + 300;

        // Is the NEXT card also stuck? Then this card is fully scrolled past.
        const nextIsStuck = nextTop !== null && nextTop <= nextStick + 20;

        let pct = 0;
        if (nextIsStuck) {
          // This card has been fully scrolled past
          pct = 100;
        } else if (isStuck && i === active) {
          // This card is currently active and stuck
          // Progress = how far the next card is from reaching its sticky position
          if (nextTop !== null) {
            // Distance the next card still needs to travel to reach its sticky pos
            const remaining = nextTop - nextStick;
            // Total distance it started from (card height approximation)
            const totalTravel = 400;
            pct = Math.round(Math.max(0, Math.min(1, 1 - (remaining / totalTravel))) * 100);
          } else {
            // Last card — use own scroll distance
            const scrolled = stick - top;
            pct = Math.round(Math.max(0, Math.min(1, scrolled / 300)) * 100);
          }
        }

        if (pct > 0) {
          pie.style.background = `conic-gradient(from 0deg, #17100e ${pct}%, rgba(23,16,14,0.12) ${pct}%)`;
        } else {
          pie.style.background = 'rgba(23,16,14,0.12)';
        }
      });
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { update(); ticking = false; });
        ticking = true;
      }
    }, { passive: true });

    navs.forEach((nav) => {
      nav.addEventListener('click', () => {
        const card = cards[parseInt((nav as HTMLElement).dataset.i || '0')];
        if (!card) return;
        const y = window.scrollY + card.getBoundingClientRect().top - getStick(card) + 1;
        const safeFn = (window as any).__safeScrollTo || window.scrollTo.bind(window);
        safeFn({ top: y, behavior: reducedMotion ? 'instant' : 'smooth' });
      });
    });

    update();
  })();
</script>
