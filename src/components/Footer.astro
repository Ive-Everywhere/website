---

<footer class="site-footer">
  <div class="footer-inner">
    <!-- Left side -->
    <div class="footer-left">
      <div style="display: flex; align-items: center; gap: 10px;">
        <img src="/images/logo.svg" alt="Eluu" style="width: 36px; height: 36px;" />
        <span style="font-family: 'Radio Canada Big', sans-serif; font-weight: 500; font-size: 26px; color: #000000; line-height: 1;">Eluu</span>
      </div>
      <div style="display: flex; align-items: center; gap: 16px;">
        <a href="#" aria-label="Twitter" style="color: #a3a3a3; display: flex;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" aria-label="LinkedIn" style="color: #a3a3a3; display: flex;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
      <span class="footer-copy">2025 Eluu AI — All rights reserved</span>
    </div>

    <!-- Right side -->
    <div class="footer-links">
      <a href="#">Terms of Service</a>
      <span class="footer-dot"></span>
      <a href="#">Privacy Policy</a>
      <span class="footer-dot"></span>
      <a href="#">Security</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #ffffff;
    padding: 48px 24px;
  }
  @media (min-width: 640px) { .site-footer { padding: 48px 40px; } }
  @media (min-width: 1024px) { .site-footer { padding: 64px 120px; } }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 1440px;
    margin: 0 auto;
  }
  @media (min-width: 768px) {
    .footer-inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer-copy {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #a3a3a3;
  }

  .footer-links {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .footer-links a {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    color: #a3a3a3;
    text-decoration: none;
  }
  .footer-links a:hover { color: #17100e; }
  .footer-dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #7c7c7c;
    display: inline-block;
  }
</style>
