---
import '../styles/footer.css';

const columns = [
  {
    label: 'Platform',
    links: [
      { text: 'Colleagues', href: '/features/colleagues' },
      { text: 'Integrations', href: '/features/integrations' },
      { text: 'Hard Drive', href: '/features/team-drive' },
      { text: 'Views', href: '/features/views' },
      { text: 'Jobs', href: '/features/jobs' },
      { text: 'Slack', href: '/features/slack' },
    ],
  },
  {
    label: 'Resources',
    links: [
      { text: 'Documentation', href: '#' },
      { text: 'Blog', href: '#' },
      { text: 'Changelog', href: '#' },
    ],
  },
];

const legal = [
  { text: 'Terms of Service', href: '/terms' },
  { text: 'Privacy Policy', href: '/privacy' },
  { text: 'Security', href: '/security' },
];
---

<footer class="sftr">
  <div class="sftr-container">

    <!-- ── CTA band ── -->
    <div class="sftr-cta-band">
      <h2 class="sftr-cta-heading">Your tools are already connected. Start in minutes.</h2>
      <p class="sftr-cta-sub">Set up your first AI colleague today. Free to start — no credit card required.</p>
      <div class="sftr-cta-actions">
        <a
          href="https://app.eluu.ai"
          class="sftr-cta sftr-cta-primary"
          onclick="window.posthog?.capture('get_started_clicked', { location: 'footer_cta' })"
        >Get started</a>
        <a
          href="https://cal.com/krishna-kaipa-wh7ao3/15min"
          class="sftr-cta sftr-cta-secondary"
          onclick="window.posthog?.capture('book_demo_clicked', { location: 'footer_cta' })"
        >Book a demo</a>
      </div>
    </div>

    <!-- ── Link columns ── -->
    <div class="sftr-columns">
      {columns.map((col) => (
        <div class="sftr-col">
          <h4 class="sftr-col-label">{col.label}</h4>
          <ul class="sftr-col-list">
            {col.links.map((link) => (
              <li><a href={link.href}>{link.text}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="sftr-col sftr-col-right">
        <div class="sftr-social">
          <a href="https://x.com/EluuAI" aria-label="X">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.linkedin.com/company/eluu/" aria-label="LinkedIn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
        </div>
        <ul class="sftr-legal">
          {legal.map((link) => (
            <li><a href={link.href}>{link.text}</a></li>
          ))}
        </ul>
      </div>
    </div>
    <div class="sftr-bottom">
      <div class="sftr-wordmark" data-parallax-wordmark>
        <img src="/images/logo.svg" alt="" class="sftr-wm-logo" />
        <span class="sftr-wm-text">Eluu AI</span>
      </div>
      <span class="sftr-copy">&copy; {new Date().getFullYear()} Eluu AI</span>
    </div>
  </div>
</footer>

<script>
  (function () {
    const wm = document.querySelector('[data-parallax-wordmark]') as HTMLElement;
    if (!wm || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    window.addEventListener('scroll', () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = wm.getBoundingClientRect();
        const vh = window.innerHeight;
        if (rect.top < vh && rect.bottom > 0) {
          const progress = (vh - rect.top) / (vh + rect.height);
          const shift = (progress - 0.5) * 30; // ±15px range
          wm.style.transform = `translateY(${shift}px)`;
        }
        ticking = false;
      });
    }, { passive: true });
  })();
</script>
