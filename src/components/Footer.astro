---
import '../styles/footer.css';

const legal = [
  { text: 'Terms of Service', href: '/terms' },
  { text: 'Privacy Policy', href: '/privacy' },
  { text: 'Security', href: '/security' },
];

const navLinks = [
  { text: 'Colleagues', href: '/features/colleagues' },
  { text: 'Integrations', href: '/features/integrations' },
  { text: 'Hard Drive', href: '/features/team-drive' },
  { text: 'Views', href: '/features/views' },
  { text: 'Jobs', href: '/features/jobs' },
  { text: 'Slack', href: '/features/slack' },
  { text: 'Pricing', href: '/pricing' },
];
---

<footer class="sftr">
  <div class="sftr-container">

    <!-- ── CTA band ── -->
    <div class="sftr-cta-band">
      <h2 class="sftr-cta-heading">Your AI workforce is waiting.</h2>
      <a href="https://app.eluu.ai" class="sftr-cta-big"
        onclick="window.posthog?.capture('get_started_clicked', { location: 'footer_cta' })"
      >Let's go</a>
    </div>

    <!-- ── Nav links row ── -->
    <div class="sftr-nav-row">
      {navLinks.map((link) => (
        <a href={link.href} class="sftr-nav-link">{link.text}</a>
      ))}
    </div>

  </div>
  <!-- ── Interactive dot grid — full viewport width ── -->
  <div class="sftr-dotgrid-wrap">
    <canvas id="sftr-dotgrid" class="sftr-dotgrid"></canvas>
  </div>
  <div class="sftr-container">

    <!-- ── Bottom bar: logo + legal + social + copyright ── -->
    <div class="sftr-bottom-bar">
      <div class="sftr-bottom-left">
        <div class="sftr-bottom-brand">
          <img src="/images/logo.svg" alt="Eluu" class="sftr-bottom-logo" />
          <span class="sftr-bottom-wordmark">Eluu AI</span>
        </div>
        <div class="sftr-bottom-links">
          {legal.map((link) => (
            <a href={link.href} class="sftr-bottom-link">{link.text}</a>
          ))}
        </div>
        <span class="sftr-copy">&copy; {new Date().getFullYear()} Eluu AI. All rights reserved.</span>
      </div>
      <div class="sftr-bottom-right">
        <!-- Who is Eluu? easter egg -->
        <div class="sftr-whois" id="sftr-whois">
          <button type="button" class="sftr-whois-trigger" id="sftr-whois-btn">Who is Eluu?</button>
          <div class="sftr-whois-popup" id="sftr-whois-popup">
            <div class="sftr-whois-content">
              <img src="/images/the-boys.webp" alt="The Eluu crew" class="sftr-whois-img" />
              <p class="sftr-whois-text">A research-obsessed crew. Four people building AI colleagues because we couldn't stop ourselves. Always looking for new ideas — hit us up.</p>
              <a href="https://cal.com/krishna-kaipa-wh7ao3/15min" class="sftr-whois-cta">Contact us</a>
            </div>
          </div>
        </div>

        <a href="https://x.com/EluuAI" aria-label="X" class="sftr-social-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="https://www.linkedin.com/company/eluu/" aria-label="LinkedIn" class="sftr-social-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

<script>
(function () {
  const canvas = document.getElementById('sftr-dotgrid') as HTMLCanvasElement;
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  if (!ctx) return;

  const SPACING = 30;
  const BASE_SIZE = 4;
  const DOT_COLOR = [200, 195, 185];
  const DOT_ALPHA = 0.45;
  const HOVER_RADIUS = 100;
  const TEXT = 'Eluu AI';
  const FONT_FAMILY = "'Jersey 10', cursive";

  interface Dot {
    ox: number; oy: number;
    currentSize: number; targetSize: number;
    currentAlpha: number; targetAlpha: number;
    seed: number; // unique random seed per dot
  }

  let dots: Dot[] = [];
  let textRect = { x: 0, y: 0, w: 0, h: 0 };
  let cols = 0;
  let rows = 0;
  let mouseX = -9999;
  let mouseY = -9999;
  let isHovering = false;
  let animId = 0;
  let isVisible = false;
  let canvasW = 0;
  let canvasH = 0;

  function resize() {
    const rect = canvas.parentElement!.getBoundingClientRect();
    const dpr = window.devicePixelRatio || 1;
    canvasW = rect.width;
    canvasH = rect.height;
    canvas.width = canvasW * dpr;
    canvas.height = canvasH * dpr;
    canvas.style.width = canvasW + 'px';
    canvas.style.height = canvasH + 'px';
    ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

    cols = Math.floor(canvasW / SPACING);
    rows = Math.floor(canvasH / SPACING);
    const offsetX = (canvasW - (cols - 1) * SPACING) / 2;
    const offsetY = (canvasH - (rows - 1) * SPACING) / 2;

    // Measure text bounding box for the clear rectangle
    const fontSize = Math.min(canvasW * 0.22, 200);
    ctx!.font = `${fontSize}px ${FONT_FAMILY}`;
    const metrics = ctx!.measureText(TEXT);
    const tw = metrics.width;
    const th = fontSize * 0.85;
    const pad = SPACING * 0.8;
    textRect = {
      x: canvasW / 2 - tw / 2 - pad,
      y: canvasH / 2 - th / 2 - pad,
      w: tw + pad * 2,
      h: th + pad * 2,
    };

    dots = [];
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = offsetX + c * SPACING;
        const y = offsetY + r * SPACING;

        // Skip dots inside the text rectangle
        if (x > textRect.x && x < textRect.x + textRect.w &&
            y > textRect.y && y < textRect.y + textRect.h) {
          continue;
        }

        dots.push({
          ox: x, oy: y,
          currentSize: BASE_SIZE,
          targetSize: BASE_SIZE,
          currentAlpha: DOT_ALPHA,
          targetAlpha: DOT_ALPHA,
          seed: Math.random(),
        });
      }
    }
  }

  function draw() {
    ctx!.clearRect(0, 0, canvasW, canvasH);

    // Draw "Eluu AI" — each character individually, lights up when cursor is near it
    const fontSize = Math.min(canvasW * 0.22, 200);
    ctx!.font = `${fontSize}px ${FONT_FAMILY}`;
    ctx!.textBaseline = 'middle';

    // Measure total width to center the text
    const totalWidth = ctx!.measureText(TEXT).width;
    let charX = canvasW / 2 - totalWidth / 2;
    const charY = canvasH / 2;

    for (let i = 0; i < TEXT.length; i++) {
      const ch = TEXT[i];
      const charWidth = ctx!.measureText(ch).width;
      const centerX = charX + charWidth / 2;

      let alpha = 0.12;
      if (isHovering) {
        const dx = mouseX - centerX;
        const dy = mouseY - charY;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const hitRadius = charWidth * 1.2 + 30;
        if (dist < hitRadius) {
          const t = 1 - dist / hitRadius;
          alpha = 0.12 + t * 0.6;
        }
      }

      ctx!.fillStyle = `rgba(237, 233, 227, ${alpha})`;
      ctx!.fillText(ch, charX, charY);
      charX += charWidth;
    }

    // Update + draw dots
    for (let i = 0; i < dots.length; i++) {
      const d = dots[i];

      // Calculate distance to cursor
      if (isHovering) {
        const dx = d.ox - mouseX;
        const dy = d.oy - mouseY;
        const dist = Math.sqrt(dx * dx + dy * dy);

        if (dist < HOVER_RADIUS) {
          // Random jitter: each dot gets its own random target size
          // Use a time-varying seed so dots keep jittering while cursor is near
          const jitter = Math.sin(Date.now() * 0.005 + d.seed * 100) * 0.5 + 0.5;
          const t = 1 - dist / HOVER_RADIUS;
          d.targetSize = BASE_SIZE + jitter * t * 6;
          d.targetAlpha = DOT_ALPHA + t * 0.4;
        } else {
          d.targetSize = BASE_SIZE;
          d.targetAlpha = DOT_ALPHA;
        }
      } else {
        d.targetSize = BASE_SIZE;
        d.targetAlpha = DOT_ALPHA;
      }

      // Ease toward target
      d.currentSize += (d.targetSize - d.currentSize) * 0.15;
      d.currentAlpha += (d.targetAlpha - d.currentAlpha) * 0.12;

      const s = d.currentSize;
      ctx!.fillStyle = `rgba(${DOT_COLOR[0]}, ${DOT_COLOR[1]}, ${DOT_COLOR[2]}, ${d.currentAlpha})`;
      ctx!.fillRect(d.ox - s / 2, d.oy - s / 2, s, s);
    }
  }

  function loop() {
    if (!isVisible) return;
    draw();
    animId = requestAnimationFrame(loop);
  }

  canvas.addEventListener('mousemove', (e) => {
    const rect = canvas.getBoundingClientRect();
    mouseX = e.clientX - rect.left;
    mouseY = e.clientY - rect.top;
    isHovering = true;
  });
  canvas.addEventListener('mouseleave', () => {
    isHovering = false;
    mouseX = -9999;
    mouseY = -9999;
  });

  const io = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting && !isVisible) {
        isVisible = true;
        loop();
      } else if (!entry.isIntersecting) {
        isVisible = false;
        cancelAnimationFrame(animId);
      }
    });
  }, { threshold: 0.05 });
  io.observe(canvas);

  resize();
  window.addEventListener('resize', () => { resize(); draw(); });
  draw();
})();

// Who is Eluu? popover — hover on desktop, tap on mobile
(function () {
  const wrap = document.getElementById('sftr-whois');
  const btn = document.getElementById('sftr-whois-btn');
  const popup = document.getElementById('sftr-whois-popup');
  if (!wrap || !btn || !popup) return;

  let closeTimer: ReturnType<typeof setTimeout> | null = null;
  const isTouch = 'ontouchstart' in window;

  if (!isTouch) {
    // Desktop: hover
    wrap.addEventListener('mouseenter', () => {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      popup.classList.add('open');
    });
    wrap.addEventListener('mouseleave', () => {
      closeTimer = setTimeout(() => popup.classList.remove('open'), 200);
    });
  }

  // Both: tap/click toggle (primary on mobile, backup on desktop)
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    popup.classList.toggle('open');
  });

  // Close on outside tap
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('#sftr-whois')) {
      popup.classList.remove('open');
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') popup.classList.remove('open');
  });
})();
</script>
