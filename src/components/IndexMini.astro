---
// Minimal index animation: Salesforce connect → sync → context ready.
// Self-contained; fills its parent via position:absolute inset:0.
---

<div class="im-stage" data-im-stage data-state="initial">
  <!-- Atmospheric background -->
  <img src="/images/cookbook-bg.webp" alt="" class="im-bg" aria-hidden="true" />

  <!-- Integration card -->
  <div class="im-card">
    <div class="im-card-head">
      <img src="/logos/integrations/salesforce.svg" alt="" class="im-logo" />
      <span class="im-name">Salesforce</span>
      <span class="im-btn" data-im-btn>
        <span class="im-btn-spinner"></span>
        <svg class="im-btn-check" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
        <span class="im-btn-label">Connect</span>
      </span>
    </div>
    <div class="im-progress">
      <div class="im-progress-fill"></div>
    </div>
  </div>

  <!-- Sync result chips -->
  <div class="im-chips">
    <div class="im-chip" style="--i:0">
      <span class="im-chip-num">1,284</span>
      <span class="im-chip-label">Contacts</span>
    </div>
    <div class="im-chip" style="--i:1">
      <span class="im-chip-num">327</span>
      <span class="im-chip-label">Deals</span>
    </div>
    <div class="im-chip" style="--i:2">
      <span class="im-chip-num">58</span>
      <span class="im-chip-label">Pipelines</span>
    </div>
  </div>
</div>

<style>
  .im-stage {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 14px;
    padding: 70px 18px 18px 18px;
    box-sizing: border-box;
    font-family: 'Söhne', sans-serif;
    overflow: hidden;
  }

  /* Atmospheric background — same painting used across animations for
     visual continuity. Sits behind content with a subtle darkening vignette. */
  .im-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .im-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center,
                                 rgba(19, 16, 10, 0.15) 0%,
                                 rgba(19, 16, 10, 0.55) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* Everything above the background/vignette */
  .im-card,
  .im-chips {
    position: relative;
    z-index: 2;
  }

  /* ── Integration card ── */
  .im-card {
    width: 100%;
    max-width: 280px;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.08);
    border-radius: 6px;
    padding: 12px 14px 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25),
                0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .im-card-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .im-logo {
    width: 22px;
    height: 22px;
    border-radius: 4px;
    background: #fff;
    padding: 2px;
    box-sizing: border-box;
  }

  .im-name {
    font-size: 13px;
    font-weight: 600;
    color: #ede9e3;
    flex: 1;
    letter-spacing: -0.01em;
  }

  /* ── Button — rides the state machine ── */
  .im-btn {
    font-family: inherit;
    font-size: 11px;
    font-weight: 500;
    padding: 5px 11px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    line-height: 1;
    letter-spacing: -0.005em;
    background: #ede9e3;
    color: #14120b;
    transition: background 0.35s ease, color 0.35s ease, padding 0.3s ease;
  }
  [data-state="connecting"] .im-btn {
    background: rgba(237, 233, 227, 0.08);
    color: rgba(237, 233, 227, 0.75);
  }
  [data-state="synced"] .im-btn {
    background: rgba(52, 199, 89, 0.14);
    color: #4ecd6a;
  }

  .im-btn-label {
    transition: opacity 0.2s ease;
  }

  .im-btn-spinner {
    width: 10px;
    height: 10px;
    border: 1.5px solid rgba(237, 233, 227, 0.2);
    border-top-color: rgba(237, 233, 227, 0.85);
    border-radius: 50%;
    display: none;
    animation: im-spin 0.7s linear infinite;
  }
  [data-state="connecting"] .im-btn-spinner { display: inline-block; }

  .im-btn-check {
    display: none;
  }
  [data-state="synced"] .im-btn-check { display: inline-block; }

  /* ── Progress bar ── */
  .im-progress {
    height: 2px;
    background: rgba(237, 233, 227, 0.07);
    border-radius: 2px;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease 0.05s;
  }
  [data-state="connecting"] .im-progress,
  [data-state="synced"] .im-progress {
    opacity: 1;
  }
  .im-progress-fill {
    height: 100%;
    width: 0%;
    background: #f54e00;
    transition: width 0s;
  }
  [data-state="connecting"] .im-progress-fill {
    width: 100%;
    transition: width 1.55s cubic-bezier(0.4, 0, 0.2, 1);
  }
  [data-state="synced"] .im-progress-fill {
    width: 100%;
    background: #4ecd6a;
    transition: background 0.35s ease;
  }

  /* ── Sync result chips ── */
  .im-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 300px;
  }
  .im-chip {
    font-size: 11px;
    color: rgba(237, 233, 227, 0.75);
    background: rgba(237, 233, 227, 0.04);
    border: 1px solid rgba(237, 233, 227, 0.08);
    border-radius: 4px;
    padding: 5px 9px;
    display: inline-flex;
    gap: 5px;
    align-items: baseline;
    letter-spacing: -0.005em;
    line-height: 1.3;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
    transition-delay: calc(var(--i) * 0.08s);
  }
  [data-state="synced"] .im-chip {
    opacity: 1;
    transform: translateY(0);
  }
  .im-chip-num {
    font-weight: 600;
    color: #ede9e3;
    font-size: 12px;
  }
  .im-chip-label {
    opacity: 0.7;
  }

  @keyframes im-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .im-btn, .im-btn-spinner, .im-progress, .im-progress-fill, .im-chip {
      transition: none;
      animation: none;
    }
  }
  @media (max-width: 480px) {
    .im-stage { padding: 28px 10px 10px; }
    .im-card { max-width: 220px; padding: 8px 10px; font-size: 11px; }
  }
</style>

<script>
  (function () {
    const stages = document.querySelectorAll<HTMLElement>('[data-im-stage]');
    stages.forEach((stage) => {
      const label = stage.querySelector<HTMLElement>('.im-btn-label');
      if (!label) return;

      const sequence = [
        { state: 'initial',    label: 'Connect',      ms: 1100 },
        { state: 'connecting', label: 'Connecting…',  ms: 1700 },
        { state: 'synced',     label: 'Synced',       ms: 2400 },
      ];
      let i = 0;
      let timerId: number | undefined;

      function tick() {
        const step = sequence[i];
        stage.dataset.state = step.state;
        label.textContent = step.label;
        timerId = window.setTimeout(() => {
          i = (i + 1) % sequence.length;
          tick();
        }, step.ms);
      }

      // Only run when card is on-screen (saves cycles and respects tab focus)
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            if (timerId === undefined) tick();
          } else {
            if (timerId !== undefined) {
              clearTimeout(timerId);
              timerId = undefined;
            }
          }
        });
      }, { threshold: 0.1 });
      io.observe(stage);
    });
  })();
</script>
