---
---
<div class="am-stage">
  <div class="am-window">
    <div class="am-topbar">
      <span class="am-tab">request.js</span>
    </div>
    <div class="am-code">
      <div class="am-line"><span class="am-kw">await</span> <span class="am-fn">eluu</span>.<span class="am-fn">run</span>({"{"}</div>
      <div class="am-line">&nbsp;&nbsp;colleague: <span class="am-str">"steve"</span>,</div>
      <div class="am-line">&nbsp;&nbsp;task: <span class="am-str">"Summarize this week's deals"</span></div>
      <div class="am-line">{"}"});</div>
    </div>
    <div class="am-divider"></div>
    <div class="am-response">
      <div class="am-res-header">
        <span class="am-status">200</span>
        <span class="am-ok">OK</span>
      </div>
      <div class="am-res-body">
        {"{"} output: <span class="am-str">"12 deals, $284K pipeline..."</span> {"}"}<span class="am-cursor"></span>
      </div>
    </div>
  </div>
</div>

<style>
  .am-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 24px 14px 14px; }
  .am-window { width: 100%; max-width: 310px; background: #1a1917; border-radius: 6px; border: 1px solid rgba(237,233,227,0.04); overflow: hidden; }
  .am-topbar { padding: 7px 12px; border-bottom: 1px solid rgba(237,233,227,0.04); }
  .am-tab { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 10px; color: rgba(237,233,227,0.35); }
  .am-code { padding: 10px 12px; display: flex; flex-direction: column; gap: 2px; }
  .am-line { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 10px; color: rgba(237,233,227,0.45); line-height: 1.6; }
  .am-kw { color: #c678dd; }
  .am-fn { color: #61afef; }
  .am-str { color: #98c379; }
  .am-divider { height: 1px; background: rgba(237,233,227,0.04); }
  .am-response { padding: 8px 12px; }
  .am-res-header { display: flex; align-items: center; gap: 6px; margin-bottom: 4px; }
  .am-status { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 10px; font-weight: 600; color: #98c379; }
  .am-ok { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 10px; color: rgba(237,233,227,0.3); }
  .am-cursor { display: inline-block; width: 5px; height: 11px; background: rgba(237,233,227,0.4); vertical-align: middle; margin-left: 2px; animation: am-blink 1s step-end infinite; }
  @keyframes am-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
  .am-res-body { font-family: 'SF Mono', 'Fira Code', monospace; font-size: 10px; color: rgba(237,233,227,0.4); line-height: 1.5; }
</style>
