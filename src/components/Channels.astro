---
import WebMini from './WebMini.astro';
import SlackMini from './SlackMini.astro';
import ApiMini from './ApiMini.astro';
import TriggerMini from './TriggerMini.astro';
---

<section class="ch">
  <div class="ch-container">

    <div class="ch-intro">
      <h2 class="ch-heading">How you can interact with Eluu</h2>
    </div>

    <div class="ch-grid">

      <article class="ch-card reveal">
        <div class="ch-text">
          <h3 class="ch-title">Web app</h3>
          <p class="ch-desc">Chat with your colleagues, review outputs, and manage everything from the browser.</p>
        </div>
        <div class="ch-media">
          <div class="ch-media-box">
            <WebMini />
          </div>
        </div>
      </article>

      <article class="ch-card reveal">
        <div class="ch-text">
          <h3 class="ch-title">Slack</h3>
          <p class="ch-desc">Talk to your colleagues right where your team already works. No tab-switching.</p>
        </div>
        <div class="ch-media">
          <div class="ch-media-box">
            <SlackMini />
          </div>
        </div>
      </article>

      <article class="ch-card reveal">
        <div class="ch-text">
          <h3 class="ch-title">API</h3>
          <p class="ch-desc">Trigger colleagues from your own code, scripts, or pipelines — programmatically.</p>
        </div>
        <div class="ch-media">
          <div class="ch-media-box">
            <ApiMini />
          </div>
        </div>
      </article>

      <article class="ch-card reveal">
        <div class="ch-text">
          <h3 class="ch-title">Scheduled triggers</h3>
          <p class="ch-desc">Colleagues run on a schedule, on events, or triggered by an incoming email.</p>
        </div>
        <div class="ch-media">
          <div class="ch-media-box">
            <TriggerMini />
          </div>
        </div>
      </article>

    </div>
  </div>
</section>

<style>
  .ch {
    background: #13100a;
    padding: 56px 0 80px;
  }

  .ch-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  .ch-intro {
    margin-bottom: 22.4px;
  }

  .ch-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  /* ── Grid: 4 cols on desktop ── */
  .ch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .ch-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1080px) {
    .ch-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Card ── */
  .ch-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #1e1d1b;
    border-radius: 4px;
    padding: 20px;
    overflow: hidden;
    box-sizing: border-box;
  }
  .ch-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
  }

  .ch-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 48ch;
  }

  .ch-title {
    font-family: 'Söhne', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .ch-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.45;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }

  .ch-media {
    padding-top: 17.5px;
    flex: 1;
  }

  .ch-media-box {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 260px;
    background: #161514 url('/images/cookbook-bg.webp') center / cover no-repeat;
    border-radius: 4px;
    overflow: hidden;
  }

  /* ── Responsive ── */
  @media (max-width: 639px) {
    .ch { padding: 32px 0 48px; }
    .ch-heading { font-size: 20px; }
    .ch-card { padding: 14px; }
    .ch-title { font-size: 14px; }
    .ch-desc { font-size: 13px; }
    .ch-media-box { min-height: 220px; }
    .ch-media { padding-top: 12px; }
  }
</style>
