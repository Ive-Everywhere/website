---
/**
 * Recipes — Ona-style card: the section is one full-bleed image card (the
 * pastel field rendered as glowing ASCII on the brand maroon — nature, made
 * futuristic), heading top-left in band ink, and a light template panel on
 * the right listing the cross-tool work agents take over.
 */
const recipes = [
  { icon: 'ri-arrow-left-right-line', label: 'Reconcile month-end close' },
  { icon: 'ri-git-pull-request-line', label: 'Fix incidents, ship the PR' },
  { icon: 'ri-user-search-line', label: 'Source and screen candidates' },
  { icon: 'ri-file-chart-line', label: 'Draft the board pack' },
  { icon: 'ri-line-chart-line', label: 'Forecast the quarter' },
  { icon: 'ri-customer-service-2-line', label: 'Triage the ticket queue' },
  { icon: 'ri-file-user-line', label: 'Prep every account brief' },
  { icon: 'ri-team-line', label: 'Synthesize interview debriefs' },
];
---

<section class="bg-bg-white-0">
  <div class="page-shell gutter-188 py-14">
    <div class="relative overflow-hidden rounded-[28px]">
      <img
        src="/brand/ascii-field.webp"
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute inset-0 size-full object-cover"
      />
      {/* soft scrim so the heading always sits on quiet ground */}
      <div
        class="absolute inset-0"
        style="background:radial-gradient(70% 90% at 18% 22%, rgba(25,15,22,.55), rgba(25,15,22,0) 65%);"
      ></div>

      <div class="relative flex flex-col gap-10 p-6 lg:flex-row lg:items-center lg:justify-between lg:gap-16 lg:p-[56px]">
        <h2 class="t-landing-h3 max-w-[440px] text-balance text-white lg:self-start">
          What humans can achieve with Eluu agents.
        </h2>

        <div class="bg-bg-white-0 w-full rounded-[20px] px-6 py-3 shadow-2xl lg:max-w-[500px] lg:px-8 lg:py-5">
          <ul class="flex flex-col">
            {
              recipes.map((recipe) => (
                <li class="border-stroke-soft-200 flex items-center gap-4 border-b py-[15px] last:border-b-0">
                  <i
                    class={`${recipe.icon} text-icon-sub-600 shrink-0 text-[22px]`}
                    aria-hidden="true"
                  />
                  <span class="t-label-md text-text-strong-950">{recipe.label}</span>
                </li>
              ))
            }
          </ul>
          <a
            href="/use-cases"
            class="t-label-md text-primary-base hover:text-primary-dark border-stroke-soft-200 mt-1 inline-flex w-full items-center gap-2 border-t pt-4 pb-2 transition-colors"
          >
            Explore all use cases <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
