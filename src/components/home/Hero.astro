---
import Button from '../ui/Button.astro';

/**
 * Hero — Figma `147:3084` (§1b of home-spec.md).
 * Section: column, gap 56, padding 32/187/64, fill #F8F8F3 → `bg-bg-white-0`.
 *
 * Figma is desktop-1600 only (contract rule 7), so every fixed width below is a
 * `max-w-` with a fluid fallback.
 *
 * The product mock Figma draws statically is supplied by the `hero-stack`
 * animation instead (see below), so this file holds only the copy block.
 */
---

<section class="bg-bg-white-0">
  {/* Figma's 32px top padding sits under a sticky header, so the H1 crowded the
      nav. Doubled to 64px. */}
  <div class="page-shell gutter-187 flex flex-col items-center gap-10 pt-16 lg:gap-14">
    {/* 147:3086 → 147:3087 → 147:3088 */}
    <div class="flex w-full flex-col items-center gap-7">
      {/* 147:3088 caps the whole block at 742px, which fitted Figma's shorter
          headline. Krishna's copy needs a wider measure than that or its second
          line wraps a third time, so the cap now sits on each child: the
          heading gets the room it needs, the paragraph keeps the drawn 742. */}
      <div class="flex w-full flex-col items-center gap-3">
        {/* 147:3089 drew "Specialist agents / to run your business." This is
            Krishna's replacement copy (2026-08-05) and supersedes Figma, so it
            is authored rather than transcribed — no `copy-needed` marker.

            The break he wrote falls after "scale,". It is suppressed below
            `lg`, where each half already wraps on its own and a forced break
            would produce four ragged lines. */}
        <h1 class="t-landing-h1 text-text-strong-950 max-w-[920px] text-center text-balance">
          The agentic team for your human team
        </h1>

        {/* 147:3090. The break is a literal U+2028 LINE SEPARATOR after
            "…whole tool stack. " — rendered as a real break above `lg` only. */}
        <p class="t-paragraph-md text-text-sub-600 max-w-[742px] text-center text-pretty">
          AI teams that run end-to-end work across your tools.<br class="hidden lg:inline" />{' '}Available 24x7 via web, Slack, or phone.
        </p>
      </div>

      {/* 147:3091 */}
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button
          variant="primary-fancy"
          label="Start for free"
          rightIcon="ri-arrow-right-up-long-line"
          href="https://app.eluu.ai/signup"
        />
        <Button
          variant="neutral-lighter"
          label="Book a demo"
          leftIcon="ri-calendar-line"
          href="https://cal.com/krishna-kaipa-wh7ao3/30min"
        />
      </div>
    </div>

    {/*
        The live-windows stage (2026-08-17, replaces the hero-stack deck).

        `/live/hero-windows.html` is a self-contained 1500×904 stage: the real
        product across three surfaces — desktop workspace (real app export),
        Slack thread (animated reveal), and a phone running an Eluu-built app
        (lock screen → notification → approve → summary → dashboard loop) —
        with a macOS-style team dock that swaps all three windows per team.
        Windows are draggable by their chrome. The stage scales itself to its
        frame width (ResizeObserver inside the document), so the aspect box
        here is all the page needs to provide.

        Below `lg` the live stage would scale past legibility (incident.io
        makes the same trade), so it is replaced by a static poster capture.
    */}
  </div>

  {/*
      The stage lives OUTSIDE the padded shell — incident.io's stage runs
      nearly full-viewport and inside `gutter-187` ours read small beside it.
      A sibling wrapper with plain auto margins is the only centering
      mechanism, so no parent width can skew it (a left-1/2/-translate
      breakout inside the shell measured 107px off-viewport once the shell
      grew to fit the child — never again). The stage document scales itself
      to fill whatever width this box gives it, including past its 1500px
      design size on wide screens.
  */}
  <div class="pt-10 pb-16 lg:pt-14">
    {/* live stage — lg and up */}
    <div class="relative mx-auto hidden w-[min(1720px,100vw-80px)] lg:block" style="aspect-ratio:1500/904">
      <iframe
        src="/live/hero-windows.html"
        title="The Eluu product across three live windows: the desktop workspace, a Slack thread, and a phone running an app an Eluu colleague built. A dock below switches the whole scene between Finance, Sales, Customer Engineering, and People teams."
        loading="eager"
        scrolling="no"
        class="absolute inset-0 size-full border-0"
      ></iframe>
    </div>
    {/* static poster — below lg */}
    <div class="px-6 sm:px-10 lg:hidden">
      <img
        src="/live/assets/hero-windows-poster.webp"
        alt="The Eluu product across three windows: the desktop workspace, a Slack thread where the Finance colleague reports the month-end close, and a phone running the Approvals app it built."
        width="1500"
        height="904"
        loading="eager"
        class="block w-full rounded-2xl"
      />
    </div>
  </div>
</section>
