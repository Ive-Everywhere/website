---
/**
 * Pillars — Modal "production cloud" 2×2 grid.
 * Only the ILLUSTRATION is enclosed (fixed-dimension placeholder, 600×400).
 * Eyebrow + headline + sub sit below it, unenclosed, like Modal.
 * Copy = the approved Ona-voice pillar bodies (headline = first fragment,
 * sub = second fragment).
 */

interface Pillar {
  eyebrow: string;
  title: string;
  body: string;
}

const pillars: Pillar[] = [
  {
    eyebrow: 'Agents',
    title: 'Hand off the work that eats your hours.',
    body: "Agents run it end to end, while you're at your desk or on the couch.",
  },
  {
    eyebrow: 'Apps',
    title: 'Software your whole team actually uses.',
    body: 'Agents build the dashboards, trackers, and internal tools, and keep them live.',
  },
  {
    eyebrow: 'Context',
    title: 'Wired into every system you run.',
    body: 'Agents pull from all of them to deliver the result you asked for.',
  },
  {
    eyebrow: 'Security',
    title: 'Under your lock and key.',
    body: 'Runs in your environment, every action scoped, logged, and auditable.',
  },
];
---

<section class="bg-bg-white-0">
  <div class="page-shell gutter-188 flex flex-col gap-10 py-14">
    <div class="flex flex-col gap-3">
      <h2 class="t-landing-h3 text-text-strong-950 text-balance">The AI team you dreamed of.</h2>
      <p class="t-landing-h3 text-text-soft-400 text-balance">
        Connects your systems. Learns your work. Gets it done.
      </p>
    </div>

    <div class="grid gap-x-6 gap-y-12 lg:grid-cols-2">
      {
        pillars.map((p) => (
          <div class="flex flex-col gap-5">
            <div class="border-stroke-sub-300 bg-bg-weak-50 flex aspect-[3/2] w-full items-center justify-center rounded-[16px] border border-dashed">
              <span class="t-label-xs text-text-soft-400 font-mono uppercase tracking-[0.08em]">
                Illustration · 600 × 400
              </span>
            </div>
            <div class="flex flex-col gap-2">
              <span class="t-label-xs text-text-soft-400 font-mono uppercase tracking-[0.08em]">
                {p.eyebrow}
              </span>
              <h3 class="t-h6 text-text-strong-950">{p.title}</h3>
              <p class="t-label-md text-text-sub-600 text-pretty max-w-[46ch]">{p.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
