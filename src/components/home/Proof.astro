---
/**
 * Testimonial + outcome stats. A heading (separates it from the teams section),
 * a full-width quote card (max two short sentences), then three stat cards.
 * Quote/numbers are the approved CRO story (2026-08-14), role-attributed.
 */
const stats = [
  { icon: 'ri-robot-2-line', value: '95%', label: 'Manual work reduced' },
  { icon: 'ri-rocket-line', value: '5x', label: 'Team productivity' },
  { icon: 'ri-flashlight-line', value: '1 day', label: 'To agent readiness' },
];
---

<section class="bg-bg-white-0">
  <div class="page-shell gutter-188 flex flex-col gap-8 py-14 lg:gap-12">
    <h2 class="t-landing-h3 text-text-strong-950 text-balance">Teams already running on Eluu.</h2>

    <figure
      class="bg-card-surface flex flex-col items-center justify-center gap-6 rounded-[28px] px-6 py-10 text-center lg:gap-8 lg:px-10 lg:py-[60px]"
    >
      <blockquote class="t-h4 text-text-strong-950 max-w-[900px] text-balance">
        Six months ago we had zero agents. Today my team runs 30-plus, and the cross-tool
        work that ate my reps’ weeks now takes minutes.
      </blockquote>
      <figcaption class="t-label-md text-text-sub-600">CRO at a leading SaaS</figcaption>
    </figure>

    <div class="grid gap-6 sm:grid-cols-3 lg:gap-9">
      {
        stats.map((stat) => (
          <div class="bg-card-surface flex flex-col gap-5 rounded-[28px] p-6 lg:p-10">
            <i class={`${stat.icon} text-icon-strong-950 text-[28px]`} aria-hidden="true" />
            <p class="t-h4 text-text-strong-950">{stat.value}</p>
            <p class="t-h6 text-text-soft-400">{stat.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
