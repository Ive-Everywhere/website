---
---
<section class="py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-6">
    <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-2">
      Customise Eluu to your workflows
    </h2>
    <p class="text-[#6B6B6B] mb-12 max-w-xl">
      Recurring tasks, report formats, data sources. Configure once — your colleagues remember.
    </p>

    <div class="grid md:grid-cols-2 gap-8">
      <!-- Left: Slack conversation mockup -->
      <div class="bg-[#E8E3DA] rounded-2xl p-6 overflow-hidden">
        <div class="bg-[#3C1F3E] rounded-xl p-4 text-white space-y-4">
          <!-- User message -->
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded bg-green-500 flex-shrink-0 flex items-center justify-center text-xs font-bold">LK</div>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-semibold text-sm">Likith Kumar</span>
                <span class="text-xs text-white/50">Jan 7th at 6:25 PM</span>
              </div>
              <p class="text-sm leading-relaxed">
                Hey <span class="text-blue-300">@Eluu</span><br/>
                Process these notes from my call with Mike (CEO of Vortex):<br/>
                He loved the demo. Said they are ready to sign but need legal review first. He mentioned his daughter is starting at Stanford next week, send a gift? Also, he introduced me to his CTO, Jen, need to add her to the deal. Remind me to call legal on Tuesday to prep the contract. Oh, and I need to buy cat food on the way home.
              </p>
              <div class="flex items-center gap-2 mt-2">
                <span class="bg-white/10 rounded px-2 py-0.5 text-xs flex items-center gap-1">&#x2705; 1</span>
                <span class="bg-white/10 rounded px-2 py-0.5 text-xs">&#x1F60A;</span>
              </div>
              <p class="text-xs text-white/40 mt-1">2 replies</p>
            </div>
          </div>
          <!-- Bot reply -->
          <div class="flex items-start gap-3">
            <svg width="24" height="24" viewBox="0 0 32 32" fill="none" class="flex-shrink-0"><rect width="32" height="32" rx="8" fill="white"/><rect x="10" y="8" width="4" height="16" rx="2" fill="#3C1F3E"/><rect x="18" y="8" width="4" height="16" rx="2" fill="#3C1F3E"/></svg>
            <div>
              <div class="flex items-center gap-2 mb-1">
                <span class="font-semibold text-sm">Eluu</span>
                <span class="bg-blue-500/20 text-blue-300 text-[10px] px-1.5 py-0.5 rounded">APP</span>
                <span class="text-xs text-white/50">Jan 7th at 6:25 PM</span>
              </div>
              <p class="text-sm leading-relaxed">
                On it, <span class="text-blue-300">@Likith Kumar</span>. I've processed your call notes with Mike and extracted the actionable items.
              </p>
            </div>
          </div>
        </div>
        <p class="mt-4 font-semibold text-lg">Live in Slack, like real teammates</p>
        <p class="text-sm text-[#6B6B6B] mt-1">
          Send tasks, ask questions, get files back. They update you, ask for clarification, and deliver work in your channels.
        </p>
      </div>

      <!-- Right: Abilities panel mockup -->
      <div class="bg-[#E8E3DA] rounded-2xl p-6">
        <div class="bg-white rounded-xl p-5 shadow-sm">
          <div class="flex items-center justify-between mb-5">
            <div class="flex items-center gap-2">
              <span class="font-semibold">Abilities</span>
              <svg class="w-4 h-4 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-width="2" d="M12 16v-4m0-4h.01"/></svg>
            </div>
            <a href="#" class="text-sm text-green-700 font-medium">Browse market &#x2192;</a>
          </div>
          <div class="space-y-4">
            <!-- Website Scraper ability -->
            <div class="border border-black/10 rounded-xl p-4">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-semibold text-sm">Website Scraper</h4>
                <span class="text-xs text-[#6B6B6B]">4 actions &#x203A;</span>
              </div>
              <p class="text-sm text-[#6B6B6B] mb-3">Enable complex web page scraping in one click</p>
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded bg-orange-100 flex items-center justify-center">
                  <div class="w-4 h-4 rounded-sm bg-orange-400"></div>
                </div>
                <div class="w-7 h-7 rounded bg-yellow-100 flex items-center justify-center">
                  <div class="w-4 h-4 rounded-full bg-yellow-400"></div>
                </div>
              </div>
            </div>
            <!-- Add ability button -->
            <button class="w-full border border-dashed border-black/20 rounded-xl py-3 text-sm text-[#6B6B6B] hover:bg-black/5 transition-colors">
              Add ability +
            </button>
            <!-- Contact Enrichment ability -->
            <div class="border border-black/10 rounded-xl p-4">
              <div class="flex items-center justify-between mb-2">
                <h4 class="font-semibold text-sm">Contact Enrichment</h4>
                <span class="text-xs text-[#6B6B6B]">4 actions &#x203A;</span>
              </div>
              <p class="text-sm text-[#6B6B6B] mb-3">Find phone numbers and emails for anyone</p>
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded bg-purple-100 flex items-center justify-center">
                  <div class="w-4 h-4 rounded-sm bg-purple-400"></div>
                </div>
                <div class="w-7 h-7 rounded bg-teal-100 flex items-center justify-center">
                  <div class="w-4 h-4 rounded-full bg-teal-400"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="mt-4 font-semibold text-lg">Equip abilities in one click</p>
        <p class="text-sm text-[#6B6B6B] mt-1">
          Pre-built tool bundles — scrapers, data providers, best practices, outreach kits. Add to any colleague instantly. No setup.
        </p>
      </div>
    </div>
  </div>
</section>
