---
---
<section class="relative py-24 md:py-32 overflow-hidden">
  <!-- Background: sunset flowers scene - gradient placeholder -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-b from-amber-200/60 via-pink-200/40 to-purple-300/50"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-orange-200/30 via-pink-100/20 to-purple-200/40"></div>
    <!-- Decorative blurred elements for flower-like look -->
    <div class="absolute bottom-0 left-10 w-48 h-48 bg-orange-400/20 rounded-full blur-2xl"></div>
    <div class="absolute bottom-0 right-20 w-64 h-64 bg-purple-400/20 rounded-full blur-3xl"></div>
    <div class="absolute top-10 left-1/4 w-32 h-32 bg-pink-400/15 rounded-full blur-2xl"></div>
    <div class="absolute bottom-10 left-1/3 w-40 h-40 bg-orange-300/20 rounded-full blur-2xl"></div>
    <div class="absolute top-1/4 right-1/4 w-56 h-56 bg-purple-300/15 rounded-full blur-3xl"></div>
  </div>

  <div class="relative z-10 text-center max-w-3xl mx-auto px-6">
    <h2 class="text-3xl md:text-5xl font-bold tracking-tight mb-2 text-[#1A1A1A]">
      The future of work is here.
    </h2>
    <p class="text-3xl md:text-5xl font-bold tracking-tight mb-10 text-[#1A1A1A]">
      Work with your first AI colleague today
    </p>
    <div class="flex items-center justify-center gap-4">
      <a href="#" class="px-8 py-3 rounded-full bg-[#1A1A1A] text-white font-medium hover:bg-black transition-colors">
        Get started
      </a>
      <a href="#" class="px-8 py-3 rounded-full border border-black/30 bg-white/50 backdrop-blur-sm font-medium hover:bg-white/70 transition-colors">
        Sign in
      </a>
    </div>
  </div>
</section>
