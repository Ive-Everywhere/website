---

<section style="background: #13100a;">
  <div class="cta-container">
    <div class="cta-content">
      <h2 class="cta-heading">Your tools are already connected. Start in minutes.</h2>
      <p class="cta-sub">Set up your first AI colleague today. Free to start — no credit card required.</p>
      <div class="cta-buttons">
        <a
          href="https://app.eluu.ai"
          class="cta-btn cta-btn-dark"
          onclick="window.posthog?.capture('get_started_clicked', { location: 'cta_footer' })"
        >Get started</a>
        <a
          href="https://cal.com/krishna-kaipa-wh7ao3/15min"
          class="cta-btn cta-btn-light"
          onclick="window.posthog?.capture('book_demo_clicked', { location: 'cta_footer' })"
        >Book a demo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-container {
    position: relative;
    overflow: hidden;
    min-height: 280px;
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  @media (min-width: 640px) { .cta-container { min-height: 360px; } }
  @media (min-width: 1024px) { .cta-container { min-height: 500px; } }

  /* bg image and overlay removed */
  .cta-content {
    position: relative;
    z-index: 2;
    padding: 40px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: inherit;
  }
  @media (min-width: 640px) { .cta-content { padding: 56px 40px; } }
  @media (min-width: 1024px) { .cta-content { padding: 80px 48px; } }

  .cta-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 5vw, 48px);
    letter-spacing: -1px;
    color: #ffffff;
    line-height: 1.1;
    margin: 0;
    max-width: 100%;
  }
  .cta-sub {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(14px, 2vw, 16px);
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.3;
    margin: 12px 0 0;
    opacity: 1;
    max-width: 100%;
  }
  .cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .cta-btn {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    font-weight: 400;
    padding: 0.89em 1.45em;
    border-radius: 9999px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cta-btn:hover {
    transform: translateY(-1px);
  }
  .cta-btn-dark { color: #14120b; background: #ede9e3; border: 1px solid #ede9e3; }
  .cta-btn-dark:hover { box-shadow: 0 4px 16px rgba(237, 233, 227, 0.15); }
  .cta-btn-light { color: #ede9e3; background: transparent; border: 1px solid rgba(237, 233, 227, 0.2); }
  .cta-btn-light:hover { box-shadow: 0 4px 16px rgba(237, 233, 227, 0.1); }

  /* Very small screens (360px) */
  @media (max-width: 400px) {
    .cta-content { padding: 32px 16px; }
    .cta-btn { padding: 10px 20px; font-size: 13px; }
    .cta-buttons { gap: 8px; }
  }
</style>
