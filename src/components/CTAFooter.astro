---
---

<section style="background: #f4f3ec;">
  <div class="cta-container">
    <img src="/images/cta-bg.jpg" alt="" aria-hidden="true" class="cta-bg" />
    <div class="cta-overlay"></div>
    <div class="cta-content">
      <h2 class="cta-heading">Your tools are already connected. Start in minutes.</h2>
      <p class="cta-sub">Set up your first AI colleague today. Free to start — no credit card required.</p>
      <div class="cta-buttons">
        <a href="https://app.eluu.ai" class="cta-btn cta-btn-dark">Get started</a>
        <a href="https://app.eluu.ai" class="cta-btn cta-btn-light">Book a demo</a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-container {
    position: relative;
    overflow: hidden;
    min-height: 280px;
  }
  @media (min-width: 640px) { .cta-container { min-height: 360px; } }
  @media (min-width: 1024px) { .cta-container { min-height: 500px; } }

  .cta-bg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .cta-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(23, 16, 14, 0.25) 0%,
      rgba(23, 16, 14, 0.45) 100%
    );
  }
  .cta-content {
    position: relative;
    z-index: 2;
    padding: 40px 20px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: inherit;
  }
  @media (min-width: 640px) { .cta-content { padding: 56px 40px; } }
  @media (min-width: 1024px) { .cta-content { padding: 80px 48px; } }

  .cta-heading {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(24px, 5vw, 48px);
    letter-spacing: -1px;
    color: #ffffff;
    line-height: 1.1;
    margin: 0;
    max-width: 100%;
  }
  .cta-sub {
    font-family: 'Inter', sans-serif;
    font-size: clamp(14px, 3vw, 30px);
    color: #ffffff;
    line-height: 1.3;
    margin: 12px 0 0;
    opacity: 0.9;
    max-width: 100%;
  }
  .cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 28px;
    flex-wrap: wrap;
  }
  .cta-btn {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 500;
    padding: 10px 24px;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .cta-btn:hover {
    transform: translateY(-1px);
  }
  @media (min-width: 640px) {
    .cta-btn { font-size: 15px; padding: 10px 48px; }
  }
  .cta-btn-dark { color: #ffffff; background: #17100e; }
  .cta-btn-dark:hover { box-shadow: 0 4px 16px rgba(23, 16, 14, 0.3); }
  .cta-btn-light { color: #17100e; background: #ffffff; }
  .cta-btn-light:hover { box-shadow: 0 4px 16px rgba(255, 255, 255, 0.3); }

  /* Very small screens (360px) */
  @media (max-width: 400px) {
    .cta-content { padding: 32px 16px; }
    .cta-btn { padding: 10px 20px; font-size: 13px; }
    .cta-buttons { gap: 8px; }
  }
</style>
