---
// Memory animation — persistent prompt card + 3 persistent chip slots.
// Only the text inside each slot swaps when cycling through recall pairs.
// No typing, no cursor, no fade-in. Just smooth text slide-up between states.
interface Slide {
  prompt: string;
  chips: [string, string, string];
}
const slides: Slide[] = [
  {
    prompt: 'prep for the Acme call',
    chips: ['Last call: 2w ago', 'Deal: $280K', 'Blocker: pricing'],
  },
  {
    prompt: "what's my 3pm about?",
    chips: ['James Chen', 'Q2 forecast review', 'Owes him the deck'],
  },
  {
    prompt: 'draft the QBR deck',
    chips: ['12 deals closed', '3 churn risks', 'Expansion targets'],
  },
];

// For each chip slot (0..2), collect the three variants across slides.
const chipVariants: [string, string, string][] = [0, 1, 2].map(
  (col) => [slides[0].chips[col], slides[1].chips[col], slides[2].chips[col]]
) as [string, string, string][];
---

<div class="mm-stage" data-mm-stage>
  <img src="/images/cookbook-bg.png" alt="" class="mm-bg" aria-hidden="true" />

  <!-- Persistent prompt card -->
  <div class="mm-card">
    <div class="mm-slot">
      {slides.map((slide, idx) => (
        <span class={`mm-text${idx === 0 ? ' active' : ''}`} data-idx={idx}>{slide.prompt}</span>
      ))}
    </div>
  </div>

  <!-- Persistent chip slots — all chips laid out; text inside swaps -->
  <div class="mm-chips">
    {chipVariants.map((variants, col) => (
      <div class="mm-chip" style={`--stagger:${(col + 1) * 60}ms`}>
        <div class="mm-slot mm-chip-slot">
          {variants.map((text, idx) => (
            <span class={`mm-text${idx === 0 ? ' active' : ''}`} data-idx={idx}>{text}</span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .mm-stage {
    position: absolute;
    inset: 0;
    box-sizing: border-box;
    font-family: 'Söhne', sans-serif;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 12px;
    padding: 70px 18px 18px 18px;
  }

  .mm-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .mm-stage::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center,
                                 rgba(19, 16, 10, 0.15) 0%,
                                 rgba(19, 16, 10, 0.55) 100%);
    z-index: 1;
    pointer-events: none;
  }

  /* ── Prompt card — static ── */
  .mm-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 280px;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.08);
    color: #ede9e3;
    padding: 10px 14px;
    border-radius: 6px;
    font-size: 13px;
    letter-spacing: -0.01em;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.25),
                0 1px 2px rgba(0, 0, 0, 0.2);
    display: flex;
    justify-content: center;
  }

  /* ── Text slot — named grid area forces all variants into one cell.
     Locked to one line height so containers never grow to fit multiple. ── */
  .mm-slot {
    position: relative;
    display: grid;
    grid-template-areas: "content";
    overflow: hidden;
    line-height: 1.3;
    height: 1.3em;
  }
  /* Chip slots must shrink to content width (not stretch) */
  .mm-chip-slot {
    display: inline-grid;
  }
  .mm-text {
    grid-area: content;
    /* Center the active variant within the grid cell — the cell auto-sizes
       to the widest variant, so shorter variants would otherwise be
       left-aligned and appear off-center within their card/chip. */
    justify-self: center;
    align-self: center;
    opacity: 0;
    transform: translateY(100%);
    transition: opacity 0.42s ease,
                transform 0.62s cubic-bezier(0.25, 1, 0.5, 1);
    transition-delay: var(--stagger, 0ms);
    font-size: 13px;
    letter-spacing: -0.01em;
    color: inherit;
    white-space: nowrap;
    pointer-events: none;
    will-change: transform, opacity;
  }
  .mm-text.active {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .mm-text.post {
    opacity: 0;
    transform: translateY(-100%);
  }

  /* ── Chips row ── */
  .mm-chips {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: center;
    max-width: 280px;
  }

  .mm-chip {
    color: rgba(237, 233, 227, 0.85);
    background: rgba(237, 233, 227, 0.05);
    border: 1px solid rgba(237, 233, 227, 0.09);
    border-radius: 4px;
    padding: 5px 9px;
    line-height: 1.3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .mm-chip-slot .mm-text {
    font-size: 11.5px;
    color: inherit;
  }

  @media (prefers-reduced-motion: reduce) {
    .mm-text {
      transition: none;
    }
  }
  @media (max-width: 480px) {
    .mm-stage { padding: 36px 12px 12px; }
  }
</style>

<script>
  (function () {
    const stages = document.querySelectorAll<HTMLElement>('[data-mm-stage]');
    stages.forEach((stage) => {
      const slots = Array.from(stage.querySelectorAll<HTMLElement>('.mm-slot'));
      if (slots.length === 0) return;

      const slotVariants = slots.map((slot) =>
        Array.from(slot.querySelectorAll<HTMLElement>('.mm-text'))
      );
      const slideCount = slotVariants[0].length;

      const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

      // runToken pattern — see ExecuteMini for explanation. Prevents concurrent
      // loops after rapid scroll-in/scroll-out causing text overlap.
      let token = 0;

      // Restore all variants to pristine state so every loop() starts clean
      // regardless of how a previous run terminated.
      function resetVariants() {
        slotVariants.forEach((variants) => {
          variants.forEach((v, i) => {
            v.classList.remove('active', 'post');
            if (i === 0) v.classList.add('active');
          });
        });
      }

      async function loop() {
        const myToken = ++token;
        resetVariants();
        await sleep(400);
        if (myToken !== token) return;

        let idx = 0;
        while (myToken === token) {
          await sleep(2800);
          if (myToken !== token) return;

          const nextIdx = (idx + 1) % slideCount;

          slotVariants.forEach((variants) => {
            variants[idx].classList.remove('active');
            variants[idx].classList.add('post');
            variants[nextIdx].classList.add('active');
          });

          await sleep(820);
          if (myToken !== token) return;

          slotVariants.forEach((variants) => {
            variants[idx].classList.remove('post');
          });

          idx = nextIdx;
        }
      }

      function stopLoop() {
        token++;
      }

      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            loop(); // safe — any previous loop self-terminates via token
          } else {
            stopLoop();
          }
        });
      }, { threshold: 0.1 });
      io.observe(stage);
    });
  })();
</script>
