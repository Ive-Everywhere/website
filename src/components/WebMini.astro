---
---
<div class="wm-stage">
  <div class="wm-window">
    <div class="wm-topbar">
      <div class="wm-dot"></div>
      <div class="wm-dot"></div>
      <div class="wm-dot"></div>
    </div>
    <div class="wm-chat">
      <div class="wm-msg wm-user">
        <span class="wm-bubble wm-bubble-user">What's our pipeline looking like?</span>
        <img src="/images/devind-dp.webp" alt="" class="wm-user-avatar" />
      </div>
      <div class="wm-msg wm-agent">
        <img src="/images/logo.svg" alt="" class="wm-avatar" />
        <div class="wm-reply">
          <span class="wm-name">Steve</span>
          <span class="wm-bubble wm-bubble-agent">12 open deals worth $284K. 3 closing this week.</span>
          <div class="wm-thinking">
            <span class="wm-dot-pulse"></span>
            <span class="wm-dot-pulse"></span>
            <span class="wm-dot-pulse"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .wm-stage { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; padding: 24px 14px 14px; }
  .wm-window { width: 100%; max-width: 300px; background: #1a1917; border-radius: 6px; border: 1px solid rgba(237,233,227,0.04); overflow: hidden; }
  .wm-topbar { display: flex; gap: 5px; padding: 8px 10px; border-bottom: 1px solid rgba(237,233,227,0.04); }
  .wm-dot { width: 6px; height: 6px; border-radius: 50%; background: rgba(237,233,227,0.1); }
  .wm-chat { padding: 10px 12px; display: flex; flex-direction: column; gap: 10px; }
  .wm-msg { display: flex; gap: 8px; }
  .wm-user { justify-content: flex-end; }
  .wm-bubble { font-family: 'Söhne', sans-serif; font-size: 11px; line-height: 1.45; padding: 8px 10px; border-radius: 4px; max-width: 220px; }
  .wm-bubble-user { background: rgba(237,233,227,0.08); color: rgba(237,233,227,0.7); }
  .wm-bubble-agent { background: rgba(237,233,227,0.04); color: rgba(237,233,227,0.55); }
  .wm-user-avatar { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; flex-shrink: 0; }
  .wm-avatar { width: 22px; height: 22px; border-radius: 50%; object-fit: cover; flex-shrink: 0; opacity: 0.6; }
  .wm-reply { display: flex; flex-direction: column; gap: 4px; }
  .wm-name { font-family: 'Söhne', sans-serif; font-size: 10px; font-weight: 600; color: rgba(237,233,227,0.4); }
  .wm-thinking { display: flex; gap: 4px; padding: 4px 0; }
  .wm-dot-pulse { width: 4px; height: 4px; border-radius: 50%; background: rgba(237,233,227,0.25); animation: wm-pulse 1.4s ease-in-out infinite; }
  .wm-dot-pulse:nth-child(2) { animation-delay: 0.2s; }
  .wm-dot-pulse:nth-child(3) { animation-delay: 0.4s; }
  @keyframes wm-pulse { 0%, 80%, 100% { opacity: 0.25; } 40% { opacity: 0.8; } }
</style>
