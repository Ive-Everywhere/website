---
import { RotatingText } from './ScrollReveal';
---
<section class="hero">
  <div class="hero-left">
    <h1>Your team focuses on thinking
      <RotatingText
        client:load
        phrases={["colleagues handle the doing", "building your dashboards", "automating your workflows", "shipping your reports"]}
      />
    </h1>
    <div class="hero-form">
      <input type="email" placeholder="What's your work email?" />
      <a class="btn btn-dark" href="#">Book a demo</a>
    </div>
  </div>
  <div class="hero-right">
    <p class="sub">Eluu colleagues build dashboards, automate workflows, and ship deliverables — so your team can focus on strategy and decisions.</p>
  </div>
</section>
