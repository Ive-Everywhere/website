---

<section class="hero-section">
  <div class="hero-inner">
    <!-- Cursor-style: heading + CTAs stacked left, no right block -->
    <div class="hero-top reveal">
      <h1 class="hero-heading">
        <span class="hero-line-1">Your tools, your workflows, your AI team.</span>
        <span class="hero-line-2">Colleagues that connect, learn, and execute on repeat.</span>
      </h1>
      <div class="hero-ctas">
        <a href="/beta" class="hero-btn hero-btn-dark hero-btn-icon" onclick="window.posthog?.capture('get_started_clicked', { location: 'hero' })">Try Eluu Beta <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        <a href="https://cal.com/krishna-kaipa-wh7ao3/15min" class="hero-btn hero-btn-light" onclick="window.posthog?.capture('book_demo_clicked', { location: 'hero' })">Book a demo</a>
      </div>
    </div>

    <!-- Hero media: painting background + iframe mockup (Cursor pattern) -->
    <div class="hero-media reveal">
      <div class="hero-media-bg">
        <img src="/images/hero-bg-painting.webp" alt="" class="hero-media-img" />
      </div>
      <div class="hero-media-frame">
        <div class="hero-iframe-wrap" data-iframe-wrapper>
          <div class="iframe-chrome">
            <div class="iframe-traffic">
              <span class="iframe-dot"></span>
              <span class="iframe-dot"></span>
              <span class="iframe-dot"></span>
            </div>
            <div class="iframe-title">Eluu AI</div>
          </div>
          <div class="iframe-body">
            <iframe
              id="hero-iframe"
              src="https://demo.eluu.ai/?autoplay=1&embed=1&darkMode=1"
              title="Eluu product demo"
              allow="autoplay"
              sandbox="allow-scripts allow-same-origin"
              tabindex="-1"
              class="hero-iframe"
            ></iframe>
            <div class="iframe-loader" id="iframe-loader" aria-hidden="true">
              <img src="/images/logo.svg" alt="" class="iframe-loader-logo" width="80" height="80" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: #13100a;
    position: relative;
    overflow: hidden;
  }
  .hero-top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 36px;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-btn {
    font-family: 'Söhne', sans-serif;
    font-size: 16px;
    font-weight: 400;
    padding: 0.89em 1.45em;
    border-radius: 9999px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-btn:hover { transform: translateY(-1px); }
  .hero-btn-dark { color: #14120b; background: #ede9e3; border: 1px solid #ede9e3; }
  .hero-btn-icon { display: inline-flex; align-items: center; gap: 10px; white-space: nowrap; }
  .hero-btn-dark:hover { box-shadow: 0 4px 12px rgba(237, 233, 227, 0.15); }
  .hero-btn-light { color: #ede9e3; background: transparent; border: 1px solid rgba(237, 233, 227, 0.2); }
  .hero-btn-light:hover { border-color: rgba(237, 233, 227, 0.4); box-shadow: 0 4px 12px rgba(237, 233, 227, 0.08); }

  .hero-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 140px 20px 120px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    box-sizing: border-box;
  }
  @media (max-width: 768px) {
    .hero-inner { padding: 100px 16px 48px; gap: 32px; }
    .hero-media-frame { min-height: min(480px, 60vh); height: min(600px, 70vh); }
    .hero-iframe-wrap { width: min(1180px, calc(100% - 32px)); height: min(720px, calc(100% - 32px)); }
  }
  @media (max-width: 480px) {
    .hero-inner { padding: 90px 16px 32px; gap: 24px; }
    .hero-media-frame { min-height: min(360px, 55vh); height: min(480px, 65vh); }
  }

  /* ── Mirai-style hero heading ──
     Two lines, same large size. Line 1 is full brightness (the claim),
     line 2 is dimmed (the context). Size does the impact, opacity does
     the hierarchy. */
  .hero-heading {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-style: normal;
    font-size: clamp(26px, 3.2vw, 44px);
    letter-spacing: -0.025em;
    color: #ede9e3;
    line-height: 1.15;
    margin: 0;
    text-align: left;
  }
  .hero-line-1,
  .hero-line-2 {
    display: block;
  }
  .hero-line-2 {
    color: rgba(237, 233, 227, 0.4);
  }
  @media (max-width: 720px) {
    .hero-heading { max-width: none; }
  }

  /* ── Cursor-style hero media: painting bg + centered iframe mockup ── */
  .hero-media {
    position: relative;
    display: grid;
    grid-template: 1fr / 1fr;
    border-radius: 4px;
    overflow: hidden;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border: 1px solid rgba(237, 233, 227, 0.06);
    border-radius: 4px;
    z-index: 30;
  }
  .hero-media-bg,
  .hero-media-frame {
    grid-area: 1 / 1;
  }
  .hero-media-bg {
    z-index: 1;
    overflow: hidden;
    position: relative;
  }
  .hero-media-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85);
  }
  .hero-media-frame {
    z-index: 20;
    height: min(880px, 80vh);
    min-height: min(760px, 70vh); /* don't overflow viewport on small screens */
    position: relative;
    overflow: hidden;
  }
  .hero-iframe-wrap {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(1180px, calc(100% - 64px));
    height: min(720px, calc(100% - 64px));
    border-radius: 12px;
    overflow: hidden;
    background: #1e1d1b;
    display: flex;
    flex-direction: column;
    isolation: isolate;
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.4),
      0 14px 32px rgba(0, 0, 0, 0.3),
      0 0 0 1px rgba(237, 233, 227, 0.08),
      inset 0 0 0 1px rgba(237, 233, 227, 0.04);
  }

  /* macOS-style window chrome */
  .iframe-chrome {
    position: relative;
    height: 28px;
    flex-shrink: 0;
    background: #1e1d1b;
    border-bottom: 1px solid rgba(237, 233, 227, 0.06);
    display: flex;
    align-items: center;
    padding: 0 12px;
  }
  .iframe-body {
    flex: 1;
    position: relative;
    overflow: hidden;
    min-height: 0;
  }
  .iframe-traffic {
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .iframe-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: rgba(237, 233, 227, 0.15);
  }
  .iframe-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    letter-spacing: -0.01em;
    pointer-events: none;
  }

  /* Iframe loader — covers the iframe area ONLY in slow-load fallback.
     Hidden by default (opacity 0). Fades in via .visible class added by JS
     after a long delay if the iframe still hasn't fired its load event.
     Most users never see this — it only appears if the demo iframe is
     genuinely slow or stuck. White background matches the iframe's bg. */
  .iframe-loader {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #1e1d1b;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .iframe-loader.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .iframe-loader-logo {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    display: block;
    animation: iframe-loader-pulse 1.8s ease-in-out infinite;
  }
  @media (max-width: 640px) {
    .iframe-loader-logo { width: 52px; height: 52px; border-radius: 7px; }
  }
  @media (max-width: 360px) {
    .iframe-loader-logo { width: 44px; height: 44px; border-radius: 6px; }
  }
  @keyframes iframe-loader-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.06); }
  }
  /* On mobile, the iframe loader only ever appears in the slow-load fallback
     case — exactly when the GPU is already strained. Drop the scale transform
     and use opacity-only pulse to keep paint cost minimal. */
  @media (max-width: 768px) {
    .iframe-loader-logo {
      animation: iframe-loader-pulse-mobile 1.8s ease-in-out infinite;
    }
    @keyframes iframe-loader-pulse-mobile {
      0%, 100% { opacity: 0.55; }
      50%      { opacity: 1; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iframe-loader-logo { animation: none; opacity: 0.85; }
  }

  /* Iframe — slight zoom-out (renders at 125%, scales to 80%) */
  .hero-iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 125%;
    height: 125%;
    transform: scale(0.8);
    transform-origin: 0 0;
    border: none;
    background: #1e1d1b;
    display: block;
    will-change: transform;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Mobile: scale iframe down more aggressively */
  @media (max-width: 768px) {
    .hero-iframe {
      width: 200%;
      height: 200%;
      transform: scale(0.5);
    }
  }
  @media (max-width: 480px) {
    .hero-btn { font-size: 14px; padding: 10px 22px; }
    .hero-iframe {
      width: 250%;
      height: 250%;
      transform: scale(0.4);
    }
  }

  /* ── Light mode sync from iframe ── */
  .iframe-chrome-light {
    background: #f5f5f5 !important;
    border-bottom-color: rgba(0, 0, 0, 0.08) !important;
  }
  .iframe-chrome-light .iframe-dot {
    background: rgba(0, 0, 0, 0.12) !important;
  }
  .iframe-chrome-light .iframe-dot:first-child { background: #ff5f57 !important; }
  .iframe-chrome-light .iframe-dot:nth-child(2) { background: #ffbd2e !important; }
  .iframe-chrome-light .iframe-dot:last-child { background: #28c840 !important; }
  .iframe-chrome-light .iframe-title {
    color: rgba(0, 0, 0, 0.5) !important;
  }
</style>

<script>
  (function () {
    const iframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
    if (!iframe) return;

    // ── Loader: only show in the slow-load fallback case ──
    // The loader is hidden by default. We only fade it in after a long delay
    // (3500ms) IF the iframe still hasn't fired its load event by then. Most
    // users see the iframe load fast enough that the loader never appears.
    // Cross-origin iframes can't be inspected for content errors, so we
    // also force-hide after a hard cap (15s) regardless.
    const loader = document.getElementById('iframe-loader');
    if (loader) {
      const SHOW_DELAY = 3500;   // only show loader if loading takes longer than this
      const HARD_CAP = 15000;    // give up after this regardless of load event
      let loaderShown = false;
      let loaderDone = false;

      function showLoader() {
        if (loaderDone || loaderShown) return;
        loaderShown = true;
        loader.classList.add('visible');
      }

      function hideLoader() {
        if (loaderDone) return;
        loaderDone = true;
        clearTimeout(showTimer);
        clearTimeout(hardCapId);
        if (loaderShown) {
          // Was visible — fade out via the same .visible class transition
          loader.classList.remove('visible');
          setTimeout(() => { loader.style.display = 'none'; }, 600);
        } else {
          // Never visible — just remove from DOM (no flash)
          loader.style.display = 'none';
        }
      }

      const showTimer = setTimeout(showLoader, SHOW_DELAY);
      const hardCapId = setTimeout(hideLoader, HARD_CAP);
      iframe.addEventListener('load', hideLoader);
    }

    // ── Saved scroll state ──
    let savedY = 0;
    let savedX = 0;

    function saveScroll() {
      savedY = window.scrollY;
      savedX = window.scrollX;
    }

    function restoreScroll() {
      if (window.scrollY !== savedY) {
        window.scrollTo(savedX, savedY);
      }
    }

    // ── Layer 1: Blur on load ──
    iframe.addEventListener('load', () => {
      if (document.activeElement === iframe) {
        iframe.blur();
        document.body.focus({ preventScroll: true });
      }
    });

    // ── Layer 2: Intercept any focus on the iframe element itself ──
    document.addEventListener('focusin', (e) => {
      if (e.target === iframe) {
        saveScroll();
        requestAnimationFrame(restoreScroll);
      }
    }, true);

    // ── Layer 3: Save scroll before any interaction with iframe ──
    let iframeHovered = false;

    iframe.addEventListener('mouseenter', () => {
      iframeHovered = true;
      saveScroll();
    });
    iframe.addEventListener('mouseleave', () => {
      iframeHovered = false;
    });
    iframe.addEventListener('mousedown', saveScroll);
    iframe.addEventListener('touchstart', saveScroll, { passive: true });

    // ── Layer 4: Detect and revert scroll theft ──
    // When the iframe is hovered/active and a sudden scroll jump happens,
    // revert it. Legitimate user scrolls are continuous small deltas;
    // iframe focus-scroll is a single large jump.
    let lastScrollY = window.scrollY;
    let scrollTick = false;

    window.addEventListener('scroll', () => {
      if (scrollTick) return;
      scrollTick = true;

      requestAnimationFrame(() => {
        const currentY = window.scrollY;
        const delta = Math.abs(currentY - lastScrollY);

        // If iframe was just active and we got a big jump toward the iframe
        // (which is near the top of the page), revert it
        if (iframeHovered && delta > 100 && document.activeElement === iframe) {
          window.scrollTo(savedX, savedY);
        }

        lastScrollY = window.scrollY;
        scrollTick = false;
      });
    }, { passive: true });

    // ── Layer 5: Blur iframe when it scrolls out of view ──
    const wrapper = iframe.closest('[data-iframe-wrapper]');
    if (wrapper) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting && document.activeElement === iframe) {
            iframe.blur();
          }
        },
        { threshold: 0.1 }
      );
      observer.observe(wrapper);
    }

    // ── Iframe zoom handling ──
    // Counter-scale the iframe so it stays the same visual size regardless
    // of page zoom. When zoom exceeds 200%, hide it entirely.
    if (wrapper) {
      const iframeWrap = wrapper as HTMLElement;
      const MAX_ZOOM = 2; // hide above 200%
      const baseDPR = window.devicePixelRatio || 1;

      function checkZoom() {
        const desktopZoom = window.outerWidth / window.innerWidth;
        const pinchZoom = window.visualViewport?.scale ?? 1;
        const viewportZoom = screen.width / window.innerWidth;
        const dprZoom = (window.devicePixelRatio || 1) / baseDPR;

        const zoom = Math.max(desktopZoom, pinchZoom, viewportZoom, dprZoom);

        if (zoom > MAX_ZOOM) {
          iframeWrap.style.display = 'none';
          return;
        }

        iframeWrap.style.display = '';

        // Counter-scale on desktop only — mobile pinch-zoom is intentional.
        // Preserve the translate(-50%, -50%) centering from CSS.
        const isMobile = window.innerWidth < 768;
        if (!isMobile && zoom > 1.05) {
          const counter = 1 / zoom;
          iframeWrap.style.transform = `translate(-50%, -50%) scale(${counter})`;
        } else {
          iframeWrap.style.transform = '';
        }
      }

      // Resize: fires on desktop zoom + mobile page zoom
      window.addEventListener('resize', checkZoom);
      // DPR change: fires on Android Chrome menu zoom
      (function watchDPR() {
        const mq = matchMedia(`(resolution: ${devicePixelRatio}dppx)`);
        mq.addEventListener('change', () => { checkZoom(); watchDPR(); }, { once: true });
      })();
      // Pinch zoom: poll since events are unreliable
      if (window.visualViewport) {
        let pollId = setInterval(checkZoom, 400);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) { clearInterval(pollId); }
          else { checkZoom(); pollId = setInterval(checkZoom, 400); }
        });
      }
      checkZoom();
    }

    // ── Theme sync: iframe chrome bar only ──
    window.addEventListener('message', (e) => {
      if (e.data?.type !== 'eluu-theme') return;
      const isLight = e.data.theme === 'light';
      const chrome = document.querySelector('.iframe-chrome') as HTMLElement;
      if (chrome) chrome.classList.toggle('iframe-chrome-light', isLight);
    });
  })();
</script>
