---
---

<section style="background: #ffffff; position: relative; overflow: hidden;">
  <!-- Bridge landscape background — fills from top edge -->
  <img
    src="/images/2683d4a4805b7192bd38dc39f0c5321f8c2b5696.png"
    alt=""
    aria-hidden="true"
    style="position: absolute; top: 0; left: 50%; transform: translateX(-50%); width: 2400px; height: auto; pointer-events: none; z-index: 0;"
  />

  <!-- Content area — all in normal flow so section height is correct -->
  <div style="position: relative; z-index: 1; padding: 80px 0 40px;">
    <div style="max-width: 1320px; margin: 0 auto; padding: 0 16px; display: flex; flex-direction: column; align-items: center; gap: 24px;">
      <!-- Text block -->
      <div class="reveal" style="display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;">
        <h1 style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: clamp(32px, 7vw, 100px); letter-spacing: -2px; color: #000000; line-height: 1; margin: 0;">
          There's a new way to work
        </h1>
        <p style="font-family: 'Inter', sans-serif; font-weight: 400; font-size: clamp(18px, 4vw, 64px); letter-spacing: -1px; color: #000000; line-height: 1.1; margin: 0;">
          Say Eluu to your AI colleagues.
        </p>
      </div>

      <!-- Iframe — in normal flow, large -->
      <div class="reveal" style="width: 100%; max-width: 1800px; margin-top: 16px;">
        <div class="iframe-glow">
          <div class="iframe-border">
            <div style="aspect-ratio: 16 / 9.5; border-radius: 14px; overflow: hidden; position: relative; background: #ffffff;">
              <iframe
                id="hero-iframe"
                src="about:blank"
                data-src="https://localhost:3001/?autoplay=1&embed=1"
                title="Eluu product demo"
                allow="autoplay"
                sandbox="allow-scripts allow-same-origin"
                tabindex="-1"
                loading="lazy"
                style="position: absolute; top: 0; left: 0; width: 133.33%; height: 133.33%; transform: scale(0.75); transform-origin: 0 0; border: none; border-radius: 14px; background: #ffffff;"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .iframe-border {
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.03),
      0 4px 16px rgba(0, 0, 0, 0.06),
      0 12px 40px rgba(0, 0, 0, 0.08);
  }

  .iframe-glow {
    border-radius: 22px;
    padding: 4px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(244, 243, 236, 0.6) 30%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(244, 243, 236, 0.5) 70%,
      rgba(255, 255, 255, 0.9) 100%
    );
    box-shadow:
      0 0 60px rgba(0, 0, 0, 0.04),
      0 0 120px rgba(0, 0, 0, 0.02);
  }

  .iframe-border {
    overflow-anchor: none;
  }
</style>

<script>
  const iframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
  if (iframe) {
    iframe.src = iframe.getAttribute('data-src') || '';
    iframe.addEventListener('load', () => {
      if (document.activeElement === iframe) iframe.blur();
    });
  }
</script>
