---
---

<section class="hero-section">
  <!-- Bridge landscape background — fills from top edge -->
  <img
    src="/images/2683d4a4805b7192bd38dc39f0c5321f8c2b5696.png"
    alt=""
    aria-hidden="true"
    class="hero-bg-img"
  />

  <!-- Content area — all in normal flow so section height is correct -->
  <div class="hero-content">
    <div class="hero-inner">
      <!-- Top row: title left, subtext+CTAs right -->
      <div class="hero-top">
        <div class="hero-left reveal">
          <h1 class="hero-heading">
            <span class="rotate-clip"><span class="rotate-track"><span class="rotate-word">Revenue operations</span><span class="rotate-word">Sales operations</span><span class="rotate-word">Marketing operations</span><span class="rotate-word">Engineering operations</span><span class="rotate-word" aria-hidden="true">Revenue operations</span></span></span><br />
            Run by AI agents
          </h1>
        </div>
        <div class="hero-right reveal">
          <p class="hero-subheading">
            Eluu colleagues connect to your tools, learn your workflows, and execute real work — on repeat, 24/7, without reminders.
          </p>
          <div class="hero-ctas">
            <a href="https://app.eluu.ai" class="hero-btn hero-btn-dark" style="display: inline-flex; align-items: center; gap: 10px; white-space: nowrap;" onclick="window.posthog?.capture('get_started_clicked', { location: 'hero' })">Get started <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
            <a href="https://cal.com/krishna-kaipa-wh7ao3/15min" class="hero-btn hero-btn-light" onclick="window.posthog?.capture('book_demo_clicked', { location: 'hero' })">Book a demo</a>
          </div>
        </div>
      </div>

      <!-- Iframe — in normal flow, large -->
      <div class="hero-iframe-wrap" data-iframe-wrapper>
        <div class="iframe-glow">
          <div class="iframe-border">
            <div class="iframe-aspect-box">
              <iframe
                id="hero-iframe"
                src="https://demo.eluu.ai/?autoplay=1&embed=1"
                title="Eluu product demo"
                allow="autoplay"
                sandbox="allow-scripts allow-same-origin"
                tabindex="-1"
                class="hero-iframe"
              ></iframe>
              <!-- Loader sits OVER the iframe; hidden when iframe.load fires
                   (or after 10s timeout). Covers the "iframe loaded but white"
                   case as well as slow loads. -->
              <div class="iframe-loader" id="iframe-loader" aria-hidden="true">
                <img
                  src="/images/logo.svg"
                  alt=""
                  class="iframe-loader-logo"
                  width="80"
                  height="80"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .hero-top {
    display: flex;
    align-items: flex-end;
    gap: 40px;
  }
  @media (max-width: 900px) {
    .hero-top { flex-direction: column; align-items: flex-start; gap: 24px; }
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    flex-shrink: 0;
  }
  .hero-right {
    flex-shrink: 0;
    max-width: 380px;
    padding-bottom: 6px;
  }
  @media (max-width: 900px) {
    .hero-right { max-width: 100%; }
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 20px;
    flex-wrap: wrap;
  }
  .hero-btn {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 12px 28px;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-btn:hover { transform: translateY(-1px); }
  .hero-btn-dark { color: #ffffff; background: #17100e; }
  .hero-btn-dark:hover { box-shadow: 0 4px 12px rgba(23, 16, 14, 0.2); }
  .hero-btn-light { color: #17100e; background: #ffffff; border: 1px solid rgba(23, 16, 14, 0.12); }
  .hero-btn-light:hover { box-shadow: 0 4px 12px rgba(23, 16, 14, 0.08); }

  .hero-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    gap: 48px;
    box-sizing: border-box;
  }
  @media (max-width: 480px) {
    .hero-inner { padding: 0 16px; gap: 16px; }
  }

  .hero-heading {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(32px, 6vw, 72px);
    letter-spacing: -2px;
    color: #17100e;
    line-height: 1.1;
    margin: 0;
    text-align: left;
  }
  @media (max-width: 480px) {
    .hero-heading { letter-spacing: -1px; }
  }

  .hero-subheading {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 16px;
    letter-spacing: -0.2px;
    color: #888;
    line-height: 1.6;
    margin: 0;
    text-align: left;
  }

  /* ── Rotating words ── */
  .rotate-clip {
    display: inline-flex;
    flex-direction: column;
    height: 1.1em;
    overflow: hidden;
    vertical-align: bottom;
    color: #ED733B;
  }
  .rotate-track {
    display: flex;
    flex-direction: column;
    animation: text-slide 15s cubic-bezier(0.83, 0, 0.17, 1) infinite;
    text-align: left;
  }
  .rotate-word {
    display: block;
    height: 1.1em;
    line-height: 1.1;
    white-space: nowrap;
    flex-shrink: 0;
  }
  @keyframes text-slide {
    0%, 20%        { transform: translateY(0); }
    25%, 45%       { transform: translateY(-20%); }
    50%, 70%       { transform: translateY(-40%); }
    75%, 95%       { transform: translateY(-60%); }
    100%           { transform: translateY(-80%); }
  }

  .hero-iframe-wrap {
    width: 100%;
    max-width: 1800px;
    margin-top: 16px;
    overflow: hidden;
    /* Match the inner glow's radius so the slide-in clip + box-shadows
       follow the same rounded shape (no square corner artifacts) */
    border-radius: 22px;
  }
  @media (max-width: 480px) {
    .hero-iframe-wrap { border-radius: 16px; }
  }
  @media (max-width: 480px) {
    .hero-iframe-wrap { margin-top: 8px; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 120px 0 16px;
  }
  @media (min-width: 480px) { .hero-content { padding: 130px 0 20px; } }
  @media (min-width: 640px) { .hero-content { padding: 140px 0 40px; } }
  @media (min-width: 1024px) { .hero-content { padding: 140px 0 40px; } }

  .hero-bg-img {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    min-width: 1200px;
    width: 100%;
    height: auto;
    pointer-events: none;
    z-index: 0;
    filter: blur(3px);
  }
  @media (min-width: 768px) {
    .hero-bg-img { min-width: 2400px; }
  }

  /* Iframe aspect container — clips the fixed-size iframe */
  .iframe-aspect-box {
    aspect-ratio: 16 / 9.5;
    border-radius: 14px;
    overflow: hidden;
    position: relative;
    background: #ffffff;
  }

  /* Iframe loader — covers the iframe area ONLY in slow-load fallback.
     Hidden by default (opacity 0). Fades in via .visible class added by JS
     after a long delay if the iframe still hasn't fired its load event.
     Most users never see this — it only appears if the demo iframe is
     genuinely slow or stuck. White background matches the iframe's bg. */
  .iframe-loader {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .iframe-loader.visible {
    opacity: 1;
    pointer-events: auto;
  }
  .iframe-loader-logo {
    width: 80px;
    height: 80px;
    border-radius: 10px;
    display: block;
    animation: iframe-loader-pulse 1.8s ease-in-out infinite;
  }
  @media (max-width: 640px) {
    .iframe-loader-logo { width: 52px; height: 52px; border-radius: 7px; }
  }
  @media (max-width: 360px) {
    .iframe-loader-logo { width: 44px; height: 44px; border-radius: 6px; }
  }
  @keyframes iframe-loader-pulse {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.06); }
  }
  /* On mobile, the iframe loader only ever appears in the slow-load fallback
     case — exactly when the GPU is already strained. Drop the scale transform
     and use opacity-only pulse to keep paint cost minimal. */
  @media (max-width: 768px) {
    .iframe-loader-logo {
      animation: iframe-loader-pulse-mobile 1.8s ease-in-out infinite;
    }
    @keyframes iframe-loader-pulse-mobile {
      0%, 100% { opacity: 0.55; }
      50%      { opacity: 1; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .iframe-loader-logo { animation: none; opacity: 0.85; }
  }

  /* Iframe element — scaled down on mobile to show full desktop layout */
  .hero-iframe {
    position: absolute;
    top: 0; left: 0;
    width: 250%;
    height: 250%;
    transform: scale(0.4);
    transform-origin: 0 0;
    border: none;
    background: #ffffff;
  }
  @media (min-width: 480px) {
    .hero-iframe {
      width: 200%;
      height: 200%;
      transform: scale(0.5);
    }
  }
  @media (min-width: 768px) {
    .hero-iframe {
      width: 111.11%;
      height: 111.11%;
      transform: scale(0.9);
    }
  }

  @media (max-width: 480px) {
    .hero-btn { font-size: 14px; padding: 10px 22px; }
    .iframe-border { border-radius: 12px; }
    .iframe-glow { border-radius: 16px; }
  }

  .iframe-border {
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.03),
      0 4px 16px rgba(0, 0, 0, 0.06),
      0 12px 40px rgba(0, 0, 0, 0.08);
    overflow-anchor: none;
    contain: layout style;
  }

  .iframe-glow {
    border-radius: 22px;
    padding: 4px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(244, 243, 236, 0.6) 30%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(244, 243, 236, 0.5) 70%,
      rgba(255, 255, 255, 0.9) 100%
    );
    box-shadow:
      0 0 60px rgba(0, 0, 0, 0.04),
      0 0 120px rgba(0, 0, 0, 0.02);
    contain: layout style;
  }
</style>

<script>
  (function () {
    const iframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
    if (!iframe) return;

    // ── Loader: only show in the slow-load fallback case ──
    // The loader is hidden by default. We only fade it in after a long delay
    // (3500ms) IF the iframe still hasn't fired its load event by then. Most
    // users see the iframe load fast enough that the loader never appears.
    // Cross-origin iframes can't be inspected for content errors, so we
    // also force-hide after a hard cap (15s) regardless.
    const loader = document.getElementById('iframe-loader');
    if (loader) {
      const SHOW_DELAY = 3500;   // only show loader if loading takes longer than this
      const HARD_CAP = 15000;    // give up after this regardless of load event
      let loaderShown = false;
      let loaderDone = false;

      function showLoader() {
        if (loaderDone || loaderShown) return;
        loaderShown = true;
        loader.classList.add('visible');
      }

      function hideLoader() {
        if (loaderDone) return;
        loaderDone = true;
        clearTimeout(showTimer);
        clearTimeout(hardCapId);
        if (loaderShown) {
          // Was visible — fade out via the same .visible class transition
          loader.classList.remove('visible');
          setTimeout(() => { loader.style.display = 'none'; }, 600);
        } else {
          // Never visible — just remove from DOM (no flash)
          loader.style.display = 'none';
        }
      }

      const showTimer = setTimeout(showLoader, SHOW_DELAY);
      const hardCapId = setTimeout(hideLoader, HARD_CAP);
      iframe.addEventListener('load', hideLoader);
    }

    // ── Saved scroll state ──
    let savedY = 0;
    let savedX = 0;

    function saveScroll() {
      savedY = window.scrollY;
      savedX = window.scrollX;
    }

    function restoreScroll() {
      if (window.scrollY !== savedY) {
        window.scrollTo(savedX, savedY);
      }
    }

    // ── Layer 1: Blur on load ──
    iframe.addEventListener('load', () => {
      if (document.activeElement === iframe) {
        iframe.blur();
        document.body.focus({ preventScroll: true });
      }
    });

    // ── Layer 2: Intercept any focus on the iframe element itself ──
    document.addEventListener('focusin', (e) => {
      if (e.target === iframe) {
        saveScroll();
        requestAnimationFrame(restoreScroll);
      }
    }, true);

    // ── Layer 3: Save scroll before any interaction with iframe ──
    let iframeHovered = false;

    iframe.addEventListener('mouseenter', () => {
      iframeHovered = true;
      saveScroll();
    });
    iframe.addEventListener('mouseleave', () => {
      iframeHovered = false;
    });
    iframe.addEventListener('mousedown', saveScroll);
    iframe.addEventListener('touchstart', saveScroll, { passive: true });

    // ── Layer 4: Detect and revert scroll theft ──
    // When the iframe is hovered/active and a sudden scroll jump happens,
    // revert it. Legitimate user scrolls are continuous small deltas;
    // iframe focus-scroll is a single large jump.
    let lastScrollY = window.scrollY;
    let scrollTick = false;

    window.addEventListener('scroll', () => {
      if (scrollTick) return;
      scrollTick = true;

      requestAnimationFrame(() => {
        const currentY = window.scrollY;
        const delta = Math.abs(currentY - lastScrollY);

        // If iframe was just active and we got a big jump toward the iframe
        // (which is near the top of the page), revert it
        if (iframeHovered && delta > 100 && document.activeElement === iframe) {
          window.scrollTo(savedX, savedY);
        }

        lastScrollY = window.scrollY;
        scrollTick = false;
      });
    }, { passive: true });

    // ── Layer 5: Blur iframe when it scrolls out of view ──
    const wrapper = iframe.closest('[data-iframe-wrapper]');
    if (wrapper) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting && document.activeElement === iframe) {
            iframe.blur();
          }
        },
        { threshold: 0.1 }
      );
      observer.observe(wrapper);
    }

    // ── Hide iframe when zoom exceeds 200% ──
    if (wrapper) {
      const iframeWrap = wrapper as HTMLElement;
      const MAX_ZOOM = 2; // 200%
      const baseDPR = window.devicePixelRatio || 1;

      function checkZoom() {
        // Method 1: Desktop browser zoom (Ctrl+/-)
        const desktopZoom = window.outerWidth / window.innerWidth;
        // Method 2: Mobile pinch zoom
        const pinchZoom = window.visualViewport?.scale ?? 1;
        // Method 3: Page zoom via viewport shrink (mobile full-width browsers)
        const viewportZoom = screen.width / window.innerWidth;
        // Method 4: Page zoom via DPR change (Android Chrome menu zoom)
        const dprZoom = (window.devicePixelRatio || 1) / baseDPR;

        const maxZoom = Math.max(desktopZoom, pinchZoom, viewportZoom, dprZoom);
        iframeWrap.style.display = maxZoom > MAX_ZOOM ? 'none' : '';
      }

      // Resize: fires on desktop zoom + mobile page zoom
      window.addEventListener('resize', checkZoom);
      // DPR change: fires on Android Chrome menu zoom
      (function watchDPR() {
        const mq = matchMedia(`(resolution: ${devicePixelRatio}dppx)`);
        mq.addEventListener('change', () => { checkZoom(); watchDPR(); }, { once: true });
      })();
      // Pinch zoom: poll since events are unreliable
      if (window.visualViewport) {
        let pollId = setInterval(checkZoom, 400);
        document.addEventListener('visibilitychange', () => {
          if (document.hidden) { clearInterval(pollId); }
          else { checkZoom(); pollId = setInterval(checkZoom, 400); }
        });
      }
      checkZoom();
    }
  })();
</script>
