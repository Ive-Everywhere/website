---
---
<section class="pt-20 pb-16 overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <h1 class="text-5xl md:text-7xl font-bold tracking-tight leading-[1.1] mb-2">
      There's a new way to work
    </h1>
    <p class="text-3xl md:text-5xl font-bold tracking-tight mb-10">
      Say Eluu to your AI colleagues.
    </p>

    <!-- Tab Buttons -->
    <div class="flex items-center justify-center gap-2 mb-8">
      <button data-tab="sales" class="hero-tab active px-6 py-2.5 rounded-full text-sm font-medium transition-all bg-[#1A1A1A] text-white">
        Sales
      </button>
      <button data-tab="support" class="hero-tab px-6 py-2.5 rounded-full text-sm font-medium transition-all bg-transparent text-[#1A1A1A] hover:bg-black/5">
        Customer Support
      </button>
      <button data-tab="product" class="hero-tab px-6 py-2.5 rounded-full text-sm font-medium transition-all bg-transparent text-[#1A1A1A] hover:bg-black/5">
        Product
      </button>
    </div>

    <!-- Hero Card Area -->
    <div class="relative max-w-4xl mx-auto">
      <!-- Nature photography background - placeholder with gradient -->
      <div class="absolute inset-0 -mx-32 rounded-2xl overflow-hidden" style="z-index: -1;">
        <div class="absolute left-0 top-0 w-1/3 h-full bg-gradient-to-br from-amber-200/40 via-green-200/30 to-amber-100/20 rounded-l-2xl"></div>
        <div class="absolute right-0 top-0 w-1/3 h-full bg-gradient-to-bl from-amber-300/40 via-green-100/20 to-amber-200/30 rounded-r-2xl"></div>
      </div>

      <!-- Gradient bar -->
      <div class="h-1.5 rounded-full bg-gradient-to-r from-pink-200 via-cyan-200 to-yellow-200 mb-0"></div>

      <!-- Tab Content Cards -->
      <div id="hero-card-sales" class="hero-card bg-[#FFF8E7] rounded-b-2xl p-8 md:p-12 min-h-[280px] flex flex-col justify-center transition-all duration-500">
        <div class="bg-[#FFF3D4] rounded-2xl px-8 py-6 mb-6 max-w-2xl mx-auto">
          <p class="text-xl md:text-2xl font-semibold text-[#1A1A1A] leading-snug">
            Can you help me draft improvement emails for my account executives who are behind quota?
          </p>
        </div>
        <div class="flex items-center gap-3 text-[#6B6B6B]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          <span class="text-base">Finding FY26 GTM team structure from memory</span>
          <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
        </div>
      </div>

      <div id="hero-card-support" class="hero-card bg-[#E8FBF5] rounded-b-2xl p-8 md:p-12 min-h-[280px] flex flex-col justify-center transition-all duration-500 hidden">
        <div class="bg-[#D4F5ED] rounded-2xl px-8 py-6 mb-6 max-w-2xl mx-auto">
          <p class="text-xl md:text-2xl font-semibold text-[#1A1A1A] leading-snug">
            <span class="text-[#6B6B6B]">/solve-ticket</span> <strong>Ticket-123 for Acme Inc</strong>
          </p>
        </div>
        <div class="flex items-center gap-3 text-[#6B6B6B]">
          <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 24 24"><path d="M3.5 3.5l8.5 5 8.5-5v17l-8.5-5-8.5 5z" opacity="0.3"/><path d="M20.5 3.5l-8.5 5-8.5-5v17l8.5-5 8.5 5z"/></svg>
          <span class="text-base">Fetching ticket information from Jira</span>
          <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
        </div>
      </div>

      <div id="hero-card-product" class="hero-card bg-[#FDF2F8] rounded-b-2xl p-8 md:p-12 min-h-[280px] flex flex-col justify-center transition-all duration-500 hidden">
        <div class="bg-[#F5D4E8] rounded-2xl px-8 py-6 mb-6 max-w-2xl mx-auto">
          <p class="text-sm text-[#6B6B6B] mb-1">9 AM, Everyday</p>
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke-width="2"/><path stroke-linecap="round" stroke-width="2" d="M12 6v6l4 2"/></svg>
            <p class="text-xl md:text-2xl font-semibold text-[#1A1A1A] leading-snug">
              Prepare last day's product and customer report
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.hero-tab');
    const cards = document.querySelectorAll('.hero-card');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const target = tab.getAttribute('data-tab');

        // Update tab styles
        tabs.forEach(t => {
          t.classList.remove('bg-[#1A1A1A]', 'text-white', 'active');
          t.classList.add('bg-transparent', 'text-[#1A1A1A]');
        });
        tab.classList.add('bg-[#1A1A1A]', 'text-white', 'active');
        tab.classList.remove('bg-transparent', 'text-[#1A1A1A]');

        // Show target card, hide others
        cards.forEach(card => card.classList.add('hidden'));
        const targetCard = document.getElementById(`hero-card-${target}`);
        if (targetCard) targetCard.classList.remove('hidden');
      });
    });
  });
</script>
