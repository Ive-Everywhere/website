---
---

<section class="hero-section">
  <!-- Bridge landscape background — fills from top edge -->
  <img
    src="/images/2683d4a4805b7192bd38dc39f0c5321f8c2b5696.png"
    alt=""
    aria-hidden="true"
    class="hero-bg-img"
  />

  <!-- Content area — all in normal flow so section height is correct -->
  <div class="hero-content">
    <div class="hero-inner">
      <!-- Text block -->
      <div class="reveal" style="display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center;">
        <h1 class="hero-heading">
          Your best colleagues aren't human anymore.
        </h1>
        <p class="hero-subheading">
          Eluu colleagues connect to your tools, learn your workflows, and execute real work — on repeat, 24/7, without reminders.
        </p>
        <div class="hero-ctas">
          <a href="https://app.eluu.ai" class="hero-btn hero-btn-dark">Get started</a>
          <a href="https://app.eluu.ai" class="hero-btn hero-btn-light">Book a demo</a>
        </div>
      </div>

      <!-- Iframe — in normal flow, large -->
      <div class="reveal hero-iframe-wrap" data-iframe-wrapper>
        <div class="iframe-glow">
          <div class="iframe-border">
            <div style="aspect-ratio: 16 / 9.5; border-radius: 14px; overflow: hidden; position: relative; background: #ffffff; contain: layout style;">
              <iframe
                id="hero-iframe"
                src="https://demo.eluu.ai/?autoplay=1&embed=1"
                title="Eluu product demo"
                allow="autoplay"
                sandbox="allow-scripts allow-same-origin"
                tabindex="-1"
                style="position: absolute; top: 0; left: 0; width: 111.11%; height: 111.11%; transform: scale(0.9); transform-origin: 0 0; border: none; border-radius: 14px; background: #ffffff; contain: strict;"
              ></iframe>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    background: #ffffff;
    position: relative;
    overflow: hidden;
  }
  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 8px;
  }
  .hero-btn {
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    padding: 12px 28px;
    border-radius: 10px;
    text-decoration: none;
    line-height: 1;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .hero-btn:hover { transform: translateY(-1px); }
  .hero-btn-dark { color: #ffffff; background: #17100e; }
  .hero-btn-dark:hover { box-shadow: 0 4px 12px rgba(23, 16, 14, 0.2); }
  .hero-btn-light { color: #17100e; background: #ffffff; border: 1px solid rgba(23, 16, 14, 0.12); }
  .hero-btn-light:hover { box-shadow: 0 4px 12px rgba(23, 16, 14, 0.08); }

  .hero-inner {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    box-sizing: border-box;
  }
  @media (max-width: 480px) {
    .hero-inner { padding: 0 16px; gap: 16px; }
  }

  .hero-heading {
    font-family: 'Season Mix', sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 7vw, 80px);
    letter-spacing: -2px;
    color: #17100e;
    line-height: 1;
    margin: 0;
    overflow-wrap: break-word;
  }
  @media (max-width: 480px) {
    .hero-heading { letter-spacing: -1px; }
  }

  .hero-subheading {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: clamp(15px, 2.5vw, 24px);
    letter-spacing: -0.3px;
    color: #5c5c5c;
    line-height: 1.5;
    margin: 0;
    max-width: 720px;
  }

  .hero-iframe-wrap {
    width: 100%;
    max-width: 1800px;
    margin-top: 16px;
    overflow: hidden;
  }
  @media (max-width: 480px) {
    .hero-iframe-wrap { margin-top: 8px; }
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding: 40px 0 16px;
  }
  @media (min-width: 480px) { .hero-content { padding: 48px 0 20px; } }
  @media (min-width: 640px) { .hero-content { padding: 80px 0 40px; } }

  .hero-bg-img {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    min-width: 1200px;
    width: 100%;
    height: auto;
    pointer-events: none;
    z-index: 0;
  }
  @media (min-width: 768px) {
    .hero-bg-img { min-width: 2400px; }
  }

  @media (max-width: 480px) {
    .hero-btn { font-size: 14px; padding: 10px 22px; }
    .iframe-border { border-radius: 12px; }
    .iframe-glow { border-radius: 16px; }
  }

  .iframe-border {
    border-radius: 18px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
    background: #ffffff;
    box-shadow:
      0 0 0 1px rgba(0, 0, 0, 0.03),
      0 4px 16px rgba(0, 0, 0, 0.06),
      0 12px 40px rgba(0, 0, 0, 0.08);
    overflow-anchor: none;
    contain: layout style;
  }

  .iframe-glow {
    border-radius: 22px;
    padding: 4px;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.9) 0%,
      rgba(244, 243, 236, 0.6) 30%,
      rgba(255, 255, 255, 0.8) 50%,
      rgba(244, 243, 236, 0.5) 70%,
      rgba(255, 255, 255, 0.9) 100%
    );
    box-shadow:
      0 0 60px rgba(0, 0, 0, 0.04),
      0 0 120px rgba(0, 0, 0, 0.02);
    contain: layout style;
  }
</style>

<script>
  (function () {
    const iframe = document.getElementById('hero-iframe') as HTMLIFrameElement;
    if (!iframe) return;

    // ── Saved scroll state ──
    let savedY = 0;
    let savedX = 0;

    function saveScroll() {
      savedY = window.scrollY;
      savedX = window.scrollX;
    }

    function restoreScroll() {
      if (window.scrollY !== savedY) {
        window.scrollTo(savedX, savedY);
      }
    }

    // ── Layer 1: Blur on load ──
    iframe.addEventListener('load', () => {
      if (document.activeElement === iframe) {
        iframe.blur();
        document.body.focus({ preventScroll: true });
      }
    });

    // ── Layer 2: Intercept any focus on the iframe element itself ──
    document.addEventListener('focusin', (e) => {
      if (e.target === iframe) {
        saveScroll();
        requestAnimationFrame(restoreScroll);
      }
    }, true);

    // ── Layer 3: Save scroll before any interaction with iframe ──
    let iframeHovered = false;

    iframe.addEventListener('mouseenter', () => {
      iframeHovered = true;
      saveScroll();
    });
    iframe.addEventListener('mouseleave', () => {
      iframeHovered = false;
    });
    iframe.addEventListener('mousedown', saveScroll);
    iframe.addEventListener('touchstart', saveScroll, { passive: true });

    // ── Layer 4: Detect and revert scroll theft ──
    // When the iframe is hovered/active and a sudden scroll jump happens,
    // revert it. Legitimate user scrolls are continuous small deltas;
    // iframe focus-scroll is a single large jump.
    let lastScrollY = window.scrollY;
    let scrollTick = false;

    window.addEventListener('scroll', () => {
      if (scrollTick) return;
      scrollTick = true;

      requestAnimationFrame(() => {
        const currentY = window.scrollY;
        const delta = Math.abs(currentY - lastScrollY);

        // If iframe was just active and we got a big jump toward the iframe
        // (which is near the top of the page), revert it
        if (iframeHovered && delta > 100 && currentY < lastScrollY) {
          window.scrollTo(savedX, savedY);
        }

        lastScrollY = window.scrollY;
        scrollTick = false;
      });
    }, { passive: true });

    // ── Layer 5: Override window.scrollTo to block iframe-triggered scrolls ──
    const nativeScrollTo = window.scrollTo.bind(window);
    (window as any).__safeScrollTo = nativeScrollTo;

    window.scrollTo = function (...args: any[]) {
      // If the iframe is the active element and something is trying to scroll,
      // block it — this catches iframe internal .focus() → scrollIntoView chains
      if (document.activeElement === iframe) {
        return;
      }
      nativeScrollTo(...args);
    } as typeof window.scrollTo;

    // ── Layer 6: Blur iframe when it scrolls out of view ──
    const wrapper = iframe.closest('[data-iframe-wrapper]');
    if (wrapper) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries[0].isIntersecting && document.activeElement === iframe) {
            iframe.blur();
          }
        },
        { threshold: 0.1 }
      );
      observer.observe(wrapper);
    }
  })();
</script>
