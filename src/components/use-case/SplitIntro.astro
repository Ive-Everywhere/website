---
import LiveArt from '../site/LiveArt.astro';

/**
 * Section 2, the value prop. Figma `147:2592` (FRAME "Hero", second of three
 * siblings): a row with a copy column on the left and a product visual on the
 * right, no gap declared.
 *
 * The card shell, inner padding and visual slot are the ones the home page's
 * `FeatureCards.astro` uses (radius 16, padding 10 outside / 30 inside), so a
 * use-case page reads as the home page's sibling rather than a second system.
 *
 * The lead line is `Bold:` in the content pack and the sentence under it is
 * `Body:`. Neither carries a Figma node, because the drawn frame holds
 * placeholder copy that the finalized content replaces.
 */

interface Props {
  heading: string;
  body: string;
  linkLabel?: string;
  linkHref?: string;
  /** Which animated illustration fills the visual slot, if one fits. */
  art?: 'c1-a-compose' | 'c2-b-plan' | 'c3-b-audit';
  /** Read aloud in place of the animation, or shown when no art fits. */
  visualNote?: string;
}

const { heading, body, linkLabel, linkHref, art, visualNote } = Astro.props;
---

<section class="bg-bg-white-0">
  <div class="page-shell gutter-188 flex flex-col gap-10 py-14">
    <div class="bg-card-surface rounded-[16px] p-2.5">
      {/* Copy and visual sit side by side at `lg` and stack below it, the same
          breakpoint the home page's feature cards use, for the same reason: the
          copy column and the animation crush each other under about 1100px. */}
      <div
        class="flex flex-col justify-between gap-8 p-5 lg:flex-row lg:items-center lg:gap-14 lg:p-[30px]"
      >
        <div class="flex flex-col justify-center gap-8 lg:max-w-[460px] lg:gap-10">
          <div class="flex flex-col gap-3">
            <h2 class="t-h4 text-text-strong-950 text-balance">{heading}</h2>
            <p class="t-label-md text-text-sub-600 text-pretty">{body}</p>
          </div>

          {
            linkLabel && (
              <a
                href={linkHref ?? '#'}
                class="t-label-md text-primary-base hover:text-primary-dark focus-visible:outline-primary-base inline-flex w-fit min-h-11 items-center gap-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 lg:min-h-0"
              >
                <span>{linkLabel}</span>
                {/* Figma draws the arrow as a TEXT node, not an icon. */}
                <span aria-hidden="true">→</span>
              </a>
            )
          }
        </div>

        {/* The visual sits INSIDE the card's padding, so the space around it is
            the same 30px as everywhere else. Rounded to 12px, one step tighter
            than the card's 16. */}
        <div class="w-full min-w-0 shrink-0 overflow-hidden rounded-[12px] lg:w-[720px] lg:shrink">
          {
            art ? (
              <LiveArt
                src={art}
                title={visualNote ?? 'An agent working across connected systems.'}
                speed={1.35}
                zoom={1.3}
                surface="var(--art-surface)"
                class="w-full"
              />
            ) : (
              /* Contract rule 6: a labelled placeholder at the drawn aspect,
                 never stock art. */
              <div class="bg-bg-sub-300 relative aspect-[700/438] w-full overflow-hidden rounded-[12px]">
                <div class="t-paragraph-sm text-text-sub-600 absolute inset-0 flex items-center justify-center p-4 text-center">
                  <span class="copy-needed">
                    Illustration needed, {visualNote ?? 'product visual'}
                  </span>
                </div>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
