---
/**
 * The feature section — Figma `144:2835`.
 *
 * NOT a grid of cards. It is a scroll-linked switcher, the pattern ona.com uses
 * on its product pages: a fixed rail on the left listing every feature, and a
 * column of cards on the right. Scrolling the cards moves the rail's active
 * row; clicking a rail row scrolls to its card.
 *
 * Transcribed geometry:
 *   row            `147:2923` — gap 24
 *   rail           `147:2922` — fixed 272px, column, gap 12
 *     inactive row `147:2924` — padding 12, radius 8, no fill,
 *                               `Label/Large` (18/24, -0.015em) at #A3A3A3
 *     active row   `147:2911` — same box, fill #DDDBD1, gap 8, a 28px icon
 *                               before the label, label at full strength
 *   cards          `147:2956` — column, gap 24
 *     card         `147:2948` — radius 16, fill #EDEDE9, padding 10/10/0,
 *                               inner text row padding 30, space-between
 *
 * Figma draws three rows; the content gives five, so the pattern extends.
 *
 * Behaviour is ours — Figma carries no prototype data.
 */
interface FeatureCard {
  headline: string;
  eyebrow: string;
  body: string;
  icon?: string;
  linkHref?: string;
  linkLabel?: string;
  /** Feature-well illustration, relative to `public/`. Falls back to the placeholder. */
  art?: string;
}

interface Props {
  features: FeatureCard[];
  /** Rendered above the row when the page supplies a section title. */
  heading?: string;
  /**
   * The pillar pages label this section but never title it, so their heading is
   * ours rather than the source's. Marked, per contract rule 5.
   */
  headingNeedsCopy?: boolean;
  id?: string;
}

const { features, heading, headingNeedsCopy = false, id = 'features' } = Astro.props;
---

<section class="bg-bg-white-0">
  <div class="page-shell gutter-188 flex flex-col gap-8 py-14 lg:gap-12">
    {
      heading && (
        <h2 class="t-landing-h3 text-text-strong-950 text-balance">
          {headingNeedsCopy ? <span class="copy-needed">{heading}</span> : heading}
        </h2>
      )
    }

    {/* 147:2923 — the rail and the cards are siblings in one row so the rail
        can stick against the FULL height of the card column. Sticky only
        travels inside its own parent's box, so this row must be that box. */}
    <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-6" data-rail-root>
      {/* 147:2922 — 272px fixed. Hidden below `lg`: a 272px column beside the
          cards cannot fit, and a horizontal version of this reads as tabs,
          which is a different control. Each card carries its own heading
          there, so nothing is lost. */}
      {/* `sticky` also makes this the offsetParent the sliding fill measures
          against, so no `relative` is needed — and adding one would fight it. */}
      <nav
        class="sticky top-24 hidden w-[272px] shrink-0 flex-col gap-3 lg:flex"
        aria-label="Features"
        data-rail-list
      >
        {/* The active row's fill, as ONE element for the whole rail, so a
            scroll slides it from row to row. See `lib/slide-indicator.ts`. */}
        <div
          data-slide-indicator
          class="bg-bg-sub-300 pointer-events-none absolute inset-x-0 top-0 rounded-[8px] opacity-0"
          aria-hidden="true"
        >
        </div>
        {
          features.map((feature, index) => (
            <button
              type="button"
              data-rail-item={index}
              aria-current="false"
              class="group text-text-soft-400 aria-[current=true]:text-text-strong-950 focus-visible:outline-primary-base relative z-10 flex min-h-[52px] items-center gap-2 rounded-[8px] p-3 text-left transition-colors focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              {/* 147:2930 — the icon marks the active row.

                  DEVIATION, deliberate: Figma removes the icon from the
                  inactive rows, so the label would start 36px further left.
                  Measured consequence — at 272px the label then fits on one
                  line while inactive and wraps to two while active, so the row
                  grows 52px -> 72px and EVERY row below it jumps 20px at the
                  moment the selection arrives. The fill would slide onto a
                  target that moved under it.

                  So the icon keeps its box at all times and only its opacity
                  changes. Row heights are then fixed, and the active row is
                  still marked three ways: the fill, the icon, and the stronger
                  label colour. Figma draws one static state and carries no
                  prototype data, so it does not rule on this. */}
              <i
                class={`${feature.icon ?? 'ri-checkbox-circle-line'} size-7 shrink-0 text-[28px] leading-none opacity-0 transition-opacity duration-200 group-aria-[current=true]:opacity-100`}
                aria-hidden="true"
              />
              <span class="t-label-lg">{feature.navLabel ?? feature.headline}</span>
            </button>
          ))
        }
      </nav>

      {/* 147:2956 — the cards. `scroll-mt` clears the sticky site header when a
          rail click scrolls one into view. */}
      <div class="flex min-w-0 flex-1 flex-col gap-6">
        {
          features.map((feature, index) => (
            <article
              id={`${id}-${index}`}
              data-rail-card={index}
              class="bg-card-surface scroll-mt-28 flex flex-col gap-6 rounded-[16px] px-2.5 pt-2.5 lg:min-h-[500px] lg:flex-row lg:items-stretch lg:gap-8"
            >
              {/* 147:2949 — padding 30, space-between. The copy sits in the
                  card's own padding; the well below bleeds to the bottom edge,
                  which is what the shell's 10/10/0 padding is for. */}
              <div class="flex min-w-0 flex-col gap-4 p-5 lg:max-w-[420px] lg:flex-1 lg:justify-center lg:p-[30px]">
                <i
                  class={`${feature.icon ?? 'ri-checkbox-circle-line'} text-icon-sub-600 text-[40px]`}
                  aria-hidden="true"
                />
                <h3 class="t-h4 text-text-strong-950 text-balance">{feature.headline}</h3>
                <p class="t-label-md text-text-sub-600 text-pretty">{feature.body}</p>
                {feature.linkHref && (
                  <a
                    href={feature.linkHref}
                    class="t-label-md text-primary-base hover:text-primary-dark focus-visible:outline-primary-base mt-1 inline-flex min-h-11 w-fit items-center gap-1 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 lg:min-h-0"
                  >
                    {feature.linkLabel ?? 'Learn more'} <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>

              {/* 147:2954 "Form" — a 440 x 460 well holding the feature's
                  visual. The artwork for these is not produced yet, so the well
                  is drawn and labelled rather than filled with stock art. It
                  bleeds to the card's bottom edge, as drawn. */}
              <div
                class="bg-art-surface flex items-center justify-center self-end overflow-hidden rounded-t-[10px] max-lg:mx-2.5 max-lg:aspect-[440/300] max-lg:w-[calc(100%-1.25rem)] lg:min-h-[460px] lg:w-[440px] lg:shrink-0"
              >
                {
                  feature.art ? (
                    <img
                      src={feature.art}
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      class="size-full object-cover"
                    />
                  ) : (
                    <span class="t-paragraph-sm copy-needed text-center">
                      Visual needed — {feature.headline}
                    </span>
                  )
                }
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { mountSlideIndicator, watchLayout } from '../../lib/slide-indicator';

  /**
   * Scroll drives the rail; clicking the rail drives the scroll.
   *
   * WHY THIS IS NOT AN IntersectionObserver.
   * It was, and it jittered: the rail would jump forward then snap back
   * whenever two cards shared the screen. Two reasons, both fatal.
   *  1. The observer callback receives only the entries that CHANGED, not all
   *     of them, so picking a winner from that batch compares an arbitrary
   *     subset against each other rather than against every card.
   *  2. `intersectionRatio` is relative to each card's OWN height, so a card
   *     half in view scores the same as a different card half in view, and the
   *     two swap ranks repeatedly as you scroll across the boundary.
   *
   * Nearest-midpoint-to-an-anchor-line is deterministic instead: every card is
   * measured against one fixed line each frame, so the winner changes exactly
   * once as you cross between two cards, and never changes back.
   */
  for (const root of document.querySelectorAll<HTMLElement>('[data-rail-root]')) {
    const items = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-rail-item]'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-rail-card]'));
    if (!items.length || !cards.length) continue;

    const list = root.querySelector<HTMLElement>('[data-rail-list]');
    const fill = list ? mountSlideIndicator(list, items) : null;
    if (list && fill) watchLayout(list, fill);

    let current = -1;
    /** Set while a rail click animates, so cards flying past do not light up. */
    let lockUntil = 0;

    const setActive = (index: number) => {
      if (index === current) return;
      current = index;
      fill?.moveTo(index);
      for (const item of items) {
        item.setAttribute('aria-current', String(Number(item.dataset.railItem) === index));
      }
    };

    const update = () => {
      if (performance.now() < lockUntil) return;
      // The anchor sits above centre so the active row matches the card you are
      // reading, not the one you are scrolling towards.
      const anchor = window.innerHeight * 0.42;
      let best = 0;
      let bestDistance = Infinity;
      for (let i = 0; i < cards.length; i += 1) {
        const box = cards[i].getBoundingClientRect();
        // Distance from the anchor to the card's span: zero while the anchor is
        // inside the card, so a tall card holds the rail for its whole height.
        const distance =
          anchor < box.top ? box.top - anchor : anchor > box.bottom ? anchor - box.bottom : 0;
        if (distance < bestDistance) {
          bestDistance = distance;
          best = i;
        }
      }
      setActive(best);
    };

    // One measurement per frame at most; scroll fires far more often than that.
    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    update();

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    for (const item of items) {
      item.addEventListener('click', () => {
        const index = Number(item.dataset.railItem);
        setActive(index);
        // Hold the selection while the smooth scroll runs, or every card it
        // passes would claim the rail on the way.
        lockUntil = performance.now() + (reduced ? 0 : 700);
        cards[index]?.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      });
    }
  }
</script>
