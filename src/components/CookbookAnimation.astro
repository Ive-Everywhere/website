---
// Cookbook workflow animation — loops through 3 commands with step-by-step execution
---

<div class="cb-wrap">
  <img src="/images/cookbook-bg.png" alt="" class="cb-bg" />

  <div class="cb-window">
    <!-- Window chrome -->
    <div class="cb-chrome">
      <div class="cb-dots">
        <span style="background:#e8655a;"></span>
        <span style="background:#e8c15a;"></span>
        <span style="background:#67c96c;"></span>
      </div>
      <div class="cb-chrome-right">
        <span>Cookbook</span>
      </div>
    </div>

    <!-- Content area -->
    <div class="cb-body">
      <!-- Command 1: /competitor-intel -->
      <div class="cb-scene cb-scene-1">
        <div class="cb-left">
          <div class="cb-cmd">/competitor-intel</div>
        </div>
        <div class="cb-divider"></div>
        <div class="cb-right">
          <div class="cb-step cb-s1-1">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Pull company data</span>
            <img src="/logos/integrations/apollographql.svg" class="cb-icon" alt="" style="filter:invert(0.5);" />
          </div>
          <div class="cb-step cb-s1-2">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Cross-reference contacts</span>
            <img src="/logos/integrations/hubspot.svg" class="cb-icon" alt="" />
          </div>
          <div class="cb-step cb-s1-3">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Analyze pricing</span>
            <img src="/logos/integrations/notion.svg" class="cb-icon" alt="" style="filter:invert(0.5);" />
          </div>
          <div class="cb-step cb-s1-4">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Draft comparison report</span>
            <img src="/logos/integrations/googlesheets.svg" class="cb-icon" alt="" />
          </div>
          <div class="cb-step cb-s1-5">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Notify #sales</span>
            <img src="/logos/integrations/slack.svg" class="cb-icon" alt="" />
          </div>
        </div>
      </div>

      <!-- Command 2: /weekly-report -->
      <div class="cb-scene cb-scene-2">
        <div class="cb-left">
          <div class="cb-cmd">/weekly-report</div>
        </div>
        <div class="cb-divider"></div>
        <div class="cb-right">
          <div class="cb-step cb-s2-1">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Pull pipeline metrics</span>
            <img src="/logos/integrations/salesforce.svg" class="cb-icon" alt="" />
          </div>
          <div class="cb-step cb-s2-2">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Build summary sheet</span>
            <img src="/logos/integrations/googlesheets.svg" class="cb-icon" alt="" />
          </div>
          <div class="cb-step cb-s2-3">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Email to leadership</span>
            <img src="/logos/integrations/gmail.svg" class="cb-icon" alt="" />
          </div>
          <div class="cb-step cb-s2-4">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Post to #team-updates</span>
            <img src="/logos/integrations/slack.svg" class="cb-icon" alt="" />
          </div>
        </div>
      </div>

      <!-- Command 3: /lead-enrichment -->
      <div class="cb-scene cb-scene-3">
        <div class="cb-left">
          <div class="cb-cmd">/lead-enrichment</div>
        </div>
        <div class="cb-divider"></div>
        <div class="cb-right">
          <div class="cb-step cb-s3-1">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Import new leads</span>
            <img src="/logos/integrations/hubspot.svg" class="cb-icon" alt="" />
          </div>
          <div class="cb-step cb-s3-2">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Enrich with contact data</span>
            <img src="/logos/integrations/apollographql.svg" class="cb-icon" alt="" style="filter:invert(0.5);" />
          </div>
          <div class="cb-step cb-s3-3">
            <div class="cb-loader"><svg class="cb-spinner" viewBox="0 0 20 20"><circle cx="10" cy="10" r="8"/></svg><svg class="cb-tick" viewBox="0 0 20 20"><path d="M6 10l3 3 5-6"/></svg></div>
            <span class="cb-step-text">Update pipeline tracker</span>
            <img src="/logos/integrations/googlesheets.svg" class="cb-icon" alt="" />
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .cb-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    box-sizing: border-box;
  }

  .cb-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .cb-window {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 500px;
    background: rgba(250, 249, 244, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 12px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25), 0 0 0 1px rgba(255,255,255,0.1);
    overflow: hidden;
    font-family: 'Inter', sans-serif;
  }

  /* Chrome bar */
  .cb-chrome {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(0,0,0,0.06);
  }
  .cb-dots {
    display: flex;
    gap: 6px;
  }
  .cb-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .cb-chrome-right {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: #17100e;
    font-weight: 600;
  }

  /* Body */
  .cb-body {
    position: relative;
    min-height: 220px;
  }

  /* Scene (one command) */
  .cb-scene {
    position: absolute;
    inset: 0;
    display: flex;
    padding: 24px 20px;
    opacity: 0;
  }

  .cb-left {
    width: 38%;
    display: flex;
    align-items: flex-start;
    padding-top: 8px;
    padding-right: 16px;
  }
  .cb-cmd {
    font-family: 'Roboto Mono', monospace;
    font-size: 13px;
    font-weight: 500;
    color: #17100e;
    opacity: 0;
    transform: translateY(8px);
  }
  .cb-divider {
    width: 1px;
    background: rgba(0,0,0,0.06);
    flex-shrink: 0;
    align-self: stretch;
  }
  .cb-right {
    flex: 1;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    justify-content: center;
  }

  /* Step row */
  .cb-step {
    display: flex;
    align-items: center;
    gap: 10px;
    opacity: 0;
    transform: translateY(6px);
  }

  /* Loader (spinner + tick) */
  .cb-loader {
    width: 14px;
    height: 14px;
    position: relative;
    flex-shrink: 0;
  }
  .cb-spinner {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cb-spinner circle {
    fill: none;
    stroke: #d4d3cb;
    stroke-width: 2;
    stroke-dasharray: 50;
    stroke-dashoffset: 50;
    stroke-linecap: round;
    transform-origin: center;
  }
  .cb-tick {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transform: scale(0);
  }
  .cb-tick path {
    fill: none;
    stroke: #17100e;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .cb-step-text {
    font-size: 12px;
    color: #17100e;
    font-weight: 500;
    flex: 1;
  }
  .cb-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.5;
  }
</style>

<script>
(function() {
  const wrap = document.querySelector('.cb-body');
  if (!wrap) return;

  const commands = [
    { scene: '.cb-scene-1', steps: 5 },
    { scene: '.cb-scene-2', steps: 4 },
    { scene: '.cb-scene-3', steps: 3 },
  ];

  const STEP_DURATION = 1200;
  const HOLD = 1000;
  const FADE = 600;

  let currentCmd = 0;

  function ease(el: HTMLElement, props: Record<string, string>, duration: number, delay = 0) {
    return new Promise<void>(resolve => {
      setTimeout(() => {
        el.style.transition = `all ${duration}ms cubic-bezier(0.16, 1, 0.3, 1)`;
        Object.assign(el.style, props);
        setTimeout(resolve, duration);
      }, delay);
    });
  }

  function fadeOut(el: HTMLElement, duration: number) {
    return new Promise<void>(resolve => {
      el.style.transition = `all ${duration}ms cubic-bezier(0.4, 0, 0.2, 1)`;
      el.style.opacity = '0';
      el.style.transform = 'translateY(-6px)';
      setTimeout(resolve, duration);
    });
  }

  async function runStep(stepEl: HTMLElement) {
    const spinner = stepEl.querySelector('.cb-spinner circle') as SVGCircleElement;
    const tick = stepEl.querySelector('.cb-tick') as HTMLElement;

    // Animate spinner stroke
    spinner.style.transition = `stroke-dashoffset ${STEP_DURATION * 0.7}ms cubic-bezier(0.4, 0, 0.2, 1), stroke ${200}ms ease`;
    spinner.style.strokeDashoffset = '0';
    spinner.style.stroke = '#17100e';

    await new Promise(r => setTimeout(r, STEP_DURATION * 0.75));

    // Complete: hide spinner, show tick
    spinner.style.opacity = '0';
    tick.style.transition = 'all 300ms cubic-bezier(0.16, 1, 0.3, 1)';
    tick.style.opacity = '1';
    tick.style.transform = 'scale(1)';

    await new Promise(r => setTimeout(r, 200));
  }

  function resetStep(stepEl: HTMLElement) {
    const spinner = stepEl.querySelector('.cb-spinner circle') as SVGCircleElement;
    const tick = stepEl.querySelector('.cb-tick') as HTMLElement;
    stepEl.style.transition = 'none';
    stepEl.style.opacity = '0';
    stepEl.style.transform = 'translateY(6px)';
    spinner.style.transition = 'none';
    spinner.style.strokeDashoffset = '50';
    spinner.style.stroke = '#d4d3cb';
    spinner.style.opacity = '1';
    tick.style.transition = 'none';
    tick.style.opacity = '0';
    tick.style.transform = 'scale(0)';
  }

  async function runCommand(cmdIndex: number) {
    const cmd = commands[cmdIndex];
    const scene = document.querySelector(cmd.scene) as HTMLElement;
    const cmdLabel = scene.querySelector('.cb-cmd') as HTMLElement;
    const steps = scene.querySelectorAll('.cb-step') as NodeListOf<HTMLElement>;

    // Reset all
    scene.style.transition = 'none';
    scene.style.opacity = '0';
    cmdLabel.style.transition = 'none';
    cmdLabel.style.opacity = '0';
    cmdLabel.style.transform = 'translateY(8px)';
    steps.forEach(s => resetStep(s));

    // Force reflow
    void scene.offsetHeight;

    // Fade in scene
    await ease(scene, { opacity: '1' }, FADE);

    // Fade in command name
    await ease(cmdLabel, { opacity: '1', transform: 'translateY(0)' }, 400);

    // Stagger-reveal steps
    for (let i = 0; i < steps.length; i++) {
      ease(steps[i], { opacity: '1', transform: 'translateY(0)' }, 350, i * 80);
    }
    await new Promise(r => setTimeout(r, 350 + steps.length * 80));

    // Run steps sequentially
    for (let i = 0; i < steps.length; i++) {
      await runStep(steps[i]);
    }

    // Hold complete state
    await new Promise(r => setTimeout(r, HOLD));

    // Fade out entire scene
    await fadeOut(scene, FADE);
  }

  async function loop() {
    while (true) {
      await runCommand(currentCmd);
      currentCmd = (currentCmd + 1) % commands.length;
    }
  }

  // Start when visible
  const io = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) {
      io.disconnect();
      loop();
    }
  }, { threshold: 0.3 });
  io.observe(wrap);
})();
</script>
