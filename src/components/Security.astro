---
---
<section class="py-20 md:py-28">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      <!-- Left: Text content -->
      <div>
        <span class="inline-block text-sm text-[#6B6B6B] border border-black/10 rounded-full px-3 py-1 mb-4">Security</span>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight mb-4 leading-tight">
          Your data is always safe, private, and fully under your control
        </h2>
        <p class="text-[#6B6B6B] mb-8 leading-relaxed">
          Encrypted, isolated, and protected across every interaction.
        </p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span class="text-sm font-medium">End-to-end encryption</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span class="text-sm font-medium">Role-based permissions</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
            <span class="text-sm font-medium">Compliance built-in</span>
          </li>
        </ul>
        <a href="#" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-black/80 text-sm font-medium hover:bg-black/5 transition-colors">
          Book a demo
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 17L17 7M17 7H7M17 7v10"/></svg>
        </a>
      </div>

      <!-- Right: Security feature cards -->
      <div class="space-y-4">
        <div class="bg-[#E8E3DA] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#D5D0C7] flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <div>
            <h3 class="font-bold mb-1">Full encryption</h3>
            <p class="text-sm text-[#6B6B6B]">All records are encrypted and stored securely by region.</p>
          </div>
        </div>
        <div class="bg-[#E8E3DA] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#D5D0C7] flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"/></svg>
          </div>
          <div>
            <h3 class="font-bold mb-1">Secure storage</h3>
            <p class="text-sm text-[#6B6B6B]">Only your team can access or export internal data.</p>
          </div>
        </div>
        <div class="bg-[#E8E3DA] rounded-2xl p-6 flex items-start gap-4">
          <div class="w-10 h-10 rounded-xl bg-[#D5D0C7] flex items-center justify-center flex-shrink-0">
            <svg class="w-5 h-5 text-[#6B6B6B]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
          </div>
          <div>
            <h3 class="font-bold mb-1">Audit logs</h3>
            <p class="text-sm text-[#6B6B6B]">Track every action, access, and change in real time.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
