---
const checklist = [
  'End-to-end encrypted',
  'Role-based permissions',
  'Compliance built in',
  'Audit logs for every action',
  'No training on your data',
];

const securityCards = [
  {
    title: 'Full encryption',
    description: 'All models are encrypted and protected according to regulations.',
    icon: 'lock',
  },
  {
    title: 'Secure storage',
    description: 'Only your team can access or transfer stored information.',
    icon: 'shield',
  },
  {
    title: 'Audit logs',
    description: 'Track every action, access, and change in real time.',
    icon: 'doc',
  },
];
---

<!-- Security: bg #f4f3ec, padding 96px 268px, gap 80px, HORIZONTAL layout -->
<section style="background: #f4f3ec; padding: 96px 268px;">
  <div style="display: flex; gap: 80px; max-width: 1440px; margin: 0 auto; align-items: flex-start;">
    <!-- LEFT side: heading, description, checklist, button -->
    <div class="reveal" style="flex: 1;">
      <span style="font-family: 'Inter', sans-serif; font-size: 12px; text-transform: uppercase; letter-spacing: 0.15em; color: #7d7d7d; font-weight: 500;">Security</span>

      <h2 style="font-family: 'Bricolage Grotesque', sans-serif; font-weight: 700; font-size: 36px; letter-spacing: -1px; color: #000000; line-height: 1.2; margin: 16px 0 0 0; max-width: 420px;">
        Your data is always safe, private, and fully under your control
      </h2>

      <p style="font-family: 'Inter', sans-serif; font-size: 15px; color: #5c5c5c; line-height: 1.6; margin: 16px 0 0 0;">
        Enterprise-grade security is built into every layer of Eluu, so your team can work confidently. Eluu stores data in encrypted, region-isolated environments. Each workspace is fully independent.
      </p>

      <!-- Checklist -->
      <div style="margin-top: 32px; display: flex; flex-direction: column; gap: 16px;">
        {checklist.map((item) => (
          <div style="display: flex; gap: 12px; align-items: center;">
            <div style="width: 24px; height: 24px; border-radius: 50%; background: #f4f3ec; border: 1px solid #ebebeb; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M2 6L5 9L10 3" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <span style="font-family: 'Inter', sans-serif; font-size: 15px; color: #000000;">{item}</span>
          </div>
        ))}
      </div>

      <!-- Button -->
      <a
        href="#"
        style="display: inline-flex; align-items: center; gap: 8px; margin-top: 32px; background: #343636; color: #ffffff; border-radius: 10px; font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; padding: 10px 36px; text-decoration: none;"
      >
        Book a demo
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <!-- RIGHT side: security feature cards -->
    <div style="flex: 1; display: flex; flex-direction: column; gap: 16px;">
      {securityCards.map((card) => (
        <div class="reveal card-hover" style="background: #ffffff; border: 1px solid #ebebeb; border-radius: 16px; padding: 24px; display: flex; gap: 20px; align-items: flex-start;">
          <!-- Icon -->
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f4f3ec; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
            {card.icon === 'lock' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="4" y="9" width="12" height="9" rx="2" stroke="#171717" stroke-width="1.5"/>
                <path d="M7 9V6C7 4.34315 8.34315 3 10 3C11.6569 3 13 4.34315 13 6V9" stroke="#171717" stroke-width="1.5" stroke-linecap="round"/>
                <circle cx="10" cy="13.5" r="1.5" fill="#171717"/>
              </svg>
            )}
            {card.icon === 'shield' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 2L3 5V10C3 14.42 6.03 18.53 10 19.5C13.97 18.53 17 14.42 17 10V5L10 2Z" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7 10L9 12L13 8" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            )}
            {card.icon === 'doc' && (
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M6 2H11.5L16 6.5V16C16 17.1046 15.1046 18 14 18H6C4.89543 18 4 17.1046 4 16V4C4 2.89543 4.89543 2 6 2Z" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M11 2V7H16" stroke="#171717" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M7 11H13M7 14H11" stroke="#171717" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            )}
          </div>
          <!-- Text -->
          <div>
            <h3 style="font-family: 'Inter', sans-serif; font-size: 16px; font-weight: 600; color: #000000; margin: 0;">{card.title}</h3>
            <p style="font-family: 'Inter', sans-serif; font-size: 14px; color: #5c5c5c; line-height: 1.5; margin: 4px 0 0 0;">{card.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
