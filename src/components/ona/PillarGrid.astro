---
// PillarGrid — heading + 4 linked cards (the "AI workforce" pillar grid).
// Props: heading, cards (array of { name, body, ctaLabel, href }).
interface Card {
  name: string;
  body: string;
  ctaLabel: string;
  href: string;
}
interface Props {
  heading: string;
  cards: Card[];
}
const { heading, cards } = Astro.props;
---

<section class="opg">
  <div class="opg-container">
    <div class="opg-intro reveal">
      <h2 class="opg-heading">{heading}</h2>
    </div>
    <div class="opg-grid">
      {cards.map((card) => (
        <a href={card.href} class="opg-card reveal">
          <div class="opg-card-text">
            <h3 class="opg-card-name">{card.name}</h3>
            <p class="opg-card-body">{card.body}</p>
          </div>
          <span class="opg-card-cta">
            {card.ctaLabel}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .opg {
    background: #13100a;
    padding: 112px 0 0;
  }
  .opg-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .opg-intro {
    margin-bottom: 22.4px;
  }
  .opg-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  .opg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .opg-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .opg-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .opg-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 28px;
    background: #1e1d1b;
    border-radius: 4px;
    padding: 24px;
    box-sizing: border-box;
    text-decoration: none;
    overflow: hidden;
    transition: background 0.25s ease;
  }
  .opg-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
    transition: border-color 0.25s ease;
  }
  .opg-card:hover { background: #232220; }
  .opg-card:hover::before { border-color: rgba(237, 233, 227, 0.08); }

  .opg-card-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .opg-card-name {
    font-family: 'Söhne', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .opg-card-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }
  .opg-card-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .opg-card-cta svg { transition: transform 0.2s ease; }
  .opg-card:hover .opg-card-cta svg { transform: translateX(2px); }

  @media (max-width: 639px) {
    .opg { padding: 64px 0 0; }
    .opg-card { padding: 20px 16px; gap: 20px; }
  }
</style>
