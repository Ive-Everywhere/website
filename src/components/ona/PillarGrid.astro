---
// PillarGrid — heading + the 4-pillar frame (the "AI workforce" section).
// Structure per ona ref (frame-02): ONE outer rounded container with a hairline
// border, internally divided 2×2 by hairline lines (no gaps, no separate cards).
// Each cell: text column (h3, muted body, arrow-link) + decorative dot-matrix
// graphic on the right. Props: heading, cards ({ name, body, ctaLabel, href }[]).
interface Card {
  name: string;
  body: string;
  ctaLabel: string;
  href: string;
}
interface Props {
  heading: string;
  cards: Card[];
}
const { heading, cards } = Astro.props;

// ── Dot-matrix generation ─────────────────────────────────────────────
// ~13×9 grid of small round dots; a deterministic subset renders brighter,
// forming a slightly different pattern per cell (seeded PRNG, no runtime JS).
const COLS = 13;
const ROWS = 9;
const STEP = 13;
const R = 2.4;
function matrixDots(seed: number) {
  let s = (seed + 1) * 7919;
  const rand = () => {
    s = (s * 9301 + 49297) % 233280;
    return s / 233280;
  };
  const dots: { x: number; y: number; on: boolean }[] = [];
  for (let row = 0; row < ROWS; row++) {
    for (let col = 0; col < COLS; col++) {
      dots.push({
        x: col * STEP + R,
        y: row * STEP + R,
        on: rand() < 0.34,
      });
    }
  }
  return dots;
}
const W = (COLS - 1) * STEP + R * 2;
const H = (ROWS - 1) * STEP + R * 2;
---

<section class="opg">
  <div class="opg-container">
    <div class="opg-intro reveal">
      <h2 class="opg-heading">{heading}</h2>
    </div>
    <div class="opg-frame reveal">
      {cards.map((card, i) => (
        <a href={card.href} class="opg-cell">
          <div class="opg-cell-text">
            <h3 class="opg-cell-name">{card.name}</h3>
            <p class="opg-cell-body">{card.body}</p>
            <span class="opg-cell-cta">
              {card.ctaLabel}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </span>
          </div>
          <div class="opg-cell-matrix" aria-hidden="true">
            <svg width={W} height={H} viewBox={`0 0 ${W} ${H}`} fill="none">
              {matrixDots(i).map((d) => (
                <circle
                  cx={d.x}
                  cy={d.y}
                  r={R}
                  class={d.on ? 'opg-dot-on' : 'opg-dot-off'}
                />
              ))}
            </svg>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .opg {
    background: #13100a;
    padding: 96px 0 0;
  }
  .opg-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .opg-intro {
    margin-bottom: 24px;
  }
  .opg-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  /* ── One frame, hairline-divided 2×2 (no gaps, no separate cards) ── */
  .opg-frame {
    display: grid;
    grid-template-columns: 1fr;
    border: 1px solid rgba(237, 233, 227, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }
  @media (min-width: 900px) {
    .opg-frame { grid-template-columns: 1fr 1fr; }
  }

  .opg-cell {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 40px;
    padding: 44px 44px 40px;
    box-sizing: border-box;
    text-decoration: none;
    border-bottom: 1px solid rgba(237, 233, 227, 0.1);
    transition: background 0.18s ease-out;
  }
  .opg-cell:last-child { border-bottom: none; }
  @media (min-width: 900px) {
    /* internal hairlines: right edge on left column, bottom edge on top row */
    .opg-cell:nth-child(odd) { border-right: 1px solid rgba(237, 233, 227, 0.1); }
    .opg-cell:nth-child(3),
    .opg-cell:nth-child(4) { border-bottom: none; }
  }
  .opg-cell:hover { background: rgba(237, 233, 227, 0.02); }

  .opg-cell-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 34ch;
  }
  .opg-cell-name {
    font-family: 'Söhne', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .opg-cell-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 14px 0 0;
    text-wrap: pretty;
  }
  .opg-cell-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 26px;
    transition: color 0.18s ease-out;
  }
  .opg-cell-cta svg { transition: transform 0.18s ease-out; }
  .opg-cell:hover .opg-cell-cta { color: #f28e5f; }
  .opg-cell:hover .opg-cell-cta svg { transform: translateX(2px); }

  .opg-cell-matrix {
    flex-shrink: 0;
    display: flex;
    align-items: flex-start;
  }
  .opg-cell-matrix :global(.opg-dot-on) {
    fill: rgba(237, 233, 227, 0.45);
    transition: fill 0.18s ease-out;
  }
  .opg-cell-matrix :global(.opg-dot-off) {
    fill: rgba(237, 233, 227, 0.12);
  }
  .opg-cell:hover .opg-cell-matrix :global(.opg-dot-on) {
    fill: rgba(237, 233, 227, 0.75);
  }
  @media (max-width: 479px) {
    .opg-cell-matrix { display: none; }
  }

  @media (max-width: 899px) {
    .opg-cell { padding: 28px 24px; gap: 24px; }
  }
  @media (max-width: 639px) {
    .opg { padding: 64px 0 0; }
  }
</style>
