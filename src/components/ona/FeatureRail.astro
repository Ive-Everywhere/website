---
// FeatureRail — case-page feature section per ona ref (case frames 02–06):
// sticky left rail listing feature names (active item = filled pill, driven by
// IntersectionObserver as the full-width feature blocks scroll by) + right
// column of stacked blocks: eyebrow-quote, title, body, large media panel.
// Replaces the old FeatureCards 2×2 grid (wrong anatomy — audit v2 U4/P3).
// Props: heading?, features ({ name, eyebrow?, title, body, vignette?,
//   mediaLabel? }[]). `vignette: { variant, tint }` renders a Vignette in the
//   media panel; mediaLabel remains as the empty-panel fallback.
import Vignette from './Vignette.astro';
import type { VignetteVariant, VignetteTint } from './Vignette.astro';

interface Feature {
  /** Short rail label (2–4 words) */
  name: string;
  /** Quoted tagline shown above the title */
  eyebrow?: string;
  title: string;
  body: string;
  /** Media vignette rendered in the panel (Pass C) */
  vignette?: { variant: VignetteVariant; tint?: VignetteTint };
  /** Fallback label when no vignette is mapped */
  mediaLabel?: string;
}
interface Props {
  heading?: string;
  features: Feature[];
}
const { heading, features } = Astro.props;

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
const ids = features.map((f, i) => `fr-${slugify(f.name) || i}`);
---

<section class="ofr" data-feature-rail>
  <div class="ofr-container">
    {heading && (
      <div class="ofr-intro reveal">
        <h2 class="ofr-heading">{heading}</h2>
      </div>
    )}
    <div class="ofr-layout">
      <nav class="ofr-rail" aria-label="Features">
        {features.map((feature, i) => (
          <a
            class="ofr-rail-item"
            href={`#${ids[i]}`}
            data-rail-link={ids[i]}
            aria-current={i === 0 ? 'true' : undefined}
          >
            <span class="ofr-rail-dot" aria-hidden="true"></span>
            <span class="ofr-rail-label">{feature.name}</span>
          </a>
        ))}
      </nav>
      <div class="ofr-blocks">
        {features.map((feature, i) => (
          <article class="ofr-block reveal" id={ids[i]} data-rail-section={ids[i]}>
            {feature.eyebrow && (
              <span class="ofr-block-eyebrow">&ldquo;{feature.eyebrow}&rdquo;</span>
            )}
            <h3 class="ofr-block-title">{feature.title}</h3>
            <p class="ofr-block-body">{feature.body}</p>
            <div class:list={['ofr-block-media', { 'ofr-block-media--vignette': feature.vignette }]}>
              {feature.vignette ? (
                <Vignette variant={feature.vignette.variant} tint={feature.vignette.tint} />
              ) : (
                <span class="ofr-media-label">{feature.mediaLabel ?? 'Product visual'}</span>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initFeatureRails() {
    document.querySelectorAll<HTMLElement>('[data-feature-rail]').forEach((root) => {
      if (root.dataset.railInit === 'true') return;
      root.dataset.railInit = 'true';

      const links = Array.from(
        root.querySelectorAll<HTMLAnchorElement>('[data-rail-link]')
      );
      const sections = Array.from(
        root.querySelectorAll<HTMLElement>('[data-rail-section]')
      );
      if (!links.length || !sections.length) return;

      const linkFor = new Map<string, HTMLAnchorElement>();
      links.forEach((link) => {
        const id = link.getAttribute('data-rail-link');
        if (id) linkFor.set(id, link);
      });

      const setActive = (id: string) => {
        links.forEach((link) => {
          const isActive = link.getAttribute('data-rail-link') === id;
          link.classList.toggle('is-active', isActive);
          if (isActive) link.setAttribute('aria-current', 'true');
          else link.removeAttribute('aria-current');
        });
      };

      // Active = the section that is ≥50% in view (falls back to the most
      // visible section for blocks taller than half the viewport).
      const visibility = new Map<string, number>();
      const pickActive = () => {
        let bestId = '';
        let bestRatio = 0;
        visibility.forEach((ratio, id) => {
          if (ratio > bestRatio) {
            bestRatio = ratio;
            bestId = id;
          }
        });
        if (bestId) setActive(bestId);
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const id = entry.target.getAttribute('data-rail-section');
            if (id) visibility.set(id, entry.isIntersecting ? entry.intersectionRatio : 0);
          });
          pickActive();
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] }
      );
      sections.forEach((section) => observer.observe(section));

      // Rail items smooth-scroll to their section.
      links.forEach((link) => {
        link.addEventListener('click', (event) => {
          const id = link.getAttribute('data-rail-link');
          const target = id ? document.getElementById(id) : null;
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          history.replaceState(null, '', `#${id}`);
        });
      });

      // Initial state: first item active.
      const first = links[0].getAttribute('data-rail-link');
      if (first) setActive(first);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFeatureRails);
  } else {
    initFeatureRails();
  }
  document.addEventListener('astro:page-load', initFeatureRails);
</script>

<style>
  .ofr {
    background: #13100a;
    padding: 96px 0 32px;
  }
  .ofr-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ofr-intro {
    margin-bottom: 56px;
  }
  .ofr-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  /* ── layout: sticky rail + block column ── */
  .ofr-layout {
    display: grid;
    grid-template-columns: 1fr;
  }
  @media (min-width: 980px) {
    .ofr-layout {
      grid-template-columns: 260px 1fr;
      gap: 96px;
    }
  }

  /* ── left rail ── */
  .ofr-rail {
    display: none;
  }
  @media (min-width: 980px) {
    .ofr-rail {
      display: flex;
      flex-direction: column;
      gap: 4px;
      position: sticky;
      top: 120px;
      align-self: start;
    }
  }
  .ofr-rail-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-radius: 2px;
    font-family: 'Söhne', sans-serif;
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.3;
    color: rgba(237, 233, 227, 0.5);
    text-decoration: none;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .ofr-rail-item:hover {
    color: rgba(237, 233, 227, 0.75);
  }
  .ofr-rail-dot {
    flex: none;
    width: 5px;
    height: 5px;
    border-radius: 1px;
    background: currentColor;
    opacity: 0.55;
    transition: opacity 0.2s ease, background-color 0.2s ease;
  }
  .ofr-rail-item.is-active {
    background: #1e1d1b;
    color: #ede9e3;
  }
  .ofr-rail-item.is-active .ofr-rail-dot {
    background: #ED733B;
    opacity: 1;
  }

  /* ── right column: one full-width block per feature ── */
  .ofr-blocks {
    display: flex;
    flex-direction: column;
    gap: 64px;
    min-width: 0;
  }
  @media (min-width: 980px) {
    .ofr-blocks {
      gap: 110px;
    }
  }
  .ofr-block {
    display: flex;
    flex-direction: column;
    scroll-margin-top: 120px;
  }

  .ofr-block-eyebrow {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    font-style: italic;
    color: #ED733B;
    line-height: 1.4;
    margin-bottom: 14px;
  }
  .ofr-block-title {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .ofr-block-body {
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.55;
    letter-spacing: -0.005em;
    max-width: 60ch;
    margin: 12px 0 0;
    text-wrap: pretty;
  }

  /* ── media panel (Pass C fills these with vignettes) ── */
  .ofr-block-media {
    position: relative;
    width: 100%;
    height: 260px;
    margin-top: 32px;
    background: #1e1d1b;
    border-radius: 2px;
    display: grid;
    place-items: center;
    box-sizing: border-box;
    overflow: hidden;
  }
  .ofr-block-media::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 2px;
    border: 1px solid rgba(237, 233, 227, 0.06);
  }
  @media (min-width: 980px) {
    .ofr-block-media {
      height: clamp(380px, 44vw, 460px);
      margin-top: 40px;
    }
  }
  /* vignette fills the panel; Vignette brings its own surface + hairline */
  .ofr-block-media--vignette {
    background: none;
    place-items: stretch;
  }
  .ofr-block-media--vignette::before {
    content: none;
  }
  .ofr-media-label {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.35);
    line-height: 1.4;
    text-align: center;
    padding: 0 24px;
  }

  @media (max-width: 979px) {
    .ofr {
      padding: 64px 0 16px;
    }
  }
</style>
