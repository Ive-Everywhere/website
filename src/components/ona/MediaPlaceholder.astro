---
// MediaPlaceholder — bordered panel standing in for a future media asset.
// Internal helper used across ona components. Props: label (describes the asset),
// ratio (CSS aspect-ratio value), compact (smaller label).
interface Props {
  label: string;
  ratio?: string;
  compact?: boolean;
}
const { label, ratio = '16 / 9', compact = false } = Astro.props;
---

<div class:list={['omp', { 'omp--compact': compact }]} style={`aspect-ratio: ${ratio};`}>
  <svg class="omp-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="3" y="5" width="18" height="14" rx="2"/>
    <polygon points="10 9 15 12 10 15"/>
  </svg>
  <span class="omp-label">{label}</span>
</div>

<style>
  .omp {
    position: relative;
    width: 100%;
    max-height: 520px;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.06);
    border-radius: 2px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 20px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .omp-icon {
    color: rgba(237, 233, 227, 0.25);
    flex-shrink: 0;
  }
  .omp-label {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    line-height: 1.5;
    text-align: center;
    max-width: 40ch;
    text-wrap: balance;
  }
  .omp--compact { gap: 6px; padding: 12px; }
  .omp--compact .omp-icon { width: 16px; height: 16px; }
  .omp--compact .omp-label { font-size: 11px; }
</style>
