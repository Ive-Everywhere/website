---
// LogoBar — customer logo strip per ona ref (frame-01): a tiny centered label
// above one single centered row of evenly-spaced muted wordmarks (no boxes,
// no borders). Unverified entries render as muted placeholder wordmarks —
// never invented facts. Props: label, logos ({ name?, tenure? }[]).
// (tenure is accepted for compatibility but not displayed; ona shows none.)
interface Logo {
  name?: string;
  tenure?: string;
}
interface Props {
  label: string;
  logos?: Logo[];
}
const { label, logos = [{}, {}, {}, {}, {}, {}] } = Astro.props;
---

<section class="olb">
  <div class="olb-container reveal">
    <p class="olb-label">{label}</p>
    <div class="olb-row">
      {logos.map((logo) => (
        <span class:list={['olb-mark', { 'olb-mark--placeholder': !logo.name }]}>
          {logo.name ?? 'Customer logo'}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .olb {
    background: #13100a;
    padding: 96px 0 0;
  }
  .olb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }
  .olb-label {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    letter-spacing: 0.01em;
    margin: 0;
    text-align: center;
  }
  .olb-row {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 20px 64px;
  }
  @media (min-width: 900px) {
    .olb-row { justify-content: space-between; flex-wrap: nowrap; }
  }
  .olb-mark {
    font-family: 'Söhne', sans-serif;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgba(237, 233, 227, 0.35);
    line-height: 1;
    white-space: nowrap;
  }
  .olb-mark--placeholder {
    font-weight: 400;
    font-size: 14px;
    color: rgba(237, 233, 227, 0.25);
    border: 1px dashed rgba(237, 233, 227, 0.1);
    border-radius: 2px;
    padding: 10px 18px;
  }

  @media (max-width: 640px) {
    .olb { padding: 64px 0 0; }
    .olb-row { gap: 16px 32px; }
  }
</style>
