---
// MegaFooter — 5-column footer per home.md §12 + Ask-AI row + legal + socials.
// Column/link content is fixed IA (not page content), so it lives here.
// Missing targets → '#' with data-todo attr.
interface FooterLink {
  text: string;
  href: string;
  todo?: boolean;
  external?: boolean;
}
interface Column {
  title: string;
  links: FooterLink[];
}

const columns: Column[] = [
  {
    title: 'Platform',
    links: [
      { text: 'Agents', href: '/agents' },
      { text: 'Workspace', href: '/workspace' },
      { text: 'Connections', href: '/connections' },
      { text: 'Security', href: '/security' },
      { text: 'Pricing', href: '/pricing' },
    ],
  },
  {
    title: 'Colleagues',
    links: [
      { text: 'Sales', href: '#', todo: true },
      { text: 'Finance', href: '#', todo: true },
      { text: 'Legal', href: '#', todo: true },
      { text: 'Chief of Staff', href: '#', todo: true },
      { text: 'Build your own', href: '#', todo: true },
    ],
  },
  {
    title: 'Compare',
    links: [
      { text: 'vs ChatGPT', href: '#', todo: true },
      { text: 'vs Claude', href: '#', todo: true },
      { text: 'vs Copilot', href: '#', todo: true },
      { text: 'vs Zapier', href: '#', todo: true },
      { text: 'vs Building in-house', href: '#', todo: true },
    ],
  },
  {
    title: 'Resources',
    links: [
      { text: 'Blog', href: '/research' },
      { text: 'Guides', href: '#', todo: true },
      { text: 'Docs', href: '#', todo: true },
      { text: 'Cookbook', href: '/cookbook' },
      { text: 'Changelog', href: '#', todo: true },
    ],
  },
  {
    title: 'Company',
    links: [
      { text: 'About', href: '#', todo: true },
      { text: 'Careers', href: '#', todo: true },
      { text: 'Contact', href: 'https://cal.com/krishna-kaipa-wh7ao3/15min', external: true },
      { text: 'Book a demo', href: 'https://cal.com/krishna-kaipa-wh7ao3/15min', external: true },
    ],
  },
];

const askAi = [
  { text: 'ChatGPT', href: '#', todo: true },
  { text: 'Claude', href: '#', todo: true },
  { text: 'Gemini', href: '#', todo: true },
  { text: 'Perplexity', href: '#', todo: true },
];

const legal = [
  { text: 'Status', href: '#', todo: true },
  { text: 'Security', href: '/legal/security' },
  { text: 'Privacy', href: '/privacy' },
  { text: 'Terms', href: '/terms' },
];
---

<footer class="omf">
  <div class="omf-container">

    <!-- ── Columns ── -->
    <div class="omf-cols">
      <div class="omf-brand-col">
        <a href="/" class="omf-brand">
          <img src="/images/logo.svg" alt="Eluu" class="omf-logo" />
          <span class="omf-wordmark">Eluu AI</span>
        </a>
      </div>
      {columns.map((col) => (
        <div class="omf-col">
          <h4 class="omf-col-title">{col.title}</h4>
          <ul class="omf-col-links">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="omf-link"
                  data-todo={link.todo ? '' : undefined}
                  target={link.external ? '_blank' : undefined}
                  rel={link.external ? 'noopener noreferrer' : undefined}
                >{link.text}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- ── Ask AI row ── -->
    <div class="omf-askai">
      <span class="omf-askai-label">Ask AI about Eluu</span>
      <div class="omf-askai-links">
        {askAi.map((item) => (
          <a href={item.href} class="omf-askai-link" data-todo={item.todo ? '' : undefined}>
            {item.text}
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
          </a>
        ))}
      </div>
    </div>

    <!-- ── Bottom bar ── -->
    <div class="omf-bottom">
      <div class="omf-bottom-left">
        <span class="omf-copy">&copy; {new Date().getFullYear()} Eluu</span>
        {legal.map((link) => (
          <a href={link.href} class="omf-bottom-link" data-todo={link.todo ? '' : undefined}>{link.text}</a>
        ))}
      </div>
      <div class="omf-bottom-right">
        <a href="https://www.linkedin.com/company/eluu/" aria-label="LinkedIn" class="omf-social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a href="https://x.com/EluuAI" aria-label="X" class="omf-social">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a href="#" aria-label="GitHub" class="omf-social" data-todo>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
        </a>
        <a href="#" aria-label="YouTube" class="omf-social" data-todo>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
      </div>
    </div>

  </div>
</footer>

<style>
  /* ── Ona footer geometry: one big rounded card inset from page edges ── */
  .omf {
    background: #13100a;
    margin-top: 40px;
    padding: 0 20px 20px;
  }
  .omf-container {
    max-width: 1340px;
    margin: 0 auto;
    padding: 56px 48px 32px;
    box-sizing: border-box;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.06);
    border-radius: 4px;
  }

  /* ── Columns ── */
  .omf-cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px 24px;
  }
  @media (min-width: 640px) {
    .omf-cols { grid-template-columns: repeat(3, 1fr); }
  }
  @media (min-width: 1024px) {
    .omf-cols { grid-template-columns: 1.2fr repeat(5, 1fr); }
  }

  .omf-brand-col { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .omf-brand-col { grid-column: auto; }
  }
  .omf-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
  }
  .omf-logo { width: 26px; height: 26px; }
  .omf-wordmark {
    font-family: 'Jersey 10', cursive;
    font-size: 28px;
    color: #ede9e3;
    line-height: 1;
    letter-spacing: -0.3px;
  }

  .omf-col-title {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: #ede9e3;
    letter-spacing: 0.01em;
    margin: 0 0 14px;
  }
  .omf-col-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .omf-link {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    text-decoration: none;
    transition: color 0.18s ease-out;
  }
  .omf-link:hover { color: #ede9e3; }

  /* ── Ask AI row ── */
  .omf-askai {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 56px;
    padding: 18px 20px;
    background: rgba(237, 233, 227, 0.03);
    border: 1px solid rgba(237, 233, 227, 0.06);
    border-radius: 2px;
  }
  .omf-askai-label {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 600;
    color: rgba(237, 233, 227, 0.7);
  }
  .omf-askai-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .omf-askai-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    text-decoration: none;
    border: 1px solid rgba(237, 233, 227, 0.1);
    border-radius: 4px;
    padding: 6px 14px;
    line-height: 1;
    transition: color 0.18s ease-out, border-color 0.18s ease-out;
  }
  .omf-askai-link:hover { color: #ede9e3; border-color: rgba(237, 233, 227, 0.25); }
  .omf-askai-link svg { opacity: 0.5; transition: opacity 0.18s ease-out; }
  .omf-askai-link:hover svg { opacity: 1; }

  /* ── Bottom bar ── */
  .omf-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(237, 233, 227, 0.06);
  }
  .omf-bottom-left {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }
  .omf-copy {
    font-family: 'Söhne', sans-serif;
    font-size: 12px;
    color: rgba(237, 233, 227, 0.4);
  }
  .omf-bottom-link {
    font-family: 'Söhne', sans-serif;
    font-size: 12px;
    color: rgba(237, 233, 227, 0.4);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .omf-bottom-link:hover { color: #ede9e3; }

  .omf-bottom-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .omf-social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    color: rgba(237, 233, 227, 0.4);
    border: 1px solid rgba(237, 233, 227, 0.06);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .omf-social:hover { color: #ede9e3; border-color: rgba(237, 233, 227, 0.2); }

  @media (max-width: 639px) {
    .omf { padding: 0 12px 12px; }
    .omf-container { padding: 40px 20px 24px; }
    .omf-askai { margin-top: 40px; }
  }
</style>
