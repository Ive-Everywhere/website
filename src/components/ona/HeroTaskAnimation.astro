---
// HeroTaskAnimation — GSAP-driven hero visual.
// A constant, uniform grid of squares fills the stage. A Slack task box slides
// in over the grid's center rows (only the covered footprint clears), timeline
// items stream in while random squares flicker like parallel computation, then
// a mint radial wave marks completion and everything resets. One master
// gsap.timeline({ repeat: -1 }) plus a delayedCall-based flicker scheduler.
// Starts/pauses via IntersectionObserver; prefers-reduced-motion gets a static
// completed frame straight from CSS (no JS motion at all).
const D_COLS = 14;
const D_ROWS = 9;
const M_COLS = 8;
const M_ROWS = 6;
const desktopCells = Array.from({ length: D_COLS * D_ROWS }, (_, i) => i);
const mobileCells = Array.from({ length: M_COLS * M_ROWS }, (_, i) => i);
---

<div class="hta" aria-hidden="true">
  {/* Desktop grid: 14 x 9. Footprint (cleared under box): cols 1-12, rows 3-6 (0-indexed). */}
  <div
    class="hta-cells hta-cells--d"
    data-cols={D_COLS}
    data-rows={D_ROWS}
    data-fp="1,12,3,6"
  >
    {desktopCells.map(() => <span class="sq"></span>)}
  </div>

  {/* Mobile grid: 8 x 6. Footprint: cols 0-7, rows 1-4 (0-indexed). */}
  <div
    class="hta-cells hta-cells--m"
    data-cols={M_COLS}
    data-rows={M_ROWS}
    data-fp="0,7,1,4"
  >
    {mobileCells.map(() => <span class="sq"></span>)}
  </div>

  <div class="hta-box">
    <div class="hta-head">
      <span class="hta-ico-slack">
        <svg viewBox="0 0 127 127" width="22" height="22" fill="none">
          <path d="M27.2 80c0 7.3-5.9 13.2-13.2 13.2C6.7 93.2.8 87.3.8 80c0-7.3 5.9-13.2 13.2-13.2h13.2V80zm6.6 0c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v33c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V80z" fill="#E01E5A"/>
          <path d="M47 27.2c-7.3 0-13.2-5.9-13.2-13.2C33.8 6.7 39.7.8 47 .8c7.3 0 13.2 5.9 13.2 13.2v13.2H47zm0 6.6c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H13.9C6.6 60.2.7 54.3.7 47c0-7.3 5.9-13.2 13.2-13.2H47z" fill="#36C5F0"/>
          <path d="M99.8 47c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H99.8V47zm-6.6 0c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V13.9C66.8 6.6 72.7.7 80 .7c7.3 0 13.2 5.9 13.2 13.2V47z" fill="#2EB67D"/>
          <path d="M80 99.8c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V99.8H80zm0-6.6c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2h33.1c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H80z" fill="#ECB22E"/>
        </svg>
      </span>
      <span class="hta-title">Review the Acme Inc. MSA and draft a negotiation brief</span>
      <span class="hta-check">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#63cf9e" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
          <path class="hta-check-path" pathLength="1" d="M4.5 12.5l5 5 10-11" />
        </svg>
      </span>
    </div>
    <ul class="hta-items">
      <li class="hta-item">
        <span class="hta-item-text">Starting secure cloud sandbox</span>
        <svg class="hta-mono" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(237,233,227,0.7)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2.5" y="4" width="19" height="13" rx="1.5" />
          <path d="M6.5 8.5l2.5 2-2.5 2M12 12.5h4M8.5 20.5h7" />
        </svg>
      </li>
      <li class="hta-item">
        <span class="hta-item-text">Fetching documents from Gmail</span>
        <svg viewBox="0 0 48 36" width="16" height="12">
          <path fill="#4285F4" d="M3.27 36h6.55V20.09L0 12.73v20A3.27 3.27 0 0 0 3.27 36z"/>
          <path fill="#34A853" d="M38.18 36h6.55A3.27 3.27 0 0 0 48 32.73v-20l-9.82 7.36z"/>
          <path fill="#FBBC04" d="M38.18 6.55v13.54L48 12.73V8.18c0-4.05-4.62-6.36-7.85-3.93z"/>
          <path fill="#EA4335" d="M9.82 20.09V6.55L24 17.18 38.18 6.55v13.54L24 30.73z"/>
          <path fill="#C5221F" d="M0 8.18v4.55l9.82 7.36V6.55L7.85 4.25C4.62 1.82 0 4.13 0 8.18z"/>
        </svg>
      </li>
      <li class="hta-item">
        <span class="hta-item-text">Using the MSA skill</span>
        <svg class="hta-mono" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(237,233,227,0.7)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a4.5 4.5 0 0 0-6 5.6L3 17.6a2 2 0 0 0 2.8 2.8l5.7-5.7a4.5 4.5 0 0 0 5.6-6l-3 3-2.8-.7-.7-2.8 3.1-3z" />
        </svg>
      </li>
      <li class="hta-item">
        <span class="hta-item-text">Created redline and negotiation brief</span>
        <svg class="hta-mono" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="rgba(237,233,227,0.7)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M13.5 2.5H6.5a1.5 1.5 0 0 0-1.5 1.5v16a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5V8l-5.5-5.5z" />
          <path d="M13.5 2.5V8H19M9 12.5h6M9 16h6" />
        </svg>
      </li>
      <li class="hta-item">
        <span class="hta-item-text">Created a draft and notified user</span>
        <svg viewBox="0 0 127 127" width="14" height="14" fill="none">
          <path d="M27.2 80c0 7.3-5.9 13.2-13.2 13.2C6.7 93.2.8 87.3.8 80c0-7.3 5.9-13.2 13.2-13.2h13.2V80zm6.6 0c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v33c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V80z" fill="#E01E5A"/>
          <path d="M47 27.2c-7.3 0-13.2-5.9-13.2-13.2C33.8 6.7 39.7.8 47 .8c7.3 0 13.2 5.9 13.2 13.2v13.2H47zm0 6.6c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H13.9C6.6 60.2.7 54.3.7 47c0-7.3 5.9-13.2 13.2-13.2H47z" fill="#36C5F0"/>
          <path d="M99.8 47c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H99.8V47zm-6.6 0c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V13.9C66.8 6.6 72.7.7 80 .7c7.3 0 13.2 5.9 13.2 13.2V47z" fill="#2EB67D"/>
          <path d="M80 99.8c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V99.8H80zm0-6.6c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2h33.1c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H80z" fill="#ECB22E"/>
        </svg>
      </li>
    </ul>
  </div>
</div>

<style>
  .hta {
    position: relative;
    width: 100%;
    max-width: 1100px;
    height: 540px;
    margin: 0 auto;
    background: #13100a;
    overflow: hidden;
  }

  /* --- The constant grid --- */
  .hta-cells {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .hta-cells--d {
    grid-template-columns: repeat(14, 1fr);
    grid-template-rows: repeat(9, 1fr);
  }
  .hta-cells--m {
    display: none;
    grid-template-columns: repeat(8, 1fr);
    grid-template-rows: repeat(6, 1fr);
  }
  .sq {
    width: 12px;
    height: 12px;
    border-radius: 0;
    background: rgba(237, 233, 227, 0.28);
  }

  /* --- Task box: fixed footprint over grid rows 4-7, cols 2-13 --- */
  .hta-box {
    position: absolute;
    left: calc(100% / 14);
    top: calc(100% * 3 / 9);
    width: calc(100% * 12 / 14);
    height: calc(100% * 4 / 9);
    z-index: 2;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden; /* clips items while the box collapses to its header row */
    background: #13100a;
    border: 1px solid rgba(237, 233, 227, 0.28);
    border-radius: 2px;
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.65);
    /* Hidden until GSAP takes over; reduced-motion CSS reveals it below. */
    opacity: 0;
  }

  .hta-head {
    display: flex;
    align-items: center;
    gap: 13px;
    flex: none;
    padding: 16px 22px 8px;
  }
  .hta-ico-slack {
    display: inline-flex;
    flex: none;
  }
  .hta-title {
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: 19px;
    color: #ede9e3;
    letter-spacing: -0.01em;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hta-check {
    display: inline-flex;
    flex: none;
    opacity: 0;
  }
  .hta-check-path {
    stroke-dasharray: 1;
  }

  /* --- Timeline items: full height reserved from the start --- */
  .hta-items {
    list-style: none;
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 4px 22px 12px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-evenly;
  }
  .hta-item {
    position: relative;
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 3px 0 3px 16px;
    font-family: 'Söhne', sans-serif;
    font-weight: 400;
    font-size: 15px;
    color: rgba(237, 233, 227, 0.8);
    opacity: 0; /* revealed by GSAP / reduced-motion CSS */
  }
  /* 1px left connector rail */
  .hta-item::before {
    content: '';
    position: absolute;
    left: 4px;
    top: -4px;
    bottom: -4px;
    width: 1px;
    background: rgba(237, 233, 227, 0.16);
  }
  .hta-item:first-child::before {
    top: 2px;
  }
  .hta-item:last-child::before {
    bottom: 2px;
  }
  .hta-item svg {
    flex: none;
  }
  .hta-item-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* --- Mobile: 8 x 6 grid, wider box --- */
  @media (max-width: 639px) {
    .hta {
      height: 440px;
    }
    .hta-cells--d {
      display: none;
    }
    .hta-cells--m {
      display: grid;
    }
    .hta-box {
      left: 0;
      top: calc(100% * 1 / 6);
      width: 100%;
      height: calc(100% * 4 / 6);
    }
    .hta-head {
      gap: 10px;
      padding: 14px 16px 6px;
    }
    .hta-title {
      font-size: 15px;
    }
    .hta-items {
      padding: 2px 16px 10px 16px;
    }
    .hta-item {
      font-size: 13px;
    }
  }

  /* --- Reduced motion: static completed frame, zero JS motion --- */
  @media (prefers-reduced-motion: reduce) {
    .sq {
      background: rgba(99, 207, 158, 0.38);
    }
    /* Static completed frame = the collapsed header-row box with its check. */
    .hta-box {
      opacity: 1;
      height: auto;
    }
    .hta-head {
      padding-bottom: 16px;
    }
    .hta-item {
      opacity: 0;
    }
    .hta-items {
      display: none;
    }
    .hta-check {
      opacity: 1;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const SQ_DEFAULT = 'rgba(237,233,227,0.28)';
  const CREAM = 'rgba(237,233,227,0.9)';
  const ACCENTS = ['#63cf9e', '#ee9de0', '#6db7f0', '#ED733B'];
  const MINT_WAVE = 'rgba(99,207,158,0.85)';
  const MOBILE_MQ = '(max-width: 639px)';

  function initHeroTaskAnimation(root: HTMLElement) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      return; // static completed frame comes straight from CSS
    }

    const box = root.querySelector<HTMLElement>('.hta-box')!;
    const check = root.querySelector<HTMLElement>('.hta-check')!;
    const checkPath = root.querySelector<SVGPathElement>('.hta-check-path')!;
    const items = Array.from(root.querySelectorAll<HTMLElement>('.hta-item'));
    const mql = window.matchMedia(MOBILE_MQ);

    let cleanup: (() => void) | null = null;

    function build() {
      const grid = root.querySelector<HTMLElement>(
        mql.matches ? '.hta-cells--m' : '.hta-cells--d'
      )!;
      const cols = Number(grid.dataset.cols);
      const rows = Number(grid.dataset.rows);
      const [c0, c1, r0, r1] = grid.dataset.fp!.split(',').map(Number);
      const cells = Array.from(grid.children) as HTMLElement[]; // row-major

      const footprint: HTMLElement[] = [];
      const fpBody: HTMLElement[] = []; // footprint rows below the header row — return early when the box collapses
      const outside: HTMLElement[] = [];
      const flickerPool: HTMLElement[] = []; // outside cells; edge ring weighted 2x
      cells.forEach((el, i) => {
        const row = Math.floor(i / cols);
        const col = i % cols;
        const inFp = col >= c0 && col <= c1 && row >= r0 && row <= r1;
        if (inFp) {
          footprint.push(el);
          if (row > r0) fpBody.push(el);
        } else {
          outside.push(el);
          flickerPool.push(el);
          // Activity radiates: cells touching the box footprint flash more often.
          const nearCol = (col === c0 - 1 || col === c1 + 1) && row >= r0 - 1 && row <= r1 + 1;
          const nearRow = (row === r0 - 1 || row === r1 + 1) && col >= c0 - 1 && col <= c1 + 1;
          if (nearCol || nearRow) flickerPool.push(el);
        }
      });

      // ---------------- Flicker scheduler ----------------
      // gsap.delayedCall pump: while (window && visible), fire 1-2 flashes every
      // ~55-125ms. Each flash: hard-set a color, tween back to default in
      // 120-200ms -> 3-5 concurrent flashes at any moment. No setTimeout.
      const flicker = { window: false, visible: false, call: null as gsap.core.Tween | null };

      const flash = () => {
        const el = flickerPool[(Math.random() * flickerPool.length) | 0];
        const color =
          Math.random() < 0.6 ? CREAM : ACCENTS[(Math.random() * ACCENTS.length) | 0];
        gsap.fromTo(
          el,
          { backgroundColor: color },
          {
            backgroundColor: SQ_DEFAULT,
            duration: 0.12 + Math.random() * 0.08,
            ease: 'power2.in',
            overwrite: true,
          }
        );
      };

      const pump = () => {
        flicker.call = null;
        if (!flicker.window || !flicker.visible) return;
        flash();
        if (Math.random() < 0.7) flash();
        flicker.call = gsap.delayedCall(0.05 + Math.random() * 0.06, pump);
      };

      const pumpIfIdle = () => {
        if (flicker.window && flicker.visible && !flicker.call) pump();
      };
      const haltPump = () => {
        flicker.call?.kill();
        flicker.call = null;
      };
      const openWindow = () => {
        flicker.window = true;
        pumpIfIdle();
      };
      const closeWindow = () => {
        flicker.window = false;
        haltPump();
        outside.forEach((el) => gsap.killTweensOf(el, 'backgroundColor'));
      };

      // ---------------- Master timeline ----------------
      const waveStagger = () => ({
        grid: [rows, cols] as [number, number],
        from: 'center' as const,
        amount: 0.6,
      });

      const tl = gsap.timeline({
        repeat: -1,
        paused: true,
        // Re-record start values every loop so tweens pick up whatever color a
        // killed flash left behind instead of snapping.
        onRepeat: () => tl.invalidate(),
      });

      // ENTER — box slides in from the right; only the covered footprint clears.
      tl.addLabel('enter', 0)
        .to(
          footprint,
          {
            opacity: 0,
            scale: 0.6,
            duration: 0.45,
            ease: 'power2.out',
            stagger: { amount: 0.15, from: 'random' },
          },
          'enter'
        )
        .fromTo(
          box,
          { x: 120, autoAlpha: 0 },
          { x: 0, autoAlpha: 1, duration: 0.7, ease: 'power3.out' },
          'enter'
        )
        .call(openWindow, undefined, 'enter+=0.7');

      // PROCESS — 5 items stream in on a 0.55s cadence while the grid flickers.
      items.forEach((item, i) => {
        tl.fromTo(
          item,
          { autoAlpha: 0, y: 8, filter: 'blur(3px)' },
          { autoAlpha: 1, y: 0, filter: 'blur(0px)', duration: 0.45, ease: 'power2.out' },
          0.95 + i * 0.55
        );
      });

      // COMPLETE — flicker stops, items fold away, the box COLLAPSES back to its
      // header row (mockup frame 3), freed rows return, check draws in, then the
      // mint wave radiates from center.
      const head = box.querySelector<HTMLElement>('.hta-head')!;
      tl.addLabel('complete', 3.95)
        .call(closeWindow, undefined, 'complete')
        .to(
          items,
          { autoAlpha: 0, y: -6, duration: 0.26, ease: 'power2.in', stagger: 0.03 },
          'complete'
        )
        .to(
          box,
          {
            height: () => head.offsetHeight + 10,
            duration: 0.5,
            ease: 'power3.inOut',
          },
          'complete+=0.14'
        )
        .to(
          fpBody,
          {
            opacity: 1,
            scale: 1,
            duration: 0.35,
            ease: 'power2.out',
            stagger: { amount: 0.14 },
          },
          'complete+=0.3'
        )
        .fromTo(
          check,
          { autoAlpha: 0, scale: 0.5 },
          { autoAlpha: 1, scale: 1, duration: 0.35, ease: 'back.out(2.2)' },
          'complete+=0.5'
        )
        .fromTo(
          checkPath,
          { strokeDashoffset: 1 },
          { strokeDashoffset: 0, duration: 0.4, ease: 'power2.out' },
          'complete+=0.5'
        )
        .to(
          cells,
          { backgroundColor: MINT_WAVE, duration: 0.25, ease: 'power1.out', stagger: waveStagger() },
          'complete+=0.75'
        )
        .to(
          cells,
          {
            keyframes: [
              { scale: 1.15, duration: 0.11, ease: 'power2.out' },
              { scale: 1, duration: 0.14, ease: 'power2.in' },
            ],
            stagger: waveStagger(),
          },
          'complete+=0.75'
        );

      // HOLD, then EXIT — the collapsed box drifts left as it fades (gentle,
      // no power3.in teleport), its header row returns, grid crossfades to grey.
      tl.addLabel('exit', 'complete+=3.0')
        .to(box, { x: -56, autoAlpha: 0, duration: 0.65, ease: 'power2.inOut' }, 'exit')
        .to(
          footprint,
          { opacity: 1, scale: 1, duration: 0.5, ease: 'power2.out', stagger: { amount: 0.1 } },
          'exit+=0.35'
        )
        .to(
          cells,
          { backgroundColor: SQ_DEFAULT, scale: 1, duration: 0.7, ease: 'power1.inOut' },
          'exit+=0.35'
        )
        // Reset the collapsed height while invisible so the next loop starts full-size.
        .set(box, { clearProps: 'height' })
        // REST before the loop repeats.
        .to({}, { duration: 0.9 });

      // ---------------- Visibility ----------------
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              flicker.visible = true;
              tl.play();
              pumpIfIdle();
            } else {
              flicker.visible = false;
              haltPump();
              tl.pause();
            }
          });
        },
        { threshold: 0.25 }
      );
      io.observe(root);

      cleanup = () => {
        io.disconnect();
        haltPump();
        tl.kill();
        gsap.killTweensOf([...cells, box, check, checkPath, ...items]);
        gsap.set([...cells, box, check, checkPath, ...items], { clearProps: 'all' });
        cleanup = null;
      };
    }

    build();
    mql.addEventListener('change', () => {
      cleanup?.();
      build();
    });
  }

  document.querySelectorAll<HTMLElement>('.hta').forEach(initHeroTaskAnimation);
</script>
