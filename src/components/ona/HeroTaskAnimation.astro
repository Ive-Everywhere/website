---
// HeroTaskAnimation — mechanical port of projects/hero-lab/hero.html (approved).
// Agent grid (11x7 squares) + 6 surface cards conveyor (Slack, Web, Email,
// Support, Product, API). Each card slides in from the right, plays its user-POV
// micro-story (message sent -> agent works -> response -> GREEN), then slides
// out left as the next surface arrives. Fresh GSAP timeline per full cycle.
// Site adaptations only: IntersectionObserver start/pause, prefers-reduced-
// motion static frame, responsive sizing. No visual/timing changes.
// Grid squares are rendered here (not in JS) so Astro's scoped styles apply.
const CELLS = Array.from({ length: 11 * 7 });
---

<div class="hta-root" aria-hidden="true">
  <div class="hta-stage">
    <div class="hta-cellgrid">
      {CELLS.map(() => <span class="sq"></span>)}
    </div>

    <!-- EMAIL (Gmail-faithful) -->
    <div class="card gmail c-email">
      <div class="gm-subject">
        <h2>Re: Q3 renewal pricing</h2>
        <span class="gm-label">Inbox</span>
      </div>
      <div class="gm-msg h0" data-a="em-in">
        <div class="gm-head">
          <div class="gm-avatar dana">D</div>
          <div class="gm-who">
            <div class="gm-line1">
              <span class="gm-name">Dana Cole</span>
              <span class="gm-addr">&lt;dana@nortavo.com&gt;</span>
              <span class="gm-time">8:41 AM</span>
            </div>
            <div class="gm-to">to me <span class="caret">▾</span></div>
          </div>
        </div>
        <div class="gm-body">Can you send the updated order form and confirm the start date?</div>
      </div>
      <hr class="gm-sep" />
      <div class="swap">
      <div class="gm-draft h0" data-a="em-draft"><span class="tdots"><i></i><i></i><i></i></span><span class="drafting">drafting reply</span></div>
      <div class="gm-msg h0" data-a="em-reply">
        <div class="gm-head">
          <div class="gm-avatar eluu"><svg width="14" height="14" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.4" height="10" rx="1" fill="#fff"/><rect x="13.2" y="7" width="3.4" height="6.5" rx="1" fill="#fff"/></svg></div>
          <div class="gm-who">
            <div class="gm-line1">
              <span class="gm-name">Eluu</span>
              <span class="gm-addr">&lt;agent@acme.com&gt;</span>
              <span class="gm-time">8:42 AM</span>
            </div>
            <div class="gm-to">to Dana <span class="caret">▾</span></div>
          </div>
        </div>
        <div class="gm-body">Order form sent. Start date confirmed for Oct 1. Auto-renewal clause flagged for your review.</div>
        <div class="gm-attach h0" data-a="em-attach">
          <div class="ficon">PDF</div>
          <div>
            <div class="fname">order-form-v3.pdf</div>
            <div class="fsize">98 KB</div>
          </div>
        </div>
      </div>
      </div>
      <div class="gm-actions h0" data-a="em-actions" style="padding-bottom:16px">
        <span class="gm-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14l-5-5 5-5"/><path d="M4 9h10a6 6 0 0 1 6 6v3"/></svg>Reply</span>
        <span class="gm-btn"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 14l5-5-5-5"/><path d="M20 9H10a6 6 0 0 0-6 6v3"/></svg>Forward</span>
      </div>
    </div>

    <!-- SLACK (faithful) -->
    <div class="card slackx c-slack">
      <div class="sx-head">
        <span class="sx-chan"><span class="hash">#</span>legal</span>
        <svg class="sx-star" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M12 3l2.7 5.8 6.3.8-4.6 4.3 1.2 6.2L12 17l-5.6 3.1 1.2-6.2L3 9.6l6.3-.8z"/></svg>
        <span class="sx-members">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3.2"/><path d="M3.5 20c0-3 2.5-5 5.5-5s5.5 2 5.5 5"/><circle cx="17" cy="8" r="2.6"/><path d="M16 15.2c2.6.3 4.5 2 4.5 4.8"/></svg>
          12
        </span>
        <svg viewBox="0 0 127 127" width="15" height="15" fill="none" style="margin-left:10px">
          <path d="M27.2 80c0 7.3-5.9 13.2-13.2 13.2C6.7 93.2.8 87.3.8 80c0-7.3 5.9-13.2 13.2-13.2h13.2V80zm6.6 0c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2v33c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V80z" fill="#E01E5A"/>
          <path d="M47 27.2c-7.3 0-13.2-5.9-13.2-13.2C33.8 6.7 39.7.8 47 .8c7.3 0 13.2 5.9 13.2 13.2v13.2H47zm0 6.6c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H13.9C6.6 60.2.7 54.3.7 47c0-7.3 5.9-13.2 13.2-13.2H47z" fill="#36C5F0"/>
          <path d="M99.8 47c0-7.3 5.9-13.2 13.2-13.2 7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H99.8V47zm-6.6 0c0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V13.9C66.8 6.6 72.7.7 80 .7c7.3 0 13.2 5.9 13.2 13.2V47z" fill="#2EB67D"/>
          <path d="M80 99.8c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2-7.3 0-13.2-5.9-13.2-13.2V99.8H80zm0-6.6c-7.3 0-13.2-5.9-13.2-13.2 0-7.3 5.9-13.2 13.2-13.2h33.1c7.3 0 13.2 5.9 13.2 13.2 0 7.3-5.9 13.2-13.2 13.2H80z" fill="#ECB22E"/>
        </svg>
      </div>
      <div class="sx-body">
        <div class="sx-msg h0" data-a="sl-user">
          <div class="sx-avatar maya">MK</div>
          <div>
            <div class="sx-line1"><span class="sx-name">Maya Kim</span><span class="sx-time">9:02 AM</span></div>
            <div class="sx-text"><span class="mention">@Eluu</span> review the Acme MSA and draft a negotiation brief before the 2pm call</div>
          </div>
        </div>
        <div class="swap">
        <div class="sx-msg h0" data-a="sl-typing">
          <div class="sx-avatar eluu"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.4" height="10" rx="1" fill="#fff"/><rect x="13.2" y="7" width="3.4" height="6.5" rx="1" fill="#fff"/></svg></div>
          <span class="tdots" style="margin-top:8px"><i></i><i></i><i></i></span>
        </div>
        <div class="sx-msg h0" data-a="sl-bot">
          <div class="sx-avatar eluu"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.4" height="10" rx="1" fill="#fff"/><rect x="13.2" y="7" width="3.4" height="6.5" rx="1" fill="#fff"/></svg></div>
          <div>
            <div class="sx-line1"><span class="sx-name">Eluu</span><span class="sx-app">APP</span><span class="sx-time">9:05 AM</span></div>
            <div class="sx-text">Done. Redlined 6 clauses and drafted the brief. Liability cap and IP assignment need your call.</div>
            <div class="sx-file h0" data-a="sl-attach">
              <div class="ficon"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 2.5H6.5a1.5 1.5 0 0 0-1.5 1.5v16a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5V8l-5.5-5.5z"/><path d="M13.5 2.5V8H19M9 12.5h6M9 16h6"/></svg></div>
              <div>
                <div class="fname">acme-msa-redline-and-brief.docx</div>
                <div class="fmeta">Word document · 14 pages</div>
              </div>
            </div>
            <span class="sx-react h0" data-a="sl-react">✅ 2</span>
          </div>
        </div>
        </div>
      </div>
      <div class="sx-input">
        Message #legal
        <div class="sx-send"><svg width="12" height="12" viewBox="0 0 24 24" fill="#fff"><path d="M3 11l18-8-8 18-2-8z"/></svg></div>
      </div>
    </div>

    <!-- SUPPORT (widget) -->
    <div class="card chatw c-support">
      <div class="cw-head">
        <div class="cw-head-row">
          <div class="cw-avatar"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.4" height="10" rx="1" fill="#fff"/><rect x="13.2" y="7" width="3.4" height="6.5" rx="1" fill="#fff"/></svg></div>
          <div>
            <div class="cw-name">Support</div>
            <div class="cw-sub">Eluu agent · Active now</div>
          </div>
        </div>
      </div>
      <div class="cw-body">
        <div class="cw-row visitor h0" data-a="cw-visitor">
          <div class="cw-bubble visitor">Where's the refund for order #10432? It's been 9 days.</div>
        </div>
        <div class="swap">
        <div class="cw-row h0" data-a="cw-typing">
          <div class="cw-mini"><svg width="10" height="10" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.4" height="10" rx="1" fill="#fff"/><rect x="13.2" y="7" width="3.4" height="6.5" rx="1" fill="#fff"/></svg></div>
          <div class="cw-bubble agent"><span class="tdots"><i></i><i></i><i></i></span></div>
        </div>
        <div class="cw-row h0" data-a="cw-agent">
          <div class="cw-mini"><svg width="10" height="10" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.4" height="10" rx="1" fill="#fff"/><rect x="13.2" y="7" width="3.4" height="6.5" rx="1" fill="#fff"/></svg></div>
          <div class="cw-bubble agent">Checked Stripe. Your refund cleared this morning. Receipt attached.</div>
        </div>
        </div>
        <div class="cw-attach h0" data-a="cw-attach">
          <div class="ficon">PDF</div>
          <div>
            <div class="fname">refund-receipt.pdf</div>
            <div class="fsize">RF-2291 · 42 KB</div>
          </div>
        </div>
      </div>
      <div class="cw-input">
        Write a message…
        <div class="cw-icons">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8.5 14.5c1 1.2 2.1 1.8 3.5 1.8s2.5-.6 3.5-1.8M9.3 9.8h.01M14.7 9.8h.01"/></svg>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.5l-8.5 8.5a5.66 5.66 0 0 1-8-8L13 4.5a3.77 3.77 0 0 1 5.3 5.3L9.8 18.3a1.89 1.89 0 0 1-2.7-2.7L15 7.8"/></svg>
        </div>
      </div>
      <div class="cw-power">Powered by <b>Eluu</b></div>
    </div>

    <!-- PRODUCT -->
    <div class="card product c-product">
      <div class="chrome">
        <div class="dot"></div><div class="dot"></div><div class="dot"></div>
        <div class="path">acme-finance / invoices</div>
      </div>
      <div class="pr-toolbar">
        <div class="pr-h">Q2 invoices <span>214 records</span></div>
        <div class="pr-btn" data-a="pr-btn">Reconcile with agent</div>
      </div>
      <svg class="pr-cursor" data-a="pr-cursor" width="19" height="19" viewBox="0 0 24 24"><path d="M5 3l14 8-6.6 1.5L9.5 19z" fill="#ede9e3" stroke="#13100a" stroke-width="1.4"/></svg>
      <div class="pr-table">
        <div class="pr-tr head">
          <div class="eyebrow">Invoice</div><div class="eyebrow">Vendor</div>
          <div class="eyebrow" style="text-align:right">Amount</div><div class="eyebrow" style="justify-self:end">Status</div>
        </div>
        <div class="pr-tr"><div class="pr-id mono">INV-2201</div><div>Northwind Supply</div><div class="pr-amt mono">$12,840</div><span class="chip" data-a="chip1" data-final="matched" data-label="Matched">Queued</span></div>
        <div class="pr-tr"><div class="pr-id mono">INV-2202</div><div>Halcyon Media</div><div class="pr-amt mono">$3,120</div><span class="chip" data-a="chip2" data-final="matched" data-label="Matched">Queued</span></div>
        <div class="pr-tr"><div class="pr-id mono">INV-2203</div><div>Brightline Foods</div><div class="pr-amt mono">$9,466</div><span class="chip" data-a="chip3" data-final="flagged" data-label="Flagged">Queued</span></div>
      </div>
      <div class="pr-foot h0" data-a="pr-foot">
        <span class="mark"></span>
        <span><b>Finance agent</b> reconciled 214 invoices. 1 needs review.</span>
      </div>
    </div>

    <!-- API -->
    <div class="card api mono c-api">
      <div class="chrome">
        <div class="dot"></div><div class="dot"></div><div class="dot"></div>
        <div class="path mono">api.eluu.ai</div>
      </div>
      <div class="api-body">
        <div class="t-line" data-a="api-l1"><span class="c-dim">$</span> <span class="c-cmd">curl -X</span> <span class="c-mint">POST</span> <span class="c-cmd">api.eluu.ai/v1/tasks</span> <span class="c-dim">\</span></div>
        <div class="t-line" data-a="api-l2">&nbsp;&nbsp;<span class="c-cmd">-d</span> <span class="c-dim">'&#123;</span><span class="c-key">"agent"</span><span class="c-dim">:</span> <span class="c-str">"revops"</span><span class="c-dim">,</span></div>
        <div class="t-line" data-a="api-l3">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class="c-key">"task"</span><span class="c-dim">:</span> <span class="c-str">"Enrich the 200 new signups and score them"</span><span class="c-dim">&#125;'</span></div>
        <hr class="api-sep h0" data-a="api-sep" />
        <div class="h0" data-a="api-r1"><span class="c-mint">202</span> <span class="c-dim">·</span> <span class="c-cmd">task accepted</span> <span class="c-dim">·</span> <span class="c-key">tsk_8H2M</span></div>
        <div class="h0" data-a="api-r2"><span class="c-dim">→</span> <span class="c-cmd">200 enriched</span> <span class="c-dim">·</span> <span class="c-orange">12 flagged as duplicates</span></div>
        <div class="h0" data-a="api-r3"><span class="c-dim">→</span> <span class="c-cmd">report ready</span> <span class="c-dim">·</span> <span class="c-key">/v1/tasks/tsk_8H2M/report</span> <span class="c-mint">✓</span></div>
      </div>
    </div>

    <!-- WEB -->
    <div class="card web c-web">
      <div class="wb-head">
        <div class="wb-logo"><svg width="13" height="13" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.2" height="10" rx="1" fill="#ED733B"/><rect x="13" y="7" width="3.2" height="6.5" rx="1" fill="#ED733B"/></svg></div>
        <div class="wb-name">Chief-of-staff agent</div>
        <div class="wb-status"><i data-a="wb-dot"></i><span data-a="wb-status">Online</span></div>
      </div>
      <div class="wb-body">
        <div class="wb-row h0" data-a="wb-user">
          <div class="who">You</div>
          <div class="msg">Prep the board pack for Thursday. Q2 numbers, hiring update, runway.</div>
        </div>
        <div class="wb-row agent h0" data-a="wb-agent">
          <div class="who agent-line"><span class="wb-av"><svg width="10" height="10" viewBox="0 0 24 24" fill="none"><rect x="8" y="7" width="3.2" height="10" rx="1" fill="#ED733B"/><rect x="13" y="7" width="3.2" height="6.5" rx="1" fill="#ED733B"/></svg></span><span>Chief-of-staff agent</span></div>
          <div class="msg">Board pack drafted. 18 slides. Q2 revenue pulled from Stripe, hiring from Ashby, runway modeled to Dec.</div>
          <div class="wb-artifact h0" data-a="wb-artifact">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#ED733B" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 2.5H6.5a1.5 1.5 0 0 0-1.5 1.5v16a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5-1.5V8l-5.5-5.5z"/><path d="M13.5 2.5V8H19"/></svg>
            <div><div class="aname">board-pack-q2.pdf</div><div class="ameta">18 slides · ready for review</div></div>
          </div>
          <div class="wb-sched h0" data-a="wb-sched">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            Repeats every Thursday · 7:00 AM
          </div>
        </div>
      </div>
      <div class="wb-input">Message your agent…
        <div class="send"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="#14110b" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7"/></svg></div>
      </div>
    </div>

  </div>
</div>

<style>
  .hta-root {
    --bg: #13100a; --card: #1e1d1b; --card-deep: #191713;
    --line: rgba(237,233,227,0.06); --line-2: rgba(237,233,227,0.12);
    --tx: #ede9e3; --tx-2: rgba(237,233,227,0.6); --tx-3: rgba(237,233,227,0.4); --tx-4: rgba(237,233,227,0.25);
    --mint: #63cf9e; --sky: #6db7f0; --orange: #ED733B;
    width: 100%;
    color: var(--tx);
    font-family: 'Söhne', sans-serif;
    letter-spacing: -0.01em;
  }
  .hta-stage { position: relative; width: 100%; max-width: 1100px; height: 640px; overflow: hidden; }
  .mono { font-family: ui-monospace, 'SF Mono', Menlo, monospace; letter-spacing: 0; }
  .eyebrow { font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--tx-3); }

  .card {
    position: absolute; left: 50%; top: 50%;
    transform: translate(-50%, -50%);
    background: var(--card-deep);
    border: 1px solid var(--line-2);
    border-radius: 3px; overflow: hidden;
    box-shadow: 0 24px 64px -32px rgba(0,0,0,0.85);
    visibility: hidden;
  }
  /* elements that animate in start hidden */
  .h0 { opacity: 0; }

  /* typing dots */
  .tdots { display: inline-flex; gap: 4px; padding: 10px 12px; border-radius: 3px; background: var(--card); }
  .tdots i { width: 5px; height: 5px; border-radius: 50%; background: var(--tx-3); }

  .chrome { display: flex; align-items: center; gap: 8px; padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .chrome .dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(237,233,227,0.12); }
  .chrome .path { font-size: 11.5px; color: var(--tx-3); margin-left: 4px; }

  /* ===== support ===== */
  .support { width: 320px; }
  .sp-head { display: flex; align-items: center; gap: 11px; padding: 14px 16px; border-bottom: 1px solid var(--line); background: var(--card); }
  .sp-avatar { width: 32px; height: 32px; border-radius: 3px; background: rgba(99,207,158,0.12); border: 1px solid rgba(99,207,158,0.45);
    display: grid; place-items: center; font-size: 13px; font-weight: 600; color: var(--mint); position: relative; }
  .sp-avatar::after { content: ''; position: absolute; right: -3px; bottom: -3px; width: 7px; height: 7px; border-radius: 50%;
    background: var(--mint); border: 2px solid var(--card); }
  .sp-name { font-size: 13.5px; font-weight: 600; line-height: 1.2; }
  .sp-sub { font-size: 11px; color: var(--tx-3); margin-top: 2px; }
  .sp-body { padding: 16px 14px 8px; display: flex; flex-direction: column; gap: 8px; min-height: 210px; }
  .sp-msg { max-width: 85%; padding: 9px 12px; font-size: 13px; line-height: 1.45; border-radius: 3px; }
  .sp-msg.cust { align-self: flex-end; background: var(--card); }
  .sp-msg.agent { align-self: flex-start; background: rgba(99,207,158,0.09); border: 1px solid rgba(99,207,158,0.2); color: var(--tx-2); }
  .sp-typing { align-self: flex-start; }
  .sp-file { align-self: flex-start; display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--tx-2);
    background: var(--card); border: 1px solid var(--line-2); border-radius: 3px; padding: 7px 10px; }
  .sp-meta { align-self: flex-start; margin-top: 2px; }
  .sp-meta .eyebrow { color: var(--mint); }
  .sp-input { margin: 8px 14px 14px; display: flex; align-items: center; background: var(--card); border: 1px solid var(--line-2);
    border-radius: 3px; padding: 9px 8px 9px 12px; font-size: 12.5px; color: var(--tx-4); }
  .sp-send { margin-left: auto; width: 24px; height: 24px; border-radius: 2px; background: var(--tx); display: grid; place-items: center; }

  /* ===== product ===== */
  .product { width: 430px; }
  .pr-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 14px 16px 12px; }
  .pr-h { font-size: 15px; font-weight: 600; }
  .pr-h span { color: var(--tx-3); font-weight: 400; font-size: 11.5px; margin-left: 8px; }
  .pr-btn { position: relative; display: inline-flex; align-items: center; background: var(--tx); color: #14110b;
    font-size: 12px; font-weight: 600; padding: 8px 12px; border-radius: 2px; }
  .pr-cursor { position: absolute; z-index: 3; opacity: 0; }
  .pr-table { padding: 0 16px; }
