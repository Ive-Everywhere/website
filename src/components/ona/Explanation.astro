---
// Explanation — pillar/use-case §2, per ona ref (case frame-00 "Hand off work,
// walk away"): narrow text column on the LEFT (heading, body, plain arrow-link)
// beside a LARGE media panel on the right (~62% width). Stacks on mobile.
// Props: heading, subhead, linkLabel?, linkHref?, mediaLabel?.
// Default slot replaces the media placeholder with a real visual/animation.
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  heading: string;
  subhead: string;
  linkLabel?: string;
  linkHref?: string;
  mediaLabel?: string;
}
const { heading, subhead, linkLabel, linkHref, mediaLabel } = Astro.props;
const hasMedia = Astro.slots.has('default');
---

<section class="oex">
  <div class="oex-container">
    <div class="oex-text reveal">
      <h2 class="oex-heading">{heading}</h2>
      <p class="oex-subhead">{subhead}</p>
      {linkLabel && linkHref && (
        <div class="oex-link-row">
          <a href={linkHref} class="oex-link">
            {linkLabel}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      )}
    </div>
    <div class="oex-media reveal">
      {hasMedia ? <slot /> : <MediaPlaceholder label={mediaLabel ?? 'Product visual'} ratio="16 / 10" />}
    </div>
  </div>
</section>

<style>
  .oex {
    background: #13100a;
    padding: 112px 0 0;
  }
  .oex-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .oex-container {
      grid-template-columns: 35fr 62fr;
      gap: 64px;
      align-items: start;
    }
  }

  .oex-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .oex-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .oex-subhead {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.6;
    letter-spacing: -0.005em;
    margin: 18px 0 0;
    max-width: 44ch;
    text-wrap: pretty;
  }
  .oex-link-row { margin-top: 24px; }
  .oex-link {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s ease;
  }
  .oex-link:hover { opacity: 0.8; }
  .oex-link svg { transition: transform 0.2s ease; }
  .oex-link:hover svg { transform: translateX(2px); }

  .oex-media { width: 100%; min-width: 0; }

  @media (max-width: 899px) {
    /* media above text when stacked, matching ona's mobile order */
    .oex-media { order: -1; }
  }
  @media (max-width: 639px) {
    .oex { padding: 64px 0 0; }
    .oex-container { gap: 24px; }
  }
</style>
