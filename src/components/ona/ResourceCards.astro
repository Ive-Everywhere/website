---
// ResourceCards — two ona-ref structures behind one component:
//  • variant="grid" (default; case frame-08): 3-column cards with a media
//    panel on top, then title, body, plain arrow-link.
//  • variant="list" (home frame-08 blog highlights): centered small heading,
//    then full-width stacked ROWS — title, muted body, small meta line,
//    and a small tag chip on the far right.
// Cards with placeholder: true render as designed placeholder tiles.
// Props: heading?, variant?, cards ({ eyebrow?, title, body?, meta?, tag?,
//   href?, ctaLabel?, mediaLabel?, placeholder?, placeholderLabel? }[]).
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Card {
  eyebrow?: string;
  title?: string;
  body?: string;
  meta?: string;
  tag?: string;
  href?: string;
  ctaLabel?: string;
  mediaLabel?: string;
  placeholder?: boolean;
  placeholderLabel?: string;
}
interface Props {
  heading?: string;
  variant?: 'grid' | 'list';
  cards: Card[];
}
const { heading, variant = 'grid', cards } = Astro.props;
---

<section class:list={['orc', `orc--${variant}`]}>
  <div class="orc-container">
    {heading && (
      <div class="orc-intro reveal">
        <h2 class="orc-heading">{heading}</h2>
      </div>
    )}

    {variant === 'list' ? (
      <div class="orc-list">
        {cards.map((card) =>
          card.placeholder ? (
            <div class="orc-row orc-row--placeholder reveal">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
              <span class="orc-ph-label">{card.placeholderLabel ?? 'Coming soon'}</span>
            </div>
          ) : (
            <a href={card.href ?? '#'} class="orc-row reveal" data-todo={card.href ? undefined : ''}>
              <div class="orc-row-text">
                <h3 class="orc-row-title">{card.title}</h3>
                {card.body && <p class="orc-row-body">{card.body}</p>}
                {card.meta && <span class="orc-row-meta">{card.meta}</span>}
              </div>
              {card.tag && <span class="orc-row-tag">{card.tag}</span>}
            </a>
          )
        )}
      </div>
    ) : (
      <div class="orc-grid">
        {cards.map((card) =>
          card.placeholder ? (
            <div class="orc-card orc-card--placeholder reveal">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
              </svg>
              <span class="orc-ph-label">{card.placeholderLabel ?? 'Coming soon'}</span>
            </div>
          ) : (
            <a href={card.href ?? '#'} class="orc-card reveal" data-todo={card.href ? undefined : ''}>
              <div class="orc-card-media">
                <MediaPlaceholder label={card.mediaLabel ?? card.eyebrow ?? 'Cover'} ratio="16 / 10" compact />
              </div>
              <div class="orc-card-text">
                {card.eyebrow && <span class="orc-card-eyebrow">{card.eyebrow}</span>}
                <h3 class="orc-card-title">{card.title}</h3>
                {card.body && <p class="orc-card-body">{card.body}</p>}
              </div>
              <span class="orc-card-cta">
                {card.ctaLabel ?? 'Read more'}
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
              </span>
            </a>
          )
        )}
      </div>
    )}
  </div>
</section>

<style>
  .orc {
    background: #13100a;
    padding: 96px 0 0;
  }
  .orc-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .orc-intro { margin-bottom: 24px; }
  .orc-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  /* ── list variant: centered heading + narrower stacked rows ── */
  .orc--list .orc-container { max-width: 900px; }
  .orc--list .orc-intro { text-align: center; margin-bottom: 28px; }
  .orc--list .orc-heading {
    font-size: clamp(16px, 1.5vw, 19px);
    font-weight: 400;
    color: rgba(237, 233, 227, 0.7);
  }

  .orc-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .orc-row {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    background: #1e1d1b;
    border-radius: 2px;
    padding: 24px 28px;
    box-sizing: border-box;
    text-decoration: none;
    overflow: hidden;
    transition: background 0.18s ease-out;
  }
  .orc-row::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 2px;
    border: 1px solid rgba(237, 233, 227, 0.06);
    z-index: 30;
    transition: border-color 0.18s ease-out;
  }
  a.orc-row:hover { background: #23221f; }
  a.orc-row:hover::before { border-color: rgba(237, 233, 227, 0.18); }
  .orc-row--placeholder {
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 96px;
    color: rgba(237, 233, 227, 0.25);
  }

  .orc-row-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .orc-row-title {
    font-family: 'Söhne', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .orc-row-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.55);
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin: 8px 0 0;
    text-wrap: pretty;
  }
  .orc-row-meta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.8125rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.35);
    line-height: 1.4;
    margin-top: 16px;
  }
  .orc-row-tag {
    flex-shrink: 0;
    align-self: flex-end;
    font-family: 'Söhne', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    border: 1px solid rgba(237, 233, 227, 0.1);
    border-radius: 4px;
    padding: 4px 10px;
    line-height: 1;
    transition: border-color 0.18s ease-out, color 0.18s ease-out;
  }
  a.orc-row:hover .orc-row-tag {
    border-color: rgba(237, 233, 227, 0.25);
    color: rgba(237, 233, 227, 0.7);
  }

  /* ── grid variant: 3 columns, media on top ── */
  .orc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .orc-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .orc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #1e1d1b;
    border-radius: 2px;
    padding: 20px;
    box-sizing: border-box;
    text-decoration: none;
    overflow: hidden;
    transition: background 0.18s ease-out, transform 0.18s ease-out;
    min-height: 220px;
  }
  .orc-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 2px;
    border: 1px solid rgba(237, 233, 227, 0.06);
    z-index: 30;
    transition: border-color 0.18s ease-out;
  }
  a.orc-card:hover { background: #23221f; transform: translateY(-2px); }
  a.orc-card:hover::before { border-color: rgba(237, 233, 227, 0.18); }

  .orc-card--placeholder {
    align-items: center;
    justify-content: center;
    gap: 10px;
    color: rgba(237, 233, 227, 0.25);
  }
  .orc-ph-label {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    text-align: center;
  }

  .orc-card-media { min-width: 0; }
  .orc-card-text {
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex-grow: 1;
  }
  .orc-card-eyebrow {
    font-family: 'Söhne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ED733B;
    line-height: 1;
  }
  .orc-card-title {
    font-family: 'Söhne', sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    text-wrap: balance;
  }
  .orc-card-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.55);
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }
  .orc-card-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.18s ease-out;
  }
  .orc-card-cta svg { transition: transform 0.18s ease-out; }
  a.orc-card:hover .orc-card-cta { color: #f28e5f; }
  a.orc-card:hover .orc-card-cta svg { transform: translateX(2px); }

  @media (max-width: 639px) {
    .orc { padding: 64px 0 0; }
    .orc-card { padding: 16px; min-height: 160px; }
    .orc-row { padding: 18px 16px; flex-direction: column; }
    .orc-row-tag { align-self: flex-start; }
  }
</style>
