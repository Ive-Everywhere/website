---
// ComplianceBadges — quiet trust strip: heading/body intro, then a
// left-aligned row of compact inline badges (icon + label side by side).
// Badges render muted pending certification verification — never a claimed fact.
// Props: heading?, body?, badges (string[]).
interface Props {
  heading?: string;
  body?: string;
  badges?: string[];
}
const { heading, body, badges = ['SOC 2', 'GDPR'] } = Astro.props;
---

<section class="ocb">
  <div class="ocb-container">
    {(heading || body) && (
      <div class="ocb-intro reveal">
        {heading && <h2 class="ocb-heading">{heading}</h2>}
        {body && <p class="ocb-body">{body}</p>}
      </div>
    )}
    <div class="ocb-row reveal">
      {badges.map((badge) => (
        <div class="ocb-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>{badge}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ocb {
    background: #13100a;
    padding: 96px 0 0;
  }
  .ocb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ocb-intro {
    margin-bottom: 24px;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ocb-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }
  .ocb-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }

  /* ── Quiet trust strip: compact inline badges ── */
  .ocb-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ocb-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 22px;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.06);
    border-radius: 2px;
    box-sizing: border-box;
    font-family: 'Söhne', sans-serif;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: rgba(237, 233, 227, 0.55);
    line-height: 1;
    transition: border-color 0.18s ease-out, color 0.18s ease-out;
  }
  .ocb-badge:hover {
    border-color: rgba(237, 233, 227, 0.14);
    color: rgba(237, 233, 227, 0.75);
  }
  .ocb-badge svg { color: rgba(237, 233, 227, 0.3); flex-shrink: 0; }

  @media (max-width: 639px) {
    .ocb { padding: 64px 0 0; }
    .ocb-badge { padding: 12px 18px; }
  }
</style>
