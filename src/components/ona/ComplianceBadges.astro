---
// ComplianceBadges — per ona ref (frame-07/08 "Enterprise-ready." + case
// frame-07): bold heading line with a muted second line, then a row of wide
// badge TILES (equal cards, centered badge mark inside, generous padding).
// Badges render muted pending certification verification — never a claimed fact.
// Props: heading?, body?, badges (string[]).
interface Props {
  heading?: string;
  body?: string;
  badges?: string[];
}
const { heading, body, badges = ['SOC 2', 'GDPR'] } = Astro.props;
---

<section class="ocb">
  <div class="ocb-container">
    {(heading || body) && (
      <div class="ocb-intro reveal">
        {heading && <h2 class="ocb-heading">{heading}</h2>}
        {body && <p class="ocb-body">{body}</p>}
      </div>
    )}
    <div class="ocb-row reveal">
      {badges.map((badge) => (
        <div class="ocb-tile">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>{badge}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .ocb {
    background: #13100a;
    padding: 112px 0 0;
  }
  .ocb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ocb-intro {
    margin-bottom: 32px;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ocb-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }
  .ocb-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }

  /* ── Equal wide tiles ── */
  .ocb-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  @media (min-width: 720px) {
    /* ona shows a 4-across row; with fewer badges the tiles keep 4-col width */
    .ocb-row { grid-template-columns: repeat(4, 1fr); }
  }
  .ocb-tile {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 110px;
    background: #1e1d1b;
    border-radius: 10px;
    padding: 24px;
    box-sizing: border-box;
    overflow: hidden;
    font-family: 'Söhne', sans-serif;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: rgba(237, 233, 227, 0.55);
  }
  .ocb-tile::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 10px;
    border: 1px solid rgba(237, 233, 227, 0.06);
    z-index: 30;
  }
  .ocb-tile svg { color: rgba(237, 233, 227, 0.3); flex-shrink: 0; }

  @media (max-width: 639px) {
    .ocb { padding: 64px 0 0; }
    .ocb-row { gap: 10px; }
    .ocb-tile { min-height: 90px; padding: 18px; }
  }
</style>
