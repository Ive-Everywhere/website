---
// FeaturedGuide — headline, body, CTA, cover visual (home §8).
// Props: headline, body, ctaLabel, ctaHref, coverLabel (placeholder label for the cover).
// Slot "cover" replaces the placeholder with a real cover asset.
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  headline: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  coverLabel?: string;
}
const { headline, body, ctaLabel, ctaHref, coverLabel = 'Guide cover' } = Astro.props;
const hasCover = Astro.slots.has('cover');
---

<section class="ofg">
  <div class="ofg-container">
    <div class="ofg-card reveal">
      <div class="ofg-media">
        {hasCover ? <slot name="cover" /> : <MediaPlaceholder label={coverLabel} ratio="4 / 3" />}
      </div>
      <div class="ofg-text">
        <h2 class="ofg-heading">{headline}</h2>
        <p class="ofg-body">{body}</p>
        <div class="ofg-cta-row">
          <a href={ctaHref} class="ofg-cta">
            {ctaLabel}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ofg {
    background: #13100a;
    padding: 112px 0 0;
  }
  .ofg-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ofg-card {
    position: relative;
    background: #1e1d1b;
    border-radius: 4px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 32px 24px;
    box-sizing: border-box;
  }
  .ofg-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
  }
  @media (min-width: 900px) {
    .ofg-card {
      grid-template-columns: 5fr 6fr;
      gap: 48px;
      padding: 48px;
      align-items: center;
    }
  }

  .ofg-media { min-width: 0; }

  .ofg-text {
    display: flex;
    flex-direction: column;
    max-width: 48ch;
  }
  .ofg-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .ofg-body {
    font-family: 'Söhne', sans-serif;
    font-size: 1rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 14px 0 0;
    text-wrap: pretty;
  }
  .ofg-cta-row { margin-top: 26px; }
  .ofg-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(237, 115, 59, 0.25);
    border-radius: 4px;
    padding: 7px 14px;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .ofg-cta:hover {
    background: rgba(237, 115, 59, 0.06);
    border-color: rgba(237, 115, 59, 0.4);
  }

  @media (max-width: 639px) {
    .ofg { padding: 64px 0 0; }
    .ofg-card { padding: 24px 16px; }
  }
</style>
