---
// FeaturedGuide — home §8, per ona ref (frame-07 "Featured content"): a single
// inset band, narrower than the full container and centered; cover visual on
// the LEFT (~1/3), text column on the right: small muted eyebrow, title, body,
// plain arrow-link at the bottom. No pill CTA.
// Props: eyebrow?, headline, body, ctaLabel, ctaHref, coverLabel.
// Slot "cover" replaces the placeholder with a real cover asset.
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  eyebrow?: string;
  headline: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  coverLabel?: string;
}
const {
  eyebrow = 'Featured content',
  headline,
  body,
  ctaLabel,
  ctaHref,
  coverLabel = 'Guide cover',
} = Astro.props;
const hasCover = Astro.slots.has('cover');
---

<section class="ofg">
  <div class="ofg-container">
    <div class="ofg-card reveal">
      <div class="ofg-media">
        {hasCover ? <slot name="cover" /> : <MediaPlaceholder label={coverLabel} ratio="4 / 3" compact />}
      </div>
      <div class="ofg-text">
        <span class="ofg-eyebrow">{eyebrow}</span>
        <h2 class="ofg-heading">{headline}</h2>
        <p class="ofg-body">{body}</p>
        <div class="ofg-cta-row">
          <a href={ctaHref} class="ofg-cta">
            {ctaLabel}
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ofg {
    background: #13100a;
    padding: 112px 0 0;
  }
  /* narrower than the standard container, centered — per ona frame-07 */
  .ofg-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ofg-card {
    position: relative;
    background: #1e1d1b;
    border-radius: 10px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 28px;
    padding: 24px;
    box-sizing: border-box;
  }
  .ofg-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 10px;
    border: 1px solid rgba(237, 233, 227, 0.06);
    z-index: 30;
  }
  @media (min-width: 720px) {
    .ofg-card {
      grid-template-columns: 4fr 7fr;
      gap: 40px;
      padding: 28px;
      align-items: center;
    }
  }

  .ofg-media { min-width: 0; }

  .ofg-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .ofg-eyebrow {
    font-family: 'Söhne', sans-serif;
    font-size: 12px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    letter-spacing: 0.01em;
    margin-bottom: 10px;
  }
  .ofg-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(17px, 1.6vw, 21px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }
  .ofg-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 10px 0 0;
    text-wrap: pretty;
  }
  .ofg-cta-row { margin-top: 20px; }
  .ofg-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: opacity 0.2s ease;
  }
  .ofg-cta:hover { opacity: 0.8; }
  .ofg-cta svg { transition: transform 0.2s ease; }
  .ofg-cta:hover svg { transform: translateX(2px); }

  @media (max-width: 639px) {
    .ofg { padding: 64px 0 0; }
    .ofg-card { padding: 20px 16px; }
  }
</style>
