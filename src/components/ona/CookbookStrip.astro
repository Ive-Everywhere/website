---
// CookbookStrip — heading, function tabs (static, no JS filtering in v1),
// recipe cards, and a CTA to the cookbook.
// Cards: compact fixed-height tiles — category eyebrow, 2-line clamped title,
// arrow pinned bottom-right (quiet by default, accent on hover).
// Props: heading, tabs (string[]), recipes ({ category, title, href? }[]),
// ctaLabel, ctaHref.
interface Recipe {
  category: string;
  title: string;
  href?: string;
}
interface Props {
  heading: string;
  tabs?: string[];
  recipes: Recipe[];
  ctaLabel?: string;
  ctaHref?: string;
}
const {
  heading,
  tabs = ['All', 'Sales', 'Finance', 'Legal', 'Operations', 'Executive', 'People', 'Product'],
  recipes,
  ctaLabel = 'Explore the cookbook',
  ctaHref = '/cookbook',
} = Astro.props;
---

<section class="ocs">
  <div class="ocs-container">
    <div class="ocs-intro reveal">
      <h2 class="ocs-heading">{heading}</h2>
    </div>

    <div class="ocs-tabs reveal" role="tablist" aria-label="Filter recipes by function">
      {tabs.map((tab, i) => (
        <span class:list={['ocs-tab', { 'is-active': i === 0 }]}>{tab}</span>
      ))}
    </div>

    <div class="ocs-grid">
      {recipes.map((recipe) => (
        <a href={recipe.href ?? ctaHref} class="ocs-card reveal">
          <span class="ocs-card-cat">{recipe.category}</span>
          <h3 class="ocs-card-title">{recipe.title}</h3>
          <span class="ocs-card-arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </span>
        </a>
      ))}
    </div>

    <div class="ocs-cta-row reveal">
      <a href={ctaHref} class="ocs-cta">
        {ctaLabel}
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>

<style>
  .ocs {
    background: #13100a;
    padding: 96px 0 0;
  }
  .ocs-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ocs-intro { margin-bottom: 24px; }
  .ocs-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  /* ── Tab chips: sharp, squared ── */
  .ocs-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 20px;
  }
  .ocs-tab {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    border: 1px solid rgba(237, 233, 227, 0.1);
    border-radius: 4px;
    padding: 6px 14px;
    line-height: 1;
    user-select: none;
    transition: border-color 0.18s ease-out, color 0.18s ease-out;
  }
  .ocs-tab:not(.is-active):hover {
    border-color: rgba(237, 233, 227, 0.25);
    color: rgba(237, 233, 227, 0.85);
  }
  .ocs-tab.is-active {
    color: #13100a;
    background: #ede9e3;
    border-color: #ede9e3;
    font-weight: 600;
  }

  /* ── Grid: 4-up desktop, tight gaps ── */
  .ocs-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  @media (min-width: 640px) {
    .ocs-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .ocs-grid { grid-template-columns: repeat(4, 1fr); }
  }

  /* ── Compact fixed-height cards ── */
  .ocs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 148px;
    background: #1e1d1b;
    border: 1px solid rgba(237, 233, 227, 0.06);
    border-radius: 2px;
    padding: 18px 18px 16px;
    box-sizing: border-box;
    text-decoration: none;
    transition: background 0.18s ease-out, border-color 0.18s ease-out, transform 0.18s ease-out;
  }
  .ocs-card:hover {
    background: #23221f;
    border-color: rgba(237, 233, 227, 0.18);
    transform: translateY(-2px);
  }

  .ocs-card-cat {
    font-family: 'Söhne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ED733B;
    line-height: 1;
    margin-bottom: 12px;
  }
  .ocs-card-title {
    font-family: 'Söhne', sans-serif;
    font-size: 17px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.9);
    line-height: 1.35;
    letter-spacing: -0.01em;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .ocs-card-arrow {
    margin-top: auto;
    margin-left: auto;
    padding-top: 10px;
    color: #ED733B;
    opacity: 0.4;
    display: flex;
    transition: opacity 0.18s ease-out, transform 0.18s ease-out;
  }
  .ocs-card:hover .ocs-card-arrow { opacity: 1; transform: translateX(2px); }

  .ocs-cta-row { margin-top: 28px; }
  .ocs-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(237, 115, 59, 0.25);
    border-radius: 4px;
    padding: 8px 14px;
    transition: background 0.18s ease-out, border-color 0.18s ease-out;
  }
  .ocs-cta svg { transition: transform 0.18s ease-out; }
  .ocs-cta:hover {
    background: rgba(237, 115, 59, 0.06);
    border-color: rgba(237, 115, 59, 0.4);
  }
  .ocs-cta:hover svg { transform: translateX(2px); }

  @media (max-width: 639px) {
    .ocs { padding: 64px 0 0; }
    .ocs-card { min-height: 128px; padding: 16px 16px 14px; }
  }
</style>
