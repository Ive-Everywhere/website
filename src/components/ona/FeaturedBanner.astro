---
// FeaturedBanner — home §6, per ona ref (frame-06 "Summit recordings" card):
// ONE full-width rounded card; text column on the LEFT (~55%: heading, body,
// pill CTA) and a row of small thumbnails with captions on the RIGHT.
// Props: eyebrow?, heading, body, ctaLabel, ctaHref, thumbnails (labels for
// placeholder thumbnails when no real assets exist yet).
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  body: string;
  ctaLabel: string;
  ctaHref: string;
  thumbnails?: string[];
}
const { eyebrow, heading, body, ctaLabel, ctaHref, thumbnails = [] } = Astro.props;
---

<section class="ofb">
  <div class="ofb-container">
    <div class="ofb-card reveal">
      <div class="ofb-text">
        {eyebrow && <span class="ofb-eyebrow">{eyebrow}</span>}
        <h2 class="ofb-heading">{heading}</h2>
        <p class="ofb-body">{body}</p>
        <div class="ofb-cta-row">
          <a href={ctaHref} class="ofb-cta">{ctaLabel}</a>
        </div>
      </div>
      {thumbnails.length > 0 && (
        <div class="ofb-thumbs">
          {thumbnails.map((label) => (
            <div class="ofb-thumb">
              <MediaPlaceholder label="" ratio="1 / 1" compact />
              <span class="ofb-thumb-caption">{label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .ofb {
    background: #13100a;
    padding: 96px 0 0;
  }
  .ofb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ofb-card {
    position: relative;
    background: #1e1d1b;
    border-radius: 2px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    padding: 32px 24px;
    box-sizing: border-box;
  }
  .ofb-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 2px;
    border: 1px solid rgba(237, 233, 227, 0.06);
    z-index: 30;
  }
  @media (min-width: 900px) {
    .ofb-card {
      grid-template-columns: 55fr 41fr;
      gap: 64px;
      padding: 44px 48px;
      align-items: center;
    }
  }

  .ofb-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .ofb-eyebrow {
    font-family: 'Söhne', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ED733B;
    line-height: 1;
    margin-bottom: 12px;
  }
  .ofb-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .ofb-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 14px 0 0;
    max-width: 52ch;
    text-wrap: pretty;
  }
  .ofb-cta-row { margin-top: 24px; }
  .ofb-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #13100a;
    background: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    border-radius: 4px;
    padding: 9px 18px;
    line-height: 1;
    transition: background 0.18s ease-out, transform 0.18s ease-out;
  }
  .ofb-cta:hover { background: #f28e5f; transform: translateY(-1px); }

  /* ── Thumbnail row with captions ── */
  .ofb-thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    align-items: start;
  }
  .ofb-thumb {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .ofb-thumb-caption {
    font-family: 'Söhne', sans-serif;
    font-size: 11px;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.45);
    line-height: 1.4;
  }

  @media (max-width: 639px) {
    .ofb { padding: 64px 0 0; }
    .ofb-thumbs { grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .ofb-card { padding: 24px 16px; }
  }
</style>
