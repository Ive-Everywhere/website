---
// FeatureCards — case-page feature grid per ona ref (case frames 05–06):
// cards in a 2-column grid; each card contains its own media panel on top,
// then title + body (+ optional eyebrow-quote). 5 cards → 2+2+1 (last spans).
// Props: heading?, sub?, cards ({ headline, eyebrowQuote?, body, mediaLabel? }[]).
import MediaPlaceholder from './MediaPlaceholder.astro';

interface Card {
  headline: string;
  eyebrowQuote?: string;
  body: string;
  mediaLabel?: string;
}
interface Props {
  heading?: string;
  sub?: string;
  cards: Card[];
}
const { heading, sub, cards } = Astro.props;
---

<section class="ofc">
  <div class="ofc-container">
    {(heading || sub) && (
      <div class="ofc-intro reveal">
        {heading && <h2 class="ofc-heading">{heading}</h2>}
        {sub && <p class="ofc-sub">{sub}</p>}
      </div>
    )}
    <div class="ofc-grid" data-count={cards.length}>
      {cards.map((card) => (
        <article class="ofc-card reveal">
          <div class="ofc-card-media">
            <MediaPlaceholder label={card.mediaLabel ?? 'Product visual'} ratio="16 / 9" compact />
          </div>
          <div class="ofc-card-text">
            {card.eyebrowQuote && <span class="ofc-card-eyebrow">&ldquo;{card.eyebrowQuote}&rdquo;</span>}
            <h3 class="ofc-card-headline">{card.headline}</h3>
            <p class="ofc-card-body">{card.body}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ofc {
    background: #13100a;
    padding: 96px 0 0;
  }
  .ofc-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .ofc-intro {
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ofc-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .ofc-sub {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(15px, 1.6vw, 18px);
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    line-height: 1.5;
    margin: 0;
  }

  /* ── 2×2-ish grid ── */
  .ofc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .ofc-grid { grid-template-columns: 1fr 1fr; }
    /* odd counts: last card spans the full row */
    .ofc-grid[data-count="3"] .ofc-card:nth-child(3),
    .ofc-grid[data-count="5"] .ofc-card:nth-child(5) {
      grid-column: 1 / -1;
    }
    /* wide (spanning) card lays out media beside text */
    .ofc-grid[data-count="3"] .ofc-card:nth-child(3),
    .ofc-grid[data-count="5"] .ofc-card:nth-child(5) {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      align-items: center;
    }
  }

  .ofc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
    background: #1e1d1b;
    border-radius: 2px;
    padding: 24px;
    box-sizing: border-box;
    overflow: hidden;
  }
  .ofc-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 2px;
    border: 1px solid rgba(237, 233, 227, 0.06);
    z-index: 30;
  }
  @media (min-width: 900px) {
    .ofc-card { padding: 28px; }
  }

  .ofc-card-media { min-width: 0; }
  .ofc-card-text {
    display: flex;
    flex-direction: column;
  }

  .ofc-card-eyebrow {
    font-family: 'Söhne', sans-serif;
    font-size: 13px;
    font-weight: 400;
    font-style: italic;
    color: #ED733B;
    line-height: 1.4;
    margin-bottom: 12px;
  }
  .ofc-card-headline {
    font-family: 'Söhne', sans-serif;
    font-size: 1.125rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.25;
    letter-spacing: -0.015em;
    margin: 0;
    text-wrap: balance;
  }
  .ofc-card-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin: 10px 0 0;
    text-wrap: pretty;
  }

  @media (max-width: 639px) {
    .ofc { padding: 64px 0 0; }
    .ofc-card { padding: 20px 16px; gap: 18px; }
  }
</style>
