---
// TechDetails — up to 3 rows: title, description, → Docs link (pillar §6).
// Props: heading?, rows ({ title, desc, linkLabel?, linkHref? }[]).
interface Row {
  title: string;
  desc: string;
  linkLabel?: string;
  linkHref?: string;
}
interface Props {
  heading?: string;
  rows: Row[];
}
const { heading, rows } = Astro.props;
---

<section class="otd">
  <div class="otd-container">
    {heading && (
      <div class="otd-intro reveal">
        <h2 class="otd-heading">{heading}</h2>
      </div>
    )}
    <div class="otd-rows">
      {rows.map((row) => (
        <div class="otd-row reveal">
          <h3 class="otd-row-title">{row.title}</h3>
          <p class="otd-row-desc">{row.desc}</p>
          <div class="otd-row-link-wrap">
            <a
              href={row.linkHref ?? '#'}
              class="otd-row-link"
              data-todo={row.linkHref ? undefined : ''}
            >
              {row.linkLabel ?? 'Docs'}
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .otd {
    background: #13100a;
    padding: 96px 0 0;
  }
  .otd-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .otd-intro { margin-bottom: 24px; }
  .otd-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  .otd-rows {
    display: flex;
    flex-direction: column;
  }
  .otd-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px 40px;
    padding: 28px 0;
    border-bottom: 1px solid rgba(237, 233, 227, 0.06);
  }
  .otd-row:first-child { border-top: 1px solid rgba(237, 233, 227, 0.06); }
  @media (min-width: 900px) {
    .otd-row {
      grid-template-columns: 3fr 6fr 2fr;
      align-items: baseline;
    }
  }

  .otd-row-title {
    font-family: 'Söhne', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .otd-row-desc {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.55;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }
  .otd-row-link-wrap {
    display: flex;
  }
  @media (min-width: 900px) {
    .otd-row-link-wrap { justify-content: flex-end; }
  }
  .otd-row-link {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.18s ease-out;
  }
  .otd-row-link:hover { color: #f28e5f; }
  .otd-row-link svg { transition: transform 0.18s ease-out; }
  .otd-row-link:hover svg { transform: translateX(2px); }

  @media (max-width: 639px) {
    .otd { padding: 64px 0 0; }
    .otd-row { padding: 20px 0; }
  }
</style>
