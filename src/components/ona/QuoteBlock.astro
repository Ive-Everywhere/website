---
// QuoteBlock — customer quote, attribution, optional stats list, optional CTA (home §7).
// Props: quote?, attribution?, stats? ({ value?, label }[] — missing values render
// as em-dash placeholders), ctaLabel?, ctaHref?.
// A missing quote renders as a designed placeholder (testimonial slot), never invented copy.
interface Stat {
  value?: string;
  label: string;
}
interface Props {
  quote?: string;
  attribution?: string;
  stats?: Stat[];
  ctaLabel?: string;
  ctaHref?: string;
}
const { quote, attribution, stats = [], ctaLabel, ctaHref } = Astro.props;
---

<section class="oqb">
  <div class="oqb-container">
    <div class="oqb-card reveal">
      <div class="oqb-quote-col">
        {quote ? (
          <blockquote class="oqb-quote">&ldquo;{quote}&rdquo;</blockquote>
        ) : (
          <blockquote class="oqb-quote oqb-quote--placeholder">Customer testimonial</blockquote>
        )}
        <p class="oqb-attr">{attribution ?? '—'}</p>
        {ctaLabel && ctaHref && (
          <div class="oqb-cta-row">
            <a href={ctaHref} class="oqb-cta">
              {ctaLabel}
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </a>
          </div>
        )}
      </div>
      {stats.length > 0 && (
        <div class="oqb-stats">
          {stats.map((stat) => (
            <div class="oqb-stat">
              <span class="oqb-stat-value">{stat.value ?? '—'}</span>
              <span class="oqb-stat-label">{stat.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .oqb {
    background: #13100a;
    padding: 112px 0 0;
  }
  .oqb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .oqb-card {
    position: relative;
    background: #1e1d1b;
    border-radius: 4px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    padding: 32px 24px;
    box-sizing: border-box;
  }
  .oqb-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
  }
  @media (min-width: 900px) {
    .oqb-card {
      grid-template-columns: 7fr 5fr;
      gap: 48px;
      padding: 48px;
      align-items: center;
    }
  }

  .oqb-quote-col {
    display: flex;
    flex-direction: column;
  }
  .oqb-quote {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(20px, 2.4vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }
  .oqb-quote--placeholder {
    color: rgba(237, 233, 227, 0.25);
    font-weight: 400;
    font-style: italic;
  }
  .oqb-attr {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    line-height: 1.5;
    margin: 16px 0 0;
  }
  .oqb-cta-row { margin-top: 26px; }
  .oqb-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(237, 115, 59, 0.25);
    border-radius: 4px;
    padding: 7px 14px;
    transition: background 0.25s ease, border-color 0.25s ease;
  }
  .oqb-cta:hover {
    background: rgba(237, 115, 59, 0.06);
    border-color: rgba(237, 115, 59, 0.4);
  }

  .oqb-stats {
    display: flex;
    flex-direction: column;
  }
  .oqb-stat {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid rgba(237, 233, 227, 0.06);
  }
  .oqb-stat:first-child { padding-top: 0; }
  .oqb-stat:last-child { border-bottom: none; padding-bottom: 0; }
  .oqb-stat-value {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(24px, 2.6vw, 36px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .oqb-stat-label {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.4);
    line-height: 1.4;
  }

  @media (max-width: 639px) {
    .oqb { padding: 64px 0 0; }
    .oqb-card { padding: 24px 16px; }
  }
</style>
