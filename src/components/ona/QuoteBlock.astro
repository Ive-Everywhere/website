---
// QuoteBlock — customer quote per ona ref (frame-06 / case frame-05):
// a true FILLED full-bleed band (solid #221A12, edge to edge) with a small
// centered small-caps eyebrow attribution, a BIG centered display quote,
// optional CTA below. Optional stats render as a 3-card row of FILLED
// #1e1d1b cards (big orange numerals) under the band — no hairline-only boxes.
// Missing quote renders as a designed placeholder — never invented copy.
interface Stat {
  value?: string;
  label: string;
}
interface Props {
  quote?: string;
  attribution?: string;
  stats?: Stat[];
  ctaLabel?: string;
  ctaHref?: string;
}
const { quote, attribution, stats = [], ctaLabel, ctaHref } = Astro.props;
---

<section class="oqb">
  <div class="oqb-band reveal">
    <div class="oqb-band-inner">
      <p class="oqb-attr">{attribution ?? 'Customer story'}</p>
      {quote ? (
        <blockquote class="oqb-quote">&ldquo;{quote}&rdquo;</blockquote>
      ) : (
        <blockquote class="oqb-quote oqb-quote--placeholder">Customer testimonial</blockquote>
      )}
      {ctaLabel && ctaHref && (
        <div class="oqb-cta-row">
          <a href={ctaHref} class="oqb-cta">
            {ctaLabel}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      )}
    </div>
  </div>

  {stats.length > 0 && (
    <div class="oqb-container">
      <div class="oqb-stats reveal">
        {stats.map((stat) => (
          <div class="oqb-stat">
            <span class="oqb-stat-value">{stat.value ?? '—'}</span>
            <span class="oqb-stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  )}
</section>

<style>
  .oqb {
    background: #13100a;
    padding: 96px 0 0;
  }
  .oqb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }

  /* ── Full-bleed FILLED band ── */
  .oqb-band {
    background: #221A12;
    width: 100%;
  }
  .oqb-band-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 110px 32px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  @media (min-width: 900px) {
    .oqb-band-inner { padding: 120px 64px; }
  }

  .oqb-attr {
    font-family: 'Söhne', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(237, 233, 227, 0.45);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-variant: small-caps;
    line-height: 1.5;
    margin: 0 0 28px;
  }
  .oqb-quote {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.25;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 26ch;
    text-wrap: balance;
  }
  .oqb-quote--placeholder {
    color: rgba(237, 233, 227, 0.3);
    font-weight: 400;
    font-style: italic;
  }
  .oqb-cta-row { margin-top: 40px; }
  .oqb-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    letter-spacing: -0.005em;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    border: 1px solid rgba(237, 115, 59, 0.25);
    border-radius: 4px;
    padding: 9px 18px;
    transition: background 0.18s ease-out, border-color 0.18s ease-out;
  }
  .oqb-cta svg { transition: transform 0.18s ease-out; }
  .oqb-cta:hover {
    background: rgba(237, 115, 59, 0.06);
    border-color: rgba(237, 115, 59, 0.4);
  }
  .oqb-cta:hover svg { transform: translateX(2px); }

  /* ── Stats row under the band (FILLED cards, big accent numerals) ── */
  .oqb-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 16px;
  }
  @media (min-width: 640px) {
    .oqb-stats { grid-template-columns: repeat(3, 1fr); }
  }
  .oqb-stat {
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: #1e1d1b;
    border-radius: 2px;
    padding: 36px 28px 40px;
    box-sizing: border-box;
  }
  .oqb-stat-value {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(34px, 3.4vw, 48px);
    font-weight: 600;
    color: #ED733B;
    line-height: 1;
    letter-spacing: -0.025em;
    font-variant-numeric: tabular-nums;
  }
  .oqb-stat-label {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.5);
    line-height: 1.4;
  }

  @media (max-width: 639px) {
    .oqb { padding: 64px 0 0; }
    .oqb-band-inner { padding: 80px 20px; }
    .oqb-stat { padding: 28px 22px 32px; }
  }
</style>
