---
// PoweredBy — 3 cross-link blocks (use-case §6): the platform pillars powering a use case.
// Props: heading?, blocks ({ name, body, ctaLabel, href }[]).
interface Block {
  name: string;
  body: string;
  ctaLabel: string;
  href: string;
}
interface Props {
  heading?: string;
  blocks: Block[];
}
const { heading = 'Powered by the Eluu platform', blocks } = Astro.props;
---

<section class="opb">
  <div class="opb-container">
    <div class="opb-intro reveal">
      <h2 class="opb-heading">{heading}</h2>
    </div>
    <div class="opb-grid">
      {blocks.map((block) => (
        <a href={block.href} class="opb-card reveal">
          <div class="opb-card-text">
            <h3 class="opb-card-name">{block.name}</h3>
            <p class="opb-card-body">{block.body}</p>
          </div>
          <span class="opb-card-cta">
            {block.ctaLabel}
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .opb {
    background: #13100a;
    padding: 112px 0 0;
  }
  .opb-container {
    max-width: 1380px;
    margin: 0 auto;
    padding: 0 20px;
    box-sizing: border-box;
  }
  .opb-intro { margin-bottom: 22.4px; }
  .opb-heading {
    font-family: 'Söhne', sans-serif;
    font-size: clamp(22px, 2.3vw, 32px);
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  .opb-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 10px;
    align-items: stretch;
  }
  @media (min-width: 640px) {
    .opb-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .opb-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    background: #1e1d1b;
    border-radius: 4px;
    padding: 24px;
    box-sizing: border-box;
    text-decoration: none;
    overflow: hidden;
    transition: background 0.25s ease;
  }
  .opb-card::before {
    content: "";
    pointer-events: none;
    position: absolute;
    inset: 0;
    border-radius: 4px;
    border: 1px solid rgba(237, 233, 227, 0.025);
    z-index: 30;
    transition: border-color 0.25s ease;
  }
  .opb-card:hover { background: #232220; }
  .opb-card:hover::before { border-color: rgba(237, 233, 227, 0.08); }

  .opb-card-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .opb-card-name {
    font-family: 'Söhne', sans-serif;
    font-size: 1.0625rem;
    font-weight: 600;
    color: #ede9e3;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .opb-card-body {
    font-family: 'Söhne', sans-serif;
    font-size: 0.9375rem;
    font-weight: 400;
    color: rgba(237, 233, 227, 0.6);
    line-height: 1.5;
    letter-spacing: -0.005em;
    margin: 0;
    text-wrap: pretty;
  }
  .opb-card-cta {
    font-family: 'Söhne', sans-serif;
    font-size: 0.875rem;
    font-weight: 400;
    color: #ED733B;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .opb-card-cta svg { transition: transform 0.2s ease; }
  .opb-card:hover .opb-card-cta svg { transform: translateX(2px); }

  @media (max-width: 639px) {
    .opb { padding: 64px 0 0; }
    .opb-card { padding: 20px 16px; }
  }
</style>
