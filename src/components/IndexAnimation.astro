---
// Index animation — connect an integration, watch it index and learn
---

<div class="ix-wrap">
  <img src="/images/cookbook-bg.png" alt="" class="ix-bg" />
  <div class="ix-window">
    <div class="ix-body" id="ix-body">
      <!-- Scene 1: Integration cards grid -->
      <div class="ix-scene" data-scene="cards">
        <div class="ix-grid">
          <div class="ix-card" data-tool="salesforce">
            <div class="ix-cover" style="background:linear-gradient(135deg,#00a1e0,#0070d2);">
              <img src="/logos/integrations/salesforce.svg" alt="" class="ix-icon" />
            </div>
            <div class="ix-card-body">
              <div class="ix-title-row">
                <span class="ix-name">Salesforce</span>
                <span class="ix-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Team</span>
              </div>
              <p class="ix-desc">CRM, deals, contacts, pipeline</p>
              <div class="ix-btn ix-btn-primary"><span class="ix-btn-text">Connect</span><span class="ix-btn-loading">Connecting<span class="ix-spinner"></span></span></div>
            </div>
          </div>

          <div class="ix-card" data-tool="hubspot">
            <div class="ix-cover" style="background:linear-gradient(135deg,#ff7a59,#ff5c35);">
              <img src="/logos/integrations/hubspot.svg" alt="" class="ix-icon" />
            </div>
            <div class="ix-card-body">
              <div class="ix-title-row">
                <span class="ix-name">HubSpot</span>
                <span class="ix-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Team</span>
              </div>
              <p class="ix-desc">Marketing, contacts, deals</p>
              <div class="ix-btn ix-btn-primary">Connect</div>
            </div>
          </div>

          <div class="ix-card" data-tool="sheets">
            <div class="ix-cover" style="background:linear-gradient(135deg,#0f9d58,#34a853);">
              <img src="/logos/integrations/googlesheets.svg" alt="" class="ix-icon" />
            </div>
            <div class="ix-card-body">
              <div class="ix-title-row">
                <span class="ix-name">Google Sheets</span>
                <span class="ix-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Team</span>
              </div>
              <p class="ix-desc">Spreadsheets, data, reports</p>
              <div class="ix-btn ix-btn-primary">Connect</div>
            </div>
          </div>

          <div class="ix-card" data-tool="stripe">
            <div class="ix-cover" style="background:linear-gradient(135deg,#635bff,#7a73ff);">
              <img src="/logos/integrations/stripe.svg" alt="" class="ix-icon" />
            </div>
            <div class="ix-card-body">
              <div class="ix-title-row">
                <span class="ix-name">Stripe</span>
                <span class="ix-badge"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>Team</span>
              </div>
              <p class="ix-desc">Payments, invoices, billing</p>
              <div class="ix-btn ix-btn-primary">Connect</div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scene 2: Indexing state -->
      <div class="ix-scene" data-scene="indexing">
        <div class="ix-indexing">
          <!-- Connected integration header -->
          <div class="ix-idx-header">
            <div class="ix-idx-logo" style="background:linear-gradient(135deg,#00a1e0,#0070d2);">
              <img src="/logos/integrations/salesforce.svg" alt="" class="ix-idx-logo-img" />
            </div>
            <div class="ix-idx-header-text">
              <span class="ix-idx-name">Salesforce</span>
              <span class="ix-idx-connected">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#1fc16b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                Connected
              </span>
            </div>
          </div>

          <!-- Thinking indicator -->
          <div class="ix-think">
            <div class="ix-think-header">
              <svg class="ix-brain" width="14" height="14" viewBox="0 0 24 24" fill="#755a68">
                <path d="M7 6C7 6.23676 7.04072 6.46184 7.11469 6.66999C7.22686 6.98559 7.17357 7.33638 6.97276 7.60444C6.77194 7.8725 6.45026 8.02222 6.11585 8.00327C6.0776 8.0011 6.03898 8 6 8C4.89543 8 4 8.89543 4 10C4 10.5129 4.19174 10.9786 4.50903 11.3331C4.84885 11.7128 4.84885 12.2872 4.50903 12.6669C4.19174 13.0214 4 13.4871 4 14C4 14.8842 4.57447 15.6369 5.37327 15.9001C5.84924 16.057 6.1356 16.5419 6.04308 17.0345C6.01489 17.1846 6 17.3401 6 17.5C6 18.8807 7.11929 20 8.5 20C9.75862 20 10.8015 19.069 10.9746 17.8583C10.9806 17.8165 10.9891 17.7756 11 17.7358V6C11 4.89543 10.1046 4 9 4C7.89543 4 7 4.89543 7 6ZM13 17.7358C13.0109 17.7756 13.0194 17.8165 13.0254 17.8583C13.1985 19.069 14.2414 20 15.5 20C16.8807 20 18 18.8807 18 17.5C18 17.3401 17.9851 17.1846 17.9569 17.0345C17.8644 16.5419 18.1508 16.057 18.6267 15.9001C19.4255 15.6369 20 14.8842 20 14C20 13.4871 19.8083 13.0214 19.491 12.6669C19.1511 12.2872 19.1511 11.7128 19.491 11.3331C19.8083 10.9786 20 10.5129 20 10C20 8.89543 19.1046 8 18 8C17.961 8 17.9224 8.0011 17.8841 8.00327C17.5497 8.02222 17.2281 7.8725 17.0272 7.60444C16.8264 7.33638 16.7731 6.98559 16.8853 6.66999C16.9593 6.46184 17 6.23676 17 6C17 4.89543 16.1046 4 15 4C13.8954 4 13 4.89543 13 6V17.7358ZM9 2C10.1947 2 11.2671 2.52376 12 3.35418C12.7329 2.52376 13.8053 2 15 2C17.2091 2 19 3.79086 19 6C19 6.04198 18.9994 6.08382 18.9981 6.12552C20.7243 6.56889 22 8.13546 22 10C22 10.728 21.8049 11.4116 21.4646 12C21.8049 12.5884 22 13.272 22 14C22 15.4817 21.1949 16.7734 19.9999 17.4646L20 17.5C20 19.9853 17.9853 22 15.5 22C14.0859 22 12.8248 21.3481 12 20.3285C11.1752 21.3481 9.91405 22 8.5 22C6.01472 22 4 19.9853 4 17.5L4.00014 17.4646C2.80512 16.7734 2 15.4817 2 14C2 13.272 2.19513 12.5884 2.53536 12C2.19513 11.4116 2 10.728 2 10C2 8.13546 3.27573 6.56889 5.00194 6.12552C5.00065 6.08382 5 6.04198 5 6C5 3.79086 6.79086 2 9 2Z"/>
              </svg>
              <span class="ix-think-label">Indexing Salesforce</span>
              <div class="ix-dots-pulse">
                <span></span><span></span><span></span>
              </div>
            </div>

            <!-- Vertical line + items -->
            <div class="ix-idx-body">
              <div class="ix-idx-line"></div>
              <div class="ix-idx-items">
                <div class="ix-idx-item" data-idx="0">
                  <div class="ix-idx-item-icon ix-idx-spinner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  </div>
                  <div class="ix-idx-item-icon ix-idx-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fc16b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </div>
                  <span class="ix-idx-item-label">Contacts</span>
                  <span class="ix-idx-item-count">2,847</span>
                </div>
                <div class="ix-idx-item" data-idx="1">
                  <div class="ix-idx-item-icon ix-idx-spinner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  </div>
                  <div class="ix-idx-item-icon ix-idx-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fc16b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </div>
                  <span class="ix-idx-item-label">Deals</span>
                  <span class="ix-idx-item-count">412</span>
                </div>
                <div class="ix-idx-item" data-idx="2">
                  <div class="ix-idx-item-icon ix-idx-spinner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  </div>
                  <div class="ix-idx-item-icon ix-idx-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fc16b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </div>
                  <span class="ix-idx-item-label">Pipelines</span>
                  <span class="ix-idx-item-count">8</span>
                </div>
                <div class="ix-idx-item" data-idx="3">
                  <div class="ix-idx-item-icon ix-idx-spinner">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 1 1-6.219-8.56"/></svg>
                  </div>
                  <div class="ix-idx-item-icon ix-idx-check">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#1fc16b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
                  </div>
                  <span class="ix-idx-item-label">Reports</span>
                  <span class="ix-idx-item-count">34</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Scene 3: Ready / Chat -->
      <div class="ix-scene" data-scene="ready">
        <div class="ix-chat">
          <div class="ix-chat-header">
            <div class="ix-chat-avatar" style="background:linear-gradient(135deg,#00a1e0,#0070d2);">
              <img src="/logos/integrations/salesforce.svg" alt="" class="ix-chat-avatar-img" />
            </div>
            <div class="ix-chat-header-text">
              <span class="ix-chat-name">Salesforce</span>
              <span class="ix-chat-status">Indexed &middot; Ready to use</span>
            </div>
          </div>
          <div class="ix-chat-body">
            <div class="ix-chat-bubble">
              <p class="ix-chat-msg">Salesforce is ready to use. I've indexed <strong>2,847 contacts</strong>, <strong>412 deals</strong>, <strong>8 pipelines</strong>, and <strong>34 reports</strong>. You can now ask me anything about your Salesforce data.</p>
            </div>
            <div class="ix-chat-meta">Just now</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* ── Wrapper ── */
  .ix-wrap {
    position: absolute; inset: 0; overflow: hidden;
    display: flex; align-items: center; justify-content: center;
    padding: 20px; box-sizing: border-box;
  }

  /* ── Background ── */
  .ix-bg {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; z-index: 0;
  }

  /* ── Window ── */
  .ix-window {
    position: relative; z-index: 1; width: 100%; max-width: 560px;
    background: #1e1c1e;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.3), 0 8px 32px rgba(0,0,0,0.2);
    overflow: hidden; font-family: 'Söhne', sans-serif;
    border: 1px solid rgba(237, 233, 227,0.08);
  }

  /* ── Body / scenes ── */
  .ix-body { position: relative; height: 360px; min-height: 360px; max-height: 360px; overflow: hidden; }
  .ix-scene {
    position: absolute; inset: 0; padding: 14px;
    opacity: 0; transition: opacity 0.4s ease;
    pointer-events: none; overflow: hidden;
  }
  .ix-scene.active { opacity: 1; pointer-events: auto; }

  /* ── Scene 1: Card grid ── */
  .ix-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
  }
  .ix-card {
    display: flex; flex-direction: column;
    border-radius: 12px; overflow: hidden;
    background: #2b272c;
    border: 1px solid rgba(237, 233, 227,0.08);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .ix-card.dimmed { opacity: 0.4; }
  .ix-cover {
    height: 72px; display: flex; align-items: center; justify-content: center;
  }
  .ix-icon {
    width: 30px; height: 30px; object-fit: contain;
    filter: brightness(0) invert(1) drop-shadow(0 2px 4px rgba(0,0,0,0.2));
  }
  .ix-card-body {
    display: flex; flex-direction: column; gap: 6px; padding: 10px;
  }
  .ix-title-row {
    display: flex; align-items: center; justify-content: space-between; gap: 4px;
  }
  .ix-name {
    font-size: 11px; font-weight: 600; color: #ede9e3;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .ix-badge {
    display: inline-flex; align-items: center; gap: 2px;
    font-size: 9px; font-weight: 500; color: #aaa89e;
    background: rgba(237, 233, 227,0.08); border-radius: 6px;
    padding: 1px 5px 1px 3px; flex-shrink: 0;
    box-shadow: 0 0 0 1px rgba(237, 233, 227,0.08);
  }
  .ix-badge svg { width: 8px; height: 8px; }
  .ix-desc {
    font-size: 10px; color: #aaa89e; line-height: 1.4;
    margin: 0; display: -webkit-box; -webkit-line-clamp: 2;
    -webkit-box-orient: vertical; overflow: hidden;
    min-height: 28px;
  }

  /* ── Connect button ── */
  .ix-btn {
    display: flex; align-items: center; justify-content: center;
    height: 28px; border-radius: 6px; font-size: 11px; font-weight: 500;
    margin-top: auto; cursor: default; transition: background 0.2s;
  }
  .ix-btn-primary {
    background: #755a68; color: #ede9e3;
  }
  .ix-btn-loading { display: none; align-items: center; gap: 6px; }
  .ix-card.connecting .ix-btn-text { display: none; }
  .ix-card.connecting .ix-btn-loading { display: flex; }
  .ix-card.connecting .ix-btn-primary {
    background: #614051;
  }

  /* ── Spinner ── */
  .ix-spinner {
    width: 10px; height: 10px; border: 1.5px solid rgba(255,255,255,0.3);
    border-top-color: #ede9e3; border-radius: 50%;
    animation: ix-spin 0.8s linear infinite;
  }
  @keyframes ix-spin {
    to { transform: rotate(360deg); }
  }

  /* ── Scene 2: Indexing ── */
  .ix-indexing { padding: 16px 8px; }

  .ix-idx-header {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0 18px;
    border-bottom: 1px solid rgba(237, 233, 227,0.08);
    margin-bottom: 20px;
  }
  .ix-idx-logo {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ix-idx-logo-img {
    width: 24px; height: 24px; object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .ix-idx-header-text {
    display: flex; flex-direction: column; gap: 2px;
  }
  .ix-idx-name {
    font-size: 14px; font-weight: 600; color: #ede9e3;
  }
  .ix-idx-connected {
    display: flex; align-items: center; gap: 4px;
    font-size: 11px; color: #1fc16b; font-weight: 500;
  }

  /* ── Thinking indicator ── */
  .ix-think { padding: 0; }
  .ix-think-header {
    display: flex; align-items: center; gap: 6px;
    padding: 4px 0;
    transition: opacity 0.3s ease;
  }
  .ix-brain {
    animation: ix-brain-pulse 1.5s ease-in-out infinite;
  }
  @keyframes ix-brain-pulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }
  .ix-think-label {
    font-size: 11px; font-weight: 500; color: #aaa89e;
    transition: color 0.3s ease;
  }
  .ix-think.completed .ix-think-label { color: #1fc16b; }
  .ix-think.completed .ix-brain { animation: none; opacity: 0; }
  .ix-think.completed .ix-dots-pulse { display: none; }
  .ix-think.completed .ix-think-header::before {
    content: '';
    display: inline-flex; width: 14px; height: 14px;
    background: url("data:image/svg+xml,%3Csvg width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%231fc16b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M20 6L9 17l-5-5'/%3E%3C/svg%3E") no-repeat center;
    flex-shrink: 0;
  }

  .ix-dots-pulse {
    display: flex; gap: 3px; align-items: center;
  }
  .ix-dots-pulse span {
    width: 4px; height: 4px; border-radius: 50%; background: #755a68;
    animation: ix-dot-pulse 1.2s ease-in-out infinite;
  }
  .ix-dots-pulse span:nth-child(2) { animation-delay: 0.2s; }
  .ix-dots-pulse span:nth-child(3) { animation-delay: 0.4s; }
  @keyframes ix-dot-pulse {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* ── Index items ── */
  .ix-idx-body {
    display: flex; gap: 10px; margin-top: 14px; margin-left: 6px;
  }
  .ix-idx-line {
    width: 1.5px; flex-shrink: 0; background: rgba(117,90,104,0.2);
    border-radius: 1px; min-height: 20px;
    transition: background 0.4s ease;
  }
  .ix-think.completed .ix-idx-line { background: rgba(31,193,107,0.3); }
  .ix-idx-items {
    flex: 1; display: flex; flex-direction: column; gap: 8px;
  }
  .ix-idx-item {
    display: flex; align-items: center; gap: 10px;
    padding: 10px 12px; border-radius: 8px;
    opacity: 0; transform: translateY(6px);
    transition: opacity 0.35s ease, transform 0.35s ease, background 0.3s ease;
  }
  .ix-idx-item.visible {
    opacity: 1; transform: translateY(0);
  }
  .ix-idx-item.done {
    background: rgba(31,193,107,0.06);
  }
  .ix-idx-item-icon { display: flex; align-items: center; flex-shrink: 0; }
  .ix-idx-spinner { color: #7c7a71; }
  .ix-idx-spinner svg { animation: ix-spin 1s linear infinite; }
  .ix-idx-check { display: none; }
  .ix-idx-item.done .ix-idx-spinner { display: none; }
  .ix-idx-item.done .ix-idx-check { display: flex; }

  .ix-idx-item-label {
    font-size: 13px; font-weight: 500; color: #ede9e3; flex: 1;
  }
  .ix-idx-item-count {
    font-size: 12px; font-weight: 500; color: #7c7a71;
    font-variant-numeric: tabular-nums;
  }
  .ix-idx-item.done .ix-idx-item-count { color: #1fc16b; }

  /* ── Scene 3: Chat ready ── */
  .ix-chat { padding: 16px 8px; display: flex; flex-direction: column; height: 100%; box-sizing: border-box; }
  .ix-chat-header {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 0 18px;
    border-bottom: 1px solid rgba(237, 233, 227,0.08);
    margin-bottom: 20px;
  }
  .ix-chat-avatar {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
  .ix-chat-avatar-img {
    width: 24px; height: 24px; object-fit: contain;
    filter: brightness(0) invert(1);
  }
  .ix-chat-header-text {
    display: flex; flex-direction: column; gap: 2px;
  }
  .ix-chat-name {
    font-size: 14px; font-weight: 600; color: #ede9e3;
  }
  .ix-chat-status {
    font-size: 11px; color: #1fc16b; font-weight: 500;
  }
  .ix-chat-body {
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .ix-chat-body.visible {
    opacity: 1; transform: translateY(0);
  }
  .ix-chat-bubble {
    background: #2b272c; border: 1px solid rgba(237, 233, 227,0.08);
    border-radius: 12px; padding: 16px 18px;
  }
  .ix-chat-msg {
    font-size: 13px; color: #ede9e3; line-height: 1.7; margin: 0;
  }
  .ix-chat-msg strong { font-weight: 600; color: #ede9e3; }
  .ix-chat-meta {
    font-size: 11px; color: #7c7a71; margin-top: 10px; padding-left: 2px;
  }

  /* ── Reduced motion ── */
  @media (prefers-reduced-motion: reduce) {
    .ix-spinner, .ix-brain, .ix-dots-pulse span, .ix-idx-spinner svg {
      animation: none;
    }
  }

  /* ── Responsive ── */
  @media (max-width: 480px) {
    .ix-window { max-width: 100%; }
    .ix-cover { height: 56px; }
    .ix-icon { width: 24px; height: 24px; }
    .ix-body { height: 300px; min-height: 300px; max-height: 300px; }
  }
</style>

<script>
(function () {
  const body = document.getElementById('ix-body');
  if (!body) return;

  const scenes = body.querySelectorAll('.ix-scene') as NodeListOf<HTMLElement>;
  const cardsScene = body.querySelector('[data-scene="cards"]') as HTMLElement;
  const indexScene = body.querySelector('[data-scene="indexing"]') as HTMLElement;
  const readyScene = body.querySelector('[data-scene="ready"]') as HTMLElement;
  if (!cardsScene || !indexScene || !readyScene) return;

  const sfCard = cardsScene.querySelector('[data-tool="salesforce"]') as HTMLElement;
  const otherCards = cardsScene.querySelectorAll('.ix-card:not([data-tool="salesforce"])') as NodeListOf<HTMLElement>;
  const idxItems = indexScene.querySelectorAll('.ix-idx-item') as NodeListOf<HTMLElement>;
  const thinkBlock = indexScene.querySelector('.ix-think') as HTMLElement;
  const thinkLabel = indexScene.querySelector('.ix-think-label') as HTMLElement;
  const chatBody = readyScene.querySelector('.ix-chat-body') as HTMLElement;

  function sleep(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  function showScene(scene: HTMLElement) {
    scenes.forEach(s => s.classList.remove('active'));
    scene.classList.add('active');
  }

  function reset() {
    // 1. Remove active from all scenes first
    scenes.forEach(s => s.classList.remove('active'));
    // 2. Disable transitions so nothing animates during reset
    scenes.forEach(s => { s.style.transition = 'none'; s.style.opacity = ''; });
    // 3. Force reflow so browser commits the state
    void body!.offsetHeight;
    // 4. Re-enable transitions
    scenes.forEach(s => { s.style.transition = ''; });
    // 5. Reset internal state
    sfCard.classList.remove('connecting');
    otherCards.forEach(c => c.classList.remove('dimmed'));
    idxItems.forEach(item => { item.classList.remove('visible', 'done'); });
    if (thinkBlock) { thinkBlock.classList.remove('completed'); }
    if (thinkLabel) { thinkLabel.textContent = 'Indexing Salesforce'; }
    if (chatBody) { chatBody.classList.remove('visible'); }
  }

  async function runCycle() {
    reset();

    // Scene 1: Show integration cards
    showScene(cardsScene);
    await sleep(2500);

    // Salesforce starts connecting
    sfCard.classList.add('connecting');
    otherCards.forEach(c => c.classList.add('dimmed'));
    await sleep(1800);

    // Scene 2: Switch to indexing view
    showScene(indexScene);
    await sleep(800);

    // Reveal items one by one with indexing
    const delays = [1200, 1800, 800, 1400];
    for (let i = 0; i < idxItems.length; i++) {
      idxItems[i].classList.add('visible');
      await sleep(delays[i]);
      idxItems[i].classList.add('done');
      await sleep(300);
    }

    // Change to "Indexing complete" state
    if (thinkLabel) { thinkLabel.textContent = 'Indexing complete'; }
    if (thinkBlock) { thinkBlock.classList.add('completed'); }
    await sleep(1800);

    // Scene 3: Chat ready
    showScene(readyScene);
    await sleep(400);
    if (chatBody) { chatBody.classList.add('visible'); }
    await sleep(3000);

    // Fade out and restart
    readyScene.style.transition = 'opacity 0.5s ease';
    readyScene.style.opacity = '0';
    await sleep(550);
  }

  async function run() {
    while (true) {
      await runCycle();
    }
  }

  const io = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) { io.disconnect(); run(); }
  }, { threshold: 0.3 });
  io.observe(body);
})();
</script>
